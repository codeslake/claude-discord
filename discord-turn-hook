#!/usr/bin/env bash
# UserPromptSubmit hook: a turn that arrived over Discord (the transcript
# wraps it in a <channel source="plugin:discord:discord" ...> tag) must be
# answered through the discord reply tool only, not also typed into the CLI.
# Must never block or fail a turn, so any parse failure, missing field or
# unrelated prompt is silent success.
set -euo pipefail

prompt=$(jq -r '.prompt // empty' 2>/dev/null) || exit 0

case $prompt in
  *'<channel source="plugin:discord:discord"'*)
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"Discord turn: answer only with the discord reply tool; write no CLI text."}}'
    ;;
esac
exit 0
