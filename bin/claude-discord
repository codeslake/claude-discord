#!/usr/bin/env bash
# Runs a Claude Code session behind its own Discord bot, so several sessions
# can sit in one Discord channel. The human talks to each by @mentioning its
# bot; the bots reach each other the same way once allowlisted (the start
# patches the plugin to let other bots through), and sessions on one machine
# can also use SendMessage, mirroring those exchanges into the channel.
#
#   claude-discord setup <name> [--reset|--mode]  ask for channel/user IDs, allowed users, the
#                                          bot token, mention policy and mode (dev-manager also
#                                          asks for its peers); --reset asks all again; --mode
#                                          asks only the mode (and, for dev-manager, the peers)
#                                          for a bot already set up
#   claude-discord --name <name> [claude args]  start the session named <name>
#                                          (-n and --name=<name> work too); the
#                                          name may sit anywhere among the claude
#                                          args. Left out, the bot comes from
#                                          --resume (its job record, or a value
#                                          that names a bot), else the project's
#                                          only bot. `claude-discord <name> ...`
#                                          still works and warns; beside --name
#                                          it is refused.
#   claude-discord refresh <name> [--force] [claude args]
#                                        replace the running session with a fresh
#                                        one that starts from its handoff
#   claude-discord install [--scope project|global] [--method link|clone]
#                                        the plugin, the shim, runtime/ and compat/ for this
#                                        project (or globally); reads no stdin at all;
#                                        safe to re-run (the bootstrap's command)
#   claude-discord update [--all]        git pull --ff-only the clone this runs from (--all:
#                                        every recorded install, each real clone once; a
#                                        clone on a detached HEAD is skipped), then the
#                                        pulled code's patch, compat copy and shim
#   claude-discord --version             version and short sha of the clone
#   claude-discord health [--json]
#                                        is every bot in this project still
#                                        answering? exit 1 on a finding
#   claude-discord health --all [--json] [--patch]
#                                        every project recorded on this machine,
#                                        one document; --patch runs `patch`
#                                        first (what a monitor pass runs)
#   claude-discord health --uninstall-timer
#                                        remove the systemd --user timer an
#                                        older version installed; no OS
#                                        scheduler is installed any more
#   claude-discord tui [<name>]          a view of a manager bot's backend monitor
#                                        (needs uv), where its hosts are added,
#                                        set and removed (through `hosts`) and its
#                                        bots' access is edited (through `access`); starts
#                                        the monitor and its keeper if none runs
#                                        (both outlive the TUI); outside a project
#                                        it picks among the recorded projects
#   claude-discord monitor --keep <name> keeps the manager's monitor up with no
#                                        TUI or session (foreground: tmux, a
#                                        container entrypoint, systemd)
#   claude-discord monitor --stop <name> stops the keeper and the monitor; nothing
#                                        starts them again until:
#   claude-discord monitor --start <name> starts the backend again, detached
#   claude-discord hosts [--bot <name>] list [--json]
#                                        a manager bot's hosts ledger: one line per
#                                        host (alias, kind, display name, env key
#                                        names; never a value)
#   claude-discord hosts [--bot <name>] add [--no-probe|--dry-run] <alias> [laptop] [KEY=VALUE...]
#                                        adds a host line, after asking the host
#                                        over ssh who it is (--dry-run prints that
#                                        command; --no-probe adds without asking)
#   claude-discord hosts [--bot <name>] set <alias> name=<display>|KEY=VALUE|KEY=...
#                                        sets or (KEY=) removes words of a host's
#                                        line; `set <alias> --stdin` reads them from
#                                        stdin, one a line (a value then is in no
#                                        argument list), `laptop on|off` too
#   claude-discord hosts [--bot <name>] laptop <alias> on|off
#   claude-discord hosts [--bot <name>] rm [--no-probe] <alias>
#                                        stops checking a host (never `local`)
#   claude-discord access [--host <alias> [--manager <name>]] [--project <dir>] <name> --json
#                                        who may drive a bot: the channels it listens in, per channel the
#                                        mention rule and the senders, the DM policy, its mode; with the
#                                        server's channels and whether the bot can read each (read-only)
#   claude-discord access [...] <name> set <change>...
#                                        shows the changes (widenings first), asks once at the terminal
#                                        and writes access.json; refuses without a terminal. --host: a bot
#                                        on a host of a manager's ledger, over ssh (-t for the question)
#   claude-discord bot [--host <alias> [--manager <name>]] [--project <dir>] <name> token
#                                        reads a new token with the echo off (never the current one),
#                                        checks it with Discord as the same bot, asks, writes .env (600)
#   claude-discord bot [...] <name> rename <new>
#                                        renames the bot on Discord first, then here: its directory,
#                                        peers.json, a manager's records; a running session is stopped
#                                        and started again from its handoff
#   claude-discord bot [...] add [--mode none|dev-manager|autoresearchclaw] [--start]
#                                        a new bot from its token; its name is its Discord username
# All run from the project directory: state is ./.claude/discord-agents/<name>/.
#
# Origin: d.kim4's wrapper (2026-09-18), published at
# https://github.com/codeslake/claude-discord. Portable on purpose: nothing
# here assumes a particular shell setup.
#
#   CLAUDE_DISCORD_LAUNCHER   optional. An environment that wraps `claude` in a
#                             process wrapper (proxy chain, version pin) names
#                             it here and the session is started as
#                             `$CLAUDE_DISCORD_LAUNCHER <claude-bin> <args>`.
#                             Unset, Claude Code's own CLAUDE_CODE_PROCESS_WRAPPER
#                             is used, from the environment or, failing that,
#                             from `.env.CLAUDE_CODE_PROCESS_WRAPPER` in
#                             ~/.claude/settings.json; unset too, plain `claude`
#                             on PATH.
#   claude-discord patch      patches every cached copy of the official discord
#                             plugin (also run at each start): bots hear each
#                             other, @everyone wakes none, long replies split
#                             fence-safe (runtime/discord-chunk.ts), the gateway
#                             follows HTTPS_PROXY (runtime/discord-proxy.ts).
# Needs: bun, jq, and `claude plugin install discord@claude-plugins-official`.
set -euo pipefail

# State lives in the PROJECT, next to its other .claude/ files, so a bot belongs
# to the directory you start it from and `setup` is run there. The token is a
# plaintext secret inside a git tree, so setup drops a `*` .gitignore into the
# directory: nothing under it is ever staged, and the project's own .gitignore
# is left alone.
root=$PWD/.claude/discord-agents
helpers=$HOME/.claude-discord
plugin=discord@claude-plugins-official
# This script lives at <plugin root>/bin/claude-discord; the plugin's tools
# and rules are named from here, resolved through any symlink to the real copy.
# $0 that is no symlink (the shim runs the file itself) is taken as it is, made absolute: no readlink is started on
# every call (self_root below is the physical directory either way).
case $0 in /*) self_path=$0;; *) self_path=$PWD/$0;; esac
[ ! -L "$self_path" ] || self_path=$(readlink -f "$0" 2>/dev/null || echo "$self_path")
# The plugin root, physical (as the hooks' plugin_root is), found by cd and back in this shell: no $(...) fork on every call.
cd_here=$PWD self_root=""
! { cd -- "${self_path%/*}/.." && cd -P .; } 2>/dev/null || self_root=$PWD   # ${..%/*}, not dirname: one fork less
cd -- "$cd_here" 2>/dev/null || { echo "claude-discord: could not return to $cd_here" >&2; exit 1; }
# reserved_name <name>: a word no bot may take as its name (setup, bot rename, bot add): claude-discord's subcommands,
# `add` (`claude-discord bot add`), and the directories beside the bots.

# monitor: the backend health monitor of a manager bot (monitor/monitor.sh has
# the whole story). --keep and --stop are for people; --ensure is the TUI's and the hooks'.
if [ "${1:-}" = monitor ]; then
  shift
  # Run from anywhere: the project is the one above the cwd that has the bot, else the recorded one (records/projects),
  # as tui finds it. Not found: monitor.sh says so (no ledger) from where it is.
  mb="" sk=0
  for a in "$@"; do
    if [ "$sk" -gt 0 ]; then sk=$((sk - 1)); continue; fi
    case $a in --holder) sk=2;; -*) ;; *) mb=$a; break;; esac
  done
  case $mb in ''|.|..|*/*) ;; *)
    mp=$PWD
    while [ ! -d "$mp/.claude/discord-agents/$mb" ] && [ "$mp" != / ]; do mp=$(dirname "$mp"); done
    if [ -d "$mp/.claude/discord-agents/$mb" ]; then cd "$mp"
    elif [ -f "$helpers/records/projects" ]; then
      mc="" mn=0
      while IFS= read -r p || [ -n "$p" ]; do
        p=${p%$'\r'}
        [ -n "$p" ] && [ -f "$p/.claude/discord-agents/$mb/hosts" ] || continue
        mc=$p; mn=$((mn + 1))
      done < "$helpers/records/projects"
      [ "$mn" != 1 ] || cd "$mc"
    fi;;
  esac
  exec bash "$self_root/monitor/monitor.sh" "$self_path" "$@"
fi
reserved_name() { case $1 in setup|install|update|patch|compat|refresh|health|monitor|tui|hosts|access|bot|add|hooks|checkin) return 0;; esac; return 1; }

# access.json is written at setup time, so every answer lives in the file the
# plugin reads and nothing else needs persisting. The run path below keeps a
# fallback for bot dirs set up before this existed.
write_access() {  # $1 = bot dir, $2 = requireMention (true|false), $3 = "all" for this bot only
  # An EMPTY group allowFrom lets everyone in that channel through (the plugin
  # only filters when the list is non-empty), which is what "all" answers.
  # dmPolicy stays an allowlist of the owner either way: "all" opens the
  # channel, never DMs.
  #
  # "all" is honoured ONLY from $3 (the live answer for this one bot), never
  # from config.env: that file is shared, so a hand-written DISCORD_ALLOW_IDS=all
  # must not silently open every bot the run path writes a fresh access.json for.
  # config.env is always read as an id list.
  local open=""; [ "$(printf '%s' "${3:-}" | tr '[:upper:]' '[:lower:]')" = all ] && open=yes
  jq -n --arg ch "$DISCORD_CHANNEL_ID" --arg me "$DISCORD_USER_ID" \
        --arg others "${DISCORD_ALLOW_IDS:-}" --argjson mention "$2" --arg open "$open" \
    '{dmPolicy: "allowlist", allowFrom: [$me], ackReaction: "👀",
      groups: {($ch): {requireMention: $mention,
                       allowFrom: (if $open == "yes" then []
                                   else [$me] + ($others | split(",") | map(gsub("\\s";"")) | map(select(. != ""))) end)}}}' \
    > "$1/access.json"
}

# Every JSON file claude-discord edits (settings.json, access.json,
# peers.json) goes through here: the file (a missing or 0-byte one reads as
# {}) is run through the jq filter in the arguments and written back only
# when the result differs, with a trailing newline, never in place: a temp
# file beside it with its mode (cp -p) is renamed over it, so a reader (the
# plugin reads access.json at every message and moves a file it cannot parse
# aside) sees the old file or the new one, never half of one. A symlink's
# target is replaced, so the link stays. A file that is not valid JSON, a filter that
# fails on it (a non-object, an event key holding a non-array) or a failed
# write is warned about on stderr, naming the file, and left alone: an edit
# must never fail the setup or the start it runs inside.
jq_edit() {  # $1 = file, the rest = jq arguments
  local f=$1 base='{}' merged
  shift
  if [ -e "$f" ]; then
    # Nothing to change in a file already in jq's own form (as every file written here is): said by one jq, not two
    # (an edit that does change it then costs three; those are setup and a first start). 2>/dev/null: bash warns
    # about a NUL byte in a file it reads.
    if [ -s "$f" ] && merged=$(jq "$@" "$f" 2>/dev/null) && [ -n "$merged" ] && { [ "$merged" = "$(<"$f")" ]; } 2>/dev/null; then return 0; fi
    base=$(jq . "$f" 2>/dev/null) || { echo "claude-discord: $f is not valid JSON, leaving it alone" >&2; return 0; }
    [ -n "$base" ] || base='{}'
  fi
  merged=$(printf '%s' "$base" | jq "$@" 2>/dev/null) || merged=""
  [ -n "$merged" ] || { echo "claude-discord: could not update $f, leaving it alone" >&2; return 0; }
  [ "$merged" != "$base" ] || return 0
  local t=$f
  [ ! -L "$f" ] || t=$(readlink -f "$f" 2>/dev/null) || t=""
  if [ -z "$t" ]; then
    # A link readlink cannot resolve (a macOS before 12.3 has no readlink -f): written through it, as before.
    { printf '%s\n' "$merged" > "$f"; } 2>/dev/null || echo "claude-discord: could not write $f, leaving it alone" >&2
  elif mkdir -p "$(dirname "$t")" 2>/dev/null && { [ ! -e "$t" ] || cp -p "$t" "$t.tmp.$$" 2>/dev/null; } &&
       printf '%s\n' "$merged" > "$t.tmp.$$" 2>/dev/null && mv -f "$t.tmp.$$" "$t" 2>/dev/null; then
    :
  else
    rm -f "$t.tmp.$$"
    echo "claude-discord: could not write $f, leaving it alone" >&2
  fi
}

# Adds access.json's ackReaction key (the plugin's own read-receipt
# reaction) only when the key is absent; an explicit "" means the owner
# disabled it and is left alone.
ensure_ack_reaction() {  # $1 = bot dir
  [ -f "$1/access.json" ] || return 0
  grep -q '"ackReaction"' "$1/access.json" && return 0   # present (even ""): nothing to add, and no jq forks
  jq_edit "$1/access.json" 'if has("ackReaction") then . else . + {ackReaction: "👀"} end'
}

# Makes <project>/.claude/discord-agents/hooks a symlink to the plugin's hooks,
# so a settings entry an old peer committed still reaches them. Kept this
# release, removed in the next. Only when the path is absent or already a
# symlink (broken or not); a real directory there is left alone with a warning.
ensure_hooks_symlink() {
  local link="$root/hooks"
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "claude-discord: $link exists and is not a symlink, leaving it alone" >&2
    return 0
  fi
  [ -L "$link" ] && [ "$link" -ef "$self_root/hooks" ] && return 0   # already right: no forks on every start
  mkdir -p "$root" 2>/dev/null || return 0
  ln -sfn "$self_root/hooks" "$link" 2>/dev/null || echo "claude-discord: could not symlink $link" >&2
}
has_path() { [ -e "$1" ] || [ -L "$1" ]; }   # a dangling link counts
# Read in the shell, not with jq: every start asks (sync_runtime), and one jq start is 10 ms with jq 1.6. The manifest is
# ours and flat (no other "version" key in it): the first one's string; "?" when there is none.
plugin_version() {
  local l re='"version"[[:space:]]*:[[:space:]]*"([^"]*)"'
  if [ -r "$1/.claude-plugin/plugin.json" ]; then
    while IFS= read -r l || [ -n "$l" ]; do
      if [[ $l =~ $re ]]; then echo "${BASH_REMATCH[1]}"; return 0; fi
    done < "$1/.claude-plugin/plugin.json"
  fi
  echo "?"
}
head_sha() { git -C "$1" rev-parse HEAD 2>/dev/null || :; }   # compat/VERSION's stamp (empty with no git)
# The one version line: what --version prints (`hosts` and `access --host` parse it on other machines, so its shape
# does not move) and, since 1.14.1, what the TUI is handed as --version-line for its title.
version_line() { echo "claude-discord $(plugin_version "$self_root") ($(git -C "$self_root" rev-parse --short HEAD 2>/dev/null || echo nogit))"; }
# ver_ge <a> <b>: a >= b for x.y.z versions; anything else is not.
ver_ge() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<<"$1"; IFS=. read -r b1 b2 b3 <<<"$2"
  # Exactly three numeric parts each (1.9.0.1 leaves a dot in the third); base 10, so 1.08.0 is not octal.
  case $a1.$a2.$a3.$b1.$b2.$b3 in *[!0-9.]*|*..*|.*|*.) return 1;; esac
  case $a3$b3 in *.*) return 1;; esac
  [ $((10#$a1 * 1000000 + 10#$a2 * 1000 + 10#$a3)) -ge $((10#$b1 * 1000000 + 10#$b2 * 1000 + 10#$b3)) ]
}
# git over the network: never a credential prompt (a script would hang on it),
# and a 120 s ceiling where timeout(1) exists. The ambient git config and
# environment apply, so a proxy is per clone: git -C <clone> config http.proxy <url>.
record_project() {
  local f=$helpers/records/projects p l
  p=$(pwd -P) || return 0
  # Already listed (every health run after the first): found with no fork.
  if [ -f "$f" ]; then while IFS= read -r l || [ -n "$l" ]; do [ "$l" != "$p" ] || return 0; done < "$f"; fi
  mkdir -p "$helpers/records" 2>/dev/null && printf '%s\n' "$p" >> "$f" 2>/dev/null || :
}
ledger_write() {
  local f=$1 m=600
  [ ! -f "$f" ] || m=$(perl -e 'printf "%o", (stat shift)[2] & 07777' "$f") || m=600
  (umask 077; printf '%s\n' "${2%$'\n'}" > "$f.tmp.$$") && chmod "$m" "$f.tmp.$$" && mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$"; return 1; }
}

# --scope and --method, anywhere and in the = form too, for setup and install;
# every other word lands in rest, in order.

# ask <var> <prompt> [-s]: one answer from stdin. Stdin ending before an answer
# is said and exits 2 (set -e would otherwise end setup with a silent 1).
ask() {
  local a=""
  read -r ${3:-} -p "$2" a || [ -n "$a" ] || {
    [ ! -t 0 ] || echo >&2
    echo "claude-discord: setup: stdin ended before '$2' was answered; run setup at a terminal, or pipe one line per question (an empty line keeps the current value)" >&2
    exit 2
  }
  printf -v "$1" '%s' "$a"
}


# The bot is named by --name/-n (the launch mirrors `claude`). The older
# positional form still works with a warning: the first bare word, wherever it
# sits, is the bot, but only when no --name is given. A word that follows a flag
# taking a value is that value, so `--resume x` never reads as the name, and
# with no name at all the project's single bot is meant. The list is
# every flag `claude --help` (2.1.277) shows with a value, optional ones
# ([value]) included since claude takes the next word for them too, plus
# hidden ones in use (--channels, --max-turns, the *-file prompt flags).
takes_value() {
  case $1 in
    -r|--resume|--model|--effort|--settings|--agent|--agents|--permission-mode|--permission-prompts| \
    --mcp-config|--add-dir|--session-id|--fallback-model|--max-turns|--max-budget-usd| \
    --output-format|--input-format|--json-schema|--debug-file|-d|--debug|--betas|--autocompact| \
    --append-system-prompt|--append-system-prompt-file|--system-prompt|--system-prompt-file| \
    --system-prompt-snapshot|--allowedTools|--allowed-tools|--disallowedTools|--disallowed-tools| \
    --tools|--setting-sources|--plugin-dir|--plugin-url|--file|--environment|--cloud|--from-pr| \
    --teleport|--remote-control|--remote-control-session-name-prefix|--prompt-suggestions| \
    -w|--worktree|--channels|-n|--name) return 0;;
    *) return 1;;
  esac
}

# A bot can stop answering without anything failing loudly: measured on this
# machine, a worker that came back from a Claude Code self-upgrade ran no
# hooks at all for 21 hours, and a `refresh` whose `--bg` start hit the
# workspace-trust gate left the bot down for 22 -- neither reported anywhere.
# `health` is the outside check for exactly that, run by hand from outside
# the session, so it still speaks when the session is the thing that died.
#
#   claude-discord health [--json]
#   claude-discord health --all [--json] [--patch]
#   claude-discord health --uninstall-timer
#
# What it judges by, and why not the obvious thing: `claude agents`' `.state`
# is NOT a liveness signal. Measured on two machines, a fully live bot shows
# `state: done, status: idle` while its pid and its gateway connection are
# both up; `state` tracks whether a turn is running. Counting processes is no
# better on its own -- the upgrade failure above kept server, gateway and
# session alive and killed only the hooks, so every process check said
# "fine". So the PRIMARY signal is behavioural:
#
#   a message that addressed this bot, never handed to its session (its id
#   is not in $dir/delivered, written by turn/on-prompt; with no such file,
#   newer than $dir/last-message-id), and older than $stale_min minutes
#
# which catches a dead process, dead hooks and a wedged turn alike. The
# process count is then used only to NAME the cause (none = down, several =
# two sessions on one token). Three things would otherwise make that signal
# cry wolf, and each is filtered:
#   - the plugin drops a message from an author outside access.json's
#     allowFrom before any hook runs, so last-message-id can never catch up
#     to it; health applies the same allowFrom (empty = everyone, as there).
#   - a long turn legitimately takes minutes, so a turn in flight
#     (turns/<session id>, written by on-prompt and removed by on-stop)
#     holds the alert back -- but only while that file is younger than
#     $turn_max_min, since a turn whose hooks died leaves it behind for ever
#     and would otherwise silence the very failure this exists to catch.
#   - a human reaches a bot by replying to it, with no mention at all, so a
#     reply whose referenced_message is this bot's counts as addressing it.
# Known gap: the plugin also treats a mention of the bot's managed ROLE as
# addressing it, and the REST payload carries those in `mention_roles`, not
# in `mentions`. Such a message is not counted, so health under-reports
# there rather than crying wolf -- the safe direction for a thing that wakes
# a human.
# Never restarts anything and never stops anything: a misjudged restart is
# what puts two sessions on one token, and this is the tool most likely to
# misjudge. It reports, and a human decides.

# untrusted: this project's workspace trust is an explicit false in ~/.claude.json, so a `claude --bg` start here would
# refuse ("Workspace not trusted"). Fail-open: no file, no jq, no key all read as trusted (refresh, below, says why).
# `// "unset"` would be wrong: jq's `//` treats FALSE as empty, so the one value this checks for could never be seen.
untrusted() {
  command -v jq >/dev/null 2>&1 &&
    [ "$(jq -r --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted | if . == null then "unset" else tostring end' "$HOME/.claude.json" 2>/dev/null)" = false ]
}

# host_id: prints this HOME's id, ~/.claude-discord/host-id (one line: 32 lower-case hex digits, random), making it when
# it is missing. It names a home, not a machine: what a monitor pass reads on a host is that home's records/projects,
# so two ledger lines that reach one home (a container and its host sharing $HOME, two ssh aliases of one account)
# would report every bot of it twice. `hosts add` compares it. Made once: the id is written to a temp file and
# hard-linked in, and ln fails when the name is there, so of two first calls at once one wins and both print the
# winner's. A file that is there but holds no id (cut off, hand-edited) is replaced.
hid_re='^[0-9a-f]{32}$'   # what a host-id is
# What travels in a watcher record: a manager bot's name that can be a file name on another machine and a bare word of
# an ssh command line, and an ssh alias as `hosts` takes one.
mgr_re='^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}$' alias_re='^[A-Za-z0-9._@][A-Za-z0-9._@-]{0,254}$'
# c_match <string> <regex>: the match in the C locale, where A-Z, a-z and 0-9 are those ASCII characters and no other
# (in a UTF-8 locale a range also takes accented and fullwidth letters, by the locale's collation). For what must be
# plain: a host-id, a manager's name, an ssh alias, an env KEY. The locale is this function's own: the rest of the
# script keeps the user's (a display name is counted in its characters).
c_match() { local LC_ALL=C; [[ $1 =~ $2 ]]; }
host_id() {
  local f=$helpers/host-id id=""
  { read -r id < "$f"; } 2>/dev/null || :
  if ! c_match "$id" "$hid_re"; then
    mkdir -p "$helpers" || return 1
    (umask 077; id=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n') && printf '%s\n' "$id" > "$f.tmp.$$") || { rm -f "$f.tmp.$$"; return 1; }
    if ! ln "$f.tmp.$$" "$f" 2>/dev/null; then
      # The name is taken: by another first call's id (kept: read below), or by a file that is no id (replaced).
      id=""; { read -r id < "$f"; } 2>/dev/null || :
      c_match "$id" "$hid_re" || mv -f "$f.tmp.$$" "$f" || :
    fi
    rm -f "$f.tmp.$$"
    id=""; { read -r id < "$f"; } 2>/dev/null || :
    c_match "$id" "$hid_re" || return 1
  fi
  printf '%s\n' "$id"
}

# What `access --host` runs on another machine (1.13.0): `--version --access <hex of the project> <hex of the bot> ...` is
# `access --project <project> -- <bot> ...` here. Behind --version for the reason --host-id is (below): an older
# claude-discord prints its version line and exits. Hex, so that no name or path has to survive a remote shell.
if [ "${1:-}" = --version ] && { [ "${2:-}" = --access ] || [ "${2:-}" = --bot ]; }; then
  c_match "${3:-}" '^([0-9a-f][0-9a-f]){1,1024}$' && c_match "${4:-}" '^([0-9a-f][0-9a-f]){1,255}$' || exit 2
  a_unhex() { local h=$1 o=""; while [ -n "$h" ]; do o="$o\\x${h:0:2}"; h=${h:2}; done; printf "$o"; }
  set -- "${2#--}" --project "$(a_unhex "$3")" -- "$(a_unhex "$4")" "${@:5}"
fi
# self_root is already the real clone (a link resolved through readlink and pwd -P).
if [ "${1:-}" = --version ]; then
  version_line
  # What `hosts add` asks another machine over ssh (1.12.0). It rides on --version because a claude-discord before
  # 1.12.0 prints the line above and exits whatever follows, while any new verb would be read there as a bot name
  # and reach the launcher.
  # watchers/<manager>, on a checked host: "<host-id of the manager's home> <its alias for this host> <UTC time>", one
  # line, written when that manager's `hosts add` took this host and removed by its `hosts rm`. The words arrive over
  # ssh from another machine, so each is matched before a file name is made from one.
  wd=$helpers/watchers
  case ${2:-} in
    --host-id)
      id=$(host_id) || exit 1; echo "host-id $id"
      for f in "$wd"/*; do
        [ -f "$f" ] && c_match "${f##*/}" "$mgr_re" || continue
        w=""; { read -r w < "$f"; } 2>/dev/null || :
        echo "watcher ${f##*/} ${w//[[:cntrl:]]/}"
      done;;
    --watch)   # <manager> <the host-id of its home> <its alias for this host>
      c_match "${3:-}" "$mgr_re" && c_match "${4:-}" "$hid_re" && c_match "${5:-}" "$alias_re" || exit 2
      id=$(host_id) || exit 1
      [ "$id" != "$4" ] || exit 1   # this very home: it is checked through `local`, never through an alias
      (umask 077; mkdir -p "$wd" && printf '%s %s %s\n' "$4" "$5" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$wd/.$3.$$" && mv -f "$wd/.$3.$$" "$wd/$3") || exit 1
      echo "watched $3";;
    --unwatch)   # <manager> <the host-id of its home>: only the record that home wrote
      c_match "${3:-}" "$mgr_re" && c_match "${4:-}" "$hid_re" || exit 2
      w=""; { read -r w rest < "$wd/$3"; } 2>/dev/null || :
      [ "$w" != "$4" ] || rm -f "$wd/$3"
      echo "unwatched $3";;
  esac
  exit 0
fi

# The verbs below live in bin/lib/<file>.sh (1.15.0), sourced here so a call parses only what it needs; each verb's
# block exits inside its file. Top-level code, never a function: a `.` inside a function would hand the file that
# function's own $1. After the --version rewrite above (its `set --` is what the file must see).
lib=$self_root/bin/lib libs=""
case ${1:-} in
  install|setup|update|compat) libs="patch install";;
  patch) libs=patch;;
  health) libs="patch health";;
  refresh) libs="sessions refresh";;
  hosts) libs="remote hosts";;
  access) libs="remote access";;
  bot) libs="sessions remote bot";;
  tui) libs=tui;;
esac
for l in $libs; do
  [ -r "$lib/$l.sh" ] || { echo "claude-discord: $lib/$l.sh is missing: bin/claude-discord runs beside bin/lib/ (a copy of the one file is no install)" >&2; exit 1; }
  . "$lib/$l.sh"
done
[ -r "$lib/patch.sh" ] || { echo "claude-discord: $lib/patch.sh is missing: bin/claude-discord runs beside bin/lib/ (a copy of the one file is no install)" >&2; exit 1; }
. "$lib/patch.sh"   # patch_official, run at every start


args=() name="" skip=0 want_name=0 named=0 positional=0 has_name=0 bare=0
# With a --name anywhere, a bare word is an argument for claude, not the bot
# (`-p hello --name beta` keeps `hello`).
for a in "$@"; do case $a in -n|--name|--name=*) has_name=1;; esac; done
seen_name=0
for a in "$@"; do
  if [ "$want_name" = 1 ]; then name=$a; named=1; want_name=0; continue; fi
  if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) args+=("$a"); continue;; esac; fi   # a value never starts with "-" (see refresh)
  case $a in
    # --name/-n IS the bot name, and the session is named after it (-n below).
    -n|--name) want_name=1; seen_name=1;;
    --name=*)  name=${a#--name=}; named=1; seen_name=1;;
    -*) args+=("$a"); takes_value "$a" && skip=1 || :;;
    *)  if [ "$has_name" = 0 ] && [ -z "$name" ]; then name=$a; positional=1
        else
          # A set-up bot's name as the first bare word BEFORE --name is the old positional form
          # mixed with the new one; a bare word after --name (or with no --name) is claude's.
          bare=$((bare + 1))
          case $a in */*|.|..) ;; *) [ "$has_name" != 1 ] || [ "$seen_name" = 1 ] || [ "$bare" != 1 ] || [ ! -f "$root/$a/.env" ] || { echo "claude-discord: '$a' and --name both name a bot; use 'claude-discord --name <bot> ...' (the positional 'claude-discord <bot> ...' is the old form), never both" >&2; exit 2; };; esac
          args+=("$a")
        fi;;
  esac
done
if [ "$want_name" = 1 ] || { [ "$named" = 1 ] && [ -z "$name" ]; }; then echo "claude-discord: --name needs a bot name" >&2; exit 2; fi
[ "$positional" = 1 ] && [ "$named" != 1 ] &&
  echo "claude-discord: 'claude-discord $name ...' is deprecated; use 'claude-discord --name $name ...'" >&2

# --resume <id|name> with no --name: the bot is the one whose job record carries
# its DISCORD_STATE_DIR (every launch passes it in --settings; the daemon keeps
# it), else the one the value itself names.
rid=""
for i in "${!args[@]}"; do
  case ${args[i]} in
    --resume|-r) rid=${args[i+1]:-};;
    --resume=*)  rid=${args[i]#--resume=};;
    -r=*)        rid=${args[i]#-r=};;
  esac
done
if [ -z "$name" ] && [ -n "$rid" ]; then
  cands=""
  # Only an id-shaped value (8+ hex) is a prefix of a session id: a bot called
  # dead or beef must not match another bot's record.
  ridl=$(printf '%s' "$rid" | tr 'A-Z' 'a-z')
  printf '%s' "$ridl" | grep -qE '^[0-9a-f-]{8,}$' || ridl=""
  for f in ${ridl:+"${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/jobs/*/state.json}; do
    jq -e --arg r "$ridl" '((.sessionId // "") | startswith($r)) or ((.resumeSessionId // "") | startswith($r))' "$f" >/dev/null 2>&1 || continue
    # The raw file, as refresh reads it: inside state.json the --settings value
    # is a JSON string, so its quotes appear escaped as \".
    for d in "$root"/*/; do
      d=${d%/}
      grep -qF -- "DISCORD_STATE_DIR\\\": \\\"$d\\\"" "$f" || continue
      case " $cands " in *" ${d##*/} "*) ;; *) cands="$cands ${d##*/}";; esac
    done
  done
  case $cands in
    '') ;;
    ' '*' '*) echo "claude-discord: --resume $rid matches sessions of several bots ($cands ); name the one with --name" >&2; exit 2;;
    *) name=${cands# };;
  esac
  case $rid in */*) ;; *) [ -n "$name" ] || { [ -f "$root/$rid/.env" ] && name=$rid; } || :;; esac
fi
if [ -z "$name" ]; then
  bots=()
  for d in "$root"/*/; do [ -f "$d/.env" ] && bots+=("$(basename "$d")"); done
  case ${#bots[@]} in
    1) name=${bots[0]};;
    0) echo "claude-discord: no bot set up in $root; run 'claude-discord setup <name>' in this directory first" >&2; exit 1;;
    *) echo "claude-discord: this directory has several bots (${bots[*]}); name the one to start with --name" >&2; exit 2;;
  esac
fi
case $name in
  ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
  hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
esac
dir=$root/$name
if [ ! -f "$dir/.env" ] || [ ! -f "$root/config.env" ]; then
  echo "claude-discord: no bot '$name' under $root; run 'claude-discord setup $name' in this directory first" >&2
  exit 1
fi
. "$root/config.env"

# Everything that can refuse the start comes before anything is written (the
# handoff below is consumed, so a refusal after it would lose it).
# `claude --resume` takes a full session id; a NAME only works through the
# interactive picker, which cannot appear under --bg and is a detour otherwise.
# So resolve a name, or a short id as `claude agents` prints it, against this
# project's transcripts. Anything already a full id, or not found, is passed
# through untouched and claude decides.
res_i=-1 res_pre=""
for i in "${!args[@]}"; do
  case ${args[i]} in
    --resume|-r)  res_i=$((i+1)); res_pre="";;
    --resume=*)   res_i=$i;       res_pre="--resume=";;
    -r=*)         res_i=$i;       res_pre="-r=";;
  esac
done
want=""
[ "$res_i" -ge 0 ] && want=${args[res_i]:-} && want=${want#"$res_pre"}
if [ -n "$want" ] && ! printf '%s' "$want" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
  # Claude Code's own transcript-dir naming: EVERY non-alphanumeric character
  # of the path becomes '-'. A narrower `tr './'` missed '_' and silently left
  # the name unresolved, and `--bg --resume <name>` then hangs on a picker.
  proj=$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
  found=""
  if printf '%s' "$want" | grep -qE '^[0-9a-f]{8}$'; then
    found=$(cd "$proj" 2>/dev/null && ls -t "$want"*.jsonl 2>/dev/null | head -1) || :
  else
    # The name is the session's own title (claude-discord -n, or /rename), which
    # is rewritten on every change, so only the LAST record of a file counts.
    found=$(cd "$proj" 2>/dev/null && for f in $(ls -t ./*.jsonl 2>/dev/null); do
      t=$(tail -c 262144 "$f" | grep -o '"customTitle":"[^"]*"' | tail -1)
      [ "$t" = "\"customTitle\":\"$want\"" ] && { echo "${f#./}"; break; }
    done) || :   # no match is not an error: `set -e` would abort on the loop's last test
  fi
  if [ -n "$found" ]; then
    args[res_i]="$res_pre${found%.jsonl}"
    echo "claude-discord: --resume $want -> ${found%.jsonl}" >&2
  fi
fi
# Whatever --resume ends up pointing at, resolved just above or passed through
# as a full id, is the session this start is about to reopen: the reaping below
# must never delete it. A transcript's basename IS the session id, and a name
# resolves to the newest transcript of this bot in this project, which is
# exactly the kind of row the daemon calls done.
resume_id=""
[ "$res_i" -ge 0 ] && resume_id=${args[res_i]:-} && resume_id=${resume_id#"$res_pre"}

# `claude` here is whatever bash finds on PATH, never a shell function: a setup
# that wraps claude in a process wrapper must name it, or that wrapping is
# skipped (measured 2026-09-18 with a launcher that wires a proxy chain: the
# bare binary bypassed it). CLAUDE_CODE_PROCESS_WRAPPER is Claude Code's own
# name for that wrapper and is exported into every session, so honouring it
# means an environment that already has one needs no extra setting. Not every
# session gets it in the environment though (settings.json's `env` block is
# merged into the session, not necessarily into the shell that starts it), so
# a session-scoped wrapper falls back to reading it from the same file Claude
# Code itself reads it from: ~/.claude/settings.json.
bin=$(command -v claude) || { echo "claude-discord: claude is not on PATH" >&2; exit 127; }
launcher=${CLAUDE_DISCORD_LAUNCHER:-${CLAUDE_CODE_PROCESS_WRAPPER:-}}
# Asked of jq only when the file names it at all: every bot start comes through here, and one jq start is 10 ms with jq 1.6.
if [ -z "$launcher" ] && [ -r "$HOME/.claude/settings.json" ]; then
  { case $(<"$HOME/.claude/settings.json") in   # 2>/dev/null: bash warns about a NUL byte in a file it reads
    *CLAUDE_CODE_PROCESS_WRAPPER*) launcher=$(jq -r '.env.CLAUDE_CODE_PROCESS_WRAPPER // empty' "$HOME/.claude/settings.json") || : ;;
  esac; } 2>/dev/null
fi
run=("$bin")
[ -n "$launcher" ] && run=("$launcher" "$bin")

# A second copy of a live session would put two sessions on one token, and the
# old row could be revived by a fleet claim: refresh replaces it instead. Same
# rule as refresh's: a row `claude agents --json` lists (no --all) is live unless
# stopped, and `done` is live (an idle bot sits there). The row is matched by
# sessionId or resumeSessionId (a prefix of 8+ hex is enough) or by its job id,
# which a resumed session keeps while its sessionId changes. Fails open: no
# listing (claude agents errors, hangs past 5 s, or prints a non-array) starts
# as before.
if [ -n "$resume_id" ]; then
  lt=(); command -v timeout >/dev/null 2>&1 && lt=(timeout 5)
  if agents=$(${lt[@]+"${lt[@]}"} "$bin" agents --json 2>/dev/null) &&
     live=$(printf '%s' "$agents" | jq -r --arg s0 "$resume_id" '($s0 | ascii_downcase) as $s | if type == "array" and ($s | test("^[0-9a-f-]{8,}$")) then first(.[] | select((((.sessionId // "") | startswith($s)) or ((.resumeSessionId // "") | startswith($s)) or (.id == $s[0:8])) and (.state // "") != "stopped")) | (.id // "?" | tostring) else empty end' 2>/dev/null) && [ -n "$live" ]; then
    # A dead session the listing still shows as done counts too; stopping its row is the way to resume it.
    echo "claude-discord: session $resume_id is running (job $live); use 'claude-discord refresh $name' to replace it, or, if that session is dead but still listed, 'claude stop $live' and then --resume" >&2
    exit 2
  fi
fi

# Pre-existing setups: same policy the old first-run write produced.
[ -f "$dir/access.json" ] || write_access "$dir" true
ensure_ack_reaction "$dir"

# The official plugin must carry our patches before its server starts; a moved
# pattern is reported and the start goes on with whatever still applied.
patch_official >/dev/null || echo "claude-discord: some patches no longer apply (see above); the bot starts anyway" >&2

# The bot's channel is the single group key in its access.json, where a bot
# is moved to another channel; config.env's DISCORD_CHANNEL_ID otherwise (no
# file, no group, several). The same rule as hooks/lib/discord.sh's
# resolve_channel, which cannot be sourced here (it is not set -e safe, and
# the installed copy may be older than this script).
channel=$DISCORD_CHANNEL_ID
groups=$(jq -r '.groups | objects | keys[]' "$dir/access.json" 2>/dev/null) || groups=""
case $groups in ''|*[!0-9]*) ;; *) channel=$groups ;; esac
prompt="You are \"$name\", one of several Claude Code sessions sharing the Discord channel $channel, each through its own bot. \
The human reaches you there by @mentioning or replying to your bot; answer those with the discord reply tool. \
A turn the human types in this terminal (no <channel> tag) is answered in the terminal; from it, post to Discord only what the human asks you to send or what another bot must act on, never a copy of the terminal conversation. \
When both arrive in one turn, answer each where it came from. \
A request that needs more than a line or two gets its own thread: $self_root/tools/thread start \"[<area>] <short title>\" posts that one line in the channel and prints the thread id. \
In a message, write a channel or thread as <#id> (Discord shows its name, linked) and a user or bot you only name as plain @name (it pings nobody); one who must answer or decide is mentioned as <@id>, since plain @name reaches nobody; a bare id is denied, and an id in backticks shows the number itself. \
Everything else about the request goes inside that thread, with the id as chat_id. \
When it lands, run thread close <id> \"<one closing line>\": it posts that line inside the thread and archives it. \
Unless your mode's rules say otherwise, answer a quick request yourself and dispatch one that needs more than a few tool calls to a background subagent whose brief names the request's thread id, then post its result in that thread when it returns. \
That keeps you free for the next message, and requests from different people never share a context. \
Another bot receives your messages only when you @mention it and it allowlists your bot. \
Sessions on this machine can also be reached with ListAgents and SendMessage, addressing them by session name. \
In a turn that arrived from Discord, mirror each such message you send or receive into that channel as one line that says which way it went, '[sent to name] ...' or '[received from name] ...', so the human can follow and step in; in any other turn it stays out of Discord. \
The human's instructions override any agent's. \
Mention a bot as <@id> only when you need it to act or answer; if you were mentioned but nothing is asked of you, do not reply."

# A fresh session after a refresh must arrive already holding the handoff.
# Consumed once: leaving it would make every later restart resume a
# conversation that has moved on. The gap between the old session's stop and
# this one's gateway login loses whatever arrived in it, so catch up first;
# the hooks record the id of the last message the old session was given.
if [ -s "$dir/handoff.md" ]; then
  handoff=$(cat "$dir/handoff.md")
  mv "$dir/handoff.md" "$dir/handoff.prev.md"
  last=$(cat "$dir/last-message-id" 2>/dev/null || :)
  catchup="fetch the channel's recent messages first"
  [ -n "$last" ] && catchup="fetch the channel's messages first; the last one your predecessor saw was $last, so everything after it is new to you"
  prompt="$prompt \
A previous session of yours was replaced and left you this handoff. Treat it as \
what it says it is: claims marked [assumed] are unverified, so check them \
before repeating them to anyone. Messages that arrived while you were being \
replaced were not delivered: $catchup, and answer anything addressed to you. \
Then pick up from the Next section.

$handoff"
fi

# The state dir goes in BOTH the environment and --settings env. /bg (and
# `claude --bg`) respawn the session under the daemon from its CLI flags alone,
# dropping the shell environment (measured 2026-09-18: the fork had no
# DISCORD_STATE_DIR, its plugin server found no token and died silently);
# --settings is one of the flags the daemon carries over.
export DISCORD_STATE_DIR=$dir

# Claude Code's daemon retires a background session after about an hour idle,
# and nothing here ever removed the retired one: `refresh` stops a session but
# never `rm`s it, so every start of a bot left one more dead entry in the agent
# view for ever (measured 2026-09-19 on an owner's machine: 7 rows for 2 bots,
# 4 of them stopped or done). So a start reaps its OWN dead sessions first:
# this bot's name, started in THIS project directory, and a state that says the
# session is over. `claude rm` deletes the session and, if it had one (the
# wrapper passes -w/--worktree through), its worktree, so everything else
# stays -- another name, another project, any live state (idle, busy, waiting,
# working, blocked), and an interactive entry with no state at all, none of
# which is this start's to remove. The session this very start is resuming is
# kept too ($resume_id, see above): --resume resolves a name to exactly such a
# done row, and reaping it would delete what the start is reopening.
# `claude rm <id>` takes the record's own `.id`, an 8-character job id, not
# `.sessionId` (a full transcript-basename UUID): measured 2026-09-19 on an
# owner's machine, `claude rm <sessionId>` answered "No job matching" while
# `claude rm <job id>` removed it, and `claude rm --help` says `Usage: claude
# rm <id>`. Most rows' `.id` equals `.sessionId`'s first 8 characters, but not
# all: a resumed session gets a new sessionId while the job id stays, so the
# two must not be conflated. $resume_id is a full sessionId (a --resume value
# resolves to a transcript basename) either way, but not necessarily the
# job's CURRENT one: a short id resolves by transcript PREFIX (see above),
# to that job's ORIGINAL transcript, so for a resumed job $keep ends up the
# stale sessionId, not the live one. `.sessionId != $keep` alone misses that
# case, so a row's `.id` is also compared, against $keep's first 8
# characters: a transcript's basename always starts with its job's id,
# whichever transcript the resolver landed on.
# Both calls go to "$bin", never "$run": they are local daemon bookkeeping and
# start no session, so a process wrapper (a proxy chain, a version pin) has
# nothing to wrap here and would only add a process per call.
# A start must never fail or stall on housekeeping, so every step is optional:
# no jq, no `timeout`, a listing that fails, hangs past 5 s, is not JSON, is
# not an array or is empty all leave the start exactly as it was, at most one
# line on stderr. The removals are capped at 20 per start, oldest first by
# startedAt, so a first run against a long-neglected daemon cannot turn a start
# into a minute of `rm` calls; the next start takes the next 20.
prune_dead_sessions() {
  local list ids id failed=0 t=()
  command -v jq >/dev/null 2>&1 || return 0
  if command -v timeout >/dev/null 2>&1; then t=(timeout 5); fi
  list=$(${t[@]+"${t[@]}"} "$bin" agents --json --all 2>/dev/null) || return 0
  # jq's regex engine (Oniguruma) treats `$` as matching before a single
  # trailing newline, so test("^[0-9a-fA-F]{8}$") alone lets an `.id` of
  # "8705916e\n" through: measured, jq -n '"8705916e\n"|test("^[0-9a-fA-F]{8}$")'
  # is true. Such a row would then take a cap slot from a real one, and its
  # raw (-r) output, split on that same embedded newline in the shell loop
  # below, would hand "8705916e" to `rm` for real. The length check closes
  # that: "8705916e\n" is 9 characters, so length==8 rejects it before either
  # of those happens.
  ids=$(printf '%s' "${list:-null}" | jq -r --arg n "$name" --arg cwd "$(pwd -P)" --arg keep "${resume_id:-}" '
    if type != "array" then empty else
      [ .[] | select(.name == $n and .cwd == $cwd
                     and (.state == "stopped" or .state == "done")
                     and (.id|type) == "string" and (.id|length) == 8 and (.id|test("^[0-9a-fA-F]{8}$"))
                     and .sessionId != $keep and .id != ($keep | .[0:8])) ]
      | sort_by(.startedAt) | .[0:20][] | .id end' 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  while IFS= read -r id; do
    # The shape check above (exactly 8 hex characters, no dashes) already
    # keeps anything else out of the sort and the cap, but a crafted id must
    # not become an argument to a delete even if something upstream of that
    # filter changes, so it is checked again here: a leading dash would read
    # as a flag, and a newline in it would otherwise arrive as two lines.
    [[ $id =~ ^[0-9a-fA-F]{8}$ ]] || continue
    "$bin" rm "$id" >/dev/null 2>&1 || failed=$((failed + 1))
  done <<<"$ids"
  [ "$failed" = 0 ] || echo "claude-discord: could not remove $failed dead session(s) of $name from the agent view" >&2
}

ensure_hooks_symlink
prune_dead_sessions || :   # even its last line (a warning on a closed stderr) may not fail the start
# worktree.bgIsolation "none" turns off Claude Code's background-isolation
# guard for this session: measured on two machines, a session started with
# --bg is refused Edit/Write in the checkout by that guard while a session
# moved to the background with /bg from the foreground is not. A bot editing
# its own project should behave like the /bg case either way it got there,
# and this needs no change to the project's own settings.json. Inert for a
# foreground start.
exec "${run[@]}" --channels "plugin:$plugin" \
  --settings "{\"enabledPlugins\": {\"$plugin\": true}, \"env\": {\"DISCORD_STATE_DIR\": \"$dir\"}, \"worktree\": {\"bgIsolation\": \"none\"}}" \
  -n "$name" --append-system-prompt "$prompt" ${args[@]+"${args[@]}"}
