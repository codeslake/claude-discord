#!/usr/bin/env bash
# Runs a Claude Code session behind its own Discord bot, so several sessions
# can sit in one Discord channel. The human talks to each by @mentioning its
# bot; the bots reach each other the same way once allowlisted (the start
# patches the plugin to let other bots through), and sessions on one machine
# can also use SendMessage, mirroring those exchanges into the channel.
#
#   claude-discord setup <name> [--reset|--mode]  ask for channel/user IDs, allowed users, the
#                                          bot token, mention policy and mode (dev-manager also
#                                          asks for its peers); --reset asks all again; --mode
#                                          asks only the mode (and, for dev-manager, the peers)
#                                          for a bot already set up
#   claude-discord --name <name> [claude args]  start the session named <name>
#                                          (-n and --name=<name> work too); the
#                                          name may sit anywhere among the claude
#                                          args. Left out, the bot comes from
#                                          --resume (its job record, or a value
#                                          that names a bot), else the project's
#                                          only bot. `claude-discord <name> ...`
#                                          still works and warns; beside --name
#                                          it is refused.
#   claude-discord refresh <name> [--force] [claude args]
#                                        replace the running session with a fresh
#                                        one that starts from its handoff
#   claude-discord install [--scope project|global] [--method link|clone]
#                                        the plugin, the shim, runtime/ and compat/ for this
#                                        project (or globally); reads no stdin at all;
#                                        safe to re-run (the bootstrap's command)
#   claude-discord update [--all]        git pull --ff-only the clone this runs from (--all:
#                                        every recorded install, each real clone once; a
#                                        clone on a detached HEAD is skipped), then the
#                                        pulled code's patch, compat copy and shim
#   claude-discord --version             version and short sha of the clone
#   claude-discord health [--json]
#                                        is every bot in this project still
#                                        answering? exit 1 on a finding
#   claude-discord health --all [--json] [--patch]
#                                        every project recorded on this machine,
#                                        one document; --patch runs `patch`
#                                        first (what a monitor pass runs)
#   claude-discord health --uninstall-timer
#                                        remove the systemd --user timer an
#                                        older version installed; no OS
#                                        scheduler is installed any more
#   claude-discord tui [<name>]          a view of a manager bot's backend monitor
#                                        (needs uv), where its hosts are added,
#                                        set and removed (through `hosts`) and its
#                                        bots' access is edited (through `access`); starts
#                                        the monitor and its keeper if none runs
#                                        (both outlive the TUI); outside a project
#                                        it picks among the recorded projects
#   claude-discord monitor --keep <name> keeps the manager's monitor up with no
#                                        TUI or session (foreground: tmux, a
#                                        container entrypoint, systemd)
#   claude-discord monitor --stop <name> stops the keeper and the monitor; nothing
#                                        starts them again until:
#   claude-discord monitor --start <name> starts the backend again, detached
#   claude-discord hosts [--bot <name>] list [--json]
#                                        a manager bot's hosts ledger: one line per
#                                        host (alias, kind, display name, env key
#                                        names; never a value)
#   claude-discord hosts [--bot <name>] add [--no-probe|--dry-run] <alias> [laptop] [KEY=VALUE...]
#                                        adds a host line, after asking the host
#                                        over ssh who it is (--dry-run prints that
#                                        command; --no-probe adds without asking)
#   claude-discord hosts [--bot <name>] set <alias> name=<display>|KEY=VALUE|KEY=...
#                                        sets or (KEY=) removes words of a host's
#                                        line; `set <alias> --stdin` reads them from
#                                        stdin, one a line (a value then is in no
#                                        argument list), `laptop on|off` too
#   claude-discord hosts [--bot <name>] laptop <alias> on|off
#   claude-discord hosts [--bot <name>] rm [--no-probe] <alias>
#                                        stops checking a host (never `local`)
#   claude-discord access [--host <alias> [--manager <name>]] [--project <dir>] <name> --json
#                                        who may drive a bot: the channels it listens in, per channel the
#                                        mention rule and the senders, the DM policy, its mode; with the
#                                        server's channels and whether the bot can read each (read-only)
#   claude-discord access [...] <name> set <change>...
#                                        shows the changes (widenings first), asks once at the terminal
#                                        and writes access.json; refuses without a terminal. --host: a bot
#                                        on a host of a manager's ledger, over ssh (-t for the question)
# All run from the project directory: state is ./.claude/discord-agents/<name>/.
#
# Origin: d.kim4's wrapper (2026-09-18), published at
# https://github.com/codeslake/claude-discord. Portable on purpose: nothing
# here assumes a particular shell setup.
#
#   CLAUDE_DISCORD_LAUNCHER   optional. An environment that wraps `claude` in a
#                             process wrapper (proxy chain, version pin) names
#                             it here and the session is started as
#                             `$CLAUDE_DISCORD_LAUNCHER <claude-bin> <args>`.
#                             Unset, Claude Code's own CLAUDE_CODE_PROCESS_WRAPPER
#                             is used, from the environment or, failing that,
#                             from `.env.CLAUDE_CODE_PROCESS_WRAPPER` in
#                             ~/.claude/settings.json; unset too, plain `claude`
#                             on PATH.
#   claude-discord patch      patches every cached copy of the official discord
#                             plugin (also run at each start): bots hear each
#                             other, @everyone wakes none, long replies split
#                             fence-safe (runtime/discord-chunk.ts), the gateway
#                             follows HTTPS_PROXY (runtime/discord-proxy.ts).
# Needs: bun, jq, and `claude plugin install discord@claude-plugins-official`.
set -euo pipefail

# State lives in the PROJECT, next to its other .claude/ files, so a bot belongs
# to the directory you start it from and `setup` is run there. The token is a
# plaintext secret inside a git tree, so setup drops a `*` .gitignore into the
# directory: nothing under it is ever staged, and the project's own .gitignore
# is left alone.
root=$PWD/.claude/discord-agents
helpers=$HOME/.claude-discord
plugin=discord@claude-plugins-official
# This script lives at <plugin root>/bin/claude-discord; the plugin's tools
# and rules are named from here, resolved through any symlink to the real copy.
self_path=$(readlink -f "$0" 2>/dev/null || echo "$0")
self_root=$(cd "${self_path%/*}/.." && pwd -P)   # ${..%/*}, not dirname: one fork less on every call

# access.json is written at setup time, so every answer lives in the file the
# plugin reads and nothing else needs persisting. The run path below keeps a
# fallback for bot dirs set up before this existed.
write_access() {  # $1 = bot dir, $2 = requireMention (true|false), $3 = "all" for this bot only
  # An EMPTY group allowFrom lets everyone in that channel through (the plugin
  # only filters when the list is non-empty), which is what "all" answers.
  # dmPolicy stays an allowlist of the owner either way: "all" opens the
  # channel, never DMs.
  #
  # "all" is honoured ONLY from $3 (the live answer for this one bot), never
  # from config.env: that file is shared, so a hand-written DISCORD_ALLOW_IDS=all
  # must not silently open every bot the run path writes a fresh access.json for.
  # config.env is always read as an id list.
  local open=""; [ "$(printf '%s' "${3:-}" | tr '[:upper:]' '[:lower:]')" = all ] && open=yes
  jq -n --arg ch "$DISCORD_CHANNEL_ID" --arg me "$DISCORD_USER_ID" \
        --arg others "${DISCORD_ALLOW_IDS:-}" --argjson mention "$2" --arg open "$open" \
    '{dmPolicy: "allowlist", allowFrom: [$me], ackReaction: "👀",
      groups: {($ch): {requireMention: $mention,
                       allowFrom: (if $open == "yes" then []
                                   else [$me] + ($others | split(",") | map(gsub("\\s";"")) | map(select(. != ""))) end)}}}' \
    > "$1/access.json"
}

# Every JSON file claude-discord edits (settings.json, access.json,
# peers.json) goes through here: the file (a missing or 0-byte one reads as
# {}) is run through the jq filter in the arguments and written back only
# when the result differs, with a trailing newline, never in place: a temp
# file beside it with its mode (cp -p) is renamed over it, so a reader (the
# plugin reads access.json at every message and moves a file it cannot parse
# aside) sees the old file or the new one, never half of one. A symlink's
# target is replaced, so the link stays. A file that is not valid JSON, a filter that
# fails on it (a non-object, an event key holding a non-array) or a failed
# write is warned about on stderr, naming the file, and left alone: an edit
# must never fail the setup or the start it runs inside.
jq_edit() {  # $1 = file, the rest = jq arguments
  local f=$1 base='{}' merged
  shift
  if [ -e "$f" ]; then
    # Nothing to change in a file already in jq's own form (as every file written here is): said by one jq, not two
    # (an edit that does change it then costs three; those are setup and a first start). 2>/dev/null: bash warns
    # about a NUL byte in a file it reads.
    if [ -s "$f" ] && merged=$(jq "$@" "$f" 2>/dev/null) && [ -n "$merged" ] && { [ "$merged" = "$(<"$f")" ]; } 2>/dev/null; then return 0; fi
    base=$(jq . "$f" 2>/dev/null) || { echo "claude-discord: $f is not valid JSON, leaving it alone" >&2; return 0; }
    [ -n "$base" ] || base='{}'
  fi
  merged=$(printf '%s' "$base" | jq "$@" 2>/dev/null) || merged=""
  [ -n "$merged" ] || { echo "claude-discord: could not update $f, leaving it alone" >&2; return 0; }
  [ "$merged" != "$base" ] || return 0
  local t=$f
  [ ! -L "$f" ] || t=$(readlink -f "$f" 2>/dev/null) || t=""
  if [ -z "$t" ]; then
    # A link readlink cannot resolve (a macOS before 12.3 has no readlink -f): written through it, as before.
    { printf '%s\n' "$merged" > "$f"; } 2>/dev/null || echo "claude-discord: could not write $f, leaving it alone" >&2
  elif mkdir -p "$(dirname "$t")" 2>/dev/null && { [ ! -e "$t" ] || cp -p "$t" "$t.tmp.$$" 2>/dev/null; } &&
       printf '%s\n' "$merged" > "$t.tmp.$$" 2>/dev/null && mv -f "$t.tmp.$$" "$t" 2>/dev/null; then
    :
  else
    rm -f "$t.tmp.$$"
    echo "claude-discord: could not write $f, leaving it alone" >&2
  fi
}

# Adds access.json's ackReaction key (the plugin's own read-receipt
# reaction) only when the key is absent; an explicit "" means the owner
# disabled it and is left alone.
ensure_ack_reaction() {  # $1 = bot dir
  [ -f "$1/access.json" ] || return 0
  grep -q '"ackReaction"' "$1/access.json" && return 0   # present (even ""): nothing to add, and no jq forks
  jq_edit "$1/access.json" 'if has("ackReaction") then . else . + {ackReaction: "👀"} end'
}

# Makes <project>/.claude/discord-agents/hooks a symlink to the plugin's hooks,
# so a settings entry an old peer committed still reaches them. Kept this
# release, removed in the next. Only when the path is absent or already a
# symlink (broken or not); a real directory there is left alone with a warning.
ensure_hooks_symlink() {
  local link="$root/hooks"
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "claude-discord: $link exists and is not a symlink, leaving it alone" >&2
    return 0
  fi
  [ -L "$link" ] && [ "$link" -ef "$self_root/hooks" ] && return 0   # already right: no forks on every start
  mkdir -p "$root" 2>/dev/null || return 0
  ln -sfn "$self_root/hooks" "$link" 2>/dev/null || echo "claude-discord: could not symlink $link" >&2
}

# select_one <label> <default> <option>...: prints the chosen option's first
# word (an option is "<name>  <hint>"). On a terminal, an @clack-style picker
# drawn on /dev/tty: ◆ while active, ● on the cursor row, ○ on the others;
# ↑/↓ or k/j move, Enter picks, the default starts under the cursor; it
# collapses to "◇ <label> — <choice>". Without a terminal on stdin, one line
# is read: an option name or its 1-based number; empty means the default,
# anything else too, with a warning. A subshell, so the stty change and the
# traps that undo it (Ctrl-C included) never leak into setup.
select_one() (
  label=$1 def=$2
  shift 2
  opts=("$@") cur=0
  for i in "${!opts[@]}"; do [ "${opts[i]%% *}" != "$def" ] || cur=$i; done
  if [ ! -t 0 ]; then
    IFS= read -r ans || :
    ans=${ans//[[:space:]]/} pick=-1
    for i in "${!opts[@]}"; do [ "$ans" != "${opts[i]%% *}" ] && [ "$ans" != "$((i + 1))" ] || pick=$i; done
    if [ "$pick" = -1 ]; then
      [ -z "$ans" ] || echo "claude-discord: no $label '$ans', using ${opts[cur]%% *}" >&2
      pick=$cur
    fi
    echo "${opts[pick]%% *}"
    exit 0
  fi
  exec 3<>/dev/tty
  saved=$(stty -g <&3)
  trap 'stty "$saved" <&3; printf "\e[?25h" >&3' EXIT
  trap 'exit 130' INT TERM
  stty -echo -icanon <&3
  cols=$(stty size <&3) cols=${cols#* }
  [ "$cols" -gt 20 ] 2>/dev/null || cols=80
  printf '\e[?25l' >&3
  n=0
  while :; do
    [ "$n" = 0 ] || printf '\e[%dF\e[J' "$n" >&3
    printf '\e[36m◆\e[0m  %s  \e[2m↑/↓ · enter\e[0m\n' "$label" >&3
    for i in "${!opts[@]}"; do
      if [ "$i" = "$cur" ]; then printf '\e[2m│\e[0m  \e[32m●\e[0m \e[36m%s\e[0m\n' "${opts[i]:0:cols-6}"
      else printf '\e[2m│\e[0m  ○ %s\n' "${opts[i]:0:cols-6}"; fi >&3
    done
    n=$((${#opts[@]} + 1))
    IFS= read -rn1 key <&3 || key=""
    [ "$key" != $'\e' ] || read -rn2 -t 1 key <&3 || key=x   # an arrow is ESC [ A/B, or ESC O A/B in application mode; a lone ESC does nothing
    case $key in
      k|'[A'|OA) cur=$(((cur + ${#opts[@]} - 1) % ${#opts[@]}));;
      j|'[B'|OB) cur=$(((cur + 1) % ${#opts[@]}));;
      '') break;;
    esac
  done
  printf '\e[%dF\e[J\e[32m◇\e[0m  %s — %s\n' "$n" "$label" "${opts[cur]%% *}" >&3
  echo "${opts[cur]%% *}"
)

# Installs the plugin at the chosen scope (setup has validated $scope, $method
# and the other scope's absence by now). method clone: this repo cloned into
# the skills dir, so a project can pin its own version. method link: a symlink
# to the machine's one source clone, ~/.claude-discord/source, so one update
# moves every bot; the hooks and tools resolve their real directory rather
# than trust ${CLAUDE_PLUGIN_ROOT}, and the plugin declares no .mcp.json, so
# the measured problems of a link do not bite. An existing install of either
# kind is kept as it is. Project scope loads only when ~/.claude.json trusts
# that exact path; setup asks before writing it.
has_path() { [ -e "$1" ] || [ -L "$1" ]; }   # a dangling link counts
# Read in the shell, not with jq: every start asks (sync_runtime), and one jq start is 10 ms with jq 1.6. The manifest is
# ours and flat (no other "version" key in it): the first one's string; "?" when there is none.
plugin_version() {
  local l re='"version"[[:space:]]*:[[:space:]]*"([^"]*)"'
  if [ -r "$1/.claude-plugin/plugin.json" ]; then
    while IFS= read -r l || [ -n "$l" ]; do
      if [[ $l =~ $re ]]; then echo "${BASH_REMATCH[1]}"; return 0; fi
    done < "$1/.claude-plugin/plugin.json"
  fi
  echo "?"
}
head_sha() { git -C "$1" rev-parse HEAD 2>/dev/null || :; }   # compat/VERSION's stamp (empty with no git)
# ver_ge <a> <b>: a >= b for x.y.z versions; anything else is not.
ver_ge() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<<"$1"; IFS=. read -r b1 b2 b3 <<<"$2"
  # Exactly three numeric parts each (1.9.0.1 leaves a dot in the third); base 10, so 1.08.0 is not octal.
  case $a1.$a2.$a3.$b1.$b2.$b3 in *[!0-9.]*|*..*|.*|*.) return 1;; esac
  case $a3$b3 in *.*) return 1;; esac
  [ $((10#$a1 * 1000000 + 10#$a2 * 1000 + 10#$a3)) -ge $((10#$b1 * 1000000 + 10#$b2 * 1000 + 10#$b3)) ]
}
# git over the network: never a credential prompt (a script would hang on it),
# and a 120 s ceiling where timeout(1) exists. The ambient git config and
# environment apply, so a proxy is per clone: git -C <clone> config http.proxy <url>.
git_net() {
  if command -v timeout >/dev/null 2>&1; then GIT_TERMINAL_PROMPT=0 timeout 120 git "$@"; else GIT_TERMINAL_PROMPT=0 git "$@"; fi
}
# A link to the machine's source clone: two of them run the same code.
src_link() { [ -L "$1" ] && [ "$1" -ef "$HOME/.claude-discord/source" ]; }

# The runtime files the patched official plugin imports live at a stable path,
# ~/.claude-discord/runtime/, because the plugin cache is machine-wide while
# clones are per project. setup and update copy them from the real clone.
# runtime/VERSION names the plugin version that wrote it. Two installs of
# different versions share runtime/ and the patched cache, so an older one
# leaves a newer copy alone (runtime_newer, said once per run; patch_official
# then leaves the cache alone too) instead of flipping it back at every start.
# Only a readable, strictly newer stamp wins: a garbled one is overwritten.
sync_runtime() {
  local rt=$HOME/.claude-discord/runtime f mine have=""
  mine=$(plugin_version "$self_root")
  [ -d "$rt" ] || mkdir -p "$rt" || return 1
  [ ! -f "$rt/VERSION" ] || IFS= read -r have < "$rt/VERSION" || :
  if [ -n "$have" ] && [ "$have" != "$mine" ] && ver_ge "$have" "$mine"; then
    [ -n "${runtime_newer:-}" ] || echo "claude-discord: ~/.claude-discord/runtime is from $have, newer than this $mine; left as it is, and so is the plugin cache until that newer version runs (its next start or update patches it)" >&2
    runtime_newer=$have; return 0
  fi
  for f in discord-chunk.ts discord-proxy.ts; do
    cmp -s "$self_root/runtime/$f" "$rt/$f" || cp "$self_root/runtime/$f" "$rt/$f" || return 1
  done
  [ "$have" = "$mine" ] || printf '%s\n' "$mine" > "$rt/VERSION"
}

# Drops recorded installs whose path is gone (a dangling link counts as gone).
prune_installs() {
  local f=$HOME/.claude-discord/records/installs p keep=""
  [ -f "$f" ] || return 0
  while IFS= read -r p || [ -n "$p" ]; do
    [ -z "$p" ] || [ ! -e "$p" ] || keep="$keep$p"$'\n'
  done < "$f"
  printf '%s' "$keep" > "$f.tmp.$$" && { cmp -s "$f.tmp.$$" "$f" || cat "$f.tmp.$$" > "$f"; }
  rm -f "$f.tmp.$$"
}
# record_project: this project's root (physical) into records/projects, once.
# `health --all` walks that list; setup and a health run in a project add to it.
record_project() {
  local f=$helpers/records/projects p l
  p=$(pwd -P) || return 0
  # Already listed (every health run after the first): found with no fork.
  if [ -f "$f" ]; then while IFS= read -r l || [ -n "$l" ]; do [ "$l" != "$p" ] || return 0; done < "$f"; fi
  mkdir -p "$helpers/records" 2>/dev/null && printf '%s\n' "$p" >> "$f" 2>/dev/null || :
}
install_plugin() {  # uses $scope $method $pdir $gdir
  local repo=${CLAUDE_DISCORD_REPO:-https://github.com/codeslake/claude-discord}
  local src=$HOME/.claude-discord/source target ex pat here t
  case $scope in project) target=$pdir;; *) target=$gdir;; esac
  # A dangling link (its source removed) is a broken install, not one to keep.
  [ -L "$target" ] && [ ! -e "$target" ] && rm -f "$target"
  if [ -e "$target" ]; then
    echo "claude-discord: plugin already installed at $target, kept as it is"
  else
    if [ -z "$method" ]; then
      if [ -n "${noask:-}" ]; then method=link; else method=$(select_one Method link "link   the machine's one source clone, ~/.claude-discord/source (one update for every bot)" "clone  its own copy, so this install can pin a version"); fi
    fi
    mkdir -p "$(dirname "$target")"
    if [ "$method" = link ]; then
      has_path "$src" || git_net clone -q "$repo" "$src" || { echo "claude-discord: could not clone $repo into $src" >&2; return 1; }
      ln -s "$src" "$target"
    else
      git_net clone -q "$repo" "$target" || { echo "claude-discord: could not clone $repo into $target" >&2; return 1; }
    fi
  fi
  # A git-tracked project (worktree, submodule or subdirectory too) keeps the
  # install out of git status; no trailing slash, so it matches a link as well.
  if [ "$scope" = project ] && { read -r t && read -r ex && read -r here; } < <(git -C "$PWD" rev-parse --is-inside-work-tree --git-path info/exclude --show-prefix 2>/dev/null) && [ "$t" = true ]; then   # one git call: inside a work tree?, the exclude file, the prefix
    case $ex in /*) ;; *) ex=$PWD/$ex;; esac
    pat=/${here}.claude/skills/claude-discord
    grep -qxF "$pat" "$ex" 2>/dev/null || { mkdir -p "$(dirname "$ex")" && printf '%s\n' "$pat" >> "$ex"; }
  fi
  mkdir -p "$HOME/.local/bin" "$HOME/.claude-discord/records"
  cmp -s "$target/shim/claude-discord" "$HOME/.local/bin/claude-discord" ||
    install -m 755 "$target/shim/claude-discord" "$HOME/.local/bin/claude-discord" ||
    { echo "claude-discord: could not install the shim from $target" >&2; return 1; }
  touch "$HOME/.claude-discord/records/installs"
  grep -qxF "$target" "$HOME/.claude-discord/records/installs" || printf '%s\n' "$target" >> "$HOME/.claude-discord/records/installs"
  prune_installs
  # The real directory behind a link, for what must outlive this project's link.
  plugin_target=$(cd -P "$target" && pwd -P) || return 1
  # Keyed by the physical path, like refresh's check.
  if [ "$scope" = project ] && [ "$(jq -r --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted | if . == true then "yes" else "no" end' "$HOME/.claude.json" 2>/dev/null)" != yes ]; then
    echo "claude-discord: $PWD is not trusted in ~/.claude.json, so Claude Code will not load the plugin here." >&2
    if [ -n "${noask:-}" ]; then
      echo "claude-discord: accept the trust dialog in a claude session here, or answer y in 'claude-discord setup <bot>' at a terminal" >&2
    else
      read -rp "Mark this project trusted now? [y/N] " t || t=""
      case $t in y|Y) jq_edit "$HOME/.claude.json" --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted = true';; esac
    fi
  fi
}

# What install.sh used to put under ~/.claude-discord becomes links into
# ~/.claude-discord/compat, a plain copy (no git) of the real plugin's hooks,
# tools and rules (the source clone when there is one, else $self_root, the
# resolved install, not one project's link): hooks/{turn,peers,lib,autoresearchclaw},
# every tool under hooks/tools, and the two runtime .ts files (the bunfig preload
# an old bot's MCP server names; they link to the stable runtime/ copy, which
# sync_runtime fills, so they never dangle). A copy, not the clone (R16): the
# previous release's install.sh writes through these links, and a write into a
# clone would leave `update` refusing to pull for good.
# Links stay for one release, because a project set up by the previous release
# and not yet by this one keeps its settings hooks, and those resolve through
# .claude/discord-agents/hooks -> ~/.claude-discord/hooks; deleting the copies
# would silently turn every one of them into a no-op. The next release removes
# the links. rules/ goes (only the old rule copies read it); scratch/, records/,
# source/ are not touched (runtime/ and compat/ are refreshed). A symlink at hooks/ itself is removed as
# a link (R2): it leads somewhere that is not ours to empty. The other paths
# are removed with rm -rf, which on a link removes only the link.
remove_old_install() {
  local h=$helpers real=$self_root c=$helpers/compat t f bad=0
  # The machine-wide source clone when there is one: a clone-method (possibly pinned) project must not pull every unmigrated project onto its version.
  [ ! -d "$h/source/hooks" ] || real=$h/source
  [ ! -L "$h/hooks" ] || rm -f "$h/hooks"
  [ ! -e "$h/rules" ] && [ ! -L "$h/rules" ] || rm -rf "$h/rules"
  [ -d "$h/hooks/tools" ] && [ ! -L "$h/hooks/tools" ] || { rm -rf "$h/hooks/tools"; mkdir -p "$h/hooks/tools" || bad=1; }
  sync_runtime || bad=1
  sync_compat "$real" || bad=1
  for f in "$h"/hooks/tools/* "$h"/hooks/tools/.[!.]*; do   # an old copy, a link into a clone, or a link to a tool the plugin no longer ships goes
    { [ -e "$f" ] || [ -L "$f" ]; } && ! { [ -L "$f" ] && [ "$f" -ef "$c/tools/${f##*/}" ]; } && { rm -rf "$f" || bad=1; }
  done
  for t in turn peers lib autoresearchclaw; do
    [ -L "$h/hooks/$t" ] && [ "$(readlink "$h/hooks/$t")" = "$c/hooks/$t" ] && continue   # already linked (every setup after the first)
    rm -rf "${h:?}/hooks/$t" && ln -s "$c/hooks/$t" "$h/hooks/$t" || bad=1
  done
  for f in "$c"/tools/*; do
    [ -L "$h/hooks/tools/${f##*/}" ] && [ "$h/hooks/tools/${f##*/}" -ef "$f" ] && continue
    ln -sfn "$f" "$h/hooks/tools/${f##*/}" || bad=1
  done
  for f in discord-chunk.ts discord-proxy.ts; do
    [ -L "$h/$f" ] && [ "$h/$f" -ef "$h/runtime/$f" ] && continue
    ln -sfn "$h/runtime/$f" "$h/$f" || bad=1
  done
  [ "$bad" = 0 ] || { echo "claude-discord: could not link the old install paths under $h to $c" >&2; return 1; }
}

# same_tree <a> <b>: same files and the same executables (diff -r ignores modes,
# and an old settings entry skips a hook that is not -x).
same_tree() {
  diff -r "$1" "$2" >/dev/null 2>&1 &&
    [ "$(cd "$1" && find . -type f -perm -100 | sort)" = "$(cd "$2" && find . -type f -perm -100 | sort)" ]
}
# sync_compat <plugin>: rebuilds ~/.claude-discord/compat from that plugin when
# it differs (a write through a link included), in a new directory swapped in by
# rename, so a hook already running from the old copy keeps its open file.
# compat/VERSION holds the plugin's HEAD sha (head_sha), written last.
# rename(2) cannot replace a non-empty directory, hence two renames; a settings
# hook started between them finds no file and its entry's -x test skips it.
# Writers (bots starting at once, on a host and in its containers, or natively
# and in Docker Desktop on one Mac) swap one at a time under compat.lock, taken
# by mkdir: atomic on every filesystem they share, across containers and
# kernels, where pids collide and flock may not reach. The copy is built first,
# in a random-named directory (no pid: unique across kernels), so the lock
# covers only a re-check and the renames. The lock holds an owner token (the
# random suffix of that directory), and a writer releases only a lock holding
# its own. A lock older than 5 s is taken for a dead writer's (a bot start must
# not wait long, and a live holder past it is harmless, see below): it is broken by
# renaming it to a name of our own, which exactly one breaker wins, and dropped
# only if it is still the lock judged stale (same inode and token). The lock
# only saves work: two holders at once (a holder stalled past the stale bound, a
# break racing a re-take) can only fail one refresh (rc 1, retried at the next
# start), never nest or leave compat/ absent: both renames are perl's rename(2),
# never mv (which moves a copy INTO a compat/ another writer, or an older
# release's taking no lock, just put in place), and our old compat/ goes aside
# into our own random directory, never to a shared name. A subshell, so its
# traps (our old copy back if compat/ is gone, the lock released) stay out of
# the caller. The bounds are read only here, so the suite can shrink them.
sync_compat() (
  c=$helpers/compat l=$helpers/compat.lock t0=$SECONDS
  st=${CLAUDE_DISCORD_COMPAT_STALE_S:-5} gu=${CLAUDE_DISCORD_COMPAT_WAIT_S:-10} ps=${CLAUDE_DISCORD_COMPAT_STEP_S:-0.1}
  n=$(mktemp -d "$c.new.XXXXXX") || return 1
  b=$n/compat o=$n/old tok=${n##*.}   # unique among writers while $n exists (mktemp -d), and no pid
  trap 'rm -rf "$n"' EXIT; trap 'exit 1' INT TERM HUP
  mkdir "$b" "$b/hooks" || return 1
  for t in turn peers lib autoresearchclaw; do cp -R "$1/hooks/$t" "$b/hooks/" || return 1; done
  cp -R "$1/tools" "$1/rules" "$b/" && head_sha "$1" > "$b/VERSION" || return 1
  until mkdir "$l" 2>/dev/null; do
    # Judged stale: the lock's inode and token, so the break can tell it from a newer lock at the same path.
    id=$(perl -e '@s = lstat $ARGV[0] or exit; $s[9] < time - $ARGV[1] or exit; open F, "<", "$ARGV[0]/owner"; chomp($t = <F> // ""); print "$s[1] $t"' "$l" "$st")
    [ -n "$id" ] && perl -e 'use File::Path "rmtree"; ($l, $k, $id) = @ARGV; rename $l, $k or exit 1; @s = lstat $k; open F, "<", "$k/owner"; chomp($t = <F> // "");
      if ("$s[1] $t" eq $id) { rmtree $k; exit 0 } rename $k, $l; exit 1' "$l" "$l.broken.$tok" "$id" && continue
    # The give-up bound is past the stale bound, so a dead holder's lock is broken before a waiter gives up.
    [ "$SECONDS" -lt $((t0 + gu)) ] || { echo "claude-discord: $l stays held; compat/ not refreshed" >&2; return 1; }
    sleep "$ps"
  done
  # compat/ gone: our old copy (unless we landed) goes back; $n holding it stays if that fails with compat/ still gone.
  # set -e is back on inside a trap: a failing command would skip the rest (the lock release) and set our status, hence || :.
  trap '{ has_path "$c" || [ ! -d "$o" ] || perl -e "rename shift, shift or exit 1" "$o" "$c" || has_path "$c"; } && rm -rf "$n" || :; IFS= read -r t 2>/dev/null < "$l/owner" && [ "$t" = "$tok" ] && rm -rf "$l" || :' EXIT
  printf '%s\n' "$tok" > "$l/owner" || { rm -rf "$l"; return 1; }   # an ownerless lock would hold every writer off until stale
  # compat/ gone: a writer killed between its renames left the only copy in its compat.new.*/old; the newest goes back.
  has_path "$c" || perl -e '$c = shift; ($o) = sort { (lstat "$b/..")[9] <=> (lstat "$a/..")[9] } grep { -d } @ARGV; rename $o, $c if $o' "$c" "$c".new.*/old || :
  # An old compat.new.* (its old/ too), compat.old.* or compat.lock.broken.* is a dead writer's or an older release's
  # (a fresh compat.new.* may be a writer still building); perl only when there is one besides ours.
  for t in "$c".new.* "$c".old.* "$l".broken.*; do
    [ "$t" = "$n" ] || ! has_path "$t" || { perl -MFile::Path=rmtree -e 'for (@ARGV) { @s = lstat; rmtree $_ if @s && $s[9] < time - 600 }' "$c".new.* "$c".old.* "$l".broken.*; break; }
  done
  [ -d "$c" ] && [ ! -L "$c" ] && same_tree "$c" "$b" && return 0   # current already (another writer's swap while we built or waited)
  { ! has_path "$c" || perl -e 'rename shift, shift or exit 1' "$c" "$o"; } && perl -e 'rename shift, shift or exit 1' "$b" "$c" && { rm -rf "$o"; return 0; }
  [ -d "$c" ] && same_tree "$c" "$b"   # another writer's copy landed first: fine if it is ours; else the trap restores
)
# compat_if_stale: run at a bot's startup and resume (on-session-start runs
# `patch --compat`). A compat/ whose VERSION is not this plugin's HEAD sha (a
# `git pull` by hand in the source clone, a copy older than the stamp) or
# that holds a file newer than its VERSION (the previous release's install.sh
# writing through the links) is rebuilt; none at all is left to setup (unless
# a killed writer left it in a compat.new.*/old, which goes back). Only by
# the source clone compat/ is built from (as in remove_old_install): with no
# source clone, compat/ is built by setup and update only, else two clones of
# different versions would flip it back and forth at each bot start.
compat_if_stale() {
  local c=$helpers/compat have=""
  [ -d "$c" ] && [ ! -L "$c" ] || { ! has_path "$c" && [ -n "$(ls -d "$c".new.*/old 2>/dev/null)" ]; } || return 0
  [ "$helpers/source" -ef "$self_root" ] || return 0
  IFS= read -r have 2>/dev/null < "$c/VERSION" || :
  [ "$have" != "$(head_sha "$self_root")" ] || [ -n "$(find "$c" -type f -newer "$c/VERSION" 2>/dev/null)" ] || return 0
  sync_compat "$self_root" && { touch "$c/VERSION" 2>/dev/null || :; }   # an identical rebuild is not redone at every start
}
# Run by update from the freshly pulled code (this process holds the old functions).
if [ "${1:-}" = compat ]; then remove_old_install; exit $?; fi

# setup tells, once, of old entries in a settings file nothing here edits: a
# symlink (often into a dotfiles repo) or the user-global settings.json. The
# plugin's first hook run removes the project's own regular files' entries;
# these keep running beside the plugin's, as no-ops in a session it runs in.
report_old_hooks() {
  local f found=""
  for f in "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json" "$HOME/.claude/settings.json"; do
    [ -L "$f" ] || [ "$f" -ef "$HOME/.claude/settings.json" ] || continue
    grep -qF /.claude/discord-agents/hooks/ "$f" 2>/dev/null || continue
    case $found in *"'$f'"*) continue;; esac   # in $HOME, the project's settings.json is the global one
    found="$found '$f'"
  done
  [ -z "$found" ] || echo "claude-discord: old claude-discord hook entries stay in$found (a symlink or the user-global file, never edited here; a session the plugin runs in skips them). They still serve every bot on this machine, and on every machine sharing that file, whose plugin is not loaded yet: only when each of those bots has a <bot dir>/plugin-sessions/ marker, remove them by hand: bash '$self_root/hooks/lib/old-hooks.sh'$found" >&2
}

# write_hosts <bot dir>: the manager's host ledger (<bot dir>/hosts), which
# the backend monitor reads and which is also its on/off switch. One line per
# host: the ssh host name, an optional `laptop` word (its own unreachability
# is never posted: a closed lid is not an outage), then optional KEY=VALUE env
# for the remote command. `local` (this machine, no ssh) is always there. An
# empty answer keeps the current list; a host already listed keeps its line as
# the owner left it. Each new host is probed once (the same ssh call also asks
# `uname -s` and the battery, so no second ssh), its answer printed, and
# written whatever the answer (a laptop may be asleep); a Darwin host with a
# battery is marked laptop, a host that did not answer is not and is said so.
write_hosts() {
  local f=$1/hosts ans h line out old="" new="" probe
  [ ! -f "$f" ] || old=$(cat "$f")
  read -rp "ssh hosts to check, comma-separated (this machine is always included): " ans || ans=""
  ans=${ans//[[:space:]]/}
  new="# ssh host names this manager checks; \"local\" is this machine (no ssh)"$'\n'
  line=$(printf '%s\n' "$old" | awk '$1 == "local"' | head -1)
  if [ -z "$line" ]; then
    line=local
    [ "$(uname -s)" != Darwin ] || ! pmset -g batt 2>/dev/null | grep -q InternalBattery || line="local laptop"
  fi
  new="$new$line"$'\n'
  if [ -z "$ans" ]; then
    new="$new$(printf '%s\n' "$old" | awk 'NF && $1 !~ /^#/ && $1 != "local"')"
  else
    set -f; set -- ${ans//,/ }; set +f   # split on commas, never glob
    for h in "$@"; do
      [ "$h" != local ] || continue
      case $h in -*|*[!A-Za-z0-9._@-]*) echo "claude-discord: skipping host '$h': not a plain ssh host name" >&2; continue;; esac
      line=$(printf '%s\n' "$old" | awk -v h="$h" '$1 == h' | head -1)
      # </dev/null: ssh would otherwise eat the rest of setup's piped answers.
      out=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$h" 'uname -s; pmset -g batt 2>/dev/null | grep -q InternalBattery && echo battery; ~/.local/bin/claude-discord --version' </dev/null 2>&1) || :
      probe=$(printf '%s\n' "$out" | grep -m1 '^claude-discord ' || printf '%s\n' "$out" | tail -1)
      echo "  $h: ${probe:-no answer}"
      if [ -z "$line" ]; then
        line=$h
        if printf '%s\n' "$out" | grep -qxE 'Darwin|Linux'; then
          printf '%s\n' "$out" | grep -qx Darwin && printf '%s\n' "$out" | grep -qx battery && line="$h laptop"
        else
          echo "  $h: could not tell whether it is a laptop; written without the laptop word (add it by hand)"
        fi
      fi
      new="$new$line"$'\n'
    done
  fi
  ledger_write "$f" "$new" || :
}

# ledger_write <ledger> <text>: the ledger replaced by <text> (one newline at its end, whether <text> has it or not).
# A temp file moved in: a running monitor reads the ledger every pass and must never see it half written. It takes
# the ledger's own mode (an owner's chmod survives), 600 when new, never the caller's umask (perl: stat's flags differ by OS).
# Returns 1 when it could not, the ledger as it was. Used by setup (write_hosts) and by `hosts`.
ledger_write() {
  local f=$1 m=600
  [ ! -f "$f" ] || m=$(perl -e 'printf "%o", (stat shift)[2] & 07777' "$f") || m=600
  (umask 077; printf '%s\n' "${2%$'\n'}" > "$f.tmp.$$") && chmod "$m" "$f.tmp.$$" && mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$"; return 1; }
}

# --scope and --method, anywhere and in the = form too, for setup and install;
# every other word lands in rest, in order.
parse_install_flags() {
  local a want=""
  scope="" method="" rest=()
  for a in "$@"; do
    if [ -n "$want" ]; then
      case $want in scope) scope=$a;; method) method=$a;; esac
      want=""
      continue
    fi
    case $a in
      --scope=*) scope=${a#--scope=};;
      --method=*) method=${a#--method=};;
      --scope) want=scope;;
      --method) want=method;;
      *) rest+=("$a");;
    esac
  done
  [ -z "$want" ] || { echo "claude-discord: --$want needs a value" >&2; exit 2; }
}

# Everything about the install that can be refused is decided here, before a
# prompt or a write: a bad flag or a copy at the other scope must leave the
# bot's files (and --reset's deletion) alone.
check_install_scope() {
  local p
  case $scope in ''|project|global) ;; *) echo "claude-discord: --scope must be project or global, got '$scope'" >&2; exit 2;; esac
  case $method in ''|link|clone) ;; *) echo "claude-discord: --method must be link or clone, got '$method'" >&2; exit 2;; esac
  # A bot in $HOME: its project's .claude IS ~/.claude, so its install is the global one.
  if [ "$(pwd -P)" = "$(cd -P "$HOME" && pwd)" ]; then
    [ "$scope" = global ] || echo "claude-discord: this project is \$HOME, whose .claude is ~/.claude: installing at global scope ($gdir)" >&2
    scope=global pdir=""
  fi
  # Asked once per project: an install already there decides the scope.
  if [ -z "$scope" ]; then
    if has_path "$pdir"; then scope=project; elif has_path "$gdir"; then scope=global; fi
  fi
  if [ "$scope" = project ] && has_path "$gdir"; then
    coexist "$pdir" "$gdir" "claude-discord: already installed globally at $gdir, and both scopes may hold an install only as links to ~/.claude-discord/source; remove it or use --scope global"
  elif [ "$scope" = global ] && has_path "$pdir"; then
    coexist "$gdir" "$pdir" "claude-discord: already installed for this project at $pdir, and both scopes may hold an install only as links to ~/.claude-discord/source; remove it or use --scope project"
  fi
  if [ "$scope" = global ] && ! has_path "$gdir"; then
    # A new global copy would shadow every project install the machine records (the global one wins).
    while IFS= read -r p || [ -n "$p" ]; do
      [ -z "$p" ] || [ ! -e "$p" ] || coexist "$gdir" "$p" "claude-discord: a project install exists at $p, which a global install would shadow (allowed only when both are links to ~/.claude-discord/source); remove it or use --scope project"
    done < <(cat "$HOME/.claude-discord/records/installs" 2>/dev/null)
  fi
}
# coexist <own path> <other install> <refusal>: a plugin present at both scopes
# loads once (measured), so two installs are fine when both are links to the
# source clone (one code); a clone on either side would run another version
# beside it, so that is refused before anything is written. An own install not
# made yet becomes a link.
coexist() {
  if src_link "$2" && { src_link "$1" || { ! has_path "$1" && [ "$method" != clone ]; }; }; then
    has_path "$1" || method=link
    return 0
  fi
  echo "$3" >&2; exit 2
}

# The plugin, the shim, runtime/, compat/ and the install record; before any
# bot question (R17), so a failed clone leaves no bot file behind.
install_all() {
  if [ -z "$scope" ]; then
    if [ -n "${noask:-}" ]; then scope=project; else scope=$(select_one Scope project "project  this project only (.claude/skills/claude-discord)" "global  every project (~/.claude/skills/claude-discord)"); fi
  fi
  install_plugin || return $?
  self_root=$plugin_target   # from here on, everything points at the real install
  remove_old_install || return $?
  report_old_hooks
}
pdir=$PWD/.claude/skills/claude-discord gdir=$HOME/.claude/skills/claude-discord

# Patches the official discord plugin's install(s) so bots can work together.
# Every version dir in the cache, not just the active one: an auto-update adds
# an unpatched dir while bots run on the old one, and the next start, respawn
# or config-changing /reload-plugins uses the new one (measured, 2.1.296).
# Six patches, each idempotent because its pattern is gone once applied:
#   bot-authors     let other bots reach access.json's allowFrom gate
#   ignore-everyone @everyone/@here wake no bot
#   chunk           fence-safe chunking, imported from the stable runtime copy
#                   (an import of any other path is rewritten to it)
#   late-token      no token at start waits instead of exiting (Claude Code would
#                   mark the server failed): .env is re-read every 10 s and the
#                   client logs in once a token is there, so a bot started before
#                   its Discord bot existed needs no restart; a token Discord
#                   refuses (TokenInvalid) is waited out the same way until .env
#                   holds a different one, and so, since 1.14.0, is a token the
#                   gateway refuses after the login (close 4004: it was reset),
#                   so a token replaced with `bot <name> token` needs no restart
#   proxy           bunfig preload pinning fetch and WebSocket to HTTPS_PROXY
#   failure-cache   a per-bot env in .mcp.json, so Claude Code's 15-minute MCP
#                   failure cache (keyed on the config hashed after ${VAR}
#                   expansion) no longer blocks every bot for one bot's failure
# The runtime files are copied to ~/.claude-discord/runtime/ because the plugin
# cache is machine-wide while clones are per project. Exit 1 names the file and
# patch whose pattern moved; the others are still applied.
patch_official() {
  local rt=$HOME/.claude-discord/runtime d f rc=0 changed=""
  mark() { case " $changed " in *" $1 "*) ;; *) changed="$changed $1";; esac; }   # list a file once
  sync_runtime || return 1
  [ -z "${runtime_newer:-}" ] || return 0   # a newer version's runtime: that code patches the cache
  for d in "$HOME"/.claude/plugins/cache/claude-plugins-official/discord/*/; do
    d=${d%/}; f=$d/server.ts   # no trailing slash, so messages name the file cleanly
    [ -f "$f" ] || continue
    if grep -q 'if (msg.author.bot) return' "$f"; then
      perl -pi -e 's/^(\s*)if \(msg\.author\.bot\) return$/$1if (msg.author.id === client.user?.id) return/' "$f"; mark "$f"
    elif ! grep -qF 'msg.author.id === client.user?.id' "$f"; then
      echo "claude-discord: patch: $f: bot-authors no longer matches" >&2; rc=1
    fi
    if grep -q 'msg.mentions.has(client.user))' "$f"; then
      perl -pi -e 's/msg\.mentions\.has\(client\.user\)\)/msg.mentions.has(client.user, { ignoreEveryone: true }))/' "$f"; mark "$f"
    elif ! grep -qF 'ignoreEveryone: true' "$f"; then
      echo "claude-discord: patch: $f: ignore-everyone no longer matches" >&2; rc=1
    fi
    if grep -qE '^[[:space:]]*const chunks = chunk\(text, limit, mode\);?[[:space:]]*$' "$f"; then
      CHUNK_TS=$rt/discord-chunk.ts perl -pi -e 's/^(\s*)const chunks = chunk\(text, limit, mode\)(;?\s*)$/$1const chunks = (await import("$ENV{CHUNK_TS}")).chunk(text, limit, mode)$2/' "$f"; mark "$f"
    elif grep -qF "import(\"$rt/discord-chunk.ts\")).chunk(text, limit, mode)" "$f"; then :
    elif grep -qE 'import\("[^"]*"\)\)\.chunk\(text, limit, mode\)' "$f"; then
      # An earlier release imported it from another path (~/.claude-discord/discord-chunk.ts, a compat link that goes in a later release).
      CHUNK_TS=$rt/discord-chunk.ts perl -pi -e 's/import\("[^"]*"\)\)\.chunk\(text, limit, mode\)/import("$ENV{CHUNK_TS}")).chunk(text, limit, mode)/' "$f"; mark "$f"
    else
      echo "claude-discord: patch: $f: chunk no longer matches" >&2; rc=1
    fi
    # Both anchors in one perl run, so a server.ts gets both edits or neither;
    # the replacement text comes in through env, so perl interpolates none of it.
    # The leading ; stops ASI from calling the line above (the real file ends client.once(...) with no ;) with this function.
    cd_login=';(async () => { let bad = ""; const read = () => { let m; try { m = readFileSync(ENV_FILE, "utf8").match(/^DISCORD_BOT_TOKEN=(.+)$/m) } catch {} return m?.[1].trim() || "" }; const pick = () => { const v = bad ? read() : (TOKEN || read()); return v && v !== bad ? v : "" }; for (;;) { const t = await new Promise<string>(ok => { const v = pick(); if (v) return ok(v); const i = setInterval(() => { const w = pick(); if (w) { clearInterval(i); ok(w) } }, 10000) }); try { await client.login(t); await new Promise<void>(ok => { const f = (ev: any) => { if (ev?.code === 4004) { client.off("shardDisconnect", f); ok() } }; client.on("shardDisconnect", f) }); bad = t; process.stderr.write("discord channel: the gateway refused the token (4004); waiting for a new one in .env (re-read every 10 s)\n") } catch (e) { if ((e as any)?.code !== "TokenInvalid") throw e; bad = t; process.stderr.write("discord channel: the token was refused; waiting for a new one in .env (re-read every 10 s)\n") } } })().catch('
    if grep -qF '"shardDisconnect"' "$f"; then :
    elif grep -qF 'code !== "TokenInvalid"' "$f"; then
      # 1.9.4 to 1.13.x waited out a refused token only at the login: the login loop is replaced by one that also waits
      # after a 4004, once.
      if CD_LOGIN=$cd_login perl -0777 -pi -e 's/^;\(async \(\) => \{ let bad = "";[^\n]*?\}\)\(\)\.catch\(/$ENV{CD_LOGIN}/m and $ok = 1; END { exit !$ok }' "$f"; then mark "$f"
      else echo "claude-discord: patch: $f: late-token no longer matches" >&2; rc=1
      fi
    elif grep -qF 'no token yet; waiting for it' "$f"; then
      # 1.9.3 patched the exit already but its login gave up on a refused token: only the login is replaced.
      if CD_LOGIN=$cd_login perl -0777 -pi -e 's/^new Promise<string>\(ok => \{ if \(TOKEN\) return ok\(TOKEN\);[^\n]*?\}\)\.then\(t => client\.login\(t\)\)\.catch\(/$ENV{CD_LOGIN}/m and $ok = 1; END { exit !$ok }' "$f"; then mark "$f"
      else echo "claude-discord: patch: $f: late-token no longer matches" >&2; rc=1
      fi
    elif CD_WAIT='process.stderr.write("discord channel: no token yet; waiting for it (re-read every 10 s)\n")' CD_LOGIN=$cd_login \
         perl -0777 -pi -e 'if (/^if \(!TOKEN\) \{\n(?:[ \t].*\n)*?[ \t]+process\.exit\(1\)$/m && /^client\.login\(TOKEN\)\.catch\(/m) {
             s/^(if \(!TOKEN\) \{\n(?:[ \t].*\n)*?[ \t]+)process\.exit\(1\)$/$1$ENV{CD_WAIT}/m; s/^client\.login\(TOKEN\)\.catch\(/$ENV{CD_LOGIN}/m; $ok = 1 }
           END { exit !$ok }' "$f"; then mark "$f"
    else
      echo "claude-discord: patch: $f: late-token no longer matches" >&2; rc=1
    fi
    [ "$(cat "$d/bunfig.toml" 2>/dev/null)" = "preload = [\"$rt/discord-proxy.ts\"]" ] ||
      { printf 'preload = ["%s"]\n' "$rt/discord-proxy.ts" > "$d/bunfig.toml"; mark "$d/bunfig.toml"; }
    # The key is ours, not the server's DISCORD_STATE_DIR: unset, "${DISCORD_STATE_DIR}"
    # would stay a literal string and mask the server's own default state dir for
    # a user of the official plugin without claude-discord; "${VAR:-}" expands to
    # "" (measured, 2.1.296). An earlier release's DISCORD_STATE_DIR line is removed.
    if [ -f "$d/.mcp.json" ] && ! jq -e '(.mcpServers.discord.env.CLAUDE_DISCORD_BOT == "${DISCORD_STATE_DIR:-}") and (.mcpServers.discord.env.DISCORD_STATE_DIR != "${DISCORD_STATE_DIR}")' "$d/.mcp.json" >/dev/null 2>&1; then
      # Only a file that already defines the discord server is edited (jq would
      # otherwise create a command-less one); jq_edit leaves bad JSON alone and
      # returns 0, so the result is verified, not assumed.
      jq -e '.mcpServers.discord.command' "$d/.mcp.json" >/dev/null 2>&1 &&
        jq_edit "$d/.mcp.json" '.mcpServers.discord.env = ((.mcpServers.discord.env // {}) + {CLAUDE_DISCORD_BOT: "${DISCORD_STATE_DIR:-}"})
          | if .mcpServers.discord.env.DISCORD_STATE_DIR == "${DISCORD_STATE_DIR}" then del(.mcpServers.discord.env.DISCORD_STATE_DIR) else . end'
      if jq -e '(.mcpServers.discord.env.CLAUDE_DISCORD_BOT == "${DISCORD_STATE_DIR:-}") and (.mcpServers.discord.env.DISCORD_STATE_DIR != "${DISCORD_STATE_DIR}")' "$d/.mcp.json" >/dev/null 2>&1; then
        mark "$d/.mcp.json"
      else
        echo "claude-discord: patch: $d/.mcp.json: failure-cache no longer matches" >&2; rc=1
      fi
    fi
  done
  [ -z "$changed" ] || echo "claude-discord: patched$changed"
  return "$rc"
}
# install: the plugin and what goes with it (the bootstrap's command): it reads
# no stdin at all, so a script's stdin is left alone. An install already there
# decides the scope, else project; the method is link unless --method says
# otherwise; an untrusted project gets a hint, never a question. Safe to re-run.
if [ "${1:-}" = install ]; then
  noask=1
  parse_install_flags "${@:2}"
  [ "${#rest[@]}" = 0 ] || { echo "usage: claude-discord install [--scope project|global] [--method link|clone]" >&2; exit 2; }
  check_install_scope
  install_all || exit $?
  # A bot's start patches the cache, but install then /reload-plugins with no restart would leave it unpatched (measured on lmd79). A failed patch must not fail the install.
  patch_official || echo "claude-discord: some patches no longer apply (see above); the install is done anyway" >&2
  echo "claude-discord: installed at $plugin_target; set up a bot with: claude-discord setup <name>"
  exit 0
fi

# ask <var> <prompt> [-s]: one answer from stdin. Stdin ending before an answer
# is said and exits 2 (set -e would otherwise end setup with a silent 1).
ask() {
  local a=""
  read -r ${3:-} -p "$2" a || [ -n "$a" ] || {
    [ ! -t 0 ] || echo >&2
    echo "claude-discord: setup: stdin ended before '$2' was answered; run setup at a terminal, or pipe one line per question (an empty line keeps the current value)" >&2
    exit 2
  }
  printf -v "$1" '%s' "$a"
}

if [ "${1:-}" = setup ]; then
  name=${2:?usage: claude-discord setup <name> [--scope project|global] [--method link|clone] [--reset|--mode]}
  # --scope and --method may sit anywhere after the name; the rest keeps its place so ${3:-} still sees --reset/--mode.
  parse_install_flags "${@:3}"
  # `bot add` runs setup with its answers on stdin: the install's own questions (scope, method, trust) are not asked
  # then, as `install` asks none, so they cannot take one of those answers.
  [ -z "${CLAUDE_DISCORD_SETUP_NOASK:-}" ] || noask=1
  set -- "$1" "$2" ${rest[@]+"${rest[@]}"}
  case $name in
    ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
    hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
    setup|install|update|patch|compat|refresh|health|monitor|tui|hosts|access|bot) echo "claude-discord: bot name '$name' is reserved: 'claude-discord $name' is a subcommand" >&2; exit 2;;
  esac
  if [ "${3:-}" = --mode ]; then
    [ -z "$scope$method" ] || { echo "claude-discord: --mode changes only the mode and installs nothing; --scope and --method do not apply" >&2; exit 2; }
  else
    check_install_scope
    install_all || exit $?
  fi
  umask 077
  if [ "${3:-}" = --mode ]; then
    # --mode changes only an already set-up bot's mode, so re-picking a mode
    # never re-asks the token or the mention question. It creates nothing:
    # a bot without both files gets neither a directory nor config.env.
    [ -f "$root/$name/.env" ] && [ -f "$root/$name/access.json" ] || {
      echo "claude-discord: bot '$name' is not set up; run 'claude-discord setup $name' first" >&2
      exit 2
    }
  else
    # --reset forgets this bot's token and access policy AND the shared IDs, so
    # every prompt is asked again; other bots keep their own files.
    [ "${3:-}" = --reset ] && rm -rf "$root/$name" "$root/config.env"
    mkdir -p "$root/$name"
    printf '*\n' > "$root/.gitignore"
    # A project set up before its Discord channel existed (Enter at these
    # prompts) is asked again, so a later setup run fills the IDs in.
    if [ ! -f "$root/config.env" ] || grep -qxE "DISCORD_(CHANNEL|USER)_ID=('')?" "$root/config.env"; then
      ask channel "Discord channel ID: "
      ask user "Your Discord user ID: "
      # Shown only at a terminal, like read -p's own prompt.
      [ -t 0 ] && cat >&2 <<'EOT'
Other user or bot IDs allowed to trigger bots there: comma-separated, empty for none,
or 'all' for everyone in the channel -- anyone who can post there could then drive this
session, which runs with shell access on this machine. Other bots in the channel count too, and
a reply to this bot counts as a mention, so two open bots can answer each other without end;
with 'respond without an @mention' on, they will.
EOT
      ask others "IDs: "
      others=${others//[[:space:]]/}   # the file is sourced: a stray space would run an ID as a command
      # "all" applies to THIS bot only and is not persisted: config.env is
      # shared by every bot in the project, so storing it would quietly open
      # up each bot set up here later. Mixing it with ids is refused rather
      # than guessed: taking the wider reading would open the channel on a
      # typo, and the narrower one would store a literal "all" as an ID.
      case $(printf '%s' "$others" | tr '[:upper:]' '[:lower:]') in   # tr, not the ,, expansion: macOS /bin/bash is 3.2
        all) allow_all=yes; others=;;
        *,all|all,*|*,all,*)
          echo "claude-discord: answer either 'all' or a list of IDs, not both" >&2; exit 2;;
      esac
      printf "DISCORD_CHANNEL_ID='%s'\nDISCORD_USER_ID='%s'\nDISCORD_ALLOW_IDS='%s'\n" "$channel" "$user" "$others" > "$root/config.env"
    fi
  fi
  [ -f "$root/config.env" ] && . "$root/config.env"   # sourced whenever present: later code (write_access) reads its variables
  if [ "${3:-}" != --mode ]; then
    keep=""
    [ -f "$root/$name/.env" ] && keep=" (empty keeps the current one)"
    ask token "Bot token for $name$keep: " -s
    echo
    [ -z "$token" ] && [ -n "$keep" ] || printf 'DISCORD_BOT_TOKEN=%s\n' "$token" > "$root/$name/.env"
    # Every bot in one channel answering every message means N replies per human
    # message, so the default stays mention-only; opt in per bot. Enter keeps
    # what the bot has now (its first group's requireMention).
    mention=true q='[y/N]'
    if [ "$(jq -r '[.groups[]?.requireMention][0]' "$root/$name/access.json" 2>/dev/null)" = false ]; then mention=false q='[Y/n]'; fi
    ask nomention "Respond to every message in the channel without an @mention? $q "
    case $nomention in y|Y) mention=false;; n|N) mention=true;; esac
    # access.json is the bot's LIVE policy: the plugin re-reads it on every
    # message, and its groups may have been hand-edited since the last setup
    # (moved to another channel, allowFrom trimmed, ackReaction silenced). A
    # re-run must not clobber that; only a bot with none yet (new, or just
    # after --reset, which deletes the bot dir first) gets one written fresh.
    # The one exception: a bot set up with no channel or user ID yet has a
    # group keyed "" and "" in allowFrom. Once the IDs are known, that group
    # takes the channel as key and each "" becomes the user (plus the other
    # IDs, or [] for "all", as write_access builds it); every other field stays.
    if [ -f "$root/$name/access.json" ]; then
      jq_edit "$root/$name/access.json" --argjson mention "$mention" --arg ch "${DISCORD_CHANNEL_ID:-}" --arg me "${DISCORD_USER_ID:-}" \
          --arg others "${DISCORD_ALLOW_IDS:-}" --arg open "${allow_all:+yes}" '
        def fill($ids): if (.allowFrom | type) == "array" then .allowFrom |= map(if . == "" then $ids[] else . end) else . end;
        if (.groups | type) == "object" then .groups |= map_values(.requireMention = $mention) else . end
        | if $me == "" then . else
            fill([$me])
            | if $ch != "" and (.groups | type) == "object" and (.groups | has("") and (has($ch) | not)) then
                .groups[$ch] = (.groups[""] | if $open == "yes" then .allowFrom = []
                  else fill([$me] + ($others | split(",") | map(gsub("\\s";"")) | map(select(. != "")))) end)
                | del(.groups[""])
              else . end
            # A group whose channel was known but whose allowFrom still holds "" (user ID answered later).
            | if (.groups | type) == "object" then .groups |= map_values(if $open == "yes" then (if (.allowFrom | type) == "array" then .allowFrom |= map(select(. != "")) else . end)
                else fill([$me] + ($others | split(",") | map(gsub("\\s";"")) | map(select(. != "")))) end) else . end
          end'
    else
      # allow_all is set only by the answer above, so it reaches this bot and
      # no other: a bot set up later in the same project inherits config.env's
      # ids, which never carry "all", and stays closed unless asked again with
      # --reset.
      write_access "$root/$name" "$mention" "${allow_all:+all}"
    fi
  fi
  mode=$(cat "$root/$name/mode" 2>/dev/null) || mode=none
  mode=$(select_one Mode "$mode" \
    "none  a plain bot" \
    "dev-manager  coordinates claude-discord changes with peer bots" \
    "autoresearchclaw  reports each AutoResearchClaw iteration to the channel")
  if [ "$mode" = dev-manager ] && [ -f "$helpers/records/projects" ]; then
    # One backend (state dir, keeper, monitor) per manager bot NAME on a machine: a second project's manager of the same
    # name would share it, and two ledgers would be followed by whichever monitor started first.
    here=$(pwd -P)
    while IFS= read -r p || [ -n "$p" ]; do
      p=${p%$'\r'}
      [ -n "$p" ] && [ "$p" != "$here" ] && [ -f "$p/.claude/discord-agents/$name/hosts" ] && [ "$(cat "$p/.claude/discord-agents/$name/mode" 2>/dev/null)" = dev-manager ] || continue
      echo "claude-discord: '$name' is already a dev-manager with a hosts ledger in $p; one backend serves one manager name per machine, so pick another bot name here" >&2
      exit 2
    done < "$helpers/records/projects"
  fi
  printf '%s\n' "$mode" > "$root/$name/mode"
  if [ "$mode" = dev-manager ]; then
    read -rp "Peer dev bots as name:bot_id:owner_id:machine, comma-separated (empty keeps the current list): " peers || :
    peers=${peers//[[:space:]]/}
    entry='^[^:]+:[0-9]+:[0-9]+:[^:]+$'
    bad=$(jq -rn --arg in "$peers" --arg re "$entry" '$in | split(",")[] | select(. != "" and (test($re) | not))')
    [ -z "$bad" ] || echo "claude-discord: skipping peers not shaped name:bot_id:owner_id:machine: ${bad//$'\n'/ }" >&2
    jq_edit "$root/peers.json" --arg in "$peers" --arg re "$entry" '
      reduce ($in | split(",")[] | select(test($re)) | split(":") | {name: .[0], bot_id: .[1], owner_id: .[2], machine: .[3]}) as $p
        (.; if any(.peers[]?; .bot_id == $p.bot_id) then .peers |= map(if .bot_id == $p.bot_id then $p else . end)
            else .peers = (.peers // []) + [$p] end)'
    # access.json's groups are kept as they are (see above), so peers go into
    # every existing group's allowFrom, wherever the bot's channel actually
    # is, not only the one keyed by config.env's channel; this bot itself is
    # skipped by name, and $a + ($ids - $a) keeps it additive, as before.
    ids=$(jq -c --arg self "$name" '[.peers[]? | select((.name // "" | tostring | ascii_downcase) != ($self | ascii_downcase)) | .bot_id | tostring]' "$root/peers.json" 2>/dev/null) || ids='[]'
    # An EMPTY allowFrom already lets every author through, peers included, and
    # adding ids to it would narrow the group to just those ids -- turning
    # "everyone" into "peers only" without saying so. Such a group is left as
    # it is. `access set mode=dev-manager` (CLAUDE_DISCORD_ACCESS_PEERS=written) has done this already, shown it and
    # written it under its lock: done again here it would be a write outside that lock, of peers nobody was shown.
    [ "${CLAUDE_DISCORD_ACCESS_PEERS:-}" = written ] ||
    jq_edit "$root/$name/access.json" --argjson ids "${ids:-[]}" \
      'if (.groups | type) == "object"
       then .groups |= map_values(if (.allowFrom // []) == [] then .
                                  else .allowFrom = (.allowFrom as $a | $a + ($ids - $a)) end)
       else . end'
    echo "Ask each peer's owner to add this bot's id to their allowFrom; both directions are needed."
    write_hosts "$root/$name"
  else
    # Only a manager posts to #bot-health-check: any other mode has no ledger, so no monitor.
    rm -f "$root/$name/hosts"
  fi
  ensure_hooks_symlink
  record_project
  # A manager's backend runs with no session and no TUI: started here, detached, unless one runs or its owner stopped
  # it (the front says which, in one line).
  if [ "$mode" = dev-manager ] && [ -f "$root/$name/hosts" ]; then
    bash "$self_root/monitor/monitor.sh" "$self_path" --keep "$name" --detach </dev/null || :
  fi
  if [ "${3:-}" = --mode ]; then
    echo "claude-discord: $root/$name/mode set to $mode"
  else
    echo "claude-discord: $root/$name/access.json written (requireMention=$mention, mode=$mode)"
  fi
  exit 0
fi

# The bot is named by --name/-n (the launch mirrors `claude`). The older
# positional form still works with a warning: the first bare word, wherever it
# sits, is the bot, but only when no --name is given. A word that follows a flag
# taking a value is that value, so `--resume x` never reads as the name, and
# with no name at all the project's single bot is meant. The list is
# every flag `claude --help` (2.1.277) shows with a value, optional ones
# ([value]) included since claude takes the next word for them too, plus
# hidden ones in use (--channels, --max-turns, the *-file prompt flags).
takes_value() {
  case $1 in
    -r|--resume|--model|--effort|--settings|--agent|--agents|--permission-mode|--permission-prompts| \
    --mcp-config|--add-dir|--session-id|--fallback-model|--max-turns|--max-budget-usd| \
    --output-format|--input-format|--json-schema|--debug-file|-d|--debug|--betas|--autocompact| \
    --append-system-prompt|--append-system-prompt-file|--system-prompt|--system-prompt-file| \
    --system-prompt-snapshot|--allowedTools|--allowed-tools|--disallowedTools|--disallowed-tools| \
    --tools|--setting-sources|--plugin-dir|--plugin-url|--file|--environment|--cloud|--from-pr| \
    --teleport|--remote-control|--remote-control-session-name-prefix|--prompt-suggestions| \
    -w|--worktree|--channels|-n|--name) return 0;;
    *) return 1;;
  esac
}

# A bot can stop answering without anything failing loudly: measured on this
# machine, a worker that came back from a Claude Code self-upgrade ran no
# hooks at all for 21 hours, and a `refresh` whose `--bg` start hit the
# workspace-trust gate left the bot down for 22 -- neither reported anywhere.
# `health` is the outside check for exactly that, run by hand from outside
# the session, so it still speaks when the session is the thing that died.
#
#   claude-discord health [--json]
#   claude-discord health --all [--json] [--patch]
#   claude-discord health --uninstall-timer
#
# What it judges by, and why not the obvious thing: `claude agents`' `.state`
# is NOT a liveness signal. Measured on two machines, a fully live bot shows
# `state: done, status: idle` while its pid and its gateway connection are
# both up; `state` tracks whether a turn is running. Counting processes is no
# better on its own -- the upgrade failure above kept server, gateway and
# session alive and killed only the hooks, so every process check said
# "fine". So the PRIMARY signal is behavioural:
#
#   a message that addressed this bot, never handed to its session (its id
#   is not in $dir/delivered, written by turn/on-prompt; with no such file,
#   newer than $dir/last-message-id), and older than $stale_min minutes
#
# which catches a dead process, dead hooks and a wedged turn alike. The
# process count is then used only to NAME the cause (none = down, several =
# two sessions on one token). Three things would otherwise make that signal
# cry wolf, and each is filtered:
#   - the plugin drops a message from an author outside access.json's
#     allowFrom before any hook runs, so last-message-id can never catch up
#     to it; health applies the same allowFrom (empty = everyone, as there).
#   - a long turn legitimately takes minutes, so a turn in flight
#     (turns/<session id>, written by on-prompt and removed by on-stop)
#     holds the alert back -- but only while that file is younger than
#     $turn_max_min, since a turn whose hooks died leaves it behind for ever
#     and would otherwise silence the very failure this exists to catch.
#   - a human reaches a bot by replying to it, with no mention at all, so a
#     reply whose referenced_message is this bot's counts as addressing it.
# Known gap: the plugin also treats a mention of the bot's managed ROLE as
# addressing it, and the REST payload carries those in `mention_roles`, not
# in `mentions`. Such a message is not counted, so health under-reports
# there rather than crying wolf -- the safe direction for a thing that wakes
# a human.
# Never restarts anything and never stops anything: a misjudged restart is
# what puts two sessions on one token, and this is the tool most likely to
# misjudge. It reports, and a human decides.
if [ "${1:-}" = health ]; then
  shift
  stale_min=15        # an addressed message older than this with no hook record is an alert
  turn_max_min=60     # a turns/<sid> file older than this is a wedged turn, not a live one
  unknown_cap=6       # runs in a row that could not tell, and
  unknown_min_s=1500  # seconds since the first of them (25 min: six passes 5 min apart), before saying so: both, as a
                      # pass can be asked for (monitor --check) and six runs may be seconds apart
  # However long a turn claims to be running, a message left unanswered this
  # long is worth saying out loud. `working` is a claim by the daemon, and a
  # session can sit in that state wedged on a tool call or a prompt that
  # never returns; without a ceiling the hold is unbounded and a bot can be
  # silent for days with nobody told. Deliberately generous -- well past any
  # honest turn -- so it only fires when something is really wrong.
  busy_cap_min=240    # 4 h unanswered ends the hold whatever the session says
  as_json=no timer="" all=no do_patch=no nolog=no
  for a in "$@"; do
    case $a in
      --json) as_json=yes;;
      --all) all=yes;;
      --patch) do_patch=yes;;
      --nolog) nolog=yes;;   # internal: --all's per-project runs write no health.log line and no journal line
      --uninstall-timer) timer=uninstall;;
      *) echo "usage: claude-discord health [--json] | health --all [--json] [--patch] | health --uninstall-timer" >&2; exit 2;;
    esac
  done
  [ "$do_patch" = no ] || [ "$all" = yes ] || { echo "claude-discord: health --patch needs --all" >&2; exit 2; }
  # --all: every project in ~/.claude-discord/records/projects, one document.
  # This is the one command a monitor pass runs per host (locally or over
  # ssh), so with --json it exits 0 whenever it printed the document: over
  # ssh a non-zero status means "no answer from that host", never "a bot has
  # a finding". Each project is judged by this same script run there with
  # --nolog; a project whose .claude/discord-agents is missing is reported with an error, never pruned.
  # Before the DISCORD_STATE_DIR fallback below: --all is about the machine,
  # so a bot session's own project must not stand in for the working directory.
  if [ "$all" = yes ]; then
    command -v jq >/dev/null 2>&1 || { echo "claude-discord: health needs jq" >&2; exit 1; }
    pf=$helpers/records/projects keep="" docs="" prc=null pout="" any=0
    if [ "$do_patch" = yes ]; then
      # The `patch` verb's own function, in a subshell; stderr only: file and patch name.
      prc=0; pout=$(patch_official 2>&1 >/dev/null) || prc=$?
    fi
    if [ -f "$pf" ]; then
      snap=$(tr -d '\r' < "$pf")
      while IFS= read -r p || [ -n "$p" ]; do
        p=${p%$'\r'}   # a hand-edited CRLF line
        [ -n "$p" ] || continue
        case $'\n'$keep in *$'\n'"$p"$'\n'*) continue;; esac   # each project once: the same bots twice would read as two
        keep="$keep$p"$'\n'
        # Missing now is not gone for good (a volume not mounted yet, the other side of a shared home): reported, never
        # pruned, so the monitor reads it as blind and its bots stay known. Only the owner removes a line.
        if [ ! -d "$p/.claude/discord-agents" ]; then
          miss="project folder missing: $p/.claude/discord-agents (gone for good: delete its line from $pf)"
          if [ "$as_json" = yes ]; then one=$(jq -nc --arg p "$p" --arg e "$miss" '{project: $p, bots: [], error: $e}'); docs=$docs$one$'\n'; else echo "== $p"; echo "$miss"; any=1; fi
          continue
        fi
        if [ "$as_json" = yes ]; then
          # </dev/null: the loop's stdin is the list itself, and a reader in the run would eat its lines.
          orc=0; one=$(cd "$p" 2>/dev/null && "$self_path" health --json --nolog 2>/dev/null </dev/null) || orc=$?
          # A child that printed no array is a crash, not a project without bots: the monitor reads `error` as blind.
          # Two plain assignments: bash 3.2 misreads a quoted jq program inside "$( )" inside double quotes.
          one=$(printf '%s' "${one:-null}" | jq -c --arg p "$p" --arg e "health exited $orc with no document" 'if type == "array" then {project: $p, bots: .} else {project: $p, bots: [], error: $e} end' 2>/dev/null) || one=$(jq -nc --arg p "$p" --arg e "health exited $orc with no document" '{project: $p, bots: [], error: $e}')
          docs=$docs$one$'\n'
        else
          echo "== $p"
          (cd "$p" 2>/dev/null && "$self_path" health --nolog </dev/null) || any=1
        fi
      done < "$pf"
      # Rewritten only when the walk changed the list (deduped, or empty lines dropped), judged against
      # the snapshot taken before it, not the live file: a `setup` recording a project
      # meanwhile would else look like a difference and be erased. Lines now in the file
      # that the snapshot lacks are appended to the new content. mv, so a concurrent
      # reader never sees a truncated file.
      if [ "${keep%$'\n'}" != "$snap" ]; then
        while IFS= read -r p || [ -n "$p" ]; do
          p=${p%$'\r'}
          [ -n "$p" ] || continue
          case $'\n'$snap$'\n' in *$'\n'"$p"$'\n'*) continue;; esac
          case $'\n'$keep in *$'\n'"$p"$'\n'*) continue;; esac
          keep="$keep$p"$'\n'
        done < "$pf"
        printf '%s' "$keep" > "$pf.tmp.$$" 2>/dev/null && mv -f "$pf.tmp.$$" "$pf" 2>/dev/null || :
      fi
      rm -f "$pf.tmp.$$"
    fi
    [ "$as_json" = yes ] || exit "$any"
    h=$(uname -n); h=${h%%.*}
    printf '%s' "$docs" | jq -s --arg host "$h" --arg home "$HOME" --argjson prc "$prc" --arg pout "$pout" \
      --arg ver "$(plugin_version "$self_root") ($(git -C "$self_root" rev-parse --short HEAD 2>/dev/null || echo nogit))" \
      '{host: $host, version: $ver, home: $home, patch: (if $prc == null then null else {rc: $prc, output: $pout} end), projects: .}'
    exit 0
  fi
  # The working directory decides, and only when it holds no bots does the
  # environment stand in. `refresh` leans on DISCORD_STATE_DIR because a
  # session refreshes ITSELF, but `health` is about a project: measured,
  # running it from another project's directory inside a bot session
  # reported that session's bots instead -- a confident answer about the
  # wrong project. A session whose shell has wandered off its own project
  # still gets the fallback.
  if [ ! -d "$root" ] && [ -n "${DISCORD_STATE_DIR:-}" ]; then
    cd "$(dirname "$(dirname "$(dirname "$DISCORD_STATE_DIR")")")"
    root=$PWD/.claude/discord-agents
  fi

  # Removing a timer an older version installed. Installing one is gone: the
  # owner's rule (2026-10-09) is no OS scheduler -- a systemd unit outlives
  # every session, so a bot thought stopped comes back on the next boot.
  # One unit per project, named after its basename.
  if [ "$timer" = uninstall ]; then
    slug=$(basename "$PWD" | tr -cd 'A-Za-z0-9_-'); slug=${slug:-project}
    unit=claude-discord-health-$slug
    ud=$HOME/.config/systemd/user
    [ -f "$ud/$unit.timer" ] || [ -f "$ud/$unit.service" ] || { echo "claude-discord: no timer was installed for this project"; exit 0; }
    systemctl --user disable --now "$unit.timer" >/dev/null 2>&1 || :
    # Both paths are built from $HOME and a slug of $PWD's basename, and
    # the slug falls back to "project", so neither can be empty; unlink
    # rather than rm, since it can only ever remove one plain file.
    [ -f "$ud/$unit.timer" ] && unlink "$ud/$unit.timer"
    [ -f "$ud/$unit.service" ] && unlink "$ud/$unit.service"
    systemctl --user daemon-reload >/dev/null 2>&1 || :
    echo "claude-discord: removed $unit.timer"
    exit 0
  fi

  [ -d "$root" ] || { echo "claude-discord: no bot set up in $root" >&2; exit 1; }
  record_project
  command -v jq >/dev/null 2>&1 || { echo "claude-discord: health needs jq" >&2; exit 1; }
  command -v curl >/dev/null 2>&1 || { echo "claude-discord: health needs curl" >&2; exit 1; }
  [ ! -f "$root/config.env" ] || . "$root/config.env"

  now_s=$(date +%s)
  # A Discord id is a snowflake: its top 42 bits are milliseconds since
  # 2015-01-01, so an id alone gives both an age and an ordering with no API
  # call. Ids are ~1.5e18 and bash arithmetic is 64-bit, so this cannot
  # overflow.
  # The id arrives as a decimal STRING (see addressed_ids). Bash arithmetic
  # is 64-bit and a snowflake is ~1.5e18, so this is exact -- unlike jq 1.6,
  # whose doubles are not. A leading zero would be read as octal, so it is
  # stripped; ids never have one, but the guard costs nothing.
  snowflake_s() { local i=${1#"${1%%[!0]*}"}; printf '%s' $(( ((${i:-0} >> 22) + 1420070400000) / 1000 )); }
  is_id() { case ${1:-} in ''|*[!0-9]*) return 1;; esac; return 0; }

  # Counts the plugin servers belonging to one bot. argv FIRST, environ
  # second, and that order is the whole point: every child of a bot session
  # (its shells, its subagents, its hooks) inherits DISCORD_STATE_DIR, so
  # matching on the environment alone counts them all and reports a healthy
  # bot as a duplicate. A server is `bun run --cwd <plugin>/discord/<ver>
  # ... start`, so the argv test is: argv[0] is bun, some argument sits
  # under a .../discord/ directory, and the last argument is `start`. Only
  # then is that pid's environ read, to see WHICH bot it serves. Without a
  # /proc (macOS) the same order runs on ps output, below. Prints "unknown"
  # only when ps itself fails, which the caller treats as "cannot tell",
  # never as zero.
  # The candidate pids, found ONCE per run rather than once per bot.
  # Walking every /proc entry cost ~85 ms per call here (805 processes) and
  # ~300 ms on a busier machine. `pgrep -x bun` narrows it to the handful of
  # processes that could possibly be a plugin server (6 of 820 here) using
  # one C program instead of hundreds of shell reads. Without pgrep, or if it
  # errors, fall back to the full walk -- correctness must not depend on an
  # optional tool.
  # Per RUN, not per bot: the list is a property of the machine, not of a
  # bot, and calling it per bot cost 8 forks where 1 does (measured here:
  # 0.15 s for 8, 0.02 s for 1). It also makes the run self-consistent --
  # every bot is judged against the same instant -- where a per-bot list
  # could count a server for one bot that had already exited for the next.
  # A health run is a snapshot either way; this makes it one snapshot.
  server_cands="" mac_env="" mac_pids="" mac_ok=no
  proc=${CLAUDE_DISCORD_PROC:-/proc}   # the suite points this at a missing path to exercise the macOS count on Linux
  if [ ! -d "$proc" ]; then
    # macOS: argv first here too. -ax, because without it ps lists only
    # processes with a terminal and a --bg server has none (measured on wmac,
    # 2026-10-10: 0 of 1). The argv test on the one-line command: the first
    # word is bun, the last is start, a word sits under .../discord/. Then one
    # more ps with -E for those pids: each line is "<pid> <argv> <environment>".
    # That second call has NO -ax: on real BSD ps -ax ORs with -p and prints the
    # whole table (836 lines on wmac), so every shell and hook of the session
    # that inherits DISCORD_STATE_DIR would count as a server.
    mac_ok=no mac_pids=""
    if mac_ps=$(ps -axww -o pid=,command= 2>/dev/null) && [ -n "$mac_ps" ]; then
      mac_ok=yes
      mac_pids=$(printf '%s\n' "$mac_ps" | awk '{ a0 = $2; sub(/.*\//, "", a0) } a0 == "bun" && $NF == "start" && /\/discord\// { printf "%s%s", (n++ ? "," : ""), $1 }') || mac_pids=""
      [ -z "$mac_pids" ] || mac_env=$(ps -Eww -o pid=,command= -p "$mac_pids" 2>/dev/null) || mac_ok=no
    fi
  fi
  if [ -d "$proc" ]; then
    if command -v pgrep >/dev/null 2>&1 && server_cands=$(pgrep -x bun 2>/dev/null); then
      server_cands=$(printf "$proc/%s/cmdline " $server_cands)
    else
      server_cands=$(printf '%s ' "$proc"/[0-9]*/cmdline)
    fi
  fi

  count_servers() {  # $1 = bot state dir
    local n=0 c pid args a hit l
    if [ ! -d "$proc" ]; then
      [ "$mac_ok" = yes ] || { printf 'unknown'; return 0; }   # ps itself failed: cannot tell, never zero
      # The token after the argv text: " DISCORD_STATE_DIR=<dir>" ending the
      # line or followed by a space, so "hbot" never counts "hbot2"'s server.
      # shortcut: ps joins env words with spaces, so a dir "/a/My" also matches a line carrying "/a/My Project/x"; quote-aware parsing if a Mac project ever has such siblings.
      local IFS=$'\n'; set -f   # one ps line at a time (a subshell: neither leaks), with no here-string (bash 3.2 writes those to TMPDIR)
      for l in $mac_env; do
        case "$l " in *" DISCORD_STATE_DIR=$1 "*) n=$((n + 1));; esac
      done
      printf '%s' "$n"; return 0
    fi
    for c in $server_cands; do
      # Braces around the read, not `2>/dev/null` on mapfile alone: a
      # process that exits between the glob and the read makes the SHELL
      # report the failed redirect, which mapfile's own redirection does not
      # silence, and this must print nothing but a number. No `basename`
      # either -- one fork per process on a machine with 800 of them cost
      # 281 ms a scan, against 83 ms for the expansion (measured).
      { mapfile -d '' -t args < "$c"; } 2>/dev/null || continue   # bash4-ok: reached only where /proc exists
      [ "${#args[@]}" -ge 2 ] || continue
      [ "${args[0]##*/}" = bun ] || continue
      [ "${args[${#args[@]}-1]}" = start ] || continue
      hit=no
      for a in "${args[@]}"; do case $a in */discord/*) hit=yes; break;; esac; done
      [ "$hit" = yes ] || continue
      pid=${c#"$proc"/}; pid=${pid%/cmdline}
      # -x: without it this is a SUBSTRING test, so a bot named "hbot"
      # counts "hbot2"'s server too (measured) -- the shorter-named bot then
      # reads as a duplicate and the longer-named one, when down, does not
      # read as down at all. -z makes each NUL-separated entry a line, and
      # -x anchors the whole entry.
      grep -qzxF "DISCORD_STATE_DIR=$1" "$proc/$pid/environ" 2>/dev/null && n=$((n + 1))
    done
    printf '%s' "$n"
  }

  # The age in minutes of the youngest turn in flight, or "" when none.
  # on-prompt creates turns/<session id> and appends a line for every
  # further message of the same turn, so a busy long turn keeps its mtime
  # fresh; on-stop removes it. The .primed and .replied neighbours are not
  # turn markers. The youngest, not the oldest: one wedged leftover must not
  # make a bot that is answering right now look wedged.
  turn_age_min() {  # $1 = bot state dir
    local f best="" age mt
    for f in "$1"/turns/*; do
      case $f in *.primed|*.replied|*'/*') continue;; esac
      [ -f "$f" ] || continue
      mt=$(date -r "$f" +%s 2>/dev/null) || continue
      age=$(( (now_s - mt) / 60 ))
      if [ -z "$best" ] || [ "$age" -lt "$best" ]; then best=$age; fi
    done
    printf '%s' "$best"
  }

  # Is a session of this bot, in this project, running a turn right now?
  # `.state` is useless as a LIVENESS signal (a live bot sits at `done`), but
  # this is the one thing it does measure, and the turn file's mtime cannot
  # tell a long working turn from a wedged one: on-prompt only touches that
  # file when a MESSAGE arrives, so a turn that runs for hours off a single
  # message goes stale-looking while it works. Measured 2026-09-25: this very
  # session was reported stale, with a --force refresh as the suggested fix,
  # while it was mid-turn. So the turn-file cap is only believed when the
  # daemon also says nothing is running. Unknown (no jq, no claude, a listing
  # that fails or is not a list) counts as WORKING, the quiet direction: a
  # missed alert is recoverable, an alert telling someone to force-refresh a
  # session that is busy is not.
  # Exit 0 = working, 1 = not working, 2 = could not tell. The caller treats
  # 2 like 0 (hold the alert) but counts how many runs in a row said so: a
  # daemon that keeps failing to answer is itself a sign something is wrong,
  # and holding for ever would hide it. See $unknown_cap below.
  session_working() {
    local list t=()
    command -v jq >/dev/null 2>&1 || return 2
    command -v claude >/dev/null 2>&1 || return 2
    command -v timeout >/dev/null 2>&1 && t=(timeout 5)
    list=$(${t[@]+"${t[@]}"} claude agents --json 2>/dev/null) || return 2
    printf '%s' "${list:-null}" | jq -e 'type == "array"' >/dev/null 2>&1 || return 2
    printf '%s' "$list" | jq -e --arg n "$1" --arg cwd "$(pwd -P)" '
      any(.[]; (.name? // "") == $n and (.cwd? // "") == $cwd
               and ((.state? // "") == "working" or (.status? // "") == "busy"))' \
      >/dev/null 2>&1
  }

  api() {  # $1 = path; sets $status and $resp. Token on stdin, never argv.
    local out
    out=$(printf 'Authorization: Bot %s\n' "$tok" | curl -s --max-time 10 -w '\n%{http_code}' -H @- \
      "https://discord.com/api/v10/$1" 2>/dev/null) || out=""
    status=${out##*$'\n'} resp=${out%$'\n'*}
    case $status in ''|*[!0-9]*) status=000;; esac
  }

  # 1.11.1: the names of this bot's channels, from ONE call for the guild's channel list: the main channel ($ch) and
  # every group of its access policy ($access). They are kept in <bot dir>/channel-names, one "<id> <name>" line each
  # (a name cleaned as the main one always was; written beside the file and moved over it), the main one in channel-guild
  # too, as before. Fails, and writes nothing, when the answer is no array or has not the main channel in it. $names is
  # what the document is built from. A channel the guild has not (another guild's, a deleted one) gets no line.
  guild_names() {
    local nl="" t
    api "guilds/$gid/channels"
    nl=$(printf '%s' "$resp" | jq -r --arg c "$ch" --argjson a "${access:-null}" '
      ([$c] + [$a.groups[]?.id]) as $ids
      | arrays | .[] | objects | select(.id as $i | any($ids[]; . == $i))
      | (.name // "" | tostring | gsub("[[:space:][:cntrl:]]+"; "-")) as $n | select($n != "") | "\(.id) \($n)"' 2>/dev/null) || nl=""
    case $'\n'$nl in *$'\n'"$ch "*) ;; *) return 1;; esac
    t=$'\n'$nl; t=${t#*$'\n'"$ch "}
    names=$nl cname=${t%%$'\n'*}
    { printf '%s\n' "$nl" > "$d/channel-names.$$" && mv "$d/channel-names.$$" "$d/channel-names"; } 2>/dev/null || :
    printf '%s %s %s %s\n' "$ch" "$gid" "$cname" "$now_s" > "$d/channel-guild" 2>/dev/null || :
  }

  # The ids in a messages array that addressed this bot. An author
  # outside allowFrom is dropped exactly as the plugin drops it, so
  # last-message-id's inability to ever reach such a message cannot become
  # an alert; an EMPTY allowFrom allows everyone, as it does there. With
  # requireMention false every allowed author's message counts; with it
  # true, a mention of this bot or a reply to one of its own messages does.
  # `.mentions` excludes @everyone, which the start patches the plugin to
  # ignore too, so the two agree.
  # The author id is bound to $aid before the allowFrom test: inside
  # `$allow | index(...)` the input is the allow ARRAY, so reaching for
  # `.author` there indexes an array with a string and the whole filter dies
  # (measured: every message dropped, so a dead bot read as healthy).
  # An id is never turned into a jq NUMBER. jq 1.6 -- still /usr/bin/jq on
  # this machine -- holds every number as an IEEE double, and a 19-digit
  # snowflake does not fit in 53 bits of mantissa: measured,
  # "1553056881315025049"|tonumber|tostring gives 1553056881315025200, which
  # is LARGER than the original, so it sails past last-message-id and invents
  # a stale verdict for a bot that is perfectly idle; two ids one apart also
  # compare equal. Ids therefore stay strings, compared by (length, then
  # lexically) -- exact for fixed-width decimals, and Discord ids are 18-19
  # digits and will not reach 20 this century.
  #
  # OLDEST unanswered, not newest: the age being measured is how long the bot
  # has been failing to answer, so it must start at the FIRST message it did
  # not answer. With the newest, every fresh message resets the clock -- and
  # a wedged bot is exactly one people keep calling, so the bots this is for
  # would never be reported. The set is bounded below by last-message-id, so
  # something answered long ago cannot drag the age back.
  id_newer() {  # $1 > $2, as ids
    [ "${#1}" -gt "${#2}" ] && return 0
    [ "${#1}" -lt "${#2}" ] && return 1
    [[ $1 > $2 ]]
  }
  # A candidate is also cleared when the bot itself posted a later message in
  # this same page (one chat: the channel or one thread): it spoke after the
  # message, so the message was handled even if no delivered line says so (a
  # catch-up after a refresh gap or a down bot). The bot's reply in ANOTHER
  # thread is a different page and clears nothing: one stuck thread still alerts.
  addressed_ids() {  # $1 = messages JSON; ids newer than $floor, not in $delivered, no later bot message here; oldest first
    printf '%s' "$1" | jq -r --arg me "$me" --argjson allow "$allow" \
      --argjson mention "$mention" --arg seen "$floor" --arg delivered "$delivered" '
      ($delivered | split("\n")) as $dl |
      if type != "array" then empty else
        [ .[] | select(.author.id? == $me) | .id? | select(type == "string") ] as $mine |
        [ .[]
          | (.author.id? // "") as $aid
          | select($aid != $me)
          | select(($allow | length) == 0 or ($allow | index($aid)) != null)
          | select($mention == false
                   or ((.mentions // []) | any((.id? // "") == $me))
                   or ((.referenced_message.author.id? // "") == $me))
          | .id
          | select(type == "string" and test("^[0-9]{17,20}$"))
          | select((. | length) > ($seen | length)
                   or ((. | length) == ($seen | length) and . > $seen))
          | select(. as $i | ($dl | index($i)) == null)
          | select(. as $i | any($mine[]; (length > ($i | length))
                                          or (length == ($i | length) and . > $i)) | not) ]
        | sort | .[]
      end' 2>/dev/null || :
  }
  # The oldest of $oldest and every id read from $1, kept in $oldest.
  note_oldest() {  # $1 = messages JSON
    local id
    while IFS= read -r id; do
      case $id in ''|*[!0-9]*) continue;; esac
      # `cond && oldest=$id` alone would be FATAL here: under `set -e` a
      # loop body whose last command returns non-zero aborts the script, and
      # that is precisely the ordinary case -- the second id not being older
      # than the first. Measured: two unanswered messages made the whole
      # check die mid-run with no output and no error. The else branch keeps
      # the body's status zero. (Same trap as `session_working; x=$?`.)
      if [ -z "$oldest" ] || id_newer "$oldest" "$id"; then oldest=$id; fi
    done < <(addressed_ids "$1")
  }

  # Can this machine reach Discord at all? `GET /gateway` needs no token, so
  # its answer separates "the network is blocked" from "this bot's token was
  # refused" -- and without that separation the two are indistinguishable:
  # measured 2026-09-25, a run with no HTTPS_PROXY got 403 on every call and
  # blamed every bot's token, which would have sent every owner to check a
  # credential that was perfectly fine. So when the network is down, that is
  # the single finding and no token is blamed. The wording names the likely cause,
  # since a missing proxy is what produced it here.
  # Same `-w '\n%{http_code}'` shape as api() below rather than
  # `-o /dev/null -w '%{http_code}'`: the status must be taken from the LAST
  # line, since a body is written whatever -o says.
  net_status=$(curl -s --max-time 10 -w '\n%{http_code}' \
    https://discord.com/api/v10/gateway </dev/null 2>/dev/null) || net_status=""
  net_status=${net_status##*$'\n'}
  case $net_status in ''|*[!0-9]*) net_status=000;; esac
  case $net_status in 2*) net=ok;; *) net=down;; esac

  # A project fact, not a per-bot one, so it is read once rather than once
  # per bot. An explicit null test, not `// "unknown"`: jq's `//` treats
  # FALSE as empty, so the untrusted case -- the one worth reporting -- would
  # read as "unknown" and the hint would be lost.
  trusted=$(jq -r --arg p "$PWD" '.projects[$p].hasTrustDialogAccepted | if . == null then "unknown" else tostring end' "$HOME/.claude.json" 2>/dev/null) || trusted=unknown
  [ -n "$trusted" ] || trusted=unknown

  # Fields are collected separated by US (0x1f) and turned into JSON once,
  # after the loop -- one jq for the whole run instead of one per bot. A
  # variable rather than a temp file: the loop is no subshell, so it
  # survives, and a machine whose TMPDIR is unwritable still works
  # (measured: with mktemp failing, the file version printed two errors and
  # no result at all). US is chosen because no bot name, verdict, detail or
  # line of refresh.log can contain it; a bash variable could not hold NUL.
  rows=""
  for d in "$root"/*/; do
    d=${d%/}
    [ -f "$d/.env" ] || continue
    # Shell expansion, not `basename`: one fork per bot per run, five minutes
    # apart forever, for a string operation bash already does. $d has had its
    # trailing slash stripped just above, so ${d##*/} is the directory name.
    bot=${d##*/}
    tok=$(grep '^DISCORD_BOT_TOKEN=' "$d/.env" 2>/dev/null | head -1) || tok=""
    tok=${tok#DISCORD_BOT_TOKEN=}
    servers=$(count_servers "$d")
    turn=$(turn_age_min "$d")
    last_seen=$(cat "$d/last-message-id" 2>/dev/null) || last_seen=0
    is_id "$last_seen" || last_seen=0
    # What "unanswered" is measured against. With a delivered log (on-prompt
    # appends every message id the session was handed, 200 kept) a message is
    # a candidate when it is newer than the OLDEST id in that log and is not
    # in it: it never reached the session. last-message-id cannot be the
    # bound there, since it moves past a message stuck in one thread as soon
    # as the bot answers in another. Without the log (a bot whose hooks have
    # not run since this release) the bound stays last-message-id, as before.
    floor=$last_seen delivered=""
    if [ -s "$d/delivered" ]; then
      floor=""
      # `|| :`: an unreadable file must not abort the run under set -e.
      while IFS= read -r id || [ -n "$id" ]; do
        is_id "$id" || continue
        delivered="$delivered$id"$'\n'
        if [ -z "$floor" ] || id_newer "$floor" "$id"; then floor=$id; fi
      done < "$d/delivered" || :
      [ -n "$floor" ] || floor=$last_seen
    fi
    refresh_tail=$(tail -1 "$d/refresh.log" 2>/dev/null) || refresh_tail=""

    # The channel is the single numeric group key in access.json (where a bot
    # is moved), config.env's otherwise: the same rule as the start path and
    # hooks/lib/discord.sh. Two keys are as ambiguous as none.
    # requireMention and allowFrom come from that same group, so all three
    # are read in ONE jq: a fork per field per bot per run is pure waste, and
    # it showed up in the suite's wall time.
    # Note the explicit null tests rather than `//`: jq's `//` treats FALSE
    # as empty, so `requireMention // true` read an owner's deliberate
    # "answer everything" (false) as true and dropped every message there as
    # unaddressed -- a wedged bot in such a channel was undetectable. Third
    # place that operator bit here; false is a meaningful value in all of
    # them, so `//` is never right for one.
    # The fourth field is the whole access policy, for the TUI (1.11.0), from this same jq: every numeric group with
    # its requireMention and allowFrom, dmPolicy and the DM allowFrom. An id is kept only when it is all digits and the
    # policy only when it is all letters, so that JSON holds no backslash and no tab and survives @tsv and `read` as it is.
    # No channel is written "-": a tab is IFS whitespace, so an empty first field would shift the others left.
    # A `groups` that is missing or no object reads as no group ($g), not as no answer: a bot that takes DMs only still
    # reports its DM policy, and its channel is config.env's as before.
    cfg=$(jq -r --arg fb "${DISCORD_CHANNEL_ID:-}" '
      def ids: [arrays[] | tostring | select(test("^[0-9]+$"))] | unique;
      ((.groups | objects) // {}) as $g
      | ($g | keys) as $k
      | (if ($k | length) == 1 and ($k[0] | test("^[0-9]+$")) then $k[0] else $fb end) as $ch
      | [ (if $ch == "" then "-" else $ch end),
          ($g[$ch].requireMention | if . == null then true else . end | tostring),
          (($g[$ch].allowFrom // []) | map(tostring) | unique | @json),
          ({dm: (.dmPolicy | if type == "string" and test("^[A-Za-z]+$") then . else null end), dm_allow: (.allowFrom | ids),
            groups: [$g | to_entries[] | select((.key | test("^[0-9]+$")) and (.value | type) == "object")
                     | {id: .key, mention: (.value.requireMention != false), allow: (.value.allowFrom | ids)}]} | tojson) ]
      | @tsv' "$d/access.json" 2>/dev/null) || cfg=""
    access=""
    IFS=$'\t' read -r ch mention allow access <<<"$cfg"
    case ${ch:-} in ''|*[!0-9]*) ch=${DISCORD_CHANNEL_ID:-};; esac
    case ${mention:-} in true|false) ;; *) mention=true;; esac
    case ${allow:-} in '['*) ;; *) allow='[]';; esac
    # The guild and the name of the channel, cached as "<channel> <guild> <name> <read at, epoch s>" (see below). Read
    # here, before any verdict, so the name is known whatever Discord answers this run. A line for another channel is
    # not used; one an older version wrote (two fields) has no name and no age.
    gid="" cname="" cat_s="" cached=$(cat "$d/channel-guild" 2>/dev/null) || cached=""
    case $cached in "$ch "*) read -r cch gid cname cat_s <<<"$cached";; esac
    # Leading zeros go, as for lm below: to bash 08 is an octal number that is none, and that error would end this whole
    # health block and let the script run on into the launcher (it started the bot's session). All zeros is 0.
    case $cat_s in ''|*[!0-9]*) cat_s=0;; esac
    cat_s=${cat_s#"${cat_s%%[!0]*}"}; cat_s=${cat_s:-0}
    [ "$cname" != - ] || cname=""
    # 1.11.1: the names kept for this bot's channels (guild_names) and its mode, both read by the shell itself.
    names="" mode=""
    { while read -r cch t; do names="$names$cch $t"$'\n'; done < "$d/channel-names"; } 2>/dev/null || :
    { read -r mode < "$d/mode"; } 2>/dev/null || :
    mode=${mode//[[:cntrl:]]/}; mode=${mode:-none}
    # 1.14.0: the bot's Discord username (a bot's name here is that username; the TUI says `≠ Discord` when they differ),
    # kept in discord-name as "<read at, epoch s> <name>" and read again once it is a day old, by the users/@me call that
    # also tells the bot's id. A number with a leading zero is decimal (cat_s says why).
    dn_s="" dname=""; { read -r dn_s dname < "$d/discord-name"; } 2>/dev/null || :
    case $dn_s in ''|*[!0-9]*) dn_s=0;; esac
    dn_s=${dn_s#"${dn_s%%[!0]*}"}; dn_s=${dn_s:-0}; dname=${dname//[[:cntrl:]]/}

    verdict=ok detail="" oldest="" age=0 me="" status=000 resp=""
    if [ "$net" = down ]; then
      verdict=noreach detail="this machine cannot reach Discord (HTTP $net_status on the unauthenticated /gateway), so nothing can be said about any bot; behind a proxy, check HTTPS_PROXY"
    elif [ -z "$tok" ] || ! is_id "$ch"; then
      verdict=unknown detail="no token or channel in $d"
    else
      # A bot's own user id never changes, so it is asked for once and kept
      # in the state dir: that is one fewer HTTP call
      # AND one fewer jq per bot per run, for a fact that was already known.
      # A cached value is trusted only if it looks like an id.
      me=$(cat "$d/bot-id" 2>/dev/null) || me=""
      if ! is_id "$me" || [ $((now_s - dn_s)) -ge 86400 ]; then
        api users/@me
        nme="" nn=""
        l=$(printf '%s' "$resp" | jq -r 'objects | [(.id // "" | tostring), (.username // "" | tostring | gsub("[[:cntrl:]]"; ""))] | join("\u001f")' 2>/dev/null) || l=""
        IFS=$'\x1f' read -r nme nn <<<"$l" || :
        if ! is_id "$me" && is_id "$nme"; then me=$nme; printf '%s\n' "$me" > "$d/bot-id" 2>/dev/null || :; fi
        # A read that fails keeps the name it had, and is tried again in an hour, not at every run.
        if is_id "$nme" && [ -n "$nn" ]; then dname=$nn; printf '%s %s\n' "$now_s" "$dname" > "$d/discord-name" 2>/dev/null || :
        elif [ -n "$dname" ]; then printf '%s %s\n' "$((now_s - 82800))" "$dname" > "$d/discord-name" 2>/dev/null || :; fi
      fi
      if ! is_id "$me"; then
        # 401 and 403 mean the credential itself was refused. Anything else
        # -- a timeout or DNS failure (000), a rate limit (429), a Discord
        # outage (5xx) -- is not the token's fault, and saying it is sends
        # someone to rotate a credential that was fine. Those are reported
        # as what they are and no bot is blamed.
        case $status in
          401|403) verdict=unreachable detail="Discord refused this bot's token (HTTP $status)";;
          429)     verdict=throttled detail="Discord is rate-limiting this bot (HTTP 429); nothing can be said about it this run";;
          *)       verdict=apierror detail="Discord did not answer for this bot (HTTP $status); the token was not rejected, so this is Discord's side or the network";;
        esac
      else
        api "channels/$ch/messages?limit=50"
        case $status in
          2*)      note_oldest "$resp";;
          401|403) verdict=unreachable detail="cannot read the channel (HTTP $status): the bot's channel permissions or its token";;
          429)     verdict=throttled detail="Discord is rate-limiting this bot (HTTP 429); nothing can be said about it this run";;
          *)       verdict=apierror detail="cannot read the channel (HTTP $status); the token was not rejected, so this is Discord's side or the network";;
        esac
        # Threads carry their own messages, and one request for the guild's
        # active threads answers with every thread's last_message_id, so a
        # thread is only READ when something in it is newer than the last id
        # the hooks recorded. Normally that is nothing at all. The
        # last_message_id comparison is done in the shell, on strings, for
        # the jq-1.6 precision reason above.
        if [ "$verdict" = ok ]; then
          # The guild a channel belongs to cannot change -- a channel is
          # created inside one guild and is deleted, not moved -- so this
          # whole request exists to learn one immutable fact. It is kept in
          # the state dir like bot-id, which is one fewer HTTP call AND one
          # fewer jq per bot per run.
          # The CHANNEL is stored beside the guild because the bot's channel
          # CAN change (access.json is edited to move it), and a cache keyed
          # on nothing would then answer for the old channel. A cached line
          # is used only when its channel is still this one and the guild
          # still looks like an id; anything else re-fetches and rewrites it.
          # Since 1.11.0 the NAME of the channel is kept there too (the TUI's channel column), and a name can change,
          # so the line is read again once it is a day old (its fourth field is when it was read): one call a day per
          # bot, and the jq that read the guild reads both. A line with no age (an older version's) is read once.
          # A read that fails keeps the line as it is: the guild in it is still right. Two steps, since bash 3.2
          # misreads a quoted jq program inside "$( )" inside double quotes. "-" stands for a missing guild or name,
          # so no field is empty (a tab is IFS whitespace) and the line always has four words.
          # Since 1.11.1 the daily read is the guild's channel list (guild_names), which has the name of every channel
          # of the bot and costs the same one call. The channel itself is asked only for what the list cannot give: the
          # guild, the first time ever (two calls, once), and the main name on a day the list fails.
          had=$gid
          if ! is_id "$gid" || { [ $((now_s - cat_s)) -ge 86400 ] && ! guild_names; }; then
            api "channels/$ch"
            cg=$(printf '%s' "$resp" | jq -r '[(.guild_id // "-" | tostring), (.name // "" | tostring | gsub("[[:space:][:cntrl:]]+"; "-") | if . == "" then "-" else . end)] | @tsv' 2>/dev/null) || cg=""
            ngid="" nname=""
            IFS=$'\t' read -r ngid nname <<<"$cg" || :
            if is_id "$ngid"; then
              gid=$ngid cname=$nname
              printf '%s %s %s %s\n' "$ch" "$gid" "$cname" "$now_s" > "$d/channel-guild" 2>/dev/null || :
              [ "$cname" != - ] || cname=""
            elif is_id "$had"; then
              # Both reads failed (Discord answers for messages but not for these): the line is kept, guild and name,
              # and only its age is set to an hour short of a day, so the next try is in an hour, not at every run
              # (two calls per bot every 5 minutes for as long as it lasts).
              printf '%s %s %s %s\n' "$ch" "$gid" "${cname:--}" "$((now_s - 82800))" > "$d/channel-guild" 2>/dev/null || :
            fi
            is_id "$had" || ! is_id "$gid" || guild_names || :
          fi
          if is_id "$gid"; then
            api "guilds/$gid/threads/active"
            for t in $(printf '%s' "$resp" | jq -r --arg c "$ch" '
                  (.threads // []) | .[] | select((.parent_id // "") == $c)
                  | [(.id // ""), (.last_message_id // "0")] | @tsv' 2>/dev/null |
                  while IFS=$'\t' read -r tid tlast; do
                    is_id "$tid" || continue
                    case $tlast in (''|*[!0-9]*) tlast=0;; esac   # (: bash 3.2 ends $( ) at a bare )
                    id_newer "$tlast" "$floor" && printf '%s\n' "$tid"
                  done); do
              api "channels/$t/messages?limit=50"
              case $status in 2*) note_oldest "$resp";; *) continue;; esac
            done
          fi
        fi
      fi
    fi

    # $oldest is already known to be newer than last-message-id (both the
    # channel and the thread filters require it), so there is nothing left
    # to compare here.
    if [ "$verdict" = ok ] && [ -n "$oldest" ]; then
      age=$(( (now_s - $(snowflake_s "$oldest")) / 60 ))
      if [ "$age" -ge "$stale_min" ]; then
        # `session_working; working=$?` would be fatal: the script runs under
        # `set -e`, and a non-zero exit from a command that is neither last
        # nor in a condition aborts it -- silently, since health prints as it
        # goes (measured: the whole check died with no output). `&&`/`||`
        # makes it a tested command, which set -e allows.
        working=1
        [ -z "$turn" ] || { session_working "$bot" && working=0 || working=$?; }
        # A run that could not tell is counted, with the time of the first of
        # the streak; a run that could resets both. Past the cap (so many
        # runs AND so long since the first) the hold is given up and the
        # not-knowing is itself the finding: `claude agents` failing
        # repeatedly means the daemon is unwell, which is exactly when a bot
        # breaks. health-unknown holds "<count> <epoch of the first>"; a file
        # of before 1.12.0 holds the count only, and its streak starts now.
        if [ "$working" = 2 ]; then
          # Checked and stripped of leading zeros BEFORE the arithmetic (see cat_s above): what is no count starts at 0,
          # and what is no time of the past is now.
          unknowns="" first=""
          { read -r unknowns first < "$d/health-unknown"; } 2>/dev/null || :
          case $unknowns in ''|*[!0-9]*) unknowns=0 first="";; esac
          case $first in ''|*[!0-9]*) first=$now_s;; esac
          unknowns=${unknowns#"${unknowns%%[!0]*}"}; unknowns=$(( ${unknowns:-0} + 1 ))
          first=${first#"${first%%[!0]*}"}; [ "${first:-0}" -le "$now_s" ] || first=$now_s
          first=${first:-0}
          printf '%s %s\n' "$unknowns" "$first" > "$d/health-unknown" 2>/dev/null || :
        else
          unknowns=0
          [ ! -f "$d/health-unknown" ] || unlink "$d/health-unknown" 2>/dev/null || :
        fi
        if [ "$working" = 2 ] && [ "$unknowns" -ge "$unknown_cap" ] && [ $((now_s - first)) -ge "$unknown_min_s" ]; then
          verdict=nostate detail="unanswered for ${age}m and 'claude agents' has not answered for $unknowns runs, so whether a turn is running cannot be told; the daemon itself may be unwell"
        elif [ -n "$turn" ] && { [ "$turn" -lt "$turn_max_min" ] || [ "$working" != 1 ]; } &&
             [ "$age" -lt "$busy_cap_min" ]; then
          verdict=busy detail="a turn has been in flight ${turn}m; holding the finding"
          case $working in
            0) detail="$detail (the session is running one now)";;
            2) detail="$detail (run $unknowns with no answer from 'claude agents', for $(( (now_s - first) / 60 ))m; a finding after $unknown_cap runs and $((unknown_min_s / 60))m)";;
          esac
        else
          verdict=stale
          case $servers in
            0)       detail="no plugin server: the bot is down";;
            1)       detail="the plugin server is up, so its hooks or its turn are stuck";;
            unknown) detail="cannot count plugin servers on this machine";;
            *)       detail="$servers plugin servers: two sessions share this bot's token";;
          esac
          detail="unanswered for ${age}m -- $detail"
          [ -z "$turn" ] || detail="$detail; a turn file has sat there ${turn}m"
          [ "$age" -lt "$busy_cap_min" ] || [ "$working" = 1 ] ||
            detail="$detail; the session still claims to be working, but ${busy_cap_min}m unanswered is too long to keep holding"
        fi
      fi
    fi
    # A duplicate is worth saying even when the bot is answering: both
    # sessions answer, so the channel gets every reply twice.
    if [ "$verdict" = ok ] && [ "$servers" != unknown ] && [ "$servers" -gt 1 ]; then
      verdict=duplicate detail="$servers plugin servers share this bot's token"
    fi
    # No server and nothing waiting to be answered: still down, and worth
    # naming before someone writes into a channel nobody is listening on.
    if [ "$verdict" = ok ] && [ "$servers" = 0 ]; then
      verdict=down detail="no plugin server for this bot"
      case $refresh_tail in *'not trusted'*) detail="$detail; its last refresh failed on workspace trust";; esac
      [ "$trusted" != false ] || detail="$detail; this project is not trusted, so a --bg start will refuse"
    fi

    rows=$rows$bot$'\x1f'$verdict$'\x1f'$detail$'\x1f'$servers$'\x1f'${turn:-}$'\x1f'
    rows=$rows${oldest:-}$'\x1f'$last_seen$'\x1f'${age:-0}$'\x1f'$refresh_tail$'\x1f'$trusted$'\x1f'
    # 1.11.0, for the TUI: the channel and its cached name, the second the last message handed to the session was made
    # (the snowflake of last-message-id, as snowflake_s reads one, with no fork; empty when there is none) and the
    # access policy. The monitor carries them into state.json.
    lm=""
    [ "$last_seen" = 0 ] || { lm=${last_seen#"${last_seen%%[!0]*}"}; lm=$(( ((${lm:-0} >> 22) + 1420070400000) / 1000 )); }
    is_id "$ch" || ch=""
    rows=$rows$ch$'\x1f'$cname$'\x1f'$lm$'\x1f'$access$'\x1f'$names$'\x1f'$mode$'\x1f'$dname$'\x1f'


    line="claude-discord health: $bot $verdict${detail:+ -- $detail}"
    # Not under --all (--nolog): at a monitor's 5-minute cadence both would grow without bound.
    if [ "$nolog" = no ]; then
      printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line" >> "$d/health.log" 2>/dev/null || :
      # journal too, because the log above lives in the state dir of a bot
      # whose whole problem may be that nobody is looking at it.
      ! command -v logger >/dev/null 2>&1 || logger -t claude-discord-health -- "$line" 2>/dev/null || :
    fi

    [ "$as_json" = yes ] || echo "$line"
  done
  # One jq for the whole run: it reads the NUL-separated fields, groups them
  # seventeen at a time into objects, prints them when asked, and reports through
  # its exit status whether anything needs a human -- so a caller can tell
  # without parsing anything. `busy` is not a
  # finding. No bots at all is an empty list, which is "nothing wrong".
  # The findings flag goes on its own LAST line, so what precedes it stays
  # exactly the JSON a caller would parse; the shell strips that line off
  # before printing. A marker merged into the document would corrupt the one
  # thing --json exists to produce. The document comes out already indented
  # (-r prints only a string raw), so printing it needs no second jq.
  rows=$(printf '%s' "$rows" | jq -rRs --argjson show "$([ "$as_json" = yes ] && echo true || echo false)" --arg owner "${DISCORD_USER_ID:-}" '
    [ splits("\u001f") ] | .[:-1]
    | [ range(0; length; 17) as $i
        # 1.11.1: the kept "<id> <name>" lines, as a name per id for the groups of `access`.
        | (.[$i+14] | split("\n") | map(select(. != "") | split(" ") | {key: .[0], value: (.[1] // "")}) | from_entries) as $n
        | { bot: .[$i], verdict: .[$i+1], detail: .[$i+2], servers: .[$i+3],
            turn_min: .[$i+4], oldest_unanswered: .[$i+5], last_seen: .[$i+6],
            unanswered_min: (.[$i+7] | tonumber? // 0), refresh_tail: .[$i+8],
            trusted: .[$i+9], owner_id: $owner,
            channel: .[$i+10], channel_name: .[$i+11],
            last_message_at: ((.[$i+12] | tonumber? // null) | if . == null then null else todate end),
            mode: .[$i+15], discord_name: (.[$i+16] | if . == "" then null else . end),
            access: (.[$i+13] | (try fromjson catch null) | if type == "object" then .groups |= map(. + {name: ($n[.id] // "")}) else . end) } ]
    | (if $show then . else empty end),
      (if all(.[]; .verdict == "ok" or .verdict == "busy") then "ok" else "finding" end)
    ' 2>/dev/null) || rows=finding
  verdicts=${rows##*$'\n'}
  if [ "$as_json" = yes ] && [ "$rows" != "$verdicts" ]; then
    printf '%s\n' "${rows%$'\n'*}"
  fi
  [ "$verdicts" = ok ] || exit 1
  exit 0
fi

# untrusted: this project's workspace trust is an explicit false in ~/.claude.json, so a `claude --bg` start here would
# refuse ("Workspace not trusted"). Fail-open: no file, no jq, no key all read as trusted (refresh, below, says why).
# `// "unset"` would be wrong: jq's `//` treats FALSE as empty, so the one value this checks for could never be seen.
untrusted() {
  command -v jq >/dev/null 2>&1 &&
    [ "$(jq -r --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted | if . == null then "unset" else tostring end' "$HOME/.claude.json" 2>/dev/null)" = false ]
}
# live_sessions <name> <bot dir>: "<job id or -> <pid or ->" for each session of the bot started in this project, by its
# name or by its job record (refresh, below, says why both). Exit 1 when `claude agents --json` fails or gives no list:
# what runs is then unknown, which is not "nothing runs".
live_sessions() {
  local jobs agents
  jobs=$(grep -lF -- "DISCORD_STATE_DIR\\\": \\\"$2\\\"" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/jobs/*/state.json 2>/dev/null) || jobs=""
  jobs=$(printf '%s\n' "$jobs" | sed -n 's#.*/\([^/]*\)/state\.json$#\1#p')
  agents=$(claude agents --json 2>/dev/null) && printf '%s' "${agents:-null}" | jq -r --arg n "$1" --arg jobs "$jobs" --arg cwd "$(pwd -P)" '
      ($jobs | split("\n")) as $j |
      if type != "array" then error("not a list") else
        .[] | select((.name == $n or (.id as $i | any($j[]; . == $i))) and .cwd == $cwd and (.id != null or .pid != null))
        | "\(.id // "-") \(.pid // "-")" end' 2>/dev/null
}
# stop_sessions <name> <live_sessions' lines>: each stopped, a background one by `claude stop <id>`, a foreground one by
# TERM (what closing its terminal sends); then up to 10 s for their pids to go, then 3 s for the gateway to let the token
# go. Exit 1, the pids still running in `alive`, when one would not die: a start then would put two sessions on one token.
stop_sessions() {
  local id pid
  pids=()
  while read -r id pid; do
    [ -n "$id" ] || continue
    echo "claude-discord: stopping $1 ($id, pid $pid)"
    if [ "$id" != - ]; then
      claude stop "$id" || echo "claude-discord: stop $id failed (already gone?)" >&2
    else
      kill -TERM "$pid" 2>/dev/null || :
    fi
    [ "$pid" = - ] || pids+=("$pid")
  done <<<"$2"
  # A stop that did not take leaves two sessions on one token, so wait for
  # every old pid to go before starting anything; a session that will not die
  # is reported, not raced.
  for _ in $(seq 20); do
    alive=()
    for pid in ${pids[@]+"${pids[@]}"}; do kill -0 "$pid" 2>/dev/null && alive+=("$pid") || :; done
    [ ${#alive[@]} -gt 0 ] || break
    sleep 0.5
  done
  [ ${#alive[@]} = 0 ] || return 1
  # The stopped session's channel server needs a moment to release the token;
  # a fresh gateway login while the old one is still up gets both dropped.
  [ -z "$2" ] || sleep 3
}
# start_fresh <wrapper> <name> <bot dir> <claude args>...: the bot started in the background (`--bg --name`), from this
# project; the launch folds handoff.md into its prompt and moves it to handoff.prev.md BEFORE claude starts, so a start
# that fails puts it back (a retry would else find none): only a handoff THIS start had, never one an earlier start left
# in handoff.prev.md, which would hand the next session a stale one. Its exit status is the start's; put_back=1 when the
# handoff was put back.
start_fresh() {
  local had=no rc=0
  put_back=""
  [ ! -s "$3/handoff.md" ] || had=yes
  "$1" --bg --name "$2" "${@:4}" || rc=$?
  if [ "$rc" != 0 ] && [ "$had" = yes ] && [ ! -s "$3/handoff.md" ] && [ -s "$3/handoff.prev.md" ]; then
    mv "$3/handoff.prev.md" "$3/handoff.md" && put_back=1 || :
  fi
  return "$rc"
}

# A long-running session answers worse as its context fills, and the automatic
# compaction near the limit summarises at the point the model is least able to
# judge what matters. `refresh` replaces the session on purpose while it can
# still choose well: the session writes handoff.md (the hook tells it how), then
# runs this. A session cannot replace itself, so the work is handed to a
# detached child that outlives the session's own shell:
#   1. refuse unless handoff.md is there (--force skips that, for a wedged session)
#   2. stop the running session(s) registered under this bot's name
#   3. start a fresh one in the background; the launch path below folds
#      handoff.md into its system prompt and moves it aside
# Stop before start, never the reverse: two sessions on one token both answer.
# The gap between them loses whatever arrives in it; the fresh session is told
# to catch up from the channel history.
if [ "${1:-}" = refresh ]; then
  shift
  # The name is kept out of the claude args so the launch below can be given
  # it explicitly, whether it came from the command line or from the
  # environment: with two bots in the project the launcher cannot guess.
  force=no; fresh=() name="" skip=0
  for a in "$@"; do
    # A flag's value never starts with "-": after one whose value is optional
    # (--debug, --worktree) the next word may be the next flag.
    if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) fresh+=("$a"); continue;; esac; fi
    case $a in
      --force) force=yes;;
      -n|--name|--name=*) echo "claude-discord: the session is named after the bot; drop $a" >&2; exit 2;;
      -*) fresh+=("$a"); takes_value "$a" && skip=1 || :;;
      *)  if [ -z "$name" ]; then name=$a; else fresh+=("$a"); fi;;
    esac
  done
  # This script is re-run twice below (the detached child, then the launch),
  # and the cd that follows would break a relative `./claude-discord`.
  case $0 in /*) self=$0;; *) self=$PWD/$0;; esac
  # The session runs this from its own Bash, whose cwd has usually wandered
  # off the project by now. Its environment still says where the state is
  # (DISCORD_STATE_DIR is set at launch), so go back to that project; a shell
  # outside any session gives the directory the usual way, by standing in it.
  if [ -n "${DISCORD_STATE_DIR:-}" ]; then
    [ -n "$name" ] || name=$(basename "$DISCORD_STATE_DIR")
    cd "$(dirname "$(dirname "$(dirname "$DISCORD_STATE_DIR")")")"
    root=$PWD/.claude/discord-agents
  fi
  [ -n "$name" ] || { echo "usage: claude-discord refresh <name> [--force] [claude args]" >&2; exit 2; }
  case $name in ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;; esac
  dir=$root/$name
  [ -f "$dir/.env" ] || { echo "claude-discord: no bot '$name' under $root" >&2; exit 1; }
  if [ "$force" = no ] && [ ! -s "$dir/handoff.md" ]; then
    echo "claude-discord: $dir/handoff.md is missing or empty; write it first, or pass --force to replace the session without one" >&2
    exit 1
  fi
  # `claude --bg` refuses to start in a workspace whose trust has never been
  # accepted, and the foreground path does not: measured 2026-09-25, a --bg
  # start in an unregistered directory exits 1 with "Workspace not trusted".
  # A bot started in a terminal and moved to the background with /bg
  # therefore never meets that gate, and can run for weeks with the trust
  # unaccepted -- until a refresh stops it and cannot start its replacement.
  # That is how a bot here was down for 22 hours. So the trust flag is read
  # BEFORE anything is stopped. Fail-OPEN on purpose: anything but an
  # explicit `false` (no file, no jq, no such project key, a future Claude
  # Code that keeps trust elsewhere) proceeds exactly as before, because a
  # check that misreads would otherwise block a refresh that would have
  # worked. --force says "do it anyway", here as everywhere else.
  # `// "unset"` would be wrong here: jq's `//` treats FALSE as empty, so
  # `false // "unset"` is "unset" and the one value this checks for could
  # never be seen (measured). An explicit null test is the only correct form.
  if [ "$force" = no ] && untrusted; then
    echo "claude-discord: $PWD is not a trusted workspace, so the fresh --bg session would refuse to start and $name would be left down." >&2
    echo "claude-discord: run 'claude' here once and accept the trust prompt, then retry; --force refreshes anyway." >&2
    exit 1
  fi
  if [ "${CLAUDE_DISCORD_REFRESH_CHILD:-}" != 1 ]; then
    # Re-run this same command detached: `claude stop` below kills the session
    # that is very likely running us, and its whole process group with it.
    # perl's setsid rather than setsid(1): macOS ships perl but no setsid.
    export CLAUDE_DISCORD_REFRESH_CHILD=1
    # One generation of the log kept aside, as handoff.prev.md is. The child's
    # `>` truncates refresh.log, and an outage is usually met with a second
    # refresh minutes after the first: that run would erase the only record of
    # what the first one did, which is the question this log exists to answer
    # afterwards (measured on DY-DevBot, 2026-10-07: a 21:14 --force left
    # nothing of the 21:12 attempt).
    [ ! -f "$dir/refresh.log" ] || mv -f "$dir/refresh.log" "$dir/refresh.prev.log" 2>/dev/null || :
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- nohup "$self" refresh "$@" > "$dir/refresh.log" 2>&1 < /dev/null &
    echo "claude-discord: refreshing $name in the background; progress in $dir/refresh.log"
    exit 0
  fi
  # Sessions are registered under the name the wrapper gave them (-n) and the
  # directory they were started in; another project's bot of the same name is
  # not ours. A renamed one (/rename) is still found by its job record: every
  # background launch passes --settings naming this bot's DISCORD_STATE_DIR,
  # and the daemon keeps that in jobs/<id>/state.json's respawnFlags. A child
  # session started from the bot's shell only inherits the variable, so it
  # is never matched this way. Every live match is stopped, not one: a copy
  # left running is the two-sessions-on-one-token this exists to prevent. A background session has an id for `claude stop` (its pid may be
  # null while it is blocked, so the id decides); a foreground one has only a
  # pid, and SIGTERM is what closing its terminal would send. A listing that
  # fails or is not an array says nothing about what is running, which is not
  # the same as "nothing is": --force may not paper over it.
  if ! live=$(live_sessions "$name" "$dir"); then
    echo "claude-discord: 'claude agents --json' failed, so what is running is unknown; refusing to start a second session" >&2
    exit 1
  fi
  if [ -z "$live" ]; then
    # Nothing to stop means either the bot is down or it is running somewhere
    # this cannot see (started under another name, or from another directory).
    # Starting a second session in the latter case puts two on one token, so
    # refuse unless told otherwise.
    if [ "$force" = no ]; then
      echo "claude-discord: no running session of $name (by name or by its job record) started in $PWD; it may be down, or running under another name. 'claude agents' lists them; pass --force to start a fresh one anyway" >&2
      exit 1
    fi
    echo "claude-discord: no running session named $name found; starting a fresh one (--force)"
  fi
  if ! stop_sessions "$name" "$live"; then
    echo "claude-discord: session $name still running after stop (pid ${alive[*]}); not starting another. Stop it by hand, then run 'claude-discord refresh $name --force'" >&2
    exit 1
  fi
  echo "claude-discord: starting $name"
  unset CLAUDE_DISCORD_REFRESH_CHILD   # the fresh session's own refresh must fork again
  # A first turn, or the fresh session sits idle until the next message and
  # whoever asked for the refresh sees nothing happen. A prompt given on the
  # command line (a bare word after the name) is that first turn instead.
  kickoff=("Catch up on the channel and continue from your handoff.")
  skip=0
  for a in ${fresh[@]+"${fresh[@]}"}; do
    if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) continue;; esac; fi
    case $a in -*) takes_value "$a" && skip=1 || :;; *) kickoff=();; esac
  done
  # NOT exec: the launch path below consumes handoff.md (it folds it into the
  # system prompt and renames it handoff.prev.md) BEFORE it starts claude, so
  # a start that fails leaves the handoff gone from the path a retry looks at
  # -- and a retry without --force then refuses because handoff.md is
  # missing. That happened here: a --bg start refused on workspace trust and
  # took the handoff with it. Running it as a child instead means there is
  # still a shell to put the file back. `claude --bg` returns as soon as the
  # session is backgrounded (measured: 0 s), so waiting for it costs nothing
  # and a non-zero status is a real launch failure.
  rc=0; start_fresh "$self" "$name" "$dir" ${fresh[@]+"${fresh[@]}"} ${kickoff[@]+"${kickoff[@]}"} || rc=$?
  [ -z "$put_back" ] || echo "claude-discord: start failed, so $name's handoff was put back; fix the error above and run 'claude-discord refresh $name'" >&2
  exit "$rc"
fi

if [ "${1:-}" = patch ]; then
  crc=0; [ "${2:-}" != --compat ] || compat_if_stale || crc=1
  patch_official || crc=1; exit "$crc"
fi

# host_id: prints this HOME's id, ~/.claude-discord/host-id (one line: 32 lower-case hex digits, random), making it when
# it is missing. It names a home, not a machine: what a monitor pass reads on a host is that home's records/projects,
# so two ledger lines that reach one home (a container and its host sharing $HOME, two ssh aliases of one account)
# would report every bot of it twice. `hosts add` compares it. Made once: the id is written to a temp file and
# hard-linked in, and ln fails when the name is there, so of two first calls at once one wins and both print the
# winner's. A file that is there but holds no id (cut off, hand-edited) is replaced.
hid_re='^[0-9a-f]{32}$'   # what a host-id is
# What travels in a watcher record: a manager bot's name that can be a file name on another machine and a bare word of
# an ssh command line, and an ssh alias as `hosts` takes one.
mgr_re='^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}$' alias_re='^[A-Za-z0-9._@][A-Za-z0-9._@-]{0,254}$'
# c_match <string> <regex>: the match in the C locale, where A-Z, a-z and 0-9 are those ASCII characters and no other
# (in a UTF-8 locale a range also takes accented and fullwidth letters, by the locale's collation). For what must be
# plain: a host-id, a manager's name, an ssh alias, an env KEY. The locale is this function's own: the rest of the
# script keeps the user's (a display name is counted in its characters).
c_match() { local LC_ALL=C; [[ $1 =~ $2 ]]; }
host_id() {
  local f=$helpers/host-id id=""
  { read -r id < "$f"; } 2>/dev/null || :
  if ! c_match "$id" "$hid_re"; then
    mkdir -p "$helpers" || return 1
    (umask 077; id=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n') && printf '%s\n' "$id" > "$f.tmp.$$") || { rm -f "$f.tmp.$$"; return 1; }
    if ! ln "$f.tmp.$$" "$f" 2>/dev/null; then
      # The name is taken: by another first call's id (kept: read below), or by a file that is no id (replaced).
      id=""; { read -r id < "$f"; } 2>/dev/null || :
      c_match "$id" "$hid_re" || mv -f "$f.tmp.$$" "$f" || :
    fi
    rm -f "$f.tmp.$$"
    id=""; { read -r id < "$f"; } 2>/dev/null || :
    c_match "$id" "$hid_re" || return 1
  fi
  printf '%s\n' "$id"
}

# What `access --host` runs on another machine (1.13.0): `--version --access <hex of the project> <hex of the bot> ...` is
# `access --project <project> -- <bot> ...` here. Behind --version for the reason --host-id is (below): an older
# claude-discord prints its version line and exits. Hex, so that no name or path has to survive a remote shell.
if [ "${1:-}" = --version ] && { [ "${2:-}" = --access ] || [ "${2:-}" = --bot ]; }; then
  c_match "${3:-}" '^([0-9a-f][0-9a-f]){1,1024}$' && c_match "${4:-}" '^([0-9a-f][0-9a-f]){1,255}$' || exit 2
  a_unhex() { local h=$1 o=""; while [ -n "$h" ]; do o="$o\\x${h:0:2}"; h=${h:2}; done; printf "$o"; }
  set -- "${2#--}" --project "$(a_unhex "$3")" -- "$(a_unhex "$4")" "${@:5}"
fi
# self_root is already the real clone (a link resolved through readlink and pwd -P).
if [ "${1:-}" = --version ]; then
  echo "claude-discord $(plugin_version "$self_root") ($(git -C "$self_root" rev-parse --short HEAD 2>/dev/null || echo nogit))"
  # What `hosts add` asks another machine over ssh (1.12.0). It rides on --version because a claude-discord before
  # 1.12.0 prints the line above and exits whatever follows, while any new verb would be read there as a bot name
  # and reach the launcher.
  # watchers/<manager>, on a checked host: "<host-id of the manager's home> <its alias for this host> <UTC time>", one
  # line, written when that manager's `hosts add` took this host and removed by its `hosts rm`. The words arrive over
  # ssh from another machine, so each is matched before a file name is made from one.
  wd=$helpers/watchers
  case ${2:-} in
    --host-id)
      id=$(host_id) || exit 1; echo "host-id $id"
      for f in "$wd"/*; do
        [ -f "$f" ] && c_match "${f##*/}" "$mgr_re" || continue
        w=""; { read -r w < "$f"; } 2>/dev/null || :
        echo "watcher ${f##*/} ${w//[[:cntrl:]]/}"
      done;;
    --watch)   # <manager> <the host-id of its home> <its alias for this host>
      c_match "${3:-}" "$mgr_re" && c_match "${4:-}" "$hid_re" && c_match "${5:-}" "$alias_re" || exit 2
      id=$(host_id) || exit 1
      [ "$id" != "$4" ] || exit 1   # this very home: it is checked through `local`, never through an alias
      (umask 077; mkdir -p "$wd" && printf '%s %s %s\n' "$4" "$5" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$wd/.$3.$$" && mv -f "$wd/.$3.$$" "$wd/$3") || exit 1
      echo "watched $3";;
    --unwatch)   # <manager> <the host-id of its home>: only the record that home wrote
      c_match "${3:-}" "$mgr_re" && c_match "${4:-}" "$hid_re" || exit 2
      w=""; { read -r w rest < "$wd/$3"; } 2>/dev/null || :
      [ "$w" != "$4" ] || rm -f "$wd/$3"
      echo "unwatched $3";;
  esac
  exit 0
fi

# update: fast-forwards the clone this command runs from, or with --all every
# recorded install, then re-patches the official plugin and refreshes the shim.
# A link resolves to the clone behind it (cd -P), so the clones that many links
# share are pulled once. Running sessions keep the code they loaded until
# /reload-plugins.
if [ "${1:-}" = update ]; then
  case ${2:-} in ''|--all) ;; *) echo "usage: claude-discord update [--all]" >&2; exit 2;; esac
  clones=("$self_root") rc=0
  if [ "${2:-}" = --all ]; then
    clones=() seen=$'\n'
    prune_installs   # a project removed since setup drops out here
    if [ -f "$helpers/records/installs" ]; then
      while IFS= read -r c || [ -n "$c" ]; do
        c=$(cd -P "$c" 2>/dev/null && pwd -P) || continue
        case $seen in *$'\n'"$c"$'\n'*) continue;; esac
        seen="$seen$c"$'\n'
        clones+=("$c")
      done < "$helpers/records/installs"
    fi
    [ "${#clones[@]}" -gt 0 ] || echo "claude-discord: no recorded install to update"
  fi
  for c in ${clones[@]+"${clones[@]}"}; do
    # A clone checked out at a tag or sha is pinned on purpose: skipped, not a failure.
    git -C "$c" symbolic-ref -q HEAD >/dev/null 2>&1 || { echo "claude-discord: $c: pinned at $(git -C "$c" rev-parse --short HEAD 2>/dev/null || echo '?'), skipped"; continue; }
    old=$(plugin_version "$c")
    git_net -C "$c" pull -q --ff-only || { echo "claude-discord: $c: pull failed (local changes, diverged, or no network)" >&2; rc=1; continue; }
    echo "claude-discord $c: $old -> $(plugin_version "$c")"
  done
  # The patch step and the shim come from the freshly pulled code, run as a
  # new process (this one still holds the old functions). runtime/ and the
  # patched cache are machine-wide, so the machine's source clone owns them;
  # without one, the first clone pulled (or this one).
  new=$self_root
  [ -x "$helpers/source/bin/claude-discord" ] && new=$helpers/source || { [ "${#clones[@]}" -eq 0 ] || new=${clones[0]}; }
  "$new/bin/claude-discord" patch || rc=1
  # compat arrived in 1.8.0: older code would read the word as a bot name.
  if ver_ge "$(plugin_version "$new")" 1.8.0; then
    "$new/bin/claude-discord" compat || rc=1
  else
    echo "claude-discord: $new is at $(plugin_version "$new"), before the compat copy (1.8.0); ~/.claude-discord/hooks left as it is"
  fi
  mkdir -p "$HOME/.local/bin"
  cmp -s "$new/shim/claude-discord" "$HOME/.local/bin/claude-discord" ||
    install -m 755 "$new/shim/claude-discord" "$HOME/.local/bin/claude-discord" ||
    { echo "claude-discord: could not install the shim from $new" >&2; rc=1; }
  echo "claude-discord: run /reload-plugins in running sessions (a bot: the self-reload skill)"
  exit "$rc"
fi

# hosts: lists and edits a manager bot's hosts ledger (<bot dir>/hosts; write_hosts above has its format), for people,
# scripts and the TUI, which changes the ledger through this verb only. It never prints the value of a KEY=VALUE word
# (a proxy URL may hold a password): key names only.
# Exit status: 0 done (a warning goes to stderr), 1 it could not (no manager bot with a ledger, a failed write, the
# ledger locked by another writer for 5 s), 2 usage or a word that is not allowed (never echoed), 3 the alias is already in the
# ledger (add) or is not in it (set, laptop, rm), 4 add refused: the host is the same home as one already checked,
# 5 not added: the host did not answer or has no claude-discord (--no-probe adds it unchecked).
# h_manager <verb> <its flag that names the manager>: which manager bot's ledger a verb acts on (hosts, and access --host).
# In the project above the cwd: its dev-manager bots that have a ledger (only the one named, with
# --bot); none there: the same among the recorded projects (records/projects), as `tui` and `monitor` find theirs.
# Exactly one must be left. This verb never asks (the TUI and scripts run it): it names the candidates and exits 2.
# Uses hb (the manager named, or empty); sets hd (its bot dir), hb and hf (its ledger).
h_manager() {
  h_cands="" h_n=0
  h_scan() {  # $1 = a project root: its manager bots with a ledger go into h_cands (one bot dir a line), each once
    local d m
    for d in "$1"/.claude/discord-agents/*/; do
      d=${d%/}; m=""
      [ -f "$d/hosts" ] || continue
      { read -r m < "$d/mode"; } 2>/dev/null || :
      [ "$m" = dev-manager ] || continue
      [ -z "$hb" ] || [ "$hb" = "${d##*/}" ] || continue
      case $'\n'$h_cands in *$'\n'"$d"$'\n'*) continue;; esac
      h_cands=$h_cands$d$'\n'; h_n=$((h_n + 1))
    done
  }
  hp=$(pwd -P)   # physical, as records/projects holds its paths
  while [ ! -d "$hp/.claude/discord-agents" ] && [ -n "$hp" ]; do hp=${hp%/*}; done
  h_scan "$hp"
  if [ "$h_n" = 0 ] && [ -f "$helpers/records/projects" ]; then
    while IFS= read -r p || [ -n "$p" ]; do
      p=${p%$'\r'}
      [ -z "$p" ] || h_scan "$p"
    done < "$helpers/records/projects"
  fi
  [ "$h_n" != 0 ] || { echo "claude-discord: $1: no dev-manager bot${hb:+ '$hb'} with a hosts ledger in the project above $PWD or in a recorded one (claude-discord setup <bot> --mode writes the ledger)" >&2; exit 1; }
  [ "$h_n" = 1 ] || { echo "claude-discord: $1: $h_n manager bots have a ledger; name one with $2 <manager>, in its project when two share a name:" >&2; printf '%s' "$h_cands" | sed 's/^/  /' >&2; exit 2; }
  hd=${h_cands%$'\n'}; hb=${hd##*/}; hf=$hd/hosts
}
# h_ssh <alias> <remote command>: one ssh call as the monitor's pass makes it (BatchMode, ConnectTimeout=8, and after
# an exit 255 once more with ControlPath=none: a stale master refuses falsely), so a host is unreachable here when a
# pass would say so. "--" ends ssh's options: the alias can never be read as one. ConnectTimeout bounds the
# connection only, so the whole call is capped too (h_cap seconds, an integer from 1 to 300; no timeout(1) on macOS):
# ssh runs in its own process group under a perl parent (h_capped) that reads what it prints, both streams, through
# a pipe of its own, and ends, killing the group, when ssh has ended and what it wrote is read, at 65536 bytes (a
# host that prints megabytes), or at the cap (exit 142; a signal to it too, a closed terminal's HUP included).
# Never at the pipe's end alone: a process ssh leaves behind (a ControlPersist master, a ProxyCommand helper) holds
# it open for as long as it lives. Sets h_rc and h_out.
# h_out is what the host said, for h_ask: from the LAST line that reads as a version line to the end (so a banner
# before it, sshd's or the shell's, does not count), or with no such line the last line (ssh's own error); 4096
# bytes at most. It comes from another machine, so each line is first made safe to print: only printable ASCII and
# well-formed UTF-8 stay (no C0 control, DEL or stray byte), less the C1 controls and the bidi overrides and
# isolates (U+0080-009F, U+202A-202E, U+2066-2069: bash's [[:cntrl:]] misses them in the C locale), cut at 200 characters.
h_cap=${CLAUDE_DISCORD_PROBE_CAP:-20}
case $h_cap in ''|0*|*[!0-9]*|????*) h_cap=20;; esac
[ "$h_cap" -le 300 ] || h_cap=20
# The suite cannot wait a whole second for a hung probe: CLAUDE_DISCORD_PROBE_CAP_TENTHS (one digit, 1 to 9; read
# here only, not for users) is the cap in tenths of a second instead. Anything else leaves the cap above as it is.
case ${CLAUDE_DISCORD_PROBE_CAP_TENTHS:-} in [1-9]) h_cap=0.$CLAUDE_DISCORD_PROBE_CAP_TENTHS;; esac
h_capped='my ($cap, $max, $buf, $st) = (shift, $ENV{CD_RAW} ? 4194304 : 65536, "");
  pipe(my $r, my $w) or exit 127;
  my $pid = fork(); defined $pid or exit 127;
  if (!$pid) { setpgrp(0, 0); close $r; open(STDOUT, ">&", $w); open(STDERR, ">&", $w); close $w; exec { $ARGV[0] } @ARGV; exit 127 }
  setpgrp($pid, $pid); close $w;
  $SIG{ALRM} = $SIG{INT} = $SIG{TERM} = $SIG{HUP} = sub { kill "KILL", -$pid; exit 142 };
  if ($cap =~ /^\d+$/) { alarm $cap } else { require Time::HiRes; Time::HiRes::alarm($cap) }   # a fraction: the suite only
  my $rin = ""; vec($rin, fileno($r), 1) = 1;
  while (length($buf) < $max) {
    $st = $? if !defined $st && waitpid($pid, 1) == $pid;   # 1 is WNOHANG
    if (select(my $rout = $rin, undef, undef, defined $st ? 0 : 0.05) > 0) {
      next if sysread($r, $buf, $max - length($buf), length($buf));
      waitpid($pid, 0), $st = $? unless defined $st;   # the end of the pipe: ssh is ending
    }
    last if defined $st;
  }
  kill "KILL", -$pid;
  waitpid($pid, 0), $st = $? unless defined $st;
  if ($ENV{CD_RAW}) { print $buf; exit($st & 127 ? 128 + ($st & 127) : $st >> 8) }
  my ($ver, @l) = (0);
  for (split /\n/, $buf) {
    s/([\x20-\x7e]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xef][\x80-\xbf]{2}|\xf0[\x90-\xbf][\x80-\xbf]{2}|[\xf1-\xf4][\x80-\xbf]{3})|./defined $1 ? $1 : ""/ge;
    s/\xc2[\x80-\x9f]|\xe2\x80[\xaa-\xae]|\xe2\x81[\xa6-\xa9]//g;
    ($_) = /^((?:[\x00-\x7f]|[\xc2-\xf4][\x80-\xbf]*){0,200})/;
    next unless /\S/;
    push @l, $_; $ver = @l if /^ *claude-discord +\d+\.\d+\.\d+(?: |$)/;
  }
  print substr(join("\n", @l[($ver ? $ver : @l) - 1 .. $#l]), 0, 4096) if @l;
  exit($st & 127 ? 128 + ($st & 127) : $st >> 8)'
h_ssh() {
  local t; local -a o
  for t in first retry; do
    o=(); [ "$t" = first ] || o=(-o ControlPath=none)
    h_rc=0
    h_out=$(CD_RAW=${3:+1} perl -e "$h_capped" "$h_cap" ssh -o BatchMode=yes -o ConnectTimeout=8 ${o[@]+"${o[@]}"} -- "$1" "$2" </dev/null) || h_rc=$?
    [ "$h_rc" = 255 ] && [ "$t" = first ] || return 0
  done
}
if [ "${1:-}" = hosts ]; then
  shift
  h_usage="usage: claude-discord hosts [--bot <manager>] list [--json] | add [--no-probe|--dry-run] <alias> [laptop] [KEY=VALUE...] | set <alias> name=<display>|KEY=VALUE|KEY=... | set <alias> --stdin | laptop <alias> on|off | rm [--no-probe] <alias>"
  hb="" h_json="" h_probe=yes h_stdin="" h_dry="" h_flags="" hw=()
  while [ $# -gt 0 ]; do
    case $1 in
      --bot) [ $# -ge 2 ] || { echo "$h_usage" >&2; exit 2; }; hb=$2; shift;;
      --json) h_json=1 h_flags="$h_flags $1";;
      --no-probe) h_probe="" h_flags="$h_flags $1";;
      --stdin) h_stdin=1 h_flags="$h_flags $1";;
      --dry-run) h_dry=1 h_flags="$h_flags $1";;
      -*) echo "$h_usage" >&2; exit 2;;   # an ssh alias never starts with "-": ssh would read it as an option
      *) hw+=("$1");;
    esac
    shift
  done
  # A flag that means nothing for the verb is a usage error, not ignored: `rm --dry-run` would remove.
  case ${hw[0]:-} in list) h_ok=" --json ";; add) h_ok=" --no-probe --dry-run ";; set) h_ok=" --stdin ";; rm) h_ok=" --no-probe ";; *) h_ok=" ";; esac
  for w in $h_flags; do case $h_ok in *" $w "*) ;; *) echo "$h_usage" >&2; exit 2;; esac; done
  h_manager hosts --bot
  # h_alias <word>: an ssh alias as the monitor's pass takes one (a line whose first word is anything else is skipped
  # there): letters, digits and . _ @ - only, never a leading "-" (ssh would read it as an option), 255 at most. Or
  # exit 2. It is the word after the verb, and like any refused word it is never echoed, only where it stands and what
  # it must be: it may be a secret that landed in the wrong place (`hosts set KEY=secret <alias>`).
  h_alias() {
    c_match "$1" "$alias_re" || { echo "claude-discord: hosts: the alias (argument 2) is not an ssh alias: letters, digits, . _ @ -, not starting with -, 255 at most" >&2; exit 2; }
  }
  # h_word <where> <word>: a KEY=VALUE word (name=<display> too) that a ledger line can hold and the monitor will read,
  # or exit 2 naming <where> it stands ("argument 4", "line 2 of stdin") and the rule. Nothing of the word is echoed,
  # not its key either: a word that ends in "=" may be a token. A value holds no whitespace or control character (the
  # word would end there) and no quote (the ledger has no quoting: the quote would travel as part of the value). A
  # display name may hold any other character and is 40 at most, counted in the user's locale.
  h_word() {
    local k=${2%%=*} v=${2#*=}
    case $2 in *=*) ;; *) k="";; esac
    c_match "$k" '^[A-Za-z_][A-Za-z0-9_]{0,63}$' || { echo "claude-discord: hosts: $1 is not KEY=VALUE (KEY: letters, digits and _, not starting with a digit, 64 at most)" >&2; exit 2; }
    case $v in
      *[[:space:]]*|*[[:cntrl:]]*|*[\'\"]*) echo "claude-discord: hosts: $1: a value holds no space, control character or quote (a ledger word is not shell-quoted: write the value bare)" >&2; exit 2;;
    esac
    [ ${#v} -le 1024 ] || { echo "claude-discord: hosts: $1: a value is 1024 characters at most" >&2; exit 2; }
    [ "$k" != name ] || [ ${#v} -le 40 ] || { echo "claude-discord: hosts: $1: a display name is 40 characters at most" >&2; exit 2; }
  }
  # h_lock: one writer of the ledger at a time (a TUI save while `hosts set` runs would otherwise lose one of the two:
  # both read, then both write). flock through perl, as the monitor's lock, on <ledger>.lock: the lock stays with fd 7
  # of this shell after perl is gone, and the kernel drops it on any death, so it is never stale. 5 s of tries, then
  # exit 1. The ledger itself cannot be the lock: it is replaced by rename, so two writers would lock two files.
  # 6 is LOCK_EX | LOCK_NB, written out: loading Fcntl for the two names costs 3 ms of every write.
  h_lock() {
    exec 7>>"$hf.lock"
    perl -e 'open(my $l, ">&=", 7) or exit 1; for (1 .. 50) { exit 0 if flock($l, 6); select(undef, undef, undef, 0.1) } exit 1' ||
      { echo "claude-discord: hosts: $hf is being changed by another claude-discord hosts; nothing was changed" >&2; exit 1; }
  }
  # h_edit <alias> add|set|rm <word>...: the ledger read and written back under the lock, in one rename (ledger_write).
  # A line that is not <alias>'s keeps its bytes, CRLF included. Sets h_changed to the number of lines it changed.
  # add: <alias> must not be there (exit 3); the new line is the last.
  # set: on EVERY line of <alias> (two lines for one host: the monitor runs it twice and the second wins), each <word>
  #   in turn: "laptop on" makes laptop the second word (the one place the monitor reads it) and "laptop off" removes
  #   it from there; KEY=VALUE replaces the first KEY= word where it stands and drops any later one, or becomes the
  #   last word; KEY= removes them (name= is one more key here). The other words keep their place, the ones the
  #   monitor skips too. A changed line is written with one space between words and keeps its CRLF; a line that comes
  #   out the same keeps its bytes, and when none changes nothing is written.
  # rm: every line of <alias> goes, unless no host line would be left (exit 2). set and rm: exit 3 when <alias> has no line.
  h_edit() {
    local alias=$1 how=$2 out="" line cr hit=0 changed=0 others=0 op w k seen was i
    local -a words nw
    shift 2
    h_lock
    while IFS= read -r line || [ -n "$line" ]; do
      cr=""; case $line in *$'\r') cr=$'\r'; line=${line%$'\r'};; esac
      set -f; words=($line); set +f
      if [ "${words[0]:-}" != "$alias" ]; then
        out="$out$line$cr"$'\n'
        case ${words[0]:-} in ''|-*|*[!A-Za-z0-9._@-]*) ;; *) others=$((others + 1));; esac   # a host line, as the monitor's pass tells one
        continue
      fi
      hit=$((hit + 1))
      [ "$how" != add ] || { echo "claude-discord: hosts: $alias is already in $hf" >&2; exit 3; }
      if [ "$how" = rm ]; then changed=$((changed + 1)); continue; fi
      was=${words[*]}
      for op in "$@"; do
        nw=("${words[0]}")
        case $op in
          "laptop on"|"laptop off")
            i=1; [ "${words[1]:-}" != laptop ] || i=2
            [ "$op" = "laptop off" ] || nw+=(laptop)
            for w in "${words[@]:$i}"; do nw+=("$w"); done;;
          *)
            k=${op%%=*} seen=""
            for w in "${words[@]:1}"; do
              case $w in
                "$k="*) [ -n "$seen" ] || [ "$op" = "$k=" ] || nw+=("$op"); seen=1;;
                *) nw+=("$w");;
              esac
            done
            [ -n "$seen" ] || [ "$op" = "$k=" ] || nw+=("$op");;
        esac
        words=("${nw[@]}")
      done
      if [ "${words[*]}" = "$was" ]; then out="$out$line$cr"$'\n'; else out="$out${words[*]}$cr"$'\n'; changed=$((changed + 1)); fi
    done < "$hf"
    case $how in
      add) out="$out$alias${*:+ $*}"$'\n'; changed=1;;
      *) [ "$hit" != 0 ] || { echo "claude-discord: hosts: $alias is not in $hf" >&2; exit 3; };;
    esac
    # Only a ledger with no local line (hand-edited) can come to this: its monitor would run with no host and say nothing.
    [ "$how" != rm ] || [ "$others" != 0 ] || { echo "claude-discord: hosts: $alias is not removed: the ledger would be empty: the monitor needs at least one host" >&2; exit 2; }
    [ "$changed" = 0 ] || ledger_write "$hf" "$out" || { echo "claude-discord: hosts: could not write $hf; it is as it was" >&2; exit 1; }
    exec 7>&-
    h_changed=$changed
  }
  # h_has <alias>: the ledger has a line for it. Read without the lock: a hint before a slow probe; h_edit decides.
  h_has() {
    local line; local -a x
    while IFS= read -r line || [ -n "$line" ]; do
      set -f; x=(${line%$'\r'}); set +f
      [ "${x[0]:-}" != "$1" ] || return 0
    done < "$hf"
    return 1
  }
  # h_ask <alias>: asks the host who it is. Sets h_ver (its claude-discord version; empty when it printed no version
  # line), h_id (its home's host-id; empty from a claude-discord before 1.12.0) and h_last (the last line of the answer:
  # ssh's own error when it failed). No byte of the answer is trusted: h_ssh made its lines safe to print, and here
  # they are only read into variables and matched: a version is N.N.N, an id 32 hex digits. Nothing of it is run or
  # becomes a command's word.
  h_who='~/.local/bin/claude-discord --version --host-id'
  h_ask() {
    local l a b c d e rest re_v='^[0-9]+\.[0-9]+\.[0-9]+$' re_t='^[0-9TZ:-]{1,20}$'
    h_ssh "$1" "$h_who"
    h_ver="" h_id="" h_last="" h_watch=""   # h_watch: the host's watcher records, "<manager> <host-id> <alias> <time>" a line
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      h_last=$l a="" b="" c="" d="" e=""
      read -r a b c d e rest <<<"$l" || :
      case $a in
        claude-discord) if [ -z "$h_ver" ] && [[ $b =~ $re_v ]]; then h_ver=$b; fi;;
        host-id) if c_match "$b" "$hid_re"; then h_id=$b; fi;;
        watcher) if c_match "$b" "$mgr_re" && c_match "$c" "$hid_re" && c_match "$d" "$alias_re" && [[ $e =~ $re_t ]] && [ -z "$rest" ]; then h_watch="$h_watch$b $c $d $e"$'\n'; fi;;
      esac
    done <<<"$h_out"
  }
  case ${hw[0]:-} in
    list)
      [ "${#hw[@]}" = 1 ] || { echo "$h_usage" >&2; exit 2; }
      # Each line as the monitor's pass reads it (monitor/monitor.sh, run_pass), so this shows what the monitor will do.
      rows="" ign=0
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        set -f; set -- $line; set +f
        [ $# -gt 0 ] || continue
        case $1 in '#'*) continue;; -*|*[!A-Za-z0-9._@-]*) ign=$((ign + 1)); continue;; esac
        a=$1 lap=false nm="" keys="" skip=0; shift
        [ "${1:-}" != laptop ] || { lap=true; shift; }
        for w in "$@"; do
          case $w in name=*) nm=${w#name=}; nm=${nm//[[:cntrl:]]/}; continue;; esac
          if [[ $w =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then keys="$keys${keys:+ }${w%%=*}"; else skip=$((skip + 1)); fi
        done
        rows="$rows$a"$'\x1f'"$lap"$'\x1f'"$nm"$'\x1f'"$keys"$'\x1f'"$skip"$'\n'
      done < "$hf"
      if [ -n "$h_json" ]; then
        printf '%s' "$rows" | jq -Rn --arg m "$hb" --arg f "$hf" --argjson ign "$ign" '{manager: $m, ledger: $f, ignored: $ign,
          hosts: [inputs | split("\u001f") | {alias: .[0], laptop: (.[1] == "true"), name: .[2], env: (.[3] | split(" ")), skipped: (.[4] | tonumber)}]}'
      else
        while IFS=$'\x1f' read -r a lap nm keys skip; do
          [ -n "$a" ] || continue
          kind=server; [ "$lap" != true ] || kind=laptop
          keys=${keys// /,}; note=""; [ "$skip" = 0 ] || note=" ($skip words the monitor skips)"
          printf '%-20s %-7s name=%s env=%s%s\n' "$a" "$kind" "${nm:--}" "${keys:--}" "$note"
        done <<<"$rows"
      fi;;
    add)
      [ "${#hw[@]}" -ge 2 ] || { echo "$h_usage" >&2; exit 2; }
      a=${hw[1]}; h_alias "$a"
      # laptop is the third word or none; a KEY comes once (two words of one key on a line: the monitor takes the last).
      i=2 keys=" "
      for w in "${hw[@]:2}"; do
        i=$((i + 1))
        [ "$w" = laptop ] && [ "$i" = 3 ] && continue
        h_word "argument $i" "$w"
        case $w in *=) echo "claude-discord: hosts: argument $i: add takes KEY=VALUE, a value that is not empty" >&2; exit 2;; esac
        case $keys in *" ${w%%=*} "*) echo "claude-discord: hosts: argument $i: its KEY was already given" >&2; exit 2;; esac
        keys="$keys${w%%=*} "
      done
      ! h_has "$a" || { echo "claude-discord: hosts: $a is already in $hf" >&2; exit 3; }
      if [ -n "$h_dry" ]; then
        # The line `add` is about to run, for a person or the TUI to read first. local is this machine: nobody is asked.
        # The second line: what the two calls leave on that machine (the TUI shows both lines before the second Enter).
        [ -z "$h_probe" ] || [ "$a" = local ] || printf '%s\n' "ssh -o BatchMode=yes -o ConnectTimeout=8 -- $a '$h_who'" \
          "checks it and writes ~/.claude-discord/host-id there if missing; adding it writes ~/.claude-discord/watchers/$hb"
        exit 0
      fi
      h_id=""
      if [ -n "$h_probe" ] && [ "$a" != local ]; then
        h_ask "$a"
        unchecked="Not added; to add it unchecked: claude-discord hosts add --no-probe $a"
        if [ "$h_rc" = 255 ]; then
          echo "claude-discord: hosts: $a did not answer (ssh exit 255, also with ControlPath=none): ${h_last:-no output}. $unchecked" >&2; exit 5
        elif [ "$h_rc" = 142 ]; then
          echo "claude-discord: hosts: $a gave no answer within ${h_cap}s. $unchecked" >&2; exit 5
        elif [ -z "$h_ver" ]; then
          echo "claude-discord: hosts: $a answered, but not as claude-discord (exit $h_rc): ${h_last:-no output}. Install it there first (README, Install): a host without it is reported blind. $unchecked" >&2; exit 5
        elif [ -z "$h_id" ] && ver_ge "$h_ver" 1.12.0; then
          echo "claude-discord: hosts: warning: claude-discord $h_ver on $a answered but could not create its host-id (is ~/.claude-discord writable there?): it could not be checked for being this same home" >&2
        elif [ -z "$h_id" ]; then
          echo "claude-discord: hosts: warning: claude-discord $h_ver on $a is older than 1.12.0 and has no host-id: it could not be checked for being this same home" >&2
        else
          mine=$(host_id) || { echo "claude-discord: hosts: could not make $helpers/host-id" >&2; exit 1; }
          # One home behind two ledger lines: every bot of it would be reported twice, one side as down.
          [ "$h_id" != "$mine" ] || { echo "claude-discord: hosts: $a is the same home as local (it answered with this home's host-id): not added. Its bots are already checked through local" >&2; exit 4; }
          while read -r wm wi wa ws; do
            [ -n "$wm" ] || continue
            if [ "$wm" = "$hb" ] && [ "$wi" = "$mine" ]; then
              # This manager's own record: the home is in this ledger already, under that alias, unless that line is gone
              # (an rm that could not reach the host left the record: stale, and overwritten below).
              if [ "$wa" != "$a" ] && h_has "$wa"; then
                echo "claude-discord: hosts: $a is the same home as $wa (this manager's own record is there under that alias): not added. Its bots are already checked through $wa" >&2; exit 4
              fi
            elif [ "$wm" = "$hb" ]; then
              echo "claude-discord: hosts: warning: $a is already watched by a manager also named $wm, from another home (since $ws): both will report its bots, and this add takes over its record there" >&2
            else
              echo "claude-discord: hosts: warning: $a is already watched by $wm (since $ws): both managers will report its bots" >&2
            fi
          done <<<"$h_watch"
        fi
      fi
      h_edit "$a" add "${hw[@]:2}"
      echo "claude-discord: hosts: added $a to $hf"
      # This manager's record on the host, for the next manager that adds it. Only a claude-discord that printed a
      # host-id knows --watch (1.12.0); its failure is a warning, the host is added and checked all the same.
      if [ -n "$h_id" ]; then
        if c_match "$hb" "$mgr_re"; then
          h_ssh "$a" "~/.local/bin/claude-discord --version --watch $hb $mine $a"
          [ "$h_rc" = 0 ] || echo "claude-discord: hosts: warning: $a is added, but this manager could not be recorded there (ssh exit $h_rc): another manager adding it will not be warned" >&2
        else
          echo "claude-discord: hosts: warning: no watcher record is written for a manager named '$hb' (letters, digits and . _ - only): another manager adding $a will not be warned" >&2
        fi
      fi;;
    set|laptop)
      [ "${#hw[@]}" -ge 2 ] || { echo "$h_usage" >&2; exit 2; }
      a=${hw[1]}; h_alias "$a"
      ops=()
      if [ "${hw[0]}" = laptop ]; then
        [ "${#hw[@]}" = 3 ] || { echo "$h_usage" >&2; exit 2; }
        case ${hw[2]} in on|off) ops=("laptop ${hw[2]}");; *) echo "$h_usage" >&2; exit 2;; esac
      elif [ -n "$h_stdin" ]; then
        # One change a line; all of them are checked before the ledger is touched.
        [ "${#hw[@]}" = 2 ] || { echo "$h_usage" >&2; exit 2; }
        i=0
        while IFS= read -r w || [ -n "$w" ]; do
          w=${w%$'\r'}; i=$((i + 1))
          [ -n "$w" ] || continue
          case $w in "laptop on"|"laptop off") ;; *) h_word "line $i of stdin" "$w";; esac
          ops+=("$w")
        done
      else
        i=2
        for w in "${hw[@]:2}"; do i=$((i + 1)); h_word "argument $i" "$w"; ops+=("$w"); done
      fi
      [ "${#ops[@]}" != 0 ] || { echo "$h_usage" >&2; exit 2; }
      h_edit "$a" set "${ops[@]}"
      if [ "$h_changed" = 0 ]; then echo "claude-discord: hosts: $a is already so in $hf"
      else echo "claude-discord: hosts: changed $a in $hf ($h_changed line$([ "$h_changed" = 1 ] || echo s))"; fi;;
    rm)
      [ "${#hw[@]}" = 2 ] || { echo "$h_usage" >&2; exit 2; }
      a=${hw[1]}; h_alias "$a"
      # The monitor's own Discord calls take their environment from the local line, and the README promises it is there.
      [ "$a" != local ] || { echo "claude-discord: hosts: local is this machine and stays in the ledger (to turn the monitor off: claude-discord monitor --stop $hb)" >&2; exit 2; }
      h_edit "$a" rm
      echo "claude-discord: hosts: removed $a from $hf (the monitor keeps it a day as 'left the ledger', then drops it)"
      # This manager's watcher record on the host goes too, when it can be reached; the ledger line is already gone
      # either way. A home with no host-id never wrote a record anywhere, and makes no id for this.
      mine=""; { read -r mine < "$helpers/host-id"; } 2>/dev/null || :
      if [ -n "$h_probe" ] && c_match "$mine" "$hid_re" && c_match "$hb" "$mgr_re"; then
        h_ssh "$a" "~/.local/bin/claude-discord --version --unwatch $hb $mine"
        [ "$h_rc" = 0 ] || echo "claude-discord: hosts: warning: $a did not answer (ssh exit $h_rc), so this manager's watcher record stays there. It only makes another manager's add warn; to remove it later: ssh $a '~/.local/bin/claude-discord --version --unwatch $hb $mine'" >&2
      fi;;
    *) echo "$h_usage" >&2; exit 2;;
  esac
  exit 0
fi

# via_host <verb> <first version> <first word> <word>...: `claude-discord <verb> --host <alias> ...` (access since 1.13.0,
# bot since 1.14.0), the bot living on a host of a manager's ledger; a_host, hb (--manager) and a_proj (--project) are
# the verb's. `local` runs the verb here with that ledger line's env words, any other alias over ssh with them, as a
# monitor pass goes. Into the remote command go hex digits (the project and the first word, which may be a bot's name)
# and the verb's own words, which it has matched as plain. Never returns.
via_host() {
  local verb=$1 minv=$2 w1=$3 line w a_hit=""
  shift 3
  c_match "$a_host" "$alias_re" || { echo "claude-discord: $verb: --host is not an ssh alias: letters, digits, . _ @ -, not starting with -, 255 at most" >&2; exit 2; }
  h_manager "$verb" --manager
  # The env words of the host's ledger line, as the monitor's pass reads them (monitor/monitor.sh, run_pass): a proxy
  # word sets both spellings, name= is no env word; of two lines for one alias the last counts.
  a_env=()
  while IFS= read -r line || [ -n "$line" ]; do
    set -f; a_w=(${line%$'\r'}); set +f
    [ "${a_w[0]:-}" = "$a_host" ] || continue
    a_hit=1 a_env=()
    for w in ${a_w[@]+"${a_w[@]:1}"}; do
      case $w in name=*) continue;; esac
      [[ $w =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
      case ${w%%=*} in
        HTTPS_PROXY|https_proxy) a_env+=("HTTPS_PROXY=${w#*=}" "https_proxy=${w#*=}");;
        HTTP_PROXY|http_proxy) a_env+=("HTTP_PROXY=${w#*=}" "http_proxy=${w#*=}");;
        ALL_PROXY|all_proxy) a_env+=("ALL_PROXY=${w#*=}" "all_proxy=${w#*=}");;
        NO_PROXY|no_proxy) a_env+=("NO_PROXY=${w#*=}" "no_proxy=${w#*=}");;
        *) a_env+=("$w");;
      esac
    done
  done < "$hf"
  [ -n "$a_hit" ] || { echo "claude-discord: $verb: $a_host is not in $hf (claude-discord hosts list)" >&2; exit 2; }
  if [ "$a_host" = local ]; then
    a_pa=(); [ -z "$a_proj" ] || a_pa=(--project "$a_proj")
    exec env ${a_env[@]+"${a_env[@]}"} "$self_path" "$verb" ${a_pa[@]+"${a_pa[@]}"} -- "$w1" "$@"
  fi
  [ -n "$a_proj" ] || { echo "claude-discord: $verb: --host $a_host needs --project <the bot's project directory on that host>" >&2; exit 2; }
  # The project and the first word travel as hex digits (a path or a name may hold anything; no quoting of ours has to
  # hold in the remote shell), behind `--version`: an older claude-discord prints its version line and exits whatever
  # follows, while a new verb would be read there as a bot's name and reach the launcher.
  a_hex() { printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n'; }
  a_remote="env $([ ${#a_env[@]} = 0 ] || printf '%q ' "${a_env[@]}")~/.local/bin/claude-discord --version --$verb $(a_hex "$a_proj") $(a_hex "$w1")${*:+ $*}"
  a_old() {  # no document: an older host printed its version line; a host new enough that could not do it said why (no such bot there)
    # A version line is a whole line, as h_capped reads one: the same words inside other text (a banner) are none.
    local l re='^ *claude-discord +([0-9]+\.[0-9]+\.[0-9]+)( |$)'
    l=$(printf '%s\n' "$h_out" | grep -E "$re" | tail -n 1) || l=""
    if [[ $l =~ $re ]]; then echo "claude-discord: $verb: $a_host needs claude-discord $minv for this (it has ${BASH_REMATCH[1]}; claude-discord update, there)" >&2; exit 5; fi
    l=$(printf '%s\n' "$h_out" | LC_ALL=C tr -d '\000-\010\013-\037\177' | grep . | tail -n 1) || l=""
    l=${l#claude-discord: $verb: }
    echo "claude-discord: $verb: $a_host: ${l:-no answer (exit $h_rc)}" >&2; exit 1
  }
  a_down() {
    case $h_rc in
      255) echo "claude-discord: $verb: $a_host did not answer (ssh exit 255, also with ControlPath=none)" >&2; exit 5;;
      142) echo "claude-discord: $verb: $a_host gave no answer within ${h_cap}s" >&2; exit 5;;
    esac
  }
  if [ "${1:-}" = --json ]; then
    # The host asks Discord, starting no call past 12 s, each 5 s at most, after ssh connected (up to 8 s): 30 s for
    # the whole call, so a slow host with a slow Discord is still an answer.
    case $h_cap in *.*) ;; *) [ "$h_cap" -ge 30 ] || h_cap=30;; esac
    h_ssh "$a_host" "$a_remote" raw; a_down
    # The document is the last line that starts as one; what the host printed around it (a banner) is not ours.
    doc=$(printf '%s\n' "$h_out" | grep '^{"access":' | tail -n 1 | jq -c 'select(.access == 1)' 2>/dev/null) || doc=""
    [ -n "$doc" ] || a_old
    printf '%s\n' "$doc"; exit 0
  fi
  h_ssh "$a_host" "~/.local/bin/claude-discord --version"; a_down
  a_v="" a_re='claude-discord ([0-9]+\.[0-9]+\.[0-9]+)'
  if [[ $h_out =~ $a_re ]]; then a_v=${BASH_REMATCH[1]}; fi
  [ -n "$a_v" ] || { echo "claude-discord: $verb: $a_host answered, but not as claude-discord (exit $h_rc)" >&2; exit 5; }
  ver_ge "$a_v" "$minv" || a_old
  if [ -t 0 ] && [ -t 1 ]; then
    # The question is asked on that host, of this terminal. No cap: a person is answering.
    a_rc=0; ssh -t -o BatchMode=yes -o ConnectTimeout=8 -- "$a_host" "$a_remote" || a_rc=$?
    [ "$a_rc" != 255 ] || { echo "claude-discord: $verb: ssh to $a_host failed (exit 255)" >&2; exit 5; }
    exit "$a_rc"
  fi
  # No terminal here: the host prints the changes and refuses (exit 3). What it printed is another machine's text.
  h_ssh "$a_host" "$a_remote" raw; a_down
  printf '%s\n' "$h_out" | LC_ALL=C tr -d '\000-\010\013-\037\177'
  exit "$h_rc"
}

# access: reads and changes who may drive a bot, for people, scripts and the TUI, which changes a bot's access.json and
# mode through this verb only: the channels it listens in (access.json's groups), per channel whether an @mention is
# required and who may write, the DM policy with its allowlist, and the bot's mode.
#   access <bot> --json          one line of JSON: the policy, the guild's channels with whether the bot can read each
#                                (asked of Discord with the bot's own token, here on the bot's machine), the people
#                                known, the mode. Read-only; needs no terminal.
#   access <bot> set <change>... prints what would change, asks, writes. A change is a word a person can type, made of
#                                lower-case letters, digits and : + = - only (a_word_re), so it travels over ssh as it is:
#     channel+<channel id>  channel-<channel id>          listen there (an @mention required, from the owner alone) / stop
#     mention:<channel id>=on|off                         an @mention is required / every message is answered
#     allow:<channel id>+<user id>  allow:<channel id>-<user id>  allow:<channel id>=any    who may write there
#     dm=allowlist|pairing|off  dm+<user id>  dm-<user id>          DMs: off is an allowlist with nobody on it
#     mode=none|dev-manager|autoresearchclaw              through `setup <bot> --mode`, its questions answered by Enter
# A change that widens who can drive the bot is shown first, marked "!" (red at a terminal), then the others; one
# question is asked for all of them, naming how many widen (1.13.1). Anything but y writes nothing: the file is what
# was shown and agreed to, or as it was.
# It refuses to write unless stdin and stdout are a terminal, and has no flag to skip the question. That is a speed
# bump, not a boundary: whoever can run this can also edit the file. Without a terminal it prints the changes and exits 3.
# --project <dir>: the bot's project (default: the one above the cwd that has the bot).
# --host <alias>: the bot lives on a host of a manager's ledger (--manager <bot> when the project has several): `local`
# runs it here with that line's env words, any other alias over ssh with them (a question needs `ssh -t`, so a terminal
# here). Only hex digits, ids and change words go into the remote command; no name does.
# Exit status: 0 done, or nothing to change; 1 it could not (no such bot, access.json unreadable or changed meanwhile, a
# failed write, the lock held 5 s, no manager's ledger for --host); 2 usage, a word that is not a change, or a change
# that cannot be made; 3 no terminal: nothing written; 4 answered no: nothing written; 5 --host: no answer from the
# host, or its claude-discord is older than 1.13.0.
if [ "${1:-}" = access ]; then
  shift
  a_usage="usage: claude-discord access [--host <alias> [--manager <bot>]] [--project <dir>] <bot> --json | set <change>...
  a change: channel+<channel id> | channel-<channel id> | mention:<channel id>=on|off | allow:<channel id>+<user id> | allow:<channel id>-<user id> | allow:<channel id>=any | dm=allowlist|pairing|off | dm+<user id> | dm-<user id> | mode=none|dev-manager|autoresearchclaw"
  a_word_re='^(channel[+-][0-9]{1,20}|mention:[0-9]{1,20}=(on|off)|allow:[0-9]{1,20}([+-][0-9]{1,20}|=any)|dm=(allowlist|pairing|off)|dm[+-][0-9]{1,20}|mode=(none|dev-manager|autoresearchclaw))$'
  a_host="" a_proj="" hb=""
  while [ $# -gt 0 ]; do
    case $1 in
      --host|--manager|--project)
        [ $# -ge 2 ] || { echo "$a_usage" >&2; exit 2; }
        case $1 in --host) a_host=$2;; --manager) hb=$2;; *) a_proj=$2;; esac
        shift 2;;
      --) shift; break;;
      -*) echo "$a_usage" >&2; exit 2;;
      *) break;;
    esac
  done
  [ $# -ge 2 ] || { echo "$a_usage" >&2; exit 2; }
  bot=$1 act=$2; shift 2
  case $bot in ''|.|..|*/*) echo "claude-discord: access: the bot's name must be a plain directory name" >&2; exit 2;; esac
  case $act in
    --json) [ $# = 0 ] || { echo "$a_usage" >&2; exit 2; };;
    set)
      [ $# -gt 0 ] || { echo "$a_usage" >&2; exit 2; }
      # Never echoed: a refused word is text from somewhere else (a paste, a state file), only where it stands is said.
      i=0; for w in "$@"; do i=$((i + 1)); c_match "$w" "$a_word_re" || { echo "claude-discord: access: change $i is not one of the changes access takes (claude-discord access, with no argument, lists them)" >&2; exit 2; }; done;;
    *) echo "$a_usage" >&2; exit 2;;
  esac

  [ -z "$a_host" ] || via_host access 1.13.0 "$bot" "$act" "$@"

  if [ -n "$a_proj" ]; then
    cd "$a_proj" 2>/dev/null || { echo "claude-discord: access: no such project directory (--project)" >&2; exit 1; }
  else
    ap=$PWD
    while [ ! -d "$ap/.claude/discord-agents/$bot" ] && [ -n "$ap" ]; do ap=${ap%/*}; done
    [ -z "$ap" ] || cd "$ap"
  fi
  root=$PWD/.claude/discord-agents; d=$root/$bot; f=$d/access.json
  bn=${bot//[[:cntrl:]]/}   # the name as it is printed
  [ -f "$f" ] || { echo "claude-discord: access: no bot '$bn' set up in $root (claude-discord setup <bot>)" >&2; exit 1; }
  command -v jq >/dev/null 2>&1 || { echo "claude-discord: access needs jq" >&2; exit 1; }
  DISCORD_CHANNEL_ID="" DISCORD_USER_ID=""
  [ ! -f "$root/config.env" ] || . "$root/config.env"
  # The bot's main channel when access.json does not say which (and a part of a URL below): an id or nothing.
  [ -z "$DISCORD_CHANNEL_ID" ] || c_match "$DISCORD_CHANNEL_ID" '^[0-9]{1,20}$' ||
    { echo "claude-discord: access: DISCORD_CHANNEL_ID in $root/config.env is not a channel id (digits only); correct it there" >&2; exit 1; }
  # What names this machine keeps: the channels' (health writes channel-names), the people's (on-prompt writes
  # user-names) and the peer bots' (peers.json). They are for reading: every argument and every stored value is an id.
  # member-names: the names Discord's member list gave at the last --json, for set to show next to an id it has no
  # name of its own for (after it: a display name is anyone's to choose).
  a_cn="" a_un="" a_mn="" a_peers="" mode=""
  { a_cn=$(<"$d/channel-names"); } 2>/dev/null || :
  { a_un=$(<"$d/user-names"); } 2>/dev/null || :
  { a_mn=$(<"$d/member-names"); } 2>/dev/null || :
  { a_peers=$(<"$root/peers.json"); } 2>/dev/null || :
  { read -r mode < "$d/mode"; } 2>/dev/null || :
  mode=${mode//[[:cntrl:]]/}; mode=${mode:-none}
  a_host_name=$(uname -n); a_host_name=${a_host_name%%.*}
  # What every jq program below starts with. An id is digits and nothing else, to the end of the string (\z: Oniguruma's
  # $ also matches before a last newline). `policy` is the part of access.json this verb is about, as health --json
  # gives it (dm, dm_allow, groups: id, mention, allow), with the plugin's own defaults: no dmPolicy is pairing, no
  # requireMention is true, no allowFrom is everyone. A name is shown, never trusted: no control character, no bidi
  # override or isolate, no zero-width character or mark (the TUI's UNSAFE set), 40 characters.
  a_defs='
    def isid: type == "string" and test("\\A[0-9]{1,20}\\z");
    def ids: [arrays[] | tostring | select(isid)] | unique;
    def policy: {dm: (.dmPolicy | if type == "string" then . else "pairing" end), dm_allow: (.allowFrom | ids),
                 groups: [(.groups | if type == "object" then . else {} end) | to_entries[] | select((.key | isid) and (.value | type) == "object")
                          | {id: .key, mention: (.value.requireMention != false), allow: (.value.allowFrom | ids)}]};
    def safe: tostring | gsub("[[:cntrl:]\u200b-\u200f\u202a-\u202e\u2060\u2066-\u2069\ufeff]"; "") | .[0:40];
    def named: split("\n") | map(select(test("^[0-9]+ .")) | {key: (split(" ")[0]), value: (sub("^[0-9]+ "; "") | safe)}) | from_entries;
    def peerlist: (try fromjson catch null) | [objects | .peers | arrays | .[] | objects | {id: (.bot_id // "" | tostring), name: (.name // "" | safe)} | select(.id | isid)];
    def mainof($fb): if (.groups | length) == 1 then .groups[0].id else $fb end;'

  if [ "$act" = --json ]; then
    a_p=$(jq -r --arg fb "$DISCORD_CHANNEL_ID" "$a_defs"'policy | [mainof($fb), tojson] | join(" ")' "$f" 2>/dev/null) && [ -n "$a_p" ] ||
      { echo "claude-discord: access: $f is not valid JSON" >&2; exit 1; }
    main=${a_p%% *} a_p=${a_p#* }
    # Discord is asked as health asks it (the token on curl's stdin, never in an argument): four calls, six when the bot's
    # id (bot-id) or its server (channel-guild) is not known here yet, each 5 s at most and none started past 12 s, so
    # the answer arrives inside the cap of the ssh call that may carry it (30 s: access --host).
    a_t0=$SECONDS status=000 resp=""
    a_api() {  # $1 = path; sets $status and $resp
      local out=""
      [ $((SECONDS - a_t0)) -lt 12 ] && out=$(printf 'Authorization: Bot %s\n' "$tok" | curl -s --max-time 5 -w '\n%{http_code}' -H @- "https://discord.com/api/v10/$1" 2>/dev/null) || out=""
      status=${out##*$'\n'} resp=${out%$'\n'*}
      case $status in ''|*[!0-9]*) status=000;; esac
    }
    tok="" me="" gid="" cch="" errs="" a_g=null a_m=null a_c=null a_mm=null
    { while IFS= read -r l || [ -n "$l" ]; do case $l in DISCORD_BOT_TOKEN=*) tok=${l#DISCORD_BOT_TOKEN=};; esac; done < "$d/.env"; } 2>/dev/null || :
    { read -r me < "$d/bot-id"; } 2>/dev/null || :
    { read -r cch gid l < "$d/channel-guild"; } 2>/dev/null || :
    [ "$cch" = "$main" ] && c_match "$gid" '^[0-9]{1,20}$' || gid=""
    if [ -z "$tok" ]; then
      errs="no token in $d/.env: Discord was not asked for the channels"
    elif ! command -v curl >/dev/null 2>&1; then
      errs="no curl here: Discord was not asked for the channels"
    else
      if ! c_match "$me" '^[0-9]{1,20}$'; then
        a_api users/@me; me=$(printf '%s' "$resp" | jq -r '.id // empty' 2>/dev/null) || me=""
        c_match "$me" '^[0-9]{1,20}$' || me=""
      fi
      if [ -z "$gid" ] && [ -n "$main" ]; then
        a_api "channels/$main"; gid=$(printf '%s' "$resp" | jq -r '.guild_id // empty' 2>/dev/null) || gid=""
        c_match "$gid" '^[0-9]{1,20}$' || gid=""
      fi
      if [ -z "$me" ] || [ -z "$gid" ]; then
        errs="Discord did not say who this bot is or which server its channel is in (HTTP $status)"
      else
        a_api "guilds/$gid/channels"; case $status in 2*) a_c=$resp;; *) errs="the server's channels: HTTP $status";; esac
        a_api "guilds/$gid"; case $status in 2*) a_g=$resp;; *) errs="$errs${errs:+$'\n'}the server's roles: HTTP $status";; esac
        a_api "guilds/$gid/members/$me"; case $status in 2*) a_m=$resp;; *) errs="$errs${errs:+$'\n'}the bot's roles: HTTP $status";; esac
        # The member list answers only when the Server Members Intent is on for this bot. Off is no error and nothing
        # to turn on: the people are then the ones this machine has names for.
        a_api "guilds/$gid/members?limit=1000"; case $status in 2*) a_mm=$resp;; esac
      fi
    fi
    # Can the bot read a channel: VIEW_CHANNEL (1 << 10) and READ_MESSAGE_HISTORY (1 << 16) after Discord's own order:
    # @everyone's and the bot's roles' permissions together; then the channel's overwrites, @everyone's first, the
    # roles' next (their denies, then their allows), the bot's own last. An administrator (1 << 3) and the server's
    # owner read everything. jq only picks the numbers out, as text: its numbers are doubles and a permission set is
    # past 2^53 one day; the arithmetic is bash's (64 bits). A number that is none, or longer than 18 digits, a call
    # that failed, an answer with no @everyone role in it (jq then prints no line): not known ("?" in the TUI), never a guess.
    a_reads=""
    a_lines=$(printf '%s\n%s\n%s\n' "$a_g" "$a_m" "$a_c" | jq -rn --arg me "$me" '
      [inputs] as [$g, $m, $c]
      | ($g | objects | .id | tostring) as $gid | ($m | objects | [.roles | arrays | .[] | tostring]) as $mr
      | [$g.roles | arrays | .[] | objects] as $roles | select(any($roles[]; (.id | tostring) == $gid))
      | def ow($o): [$o[] | objects | "\(.allow // "0")/\(.deny // "0")"] | join(",") | if . == "" then "-" else . end;
        "B " + ([$roles[] | (.id | tostring) as $i | select($i == $gid or any($mr[]; . == $i)) | .permissions | tostring] | join(" ")),
        "O " + (if ($g.owner_id // "" | tostring) == $me then "1" else "0" end),
        ($c | arrays | .[] | objects | select(.type == 0 or .type == 5 or .type == 15)
         | [.permission_overwrites | arrays | .[] | objects] as $o
         | "C \(.id) \(ow([$o[] | select((.id | tostring) == $gid)])) \(ow([$o[] | (.id | tostring) as $i | select((.type == 0 or .type == "role") and $i != $gid and any($mr[]; . == $i))])) \(ow([$o[] | select((.id | tostring) == $me)]))")' 2>/dev/null) || a_lines=""
    a_num() { c_match "$1" '^[0-9]{1,18}$'; }
    a_ow() {  # $1 = "allow/deny,..." or "-": folded into p (the denies of all of them, then their allows); unsure=1 for a number that is none
      local x al=0 dn=0
      [ "$1" != - ] || return 0
      for x in ${1//,/ }; do
        if a_num "${x%/*}" && a_num "${x#*/}"; then al=$((al | 10#${x%/*})) dn=$((dn | 10#${x#*/})); else unsure=1; fi
      done
      p=$(( (p & ~dn) | al ))
    }
    base=0 sure=yes all=0
    while read -r t a b c e; do
      case $t in
        B) for x in $a $b $c $e; do if a_num "$x"; then base=$((base | 10#$x)); else sure=no; fi; done;;
        O) [ "$a" != 1 ] || all=1;;
        C) p=$base unsure=0; a_ow "$b"; a_ow "$c"; a_ow "$e"
           if [ "$sure" != yes ] || ! c_match "$a" '^[0-9]{1,20}$'; then :
           elif [ "$all" = 1 ] || [ $((base & 8)) != 0 ]; then a_reads="$a_reads$a 1"$'\n'
           elif [ "$unsure" = 1 ]; then :
           elif [ $((p & 1024)) != 0 ] && [ $((p & 65536)) != 0 ]; then a_reads="$a_reads$a 1"$'\n'
           else a_reads="$a_reads$a 0"$'\n'; fi;;
      esac
    done <<<"$a_lines"
    a_doc() {  # the document, from the three answers on stdin (null for one that did not come)
      jq -cn --arg bot "$bot" --arg me "$me" --arg host "$a_host_name" --arg project "$PWD" --arg mode "$mode" --arg owner "$DISCORD_USER_ID" \
        --arg main "$main" --arg ver "$(plugin_version "$self_root")" --arg cn "$a_cn" --arg un "$a_un" --arg peers "$a_peers" \
        --arg reads "$a_reads" --arg errs "$errs" --argjson policy "$a_p" "$a_defs"'
        [inputs] as [$g, $c, $mm]
        | ($cn | named) as $CN | ($un | named) as $UN | ($peers | peerlist) as $PL
        | ($reads | split("\n") | map(select(. != "") | split(" ") | {key: .[0], value: (.[1] == "1")}) | from_entries) as $R
        | [$c | arrays | .[] | objects | select(.type == 0 or .type == 5 or .type == 15) | . + {id: (.id | tostring)}] as $gc
        | ([$mm | arrays | .[] | objects | select(.user | type == "object")
            | {id: (.user.id | tostring), name: (.nick // .user.global_name // .user.username // "" | safe), bot: (.user.bot == true)}]) as $api
        | ([$PL[] | . + {bot: true}] + [$UN | to_entries[] | {id: .key, name: .value, bot: false}]) as $kept
        | {access: 1, version: $ver, bot: $bot, bot_id: $me, host: $host, project: $project, mode: $mode,
           owner: (if ($owner | isid) then $owner else "" end), main: $main, peers: [$PL[] | select((.name | ascii_downcase) != ($bot | ascii_downcase)) | .id],
           guild: (if ($g | type) == "object" then {id: ($g.id | tostring), name: ($g.name // "" | safe)} else null end),
           policy: $policy,
           channels: ([$gc | sort_by(.position // 0)[] | {id, name: (.name // "" | safe), kind: (if .type == 15 then "forum" elif .type == 5 then "news" else "text" end), read: $R[.id]}]
                      + [$policy.groups[] | .id as $i | select(all($gc[]; .id != $i)) | {id: $i, name: ($CN[$i] // ""), kind: "unknown", read: null}]),
           # kept: the name this machine keeps (user-names, peers.json), the only one the TUI takes a typed name for.
           people: (([$api[] | . + {k: ""}] + [$kept[] | . + {k: .name}] + [($policy.dm_allow + [$policy.groups[].allow[]])[] | {id: ., name: "", bot: false, k: ""}])
                    | map(select(.id | isid)) | group_by(.id)
                    | map({id: .[0].id, name: (map(.name | select(. != ""))[0] // ""), kept: (map(.k | select(. != ""))[0] // ""), bot: any(.[]; .bot)})),
           members: (if ($mm | type) == "array" then "api" else "names" end),
           errors: ($errs | split("\n") | map(select(. != "")))}'
    }
    if [ "$a_mm" != null ]; then
      a_mn=$(printf '%s' "$a_mm" | jq -r "$a_defs"'.[]? | objects | select(.user | type == "object")
        | [(.user.id | tostring), (.nick // .user.global_name // .user.username // "" | safe)] | select((.[0] | isid) and .[1] != "") | join(" ")' 2>/dev/null) &&
        (umask 077; printf '%s\n' "$a_mn" > "$d/member-names.$$") 2>/dev/null && mv -f "$d/member-names.$$" "$d/member-names" 2>/dev/null || rm -f "$d/member-names.$$"
    fi
    printf '%s\n%s\n%s\n' "$a_g" "$a_c" "$a_mm" | a_doc 2>/dev/null ||
      { errs="$errs${errs:+$'\n'}Discord's answer could not be read"; a_reads=""; printf 'null\nnull\nnull\n' | a_doc; } ||
      { echo "claude-discord: access: the document could not be made from $f" >&2; exit 1; }
    exit 0
  fi

  # set. One jq program does both halves: with $out = "diff" it prints what the words would change, one line a change;
  # with $out = "doc" it prints the new access.json, made from the file as it is THEN (the plugin adds its own keys to
  # it: a pending pairing), and fails when the policy in it is no longer the one the diff was made from ($seen).
  # The words are applied in order to the whole document, so every key this verb does not know stays as it is.
  # A diff line is <kind> US <where> US <text>; the kinds: P the policy the diff was made from, as JSON; W a change that
  # widens who can drive the bot (shown first, red); C any other change; N a warning; E a change that cannot be
  # made (exit 2). Widening is: an @mention no longer required; a channel opened to anyone; DMs to pairing, or back
  # from disabled; a person added to the DM allowlist (they then answer the bot's permission prompts too); a person
  # this bot listed nowhere until now.
  a_prog="$a_defs"'
    def has_grp($c): (.d.groups | type) == "object" and (.d.groups | has($c)) and (.d.groups[$c] | type) == "object";
    def without($u): [arrays[] | select(tostring != $u)];
    def with($u): [arrays[]] | if any(.[]; tostring == $u) then . else . + [$u] end;
    def step($x):
      if .err then .
      elif ($x | startswith("channel+")) then $x[8:] as $c
        | if has_grp($c) then . elif $owner == "" then .err = "channel+\($c): no owner id is known (DISCORD_USER_ID in config.env), so who may write there cannot be set"
          else .d.groups = ((.d.groups | if type == "object" then . else {} end) + {($c): {requireMention: true, allowFrom: [$owner]}}) end
      elif ($x | startswith("channel-")) then $x[8:] as $c | (if has_grp($c) then del(.d.groups[$c]) else . end) | .any -= [$c]
      elif ($x | startswith("mention:")) then ($x[8:] | split("=")) as [$c, $v]
        | if has_grp($c) then .d.groups[$c].requireMention = ($v == "on") else .err = "mention:\($c): the bot does not listen in that channel (channel+\($c) first)" end
      elif ($x | startswith("allow:")) then ($x[6:] | capture("^(?<c>[0-9]+)(?<o>[-+=])(?<u>.*)$")) as $m | $m.c as $c
        | if has_grp($c) | not then .err = "allow:\($c): the bot does not listen in that channel (channel+\($c) first)"
          elif $m.o == "=" then .d.groups[$c].allowFrom = [] | .any += [$c]
          elif $m.o == "+" then .d.groups[$c].allowFrom |= with($m.u) | .any -= [$c]
          else .d.groups[$c].allowFrom |= without($m.u) end
      elif $x == "dm=off" then .d.dmPolicy = "allowlist" | .d.allowFrom = []
      elif ($x | startswith("dm=")) then .d.dmPolicy = $x[3:]
      elif ($x | startswith("dm+")) then .d.allowFrom |= with($x[3:])
      elif ($x | startswith("dm-")) then .d.allowFrom |= without($x[3:])
      else . end;
    def dmw: if .dm == "disabled" then "disabled" elif .dm != "allowlist" then "pairing" elif .dm_allow == [] then "off" else "allowlist" end;
    . as $doc | policy as $P0
    # The mode after the call: the last mode= word, else the one the bot has.
    | ([$words | split(" ")[] | select(startswith("mode="))] | last // null | if . then .[5:] else $mode end) as $nm
    | ([$peers | peerlist[] | select((.name | ascii_downcase) != ($bot | ascii_downcase)) | .id]) as $pi
    | (reduce ($words | split(" ")[] | select(. != "")) as $x ({d: $doc, any: [], err: null}; step($x))) as $r0
    # Entering dev-manager, the peers of peers.json go into every channel that lists its senders: what `setup --mode`
    # does, done here once, after all the words (wherever mode= stands), so the diff shows it, the question is asked and
    # the file written under the lock holds it; setup is then told not to do it again (CLAUDE_DISCORD_ACCESS_PEERS).
    | (if $nm == "dev-manager" and $mode != "dev-manager" and ($r0.err | not) and (($r0.d.groups | type) == "object")
       then $r0 | .d.groups |= map_values(if (.allowFrom // []) == [] then . else .allowFrom = (.allowFrom as $a | $a + ($pi - $a)) end)
       else $r0 end) as $r
    | ($r0.d | policy | .groups | map({key: .id, value: .}) | from_entries) as $Gw
    | ($r.d | policy) as $P1
    | ($P0.groups | map({key: .id, value: .}) | from_entries) as $G0 | ($P1.groups | map({key: .id, value: .}) | from_entries) as $G1
    # The last sender taken off a list would leave it empty, and an empty list is everyone: never by a removal.
    | ([$P1.groups[] | select(.allow == [] and ((.id as $i | $r.any | index($i)) == null) and ($G0[.id] == null or $G0[.id].allow != [])) | .id][0]) as $emptied
    | (if $r.err then $r.err elif $emptied then "allow:\($emptied): that would leave no sender, and a channel with none listed takes everyone. Say allow:\($emptied)=any to mean that, or channel-\($emptied) to stop listening there" else null end) as $err
    | if $out == "doc" then
        (if $err or (($P0 | tojson) != $seen) then error("changed") else $r.d end)
      else
        ($cn | named) as $CN | ($un | named) as $UN | ($mn | named) as $MN | ($peers | peerlist) as $PL | ($PL | map({key: .id, value: .name}) | from_entries) as $PN
        | def ch: "#" + ($CN[.] // .);
          # A name kept here goes before the id; one only the Discord member list gave (the person chose it) after it.
          def who: . as $u | ($UN[$u] // $PN[$u] // "") | if . != "" then "\(.) (\($u))" else ($MN[$u] // "" | if . == "" then $u else "\($u) (\(.))" end) end;
          def whos: if . == [] then "anyone" else map(who) | join(", ") end;
          def rule: if .mention then "an @mention required" else "any message" end;
          def line($k; $l; $t): [$k, $l, $t] | join("\u001f");
          ([$P0.groups[].allow[]] + $P0.dm_allow | unique) as $known
        | line("P"; ""; $P0 | tojson),
          (if $err then line("E"; ""; $err) else
            ($P1.groups[] | . as $n | $G0[$n.id] as $o
             | if $o == null then
                 line("C"; $n.id | ch; "+ listens here: \($n | rule), from \($n.allow | whos)"),
                 (if $n.mention then empty else line("W"; $n.id | ch; "answers every message there, with no @mention") end),
                 (if $n.allow == [] then line("W"; $n.id | ch; "anyone in the channel may write to it") else empty end)
               else
                 (if $o.mention and ($n.mention | not) then line("W"; $n.id | ch; "an @mention required -> any message")
                  elif ($o.mention | not) and $n.mention then line("C"; $n.id | ch; "any message -> an @mention required") else empty end),
                 (if $o.allow != [] and $n.allow == [] then line("W"; $n.id | ch; "from \($o.allow | whos) -> from anyone in the channel")
                  elif $o.allow == [] and $n.allow != [] then line("C"; $n.id | ch; "from anyone -> from \($n.allow | whos)")
                  else (($n.allow - $o.allow)[] | select(. as $u | $known | index($u)) | line("C"; $n.id | ch; "+ \(who) may write to it there")),
                       (($o.allow - $n.allow)[] | line("C"; $n.id | ch; "- \(who) may no longer write to it there")) end)
               end),
            ($P0.groups[] | select($G1[.id] == null) | line("C"; .id | ch; "- stops listening here")),
            ([$P1.groups[] | . as $n | select($G0[$n.id] == null or $G0[$n.id].allow != []) | ($n.allow - $known)[] | {u: ., c: $n.id}] | group_by(.u)[]
             | line("W"; .[0].u | who; "new to this bot: may write to it in \(map(.c | ch) | join(", "))")),
            (($P0 | dmw) as $a | ($P1 | dmw) as $b
             | if $a == $b then empty
               elif $a == "disabled" then line("W"; "DMs"; "disabled -> \($b): the bot receives again, in its channels too (disabled drops every message)")
               elif $b == "pairing" then line("W"; "DMs"; "\($a) -> pairing: anyone who shares a server with the bot can DM it and is sent a pairing code")
               else line("C"; "DMs"; "\($a) -> \($b)") end),
            (($P1.dm_allow - $P0.dm_allow)[] | line("W"; "DMs"; "+ \(who) may DM it, and answers its permission prompts")),
            (($P0.dm_allow - $P1.dm_allow)[] | line("C"; "DMs"; "- \(who) may no longer DM it")),
            # Warnings: the owner taken off a list, the main channel moved, a dev-manager cut off from a peer.
            (select($owner != "") | $P0.groups[] | . as $o | $G1[$o.id] | select(. != null and .allow != [] and ($o.allow | index($owner)) != null and (.allow | index($owner)) == null)
             | line("N"; ""; "\($owner | who) is the owner of this bot (DISCORD_USER_ID) and can no longer write to it in \($o.id | ch)")),
            (select($owner != "" and ($P0.dm_allow | index($owner)) != null and ($P1.dm_allow | index($owner)) == null)
             | line("N"; ""; "\($owner | who) is the owner of this bot and no longer gets its DMs or its permission prompts")),
            (($P0 | mainof($fb)) as $a | ($P1 | mainof($fb)) as $b | select($a != $b)
             | line("N"; ""; "the main channel of the bot becomes \(if $b == "" then "none" else ($b | ch) end) (was \($a | ch)): its session prompt, its hooks and health use that one"
                    + (if $b != "" and $G1[$b] == null then ", and it does not listen there" else "" end))),
            (select($nm == "dev-manager") | $PL[] | . as $p | $P0.groups[] | . as $o | $G1[$o.id]
             | select(. != null and .allow != [] and ($o.allow | index($p.id)) != null and (.allow | index($p.id)) == null)
             | line("N"; ""; "\($p.id | who) is a peer dev bot (peers.json) and can no longer reach this bot in \($o.id | ch)")),
            # A peer a word took off, back on the list because the bot enters dev-manager: no removal is shown, so say why.
            ($P1.groups[] | . as $n | $pi[] | select(. as $p | ($G0[$n.id].allow // [] | index($p)) != null and ($Gw[$n.id].allow // [] | index($p)) == null and ($n.allow | index($p)) != null)
             | line("N"; ""; "\(who) is a peer dev bot (peers.json): entering dev-manager puts it back in \($n.id | ch)"))
          end)
      end'
  a_jq() {  # $1 = diff|doc, $2 = the policy the diff was made from (doc)
    jq -r --arg out "$1" --arg seen "${2:-}" --arg words "$a_words" --arg owner "$a_owner" --arg fb "$DISCORD_CHANNEL_ID" --arg bot "$bot" \
      --arg mode "$mode" --arg cn "$a_cn" --arg un "$a_un" --arg mn "$a_mn" --arg peers "$a_peers" "$a_prog" "$f"
  }
  a_owner=$DISCORD_USER_ID; c_match "$a_owner" '^[0-9]{1,20}$' || a_owner=""
  a_words=" $*"
  a_diff=$(a_jq diff 2>/dev/null) && [ -n "$a_diff" ] || { echo "claude-discord: access: $f is not valid JSON; nothing was changed" >&2; exit 1; }
  red="" yel="" off=""
  [ ! -t 1 ] || { red=$'\033[1;31m' yel=$'\033[33m' off=$'\033[0m'; }
  # The widenings are shown first, then the other changes, then the warnings; one question is asked for all of them.
  a_seen="" a_nw=0 a_n=0 a_warn="" a_sw="" a_sc=""
  while IFS=$'\x1f' read -r k where text; do
    case $k in
      P) a_seen=$text;;
      E) echo "claude-discord: access: $text" >&2; exit 2;;
      W) a_nw=$((a_nw + 1)); a_sw="$a_sw"$'\n'"$red  ! $where: $text$off";;
      C) a_n=$((a_n + 1)); a_sc="$a_sc"$'\n'"    $where: $text";;
      N) a_warn="$a_warn"$'\n'"${yel}warning: $text$off";;
    esac
  done <<<"$a_diff"
  # The mode is not in access.json: its line is made here. Out of dev-manager with a hosts ledger, `setup --mode` deletes
  # the ledger, which stops the manager's monitor: a widening.
  newmode=$mode
  for w in "$@"; do case $w in mode=*) newmode=${w#mode=};; esac; done
  a_mgr=""; [ "$newmode" != dev-manager ] || [ -f "$d/hosts" ] || a_mgr=": it gets a hosts ledger (this machine) and its monitor starts, which posts in #bot-health-check"
  if [ "$newmode" != "$mode" ] && [ "$mode" = dev-manager ] && [ -f "$d/hosts" ]; then
    a_mq="mode: dev-manager -> $newmode: its hosts ledger ($d/hosts) is deleted and its monitor and keeper stop within a minute. Nobody is told in #bot-health-check when a bot of its hosts goes down"
    a_nw=$((a_nw + 1)); a_sw="$a_sw"$'\n'"$red  ! $a_mq$off"
  elif [ "$newmode" != "$mode" ]; then
    a_n=$((a_n + 1)); a_sc="$a_sc"$'\n'"    mode: $mode -> $newmode$a_mgr"
  fi
  if [ "$a_nw" = 0 ] && [ "$a_n" = 0 ]; then echo "claude-discord: access: $bn is already so; nothing to change"; exit 0; fi
  printf '%s%s%s%s\n' "claude-discord: access: $bn on $a_host_name, $f" "$a_sw" "$a_sc" "$a_warn"
  [ -t 0 ] && [ -t 1 ] || { echo "claude-discord: access: not a terminal (stdin and stdout), so nothing was changed: run it in a terminal to answer for these changes" >&2; exit 3; }
  a_no() { echo "claude-discord: access: answered no; nothing was changed" >&2; exit 4; }
  # One question for the whole change set (1.13.1): y writes all of it; n, the end of input or anything else, none.
  a_t=$((a_nw + a_n))
  if [ "$a_nw" = 0 ]; then q="Apply $([ "$a_t" = 1 ] && echo "this change" || echo "these $a_t changes")?"
  elif [ "$a_nw" = "$a_t" ]; then q="Apply $([ "$a_t" = 1 ] && echo "this widening change" || echo "these $a_t widening changes")?"
  else q="Apply $a_t changes, $a_nw of them widening?"; fi
  # Before it, on its own line, a marker: U+2060 alone (no control character, nothing on a terminal), which no Discord
  # name can hold (safe, in a_defs, takes it out of every name). The TUI asks only after it (1.13.1): a name that ends
  # in [y/N] can never pass for the question.
  printf '\342\201\240\n' >&2
  a=""; read -r -p "$q [y/N] " a || a=""
  case $a in y|Y) ;; *) a_no;; esac
  a_file=""; case $'\n'$a_diff in *$'\n'[WC]$'\x1f'*) a_file=1;; esac   # a change of access.json itself, not of the mode alone
  # access.log: when, who (the account here), on which machine, and what was done: a line for access.json (with the
  # change words, ids only) right after its rename, before setup --mode runs, so a run stopped in setup still has its
  # write logged; then a line for the mode, set or failed.
  a_log() { (umask 077; printf '%s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(id -un 2>/dev/null || echo unknown)" "$a_host_name" "$1" >> "$d/access.log") 2>/dev/null || :; }
  if [ -n "$a_file" ]; then
    # One writer of ours at a time (flock through perl on <file>.lock, as the ledger's: fd 7, never stale), and the
    # file replaced by rename, never written in place: the plugin reads it at every message, and one it cannot parse it
    # moves aside and answers with its defaults (pairing, no channel). The plugin takes no lock: it rewrites the file
    # itself when a DM asks for a pairing code or one expires, which is why the new document is made from the file as
    # it is now, a moment before the rename.
    exec 7>>"$f.lock"
    perl -e 'open(my $l, ">&=", 7) or exit 1; for (1 .. 50) { exit 0 if flock($l, 6); select(undef, undef, undef, 0.1) } exit 1' ||
      { echo "claude-discord: access: $f is being changed by another claude-discord access; nothing was changed" >&2; exit 1; }
    a_new=$(a_jq doc "$a_seen" 2>/dev/null) && [ -n "$a_new" ] ||
      { echo "claude-discord: access: $f changed while you were answering (or is no longer valid JSON); nothing was changed, run it again" >&2; exit 1; }
    (umask 077; printf '%s\n' "$a_new" > "$f.cd.$$") && mv -f "$f.cd.$$" "$f" ||
      { rm -f "$f.cd.$$"; echo "claude-discord: access: could not write $f; it is as it was" >&2; exit 1; }
    a_log "access.json:$a_words"
    exec 7>&-
  fi
  [ -z "$a_file" ] || echo "claude-discord: access: $f written. The plugin reads it at the next message: no restart."
  if [ "$newmode" != "$mode" ]; then
    # setup --mode, with the mode on its stdin and nothing after it: its peers and hosts questions read the end of
    # input, which keeps both lists (README, Modes).
    if ! printf '%s\n' "$newmode" | CLAUDE_DISCORD_ACCESS_PEERS=written "$self_path" setup "$bot" --mode; then
      a_log "mode: $mode -> $newmode failed (claude-discord setup $bn --mode)"
      echo "claude-discord: access: the mode was not changed (claude-discord setup $bn --mode, above)${a_file:+; the changes to access.json stay}" >&2; exit 1
    fi
    echo "claude-discord: access: the hooks follow the new mode from their next call; the dev-manager rules reach, or leave, a running session at its next start, compact or clear."
    [ "$newmode" != dev-manager ] || echo "claude-discord: access: its peers and the hosts it checks: claude-discord setup $bn --mode, and claude-discord hosts add"
    a_log "mode: $mode -> $newmode"
  fi
  exit 0
fi

# bot: a bot's token and its name (1.14.0), for people and the TUI, which changes them through this verb only. A bot's
# name here is its Discord username (b_name_re: 2 to 32 of A-Z a-z 0-9 _ -): its directory, its session's name and what
# the monitor and the TUI show.
#   bot <name> token          the new token, read from the terminal with its echo off; Discord is asked who it is (GET
#                             /users/@me as that token): a token Discord refuses, or one of another bot, is refused;
#                             <bot dir>/.env replaced by rename, mode 600, its other lines kept. A running session logs in
#                             with it within 10 s.
#   bot <name> rename <new>   Discord's name first (PATCH /users/@me as the bot: about two changes an hour are allowed,
#                             and a refusal changes nothing here), then everything here keyed by the name (below). <new>
#                             that Discord has already: only the name here changes (the TUI's `=`).
#   bot add [--mode <mode>] [--start]   a new bot in this project: its token read as token reads it, its Discord username
#                             its name, set up by `setup` with its answers on stdin (the project's channel and owner
#                             are config.env's; an @mention required), started (`--bg --name`) with --start.
# Each asks one question at the terminal, after the marker line access set prints (U+2060), and refuses without a
# terminal on stdin and stdout (exit 3): token and add before they read anything, rename after printing what it would
# do. The token is never printed, never in an argument list, the environment or a log: read from the terminal (or
# .env), sent to curl and to setup on their stdin.
# --host <alias> [--manager <bot>] --project <dir>: as access --host; the host needs claude-discord 1.14.0.
# Exit status: 0 done, or nothing to change; 1 it could not (Discord refused or did not answer, a token of another bot,
# no such bot, a name taken, a failed write or start: what was done and what was not is said); 2 usage, a name that is
# none, or what was typed is no token; 3 no terminal: nothing read or changed; 4 answered no; 5 --host: no answer from
# the host, or its claude-discord is older than 1.14.0.
if [ "${1:-}" = bot ]; then
  shift
  b_usage="usage: claude-discord bot [--host <alias> [--manager <bot>]] [--project <dir>] <bot> token | <bot> rename <new name> | add [--mode none|dev-manager|autoresearchclaw] [--start]"
  b_name_re='^[A-Za-z0-9_-]{2,32}$'   # a bot's name: Discord's username, which it is
  a_host="" a_proj="" hb=""
  while [ $# -gt 0 ]; do
    case $1 in
      --host|--manager|--project)
        [ $# -ge 2 ] || { echo "$b_usage" >&2; exit 2; }
        case $1 in --host) a_host=$2;; --manager) hb=$2;; *) a_proj=$2;; esac
        shift 2;;
      --) shift; break;;
      -*) echo "$b_usage" >&2; exit 2;;
      *) break;;
    esac
  done
  [ $# -ge 1 ] || { echo "$b_usage" >&2; exit 2; }
  bot=$1 act=${2:-} new="" b_mode=none b_start=""; shift
  [ "$bot" != add ] || act=add
  [ $# = 0 ] || [ "$act" = add ] || shift
  case $bot in ''|.|..|*/*) echo "claude-discord: bot: the bot's name must be a plain directory name" >&2; exit 2;; esac
  case $act in
    add)
      while [ $# -gt 0 ]; do
        case $1 in
          --mode) [ $# -ge 2 ] || { echo "$b_usage" >&2; exit 2; }
                  case $2 in none|dev-manager|autoresearchclaw) b_mode=$2;; *) echo "$b_usage" >&2; exit 2;; esac; shift 2;;
          --start) b_start=1; shift;;
          *) echo "$b_usage" >&2; exit 2;;
        esac
      done;;
    token) [ $# = 0 ] || { echo "$b_usage" >&2; exit 2; };;
    rename)
      [ $# = 1 ] || { echo "$b_usage" >&2; exit 2; }
      new=$1
      c_match "$new" "$b_name_re" || { echo "claude-discord: bot: the new name is 2 to 32 of A-Z a-z 0-9 _ - (Discord's username, which it becomes)" >&2; exit 2; };;
    *) echo "$b_usage" >&2; exit 2;;
  esac
  b_noterm() { echo "claude-discord: bot: $act reads the token from a terminal and asks there: run it in a terminal (stdin and stdout); nothing was read or changed" >&2; exit 3; }
  if [ -n "$a_host" ]; then
    [ "$act" = rename ] || { [ -t 0 ] && [ -t 1 ]; } || b_noterm   # nothing is read over ssh without a terminal here
    if [ "$act" = add ]; then via_host bot 1.14.0 add --mode "$b_mode" ${b_start:+--start}; fi
    via_host bot 1.14.0 "$bot" "$act" ${new:+"$new"}
  fi
  if [ -n "$a_proj" ]; then
    cd "$a_proj" 2>/dev/null || { echo "claude-discord: bot: no such project directory (--project)" >&2; exit 1; }
  else
    # The project above the cwd that has the bot; for add, the one above it with bots.
    bp=$PWD bw=$bot; [ "$act" != add ] || bw=""
    while [ ! -d "$bp/.claude/discord-agents/$bw" ] && [ -n "$bp" ]; do bp=${bp%/*}; done
    [ -z "$bp" ] || cd "$bp"
  fi
  root=$PWD/.claude/discord-agents; d=$root/$bot M=$helpers/records/monitor
  bn=${bot//[[:cntrl:]]/}   # the name as it is printed
  b_host_name=$(uname -n); b_host_name=${b_host_name%%.*}
  [ "$act" = add ] || [ -f "$d/.env" ] || { echo "claude-discord: bot: no bot '$bn' set up in $root (claude-discord setup <bot>)" >&2; exit 1; }
  command -v jq >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 || { echo "claude-discord: bot needs jq and curl" >&2; exit 1; }
  # b_api <method> <path> [<JSON body>]: Discord asked with $tok, which goes to curl on its stdin as health sends it;
  # sets status and resp.
  b_api() {
    local out=""
    out=$(printf 'Authorization: Bot %s\n' "$tok" | curl -s --max-time 10 -w '\n%{http_code}' -X "$1" -H @- ${3:+-H 'Content-Type: application/json' --data-binary "$3"} "https://discord.com/api/v10/$2" 2>/dev/null) || out=""
    status=${out##*$'\n'} resp=${out%$'\n'*}
    case $status in ''|*[!0-9]*) status=000;; esac
  }
  # b_me <what to do when Discord refuses it>: who $tok is: b_id, b_user (its username, as Discord gives it), b_isbot,
  # and b_shown (that name made safe to print: another program's text). Exit 1 when Discord refused the token or did not
  # answer.
  b_me() {
    local l
    b_api GET users/@me
    l=$(printf '%s' "$resp" | jq -r 'objects | [(.id // "" | tostring), (.bot == true | tostring), (.username // "" | tostring)] | join("\u001f")' 2>/dev/null) || l=""
    IFS=$'\x1f' read -r b_id b_isbot b_user <<<"$l" || :
    b_shown=$(printf '%s' "$b_user" | LC_ALL=C tr -d '\000-\037\177'); b_shown=${b_shown:0:40}
    case $status in
      2*) c_match "$b_id" '^[0-9]{1,20}$' || { echo "claude-discord: bot: Discord's answer had no bot id in it; nothing was changed" >&2; exit 1; };;
      401) echo "claude-discord: bot: Discord refused the token (HTTP 401): $1; nothing was changed" >&2; exit 1;;
      *) echo "claude-discord: bot: Discord did not answer (HTTP $status); nothing was changed" >&2; exit 1;;
    esac
  }
  # b_read: the token, from the terminal with its echo off (turned off before the prompt is printed, so nothing typed or
  # written to it is shown), after the marker line: into tok. Ctrl-C puts the echo back.
  b_read() {
    local st
    st=$(stty -g 2>/dev/null) && stty -echo 2>/dev/null || { echo "claude-discord: bot: the terminal's echo could not be turned off, so no token is read" >&2; exit 1; }
    trap 'stty "$st" 2>/dev/null' EXIT; trap 'exit 130' INT TERM HUP
    printf '\342\201\240\n' >&2
    tok=""; IFS= read -r -p "Token (hidden): " tok || tok=""
    stty "$st" 2>/dev/null; trap - EXIT INT TERM HUP
    echo >&2
    tok=${tok%$'\r'}
    c_match "$tok" '^[A-Za-z0-9._-]{20,200}$' || { tok=""; echo "claude-discord: bot: what was typed is no bot token (letters, digits and . _ -, 20 to 200 of them); nothing was changed" >&2; exit 2; }
  }
  # b_ask <question>: the one question, after the marker (the TUI asks only after it); anything but y is exit 4.
  b_ask() {
    local a=""
    printf '\342\201\240\n' >&2
    read -r -p "$1 [y/N] " a || a=""
    case $a in y|Y) ;; *) echo "claude-discord: bot: answered no; nothing was changed" >&2; exit 4;; esac
  }
  # b_mgr_free <name> [<its old name>]: no manager of that name has a backend on this machine, or exit 1 naming where one
  # is: one backend (state dir, keeper, monitor) per manager NAME on a machine (setup says why).
  b_mgr_free() {
    local p
    [ ! -e "$M/$1" ] || [ "$M/$1" -ef "$M/${2:-}" ] || { echo "claude-discord: bot: $M/$1 is there: a manager named $1 has a backend on this machine; nothing was changed" >&2; exit 1; }
    while IFS= read -r p || [ -n "$p" ]; do
      p=${p%$'\r'}
      [ -n "$p" ] && [ -f "$p/.claude/discord-agents/$1/hosts" ] || continue
      echo "claude-discord: bot: '$1' is a dev-manager with a hosts ledger in $p: one backend serves one manager name per machine; nothing was changed" >&2; exit 1
    done < <(cat "$helpers/records/projects" 2>/dev/null)
  }
  # b_dname <bot dir> <name>: Discord's name for the bot, as health keeps it (discord-name: "<read at> <name>").
  b_dname() { printf '%s %s\n' "$(date +%s)" "${2//[[:cntrl:]]/}" > "$1/discord-name" 2>/dev/null || :; }
  # b_log <bot dir> <what>: a line in the bot's access.log, as access set writes it (the token: the fact only).
  b_log() { (umask 077; printf '%s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(id -un 2>/dev/null || echo unknown)" "$b_host_name" "$2" >> "$1/access.log") 2>/dev/null || :; }

  if [ "$act" = add ]; then
    # The project's channel and owner are set: add asks none of what setup asks of a project's first bot.
    DISCORD_CHANNEL_ID="" DISCORD_USER_ID="" DISCORD_ALLOW_IDS=""
    [ ! -f "$root/config.env" ] || . "$root/config.env"
    c_match "$DISCORD_CHANNEL_ID" '^[0-9]{1,20}$' && c_match "$DISCORD_USER_ID" '^[0-9]{1,20}$' ||
      { echo "claude-discord: bot: add needs a project whose channel and owner are set ($root/config.env): set up its first bot with claude-discord setup <bot> at a terminal there; nothing was changed" >&2; exit 1; }
    [ -t 0 ] && [ -t 1 ] || b_noterm
    b_read
    b_me "copy it again (Developer Portal, the bot's Bot tab, Reset Token)"
    [ "$b_isbot" = true ] || { echo "claude-discord: bot: that token is no bot's (Discord says it is a user's); nothing was changed" >&2; exit 1; }
    new=$b_user
    # Its name here is its Discord username: one that is no name here is renamed on Discord first.
    case $new in setup|install|update|patch|compat|refresh|health|monitor|tui|hosts|access|bot|hooks|checkin|add) new=" $new";; esac
    c_match "$new" "$b_name_re" || { echo "claude-discord: bot: Discord calls this bot '$b_shown', and a bot's name here is its Discord username: 2 to 32 of A-Z a-z 0-9 _ -, and no name claude-discord itself uses. Rename it in the Developer Portal first (the bot's Bot tab, Username), then add it again; nothing was changed" >&2; exit 1; }
    [ ! -e "$root/$new" ] || { echo "claude-discord: bot: a bot '$new' is set up in $root already (claude-discord bot $new token replaces its token); nothing was changed" >&2; exit 1; }
    # One bot, one session: a bot set up on this machine already (its id kept in bot-id) is not set up twice.
    while IFS= read -r p || [ -n "$p" ]; do
      p=${p%$'\r'}
      for f in "$p"/.claude/discord-agents/*/bot-id; do
        id=""; { read -r id < "$f"; } 2>/dev/null || :
        [ "$id" != "$b_id" ] || { echo "claude-discord: bot: that token's bot ($b_id) is set up in ${f%/bot-id} already: two sessions on one token both answer; nothing was changed" >&2; exit 1; }
      done
    done < <(printf '%s\n' "$PWD"; cat "$helpers/records/projects" 2>/dev/null)
    [ "$b_mode" != dev-manager ] || b_mgr_free "$new"
    printf '%s\n' "claude-discord: bot: add $new (Discord $b_id) on $b_host_name, $root/$new" \
      "    it listens in channel $DISCORD_CHANNEL_ID (config.env): an @mention required, from $DISCORD_USER_ID${DISCORD_ALLOW_IDS:+ and $DISCORD_ALLOW_IDS}" \
      "    mode: $b_mode$([ "$b_mode" != dev-manager ] || echo ": a hosts ledger (this machine) and its monitor, which posts in #bot-health-check")" \
      "    $([ -n "$b_start" ] && echo "it starts at once: claude-discord --bg --name $new" || echo "it is not started: claude-discord --bg --name $new starts it")"
    b_ask "Add this bot?"
    # setup, as at a terminal: its answers on its stdin (the token, Enter for the mention question, the mode, Enter for a
    # manager's peers and hosts), its install questions not asked. Whatever it wrote goes when it fails: the bot was not there.
    if ! printf '%s\n\n%s\n\n\n' "$tok" "$b_mode" | CLAUDE_DISCORD_SETUP_NOASK=1 "$self_path" setup "$new"; then
      tok=""; rm -rf "${root:?}/$new"
      echo "claude-discord: bot: setup failed (above); nothing was added" >&2; exit 1
    fi
    tok=""
    printf '%s\n' "$b_id" > "$root/$new/bot-id" 2>/dev/null || :
    b_dname "$root/$new" "$new"
    b_log "$root/$new" "added (bot $b_id, mode $b_mode)"
    if [ -n "$b_start" ]; then
      ! untrusted || { echo "claude-discord: bot: $new is added, not started: $PWD is not a trusted workspace (run 'claude' here once and accept the trust prompt), then claude-discord --bg --name $new" >&2; exit 1; }
      "$self_path" --bg --name "$new" || { echo "claude-discord: bot: $new is added, but did not start (above): claude-discord --bg --name $new" >&2; exit 1; }
    fi
    echo "claude-discord: bot: $new added${b_start:+ and started}"
    exit 0
  fi

  if [ "$act" = token ]; then
    [ -t 0 ] && [ -t 1 ] || b_noterm
    b_read
    b_me "copy it again (Developer Portal, the bot's Bot tab, Reset Token)"
    [ "$b_isbot" = true ] || { echo "claude-discord: bot: that token is no bot's (Discord says it is a user's); nothing was changed" >&2; exit 1; }
    # The same bot: its id, kept in bot-id by health; with none kept here, its Discord name is this bot's name.
    me=""; { read -r me < "$d/bot-id"; } 2>/dev/null || :
    if c_match "$me" '^[0-9]{1,20}$'; then
      [ "$me" = "$b_id" ] || { echo "claude-discord: bot: that token is the bot $b_shown ($b_id), not $bn ($me): a token of another bot is refused, it would make this another bot; nothing was changed" >&2; exit 1; }
    elif [ "$b_user" != "$bot" ]; then
      echo "claude-discord: bot: this machine does not know $bn's Discord id yet, and that token is the bot $b_shown ($b_id), another name: refused; nothing was changed" >&2; exit 1
    fi
    b_keep="" b_old=""
    while IFS= read -r l || [ -n "$l" ]; do
      case $l in DISCORD_BOT_TOKEN=*) [ -n "$b_old" ] || b_old=${l#DISCORD_BOT_TOKEN=};; *) b_keep="$b_keep$l"$'\n';; esac
    done < "$d/.env"
    [ "$b_old" != "$tok" ] || { echo "claude-discord: bot: that is $bn's token already; nothing to change"; exit 0; }
    printf '%s\n' "claude-discord: bot: $bn on $b_host_name, $d/.env" \
      "    its token is replaced by this one, of $b_shown ($b_id); the old one is not kept" \
      "    a running session of $bn logs in with it within 10 s (one started before claude-discord 1.14.0: claude-discord refresh $bn --force)"
    b_ask "Replace the token?"
    # By rename, never in place: the plugin re-reads .env every 10 s while it waits for a token, by its path.
    (umask 077; printf 'DISCORD_BOT_TOKEN=%s\n%s' "$tok" "$b_keep" > "$d/.env.cd.$$") && mv -f "$d/.env.cd.$$" "$d/.env" ||
      { rm -f "$d/.env.cd.$$"; echo "claude-discord: bot: could not write $d/.env; it is as it was" >&2; exit 1; }
    tok=""
    c_match "$me" '^[0-9]{1,20}$' || printf '%s\n' "$b_id" > "$d/bot-id" 2>/dev/null || :
    b_dname "$d" "$b_user"
    b_log "$d" "token: replaced (bot $b_id)"
    echo "claude-discord: bot: $d/.env written. A running session of $bn logs in with it within 10 s."
    exit 0
  fi

  # rename <new>. What is keyed by the name here, and how each moves (README, A bot's name):
  #   the bot's directory, with its token, access.json, mode, ledger, logs, caches and handoff: one rename(2);
  #   its running session: stopped first, started again under the new name after, from its handoff.md when it has one;
  #   this bot's line in the peers.json of each project of this machine, found by its id (a bot skips its own NAME there);
  #   its scratch directory, ~/.claude-discord/scratch/<name>;
  #   a manager's backend: its keeper and monitor stopped, records/monitor/<name> (state, alerts, log) moved, state.json's
  #   manager renamed, the backend started again unless its owner had stopped it, and its watcher record on each host
  #   of its ledger renamed (over ssh, as hosts add wrote it).
  # Not here: the monitor's row of the old name leaves at its next pass, unannounced; peers on other machines keep the old
  # name in their peers.json (they reach it by id); both are said. Before the directory moves, a failure undoes what was
  # stopped; after it, what fails is said and the rest goes on: the name here is the new one either way.
  nd=$root/$new
  case $new in setup|install|update|patch|compat|refresh|health|monitor|tui|hosts|access|bot|hooks|checkin)
    echo "claude-discord: bot: '$new' is a subcommand or a directory of claude-discord, so no bot may take the name" >&2; exit 2;; esac
  [ ! -e "$nd" ] || [ "$nd" -ef "$d" ] || { echo "claude-discord: bot: a bot '$new' is set up in $root already" >&2; exit 1; }
  # The session that would run this is the one stopped on the way.
  [ -z "${DISCORD_STATE_DIR:-}" ] || ! [ "$DISCORD_STATE_DIR" -ef "$d" ] ||
    { echo "claude-discord: bot: a session cannot rename its own bot: it is stopped on the way. Run it in a terminal outside $bn's session" >&2; exit 2; }
  mode=""; { read -r mode < "$d/mode"; } 2>/dev/null || :
  mgr=""; [ "$mode" != dev-manager ] || [ ! -f "$d/hosts" ] || [ "$new" = "$bot" ] || mgr=1
  [ -z "$mgr" ] || b_mgr_free "$new" "$bot"
  tok=""
  { while IFS= read -r l || [ -n "$l" ]; do case $l in DISCORD_BOT_TOKEN=*) tok=${l#DISCORD_BOT_TOKEN=}; break;; esac; done < "$d/.env"; } 2>/dev/null || :
  [ -n "$tok" ] || { echo "claude-discord: bot: no token in $d/.env (claude-discord bot $bn token)" >&2; exit 1; }
  b_me "claude-discord bot $bn token, first"
  me=""; { read -r me < "$d/bot-id"; } 2>/dev/null || :
  ! c_match "$me" '^[0-9]{1,20}$' || [ "$me" = "$b_id" ] ||
    { echo "claude-discord: bot: $d/.env holds the token of the bot $b_shown ($b_id), not $bn's ($me): claude-discord bot $bn token puts its own back; nothing was changed" >&2; exit 1; }
  [ "$b_user" != "$new" ] || [ "$new" != "$bot" ] || { echo "claude-discord: bot: $bn is its name here and on Discord already; nothing to change"; exit 0; }
  # A peer of that name in peers.json: the bot would skip it as itself.
  b_clash=$(jq -r --arg n "$new" --arg id "$b_id" 'first(.peers[]? | objects | select((.name // "" | tostring | ascii_downcase) == ($n | ascii_downcase) and (.bot_id // "" | tostring) != $id) | .bot_id | tostring) // empty' "$root/peers.json" 2>/dev/null) || b_clash=""
  [ -z "$b_clash" ] || { echo "claude-discord: bot: the peer $new (${b_clash//[!0-9]/}) in $root/peers.json has that name, and a bot skips its own name there; nothing was changed" >&2; exit 1; }
  live=""
  if [ "$new" != "$bot" ]; then
    live=$(live_sessions "$bot" "$d") || { echo "claude-discord: bot: 'claude agents --json' failed, so what runs is unknown; nothing was changed" >&2; exit 1; }
    [ -z "$live" ] || ! untrusted || { echo "claude-discord: bot: $PWD is not a trusted workspace, so $bn would not start again after the rename: run 'claude' here once and accept the trust prompt; nothing was changed" >&2; exit 1; }
  fi
  b_n=0; [ -z "$live" ] || b_n=$(printf '%s\n' "$live" | grep -c .)
  printf '%s\n' "claude-discord: bot: $bn on $b_host_name, $root"
  if [ "$b_user" = "$new" ]; then echo "    Discord: it is $new there already: Discord is not asked to change it"
  else echo "    Discord: $b_shown -> $new (about 2 changes an hour are allowed: if Discord refuses, nothing here is changed)"; fi
  if [ "$new" != "$bot" ]; then
    echo "    here: $bn -> $new (its directory, and its line in the peers.json of this machine's projects)"
    if [ -z "$live" ]; then echo "    it is not running: renamed only (claude-discord --bg --name $new starts it)"
    elif [ -s "$d/handoff.md" ]; then echo "    it runs ($b_n session$([ "$b_n" = 1 ] || echo s)): stopped, renamed, started again as $new from its handoff.md"
    else echo "    it runs ($b_n session$([ "$b_n" = 1 ] || echo s)): stopped, renamed, started again as $new with no handoff.md: an empty context that catches up from the channel"; fi
    [ -z "$mgr" ] || echo "    a manager: its keeper and monitor stop, its state, alerts and log move to $M/$new, its backend starts again as $new, and its record on each ledger host is renamed"
  fi
  [ -t 0 ] && [ -t 1 ] || { echo "claude-discord: bot: not a terminal (stdin and stdout), so nothing was changed: run it in a terminal to answer" >&2; exit 3; }
  b_ask "Rename it to $new?"
  b_disc=""
  if [ "$b_user" != "$new" ]; then
    b_api PATCH users/@me "{\"username\":\"$new\"}"
    l=$(printf '%s' "$resp" | jq -r 'objects | (.username // "") | tostring' 2>/dev/null) || l=""
    case $status in
      2*) [ "$l" = "$new" ] || { echo "claude-discord: bot: Discord calls it '$(printf '%s' "$l" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-40)' now, not $new: nothing here was changed" >&2; exit 1; };;
      *) l=$(printf '%s' "$resp" | jq -r 'objects | [.errors.username._errors[]?.message?, .message, (.retry_after | if . then "retry after \(.) s" else null end)] | map(select(type == "string")) | join(": ")' 2>/dev/null) || l=""
         echo "claude-discord: bot: Discord refused the new name (HTTP $status${l:+: $(printf '%s' "$l" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-200)}); nothing was changed" >&2; exit 1;;
    esac
    b_disc=1
    b_log "$d" "rename: on Discord $b_shown -> $new"
  fi
  tok=""
  b_dname "$d" "$new"
  [ "$new" != "$bot" ] || { echo "claude-discord: bot: Discord calls it $new now, as it is called here"; exit 0; }
  b_again=""; [ -z "$b_disc" ] || b_again=" (Discord calls it $new now: run this again to rename it here)"
  if [ -n "$live" ] && ! stop_sessions "$bn" "$live"; then
    echo "claude-discord: bot: $bn still runs after stop (pid ${alive[*]}): nothing here was renamed$b_again. Stop it by hand first" >&2; exit 1
  fi
  b_undo() {  # the directory did not move: what was stopped runs again
    if [ -n "$mgr" ]; then
      rm -f "$M/$new/stopped"; rmdir "$M/$new" 2>/dev/null || :
      [ -n "$was_stopped" ] || bash "$self_root/monitor/monitor.sh" "$self_path" --start "$bot" </dev/null >/dev/null 2>&1 || :
    fi
    [ -z "$live" ] || start_fresh "$self_path" "$bot" "$d" "Catch up on the channel and continue from your handoff." || :
  }
  was_stopped=""
  if [ -n "$mgr" ]; then
    [ ! -e "$M/$bot/stopped" ] || was_stopped=1
    bash "$self_root/monitor/monitor.sh" "$self_path" --stop "$bot" </dev/null >/dev/null 2>&1 || :
    # A marker under the new name before the directory has it: no session's hook starts a backend for it meanwhile.
    mkdir -p "$M" && mkdir "$M/$new" && : > "$M/$new/stopped" ||
      { b_undo; echo "claude-discord: bot: could not make $M/$new: nothing here was renamed$b_again" >&2; exit 1; }
  fi
  perl -e 'rename $ARGV[0], $ARGV[1] or exit 1' "$d" "$nd" ||
    { b_undo; echo "claude-discord: bot: could not rename $d: nothing here was renamed$b_again" >&2; exit 1; }
  b_log "$nd" "rename: $bn -> $new"
  b_rc=0 b_warn=""
  # This bot's line in each project's peers.json, by its id.
  while IFS= read -r p || [ -n "$p" ]; do
    p=${p%$'\r'}
    [ -n "$p" ] && [ -f "$p/.claude/discord-agents/peers.json" ] || continue
    jq_edit "$p/.claude/discord-agents/peers.json" --arg id "$b_id" --arg n "$new" \
      'if (.peers | type) == "array" then .peers |= map(if type == "object" and ((.bot_id // "") | tostring) == $id then .name = $n else . end) else . end'
  done < <(printf '%s\n' "$PWD"; cat "$helpers/records/projects" 2>/dev/null)
  if [ -d "$helpers/scratch/$bot" ] && [ ! -e "$helpers/scratch/$new" ]; then
    mv "$helpers/scratch/$bot" "$helpers/scratch/$new" 2>/dev/null || b_warn="$b_warn"$'\n'"    its scratch directory stays $helpers/scratch/$bot"
  fi
  if [ -n "$mgr" ]; then
    rm -f "$M/$new/stopped"
    if [ ! -d "$M/$bot" ]; then
      rmdir "$M/$new" 2>/dev/null || :
    elif rmdir "$M/$new" 2>/dev/null && perl -e 'rename $ARGV[0], $ARGV[1] or exit 1' "$M/$bot" "$M/$new"; then
      # The monitor starts from a state.json only when it names this manager: else it would post standing findings again.
      { jq -c --arg m "$new" '.manager = $m' "$M/$new/state.json" > "$M/$new/state.json.tmp" && mv -f "$M/$new/state.json.tmp" "$M/$new/state.json"; } 2>/dev/null || rm -f "$M/$new/state.json.tmp"
    else
      b_warn="$b_warn"$'\n'"    its state and alerts stay in $M/$bot: the monitor of $new starts with none (a finding standing now is posted again)"
    fi
    if [ -n "$was_stopped" ]; then
      b_warn="$b_warn"$'\n'"    its backend stays stopped, as you left it: claude-discord monitor --start $new"
    else
      bash "$self_root/monitor/monitor.sh" "$self_path" --start "$new" </dev/null >/dev/null 2>&1 ||
        { b_rc=1; b_warn="$b_warn"$'\n'"    its backend did not start: claude-discord monitor --start $new"; }
    fi
    # Its record on each host of its ledger (hosts add wrote it): renamed over ssh, a host that does not answer said.
    mine=""; { read -r mine < "$helpers/host-id"; } 2>/dev/null || :
    if c_match "$mine" "$hid_re" && c_match "$new" "$mgr_re"; then
      while IFS= read -r line || [ -n "$line" ]; do
        set -f; set -- ${line%$'\r'}; set +f
        a=${1:-}
        [ "$a" != local ] && c_match "$a" "$alias_re" || continue
        h_ssh "$a" "~/.local/bin/claude-discord --version --watch $new $mine $a"
        if [ "$h_rc" = 0 ]; then
          ! c_match "$bot" "$mgr_re" || h_ssh "$a" "~/.local/bin/claude-discord --version --unwatch $bot $mine"
        else
          b_warn="$b_warn"$'\n'"    $a did not answer (ssh exit $h_rc), so its watcher record still names $bn: ssh $a '~/.local/bin/claude-discord --version --watch $new $mine $a'"
        fi
      done < "$nd/hosts"
    fi
  fi
  b_ran=""
  if [ -n "$live" ]; then
    if start_fresh "$self_path" "$new" "$nd" "Catch up on the channel and continue from your handoff."; then b_ran=1
    else b_rc=1; b_warn="$b_warn"$'\n'"    $new did not start (above)${put_back:+; its handoff was put back}: claude-discord --bg --name $new"; fi
  fi
  echo "claude-discord: bot: renamed: $nd${b_disc:+ (and on Discord)}"
  [ -z "$b_ran" ] || echo "    its session runs again as $new"
  [ -n "$live" ] || echo "    it was not running: claude-discord --bg --name $new starts it"
  echo "    the monitor shows $new from its next pass; the row of $bn leaves it then, unannounced"
  [ "$mode" != dev-manager ] || echo "    peers on other machines list it as $bn in their peers.json, by its id $b_id, so they still reach it; to show the new name there, their owner runs claude-discord setup <their bot> --mode, with the peer $new:$b_id:<owner id>:<machine>"
  [ -z "$b_warn" ] || printf 'claude-discord: bot: not done:%s\n' "$b_warn" >&2
  exit "$b_rc"
fi

# monitor: the backend health monitor of a manager bot (monitor/monitor.sh has
# the whole story). --keep and --stop are for people; --ensure is the TUI's and the hooks'.
if [ "${1:-}" = monitor ]; then
  shift
  # Run from anywhere: the project is the one above the cwd that has the bot, else the recorded one (records/projects),
  # as tui finds it. Not found: monitor.sh says so (no ledger) from where it is.
  mb="" sk=0
  for a in "$@"; do
    if [ "$sk" -gt 0 ]; then sk=$((sk - 1)); continue; fi
    case $a in --holder) sk=2;; -*) ;; *) mb=$a; break;; esac
  done
  case $mb in ''|.|..|*/*) ;; *)
    mp=$PWD
    while [ ! -d "$mp/.claude/discord-agents/$mb" ] && [ "$mp" != / ]; do mp=$(dirname "$mp"); done
    if [ -d "$mp/.claude/discord-agents/$mb" ]; then cd "$mp"
    elif [ -f "$helpers/records/projects" ]; then
      mc="" mn=0
      while IFS= read -r p || [ -n "$p" ]; do
        p=${p%$'\r'}
        [ -n "$p" ] && [ -f "$p/.claude/discord-agents/$mb/hosts" ] || continue
        mc=$p; mn=$((mn + 1))
      done < "$helpers/records/projects"
      [ "$mn" != 1 ] || cd "$mc"
    fi;;
  esac
  exec bash "$self_root/monitor/monitor.sh" "$self_path" "$@"
fi

# tui: a view of the monitor's state.json, and the hosts ledger's editor through `hosts` (tui/claude_discord_tui.py,
# Python + Textual through `uv run --script`; uv is needed for this verb only).
# The bot is the project's one dev-manager bot with a hosts ledger unless named. Outside any project: the recorded
# projects' manager bots (records/projects), and the cwd becomes the chosen project's root.
if [ "${1:-}" = tui ]; then
  bot=${2:-}
  # From anywhere inside the project, like the shim: up to the directory that holds .claude/discord-agents.
  here=$PWD
  while [ ! -d "$PWD/.claude/discord-agents" ] && [ "$PWD" != / ]; do cd ..; done
  # A project above with no manager bot (or not the one named), e.g. a plain bot's project, counts as none; a bot named
  # that lives here stays here, so its own refusal (no ledger) is the one said.
  mgr_here=""
  [ -z "$bot" ] || [ ! -d "$PWD/.claude/discord-agents/$bot" ] || mgr_here=1
  for d in "$PWD"/.claude/discord-agents/*/; do
    d=${d%/}
    [ -f "$d/hosts" ] && [ "$(cat "$d/mode" 2>/dev/null)" = dev-manager ] && { [ -z "$bot" ] || [ "$bot" = "${d##*/}" ]; } && { mgr_here=1; break; }
  done
  if [ -z "$mgr_here" ]; then
    # No manager project above: the recorded ones (records/projects, as health --all reads it), the manager bots with a ledger.
    cands="" n=0 pf=$helpers/records/projects
    if [ -f "$pf" ]; then
      while IFS= read -r p || [ -n "$p" ]; do
        p=${p%$'\r'}; [ -n "$p" ] || continue
        for d in "$p"/.claude/discord-agents/*/; do
          d=${d%/}; b=${d##*/}
          [ -f "$d/hosts" ] && [ "$(cat "$d/mode" 2>/dev/null)" = dev-manager ] || continue
          [ -z "$bot" ] || [ "$bot" = "$b" ] || continue
          c=$b$'\t'$p$'\n'
          case $'\n'$cands in *$'\n'"$c"*) continue;; esac
          cands=$cands$c; n=$((n + 1))
        done
      done < "$pf"
    fi
    [ "$n" -gt 0 ] || { echo "claude-discord: tui: no project above $here with a manager bot, and no recorded project has a dev-manager bot${bot:+ '$bot'} with a hosts ledger (claude-discord setup <bot> --mode writes one)" >&2; exit 1; }
    if [ "$n" = 1 ]; then
      pick=${cands%$'\n'}
    else
      [ -t 0 ] || { echo "claude-discord: tui: more than one recorded manager bot; run it in a project, or at a terminal to choose:" >&2; while IFS=$'\t' read -r b p; do [ -z "$b" ] || echo "  $b  $p" >&2; done <<<"$cands"; exit 2; }
      # The replacement in a variable: bash 3.2 prints quotes inside ${p/#..} literally ("~"/x, measured on wmac).
      t='~' i=0; while IFS=$'\t' read -r b p; do [ -z "$b" ] || { i=$((i + 1)); echo "$i) $b  ${p/#"$HOME"/$t}"; }; done <<<"$cands"
      read -rp "Number: " i || i=""
      case $i in ''|*[!0-9]*|0*) echo "claude-discord: tui: not a number: '$i'" >&2; exit 2;; esac
      pick=$(sed -n "${i}p" <<<"$cands")
      [ -n "$pick" ] || { echo "claude-discord: tui: no entry $i" >&2; exit 2; }
    fi
    bot=${pick%%$'\t'*}; cd "${pick#*$'\t'}"
  fi
  root=$PWD/.claude/discord-agents
  if [ -z "$bot" ]; then
    n=0
    for d in "$root"/*/; do
      d=${d%/}
      [ -f "$d/hosts" ] && [ "$(cat "$d/mode" 2>/dev/null)" = dev-manager ] || continue
      bot=${d##*/}; n=$((n + 1))
    done
    if [ "$n" != 1 ]; then
      # Not exactly one: ask at a terminal, else say what to type.
      [ -t 0 ] || { echo "claude-discord: tui: name the manager bot (claude-discord tui <bot>); this project has $n dev-manager bots with a hosts ledger" >&2; exit 2; }
      read -rp "Manager bot: " bot || bot=""
    fi
  fi
  case $bot in ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$bot'" >&2; exit 2;; esac
  [ -f "$root/$bot/hosts" ] || { echo "claude-discord: tui: $root/$bot has no hosts ledger (claude-discord setup $bot --mode writes one)" >&2; exit 1; }
  uv=${CLAUDE_DISCORD_UV:-uv}
  command -v "$uv" >/dev/null 2>&1 || { echo "claude-discord: tui needs uv (https://docs.astral.sh/uv/); nothing else in claude-discord does" >&2; exit 1; }
  # The backend's keeper, detached, so the monitor outlives the TUI (none is started when one runs; monitor.log says
  # why). Stopped by its owner (monitor --stop): the TUI asks whether to start it again.
  [ -e "$HOME/.claude-discord/records/monitor/$bot/stopped" ] ||
    bash "$self_root/monitor/monitor.sh" "$self_path" --keep "$bot" --detach </dev/null >/dev/null || :
  # The cwd stays the project root: the TUI's `monitor --ensure` call reads the ledger from there.
  exec "$uv" run --script "$self_root/tui/claude_discord_tui.py" --bot "$bot" \
    --state-dir "$HOME/.claude-discord/records/monitor/$bot" --claude-discord "$self_path"
fi

args=() name="" skip=0 want_name=0 named=0 positional=0 has_name=0 bare=0
# With a --name anywhere, a bare word is an argument for claude, not the bot
# (`-p hello --name beta` keeps `hello`).
for a in "$@"; do case $a in -n|--name|--name=*) has_name=1;; esac; done
seen_name=0
for a in "$@"; do
  if [ "$want_name" = 1 ]; then name=$a; named=1; want_name=0; continue; fi
  if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) args+=("$a"); continue;; esac; fi   # a value never starts with "-" (see refresh)
  case $a in
    # --name/-n IS the bot name, and the session is named after it (-n below).
    -n|--name) want_name=1; seen_name=1;;
    --name=*)  name=${a#--name=}; named=1; seen_name=1;;
    -*) args+=("$a"); takes_value "$a" && skip=1 || :;;
    *)  if [ "$has_name" = 0 ] && [ -z "$name" ]; then name=$a; positional=1
        else
          # A set-up bot's name as the first bare word BEFORE --name is the old positional form
          # mixed with the new one; a bare word after --name (or with no --name) is claude's.
          bare=$((bare + 1))
          case $a in */*|.|..) ;; *) [ "$has_name" != 1 ] || [ "$seen_name" = 1 ] || [ "$bare" != 1 ] || [ ! -f "$root/$a/.env" ] || { echo "claude-discord: '$a' and --name both name a bot; use 'claude-discord --name <bot> ...' (the positional 'claude-discord <bot> ...' is the old form), never both" >&2; exit 2; };; esac
          args+=("$a")
        fi;;
  esac
done
if [ "$want_name" = 1 ] || { [ "$named" = 1 ] && [ -z "$name" ]; }; then echo "claude-discord: --name needs a bot name" >&2; exit 2; fi
[ "$positional" = 1 ] && [ "$named" != 1 ] &&
  echo "claude-discord: 'claude-discord $name ...' is deprecated; use 'claude-discord --name $name ...'" >&2

# --resume <id|name> with no --name: the bot is the one whose job record carries
# its DISCORD_STATE_DIR (every launch passes it in --settings; the daemon keeps
# it), else the one the value itself names.
rid=""
for i in "${!args[@]}"; do
  case ${args[i]} in
    --resume|-r) rid=${args[i+1]:-};;
    --resume=*)  rid=${args[i]#--resume=};;
    -r=*)        rid=${args[i]#-r=};;
  esac
done
if [ -z "$name" ] && [ -n "$rid" ]; then
  cands=""
  # Only an id-shaped value (8+ hex) is a prefix of a session id: a bot called
  # dead or beef must not match another bot's record.
  ridl=$(printf '%s' "$rid" | tr 'A-Z' 'a-z')
  printf '%s' "$ridl" | grep -qE '^[0-9a-f-]{8,}$' || ridl=""
  for f in ${ridl:+"${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/jobs/*/state.json}; do
    jq -e --arg r "$ridl" '((.sessionId // "") | startswith($r)) or ((.resumeSessionId // "") | startswith($r))' "$f" >/dev/null 2>&1 || continue
    # The raw file, as refresh reads it: inside state.json the --settings value
    # is a JSON string, so its quotes appear escaped as \".
    for d in "$root"/*/; do
      d=${d%/}
      grep -qF -- "DISCORD_STATE_DIR\\\": \\\"$d\\\"" "$f" || continue
      case " $cands " in *" ${d##*/} "*) ;; *) cands="$cands ${d##*/}";; esac
    done
  done
  case $cands in
    '') ;;
    ' '*' '*) echo "claude-discord: --resume $rid matches sessions of several bots ($cands ); name the one with --name" >&2; exit 2;;
    *) name=${cands# };;
  esac
  case $rid in */*) ;; *) [ -n "$name" ] || { [ -f "$root/$rid/.env" ] && name=$rid; } || :;; esac
fi
if [ -z "$name" ]; then
  bots=()
  for d in "$root"/*/; do [ -f "$d/.env" ] && bots+=("$(basename "$d")"); done
  case ${#bots[@]} in
    1) name=${bots[0]};;
    0) echo "claude-discord: no bot set up in $root; run 'claude-discord setup <name>' in this directory first" >&2; exit 1;;
    *) echo "claude-discord: this directory has several bots (${bots[*]}); name the one to start with --name" >&2; exit 2;;
  esac
fi
case $name in
  ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
  hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
esac
dir=$root/$name
if [ ! -f "$dir/.env" ] || [ ! -f "$root/config.env" ]; then
  echo "claude-discord: no bot '$name' under $root; run 'claude-discord setup $name' in this directory first" >&2
  exit 1
fi
. "$root/config.env"

# Everything that can refuse the start comes before anything is written (the
# handoff below is consumed, so a refusal after it would lose it).
# `claude --resume` takes a full session id; a NAME only works through the
# interactive picker, which cannot appear under --bg and is a detour otherwise.
# So resolve a name, or a short id as `claude agents` prints it, against this
# project's transcripts. Anything already a full id, or not found, is passed
# through untouched and claude decides.
res_i=-1 res_pre=""
for i in "${!args[@]}"; do
  case ${args[i]} in
    --resume|-r)  res_i=$((i+1)); res_pre="";;
    --resume=*)   res_i=$i;       res_pre="--resume=";;
    -r=*)         res_i=$i;       res_pre="-r=";;
  esac
done
want=""
[ "$res_i" -ge 0 ] && want=${args[res_i]:-} && want=${want#"$res_pre"}
if [ -n "$want" ] && ! printf '%s' "$want" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
  # Claude Code's own transcript-dir naming: EVERY non-alphanumeric character
  # of the path becomes '-'. A narrower `tr './'` missed '_' and silently left
  # the name unresolved, and `--bg --resume <name>` then hangs on a picker.
  proj=$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
  found=""
  if printf '%s' "$want" | grep -qE '^[0-9a-f]{8}$'; then
    found=$(cd "$proj" 2>/dev/null && ls -t "$want"*.jsonl 2>/dev/null | head -1) || :
  else
    # The name is the session's own title (claude-discord -n, or /rename), which
    # is rewritten on every change, so only the LAST record of a file counts.
    found=$(cd "$proj" 2>/dev/null && for f in $(ls -t ./*.jsonl 2>/dev/null); do
      t=$(tail -c 262144 "$f" | grep -o '"customTitle":"[^"]*"' | tail -1)
      [ "$t" = "\"customTitle\":\"$want\"" ] && { echo "${f#./}"; break; }
    done) || :   # no match is not an error: `set -e` would abort on the loop's last test
  fi
  if [ -n "$found" ]; then
    args[res_i]="$res_pre${found%.jsonl}"
    echo "claude-discord: --resume $want -> ${found%.jsonl}" >&2
  fi
fi
# Whatever --resume ends up pointing at, resolved just above or passed through
# as a full id, is the session this start is about to reopen: the reaping below
# must never delete it. A transcript's basename IS the session id, and a name
# resolves to the newest transcript of this bot in this project, which is
# exactly the kind of row the daemon calls done.
resume_id=""
[ "$res_i" -ge 0 ] && resume_id=${args[res_i]:-} && resume_id=${resume_id#"$res_pre"}

# `claude` here is whatever bash finds on PATH, never a shell function: a setup
# that wraps claude in a process wrapper must name it, or that wrapping is
# skipped (measured 2026-09-18 with a launcher that wires a proxy chain: the
# bare binary bypassed it). CLAUDE_CODE_PROCESS_WRAPPER is Claude Code's own
# name for that wrapper and is exported into every session, so honouring it
# means an environment that already has one needs no extra setting. Not every
# session gets it in the environment though (settings.json's `env` block is
# merged into the session, not necessarily into the shell that starts it), so
# a session-scoped wrapper falls back to reading it from the same file Claude
# Code itself reads it from: ~/.claude/settings.json.
bin=$(command -v claude) || { echo "claude-discord: claude is not on PATH" >&2; exit 127; }
launcher=${CLAUDE_DISCORD_LAUNCHER:-${CLAUDE_CODE_PROCESS_WRAPPER:-}}
# Asked of jq only when the file names it at all: every bot start comes through here, and one jq start is 10 ms with jq 1.6.
if [ -z "$launcher" ] && [ -r "$HOME/.claude/settings.json" ]; then
  { case $(<"$HOME/.claude/settings.json") in   # 2>/dev/null: bash warns about a NUL byte in a file it reads
    *CLAUDE_CODE_PROCESS_WRAPPER*) launcher=$(jq -r '.env.CLAUDE_CODE_PROCESS_WRAPPER // empty' "$HOME/.claude/settings.json") || : ;;
  esac; } 2>/dev/null
fi
run=("$bin")
[ -n "$launcher" ] && run=("$launcher" "$bin")

# A second copy of a live session would put two sessions on one token, and the
# old row could be revived by a fleet claim: refresh replaces it instead. Same
# rule as refresh's: a row `claude agents --json` lists (no --all) is live unless
# stopped, and `done` is live (an idle bot sits there). The row is matched by
# sessionId or resumeSessionId (a prefix of 8+ hex is enough) or by its job id,
# which a resumed session keeps while its sessionId changes. Fails open: no
# listing (claude agents errors, hangs past 5 s, or prints a non-array) starts
# as before.
if [ -n "$resume_id" ]; then
  lt=(); command -v timeout >/dev/null 2>&1 && lt=(timeout 5)
  if agents=$(${lt[@]+"${lt[@]}"} "$bin" agents --json 2>/dev/null) &&
     live=$(printf '%s' "$agents" | jq -r --arg s0 "$resume_id" '($s0 | ascii_downcase) as $s | if type == "array" and ($s | test("^[0-9a-f-]{8,}$")) then first(.[] | select((((.sessionId // "") | startswith($s)) or ((.resumeSessionId // "") | startswith($s)) or (.id == $s[0:8])) and (.state // "") != "stopped")) | (.id // "?" | tostring) else empty end' 2>/dev/null) && [ -n "$live" ]; then
    # A dead session the listing still shows as done counts too; stopping its row is the way to resume it.
    echo "claude-discord: session $resume_id is running (job $live); use 'claude-discord refresh $name' to replace it, or, if that session is dead but still listed, 'claude stop $live' and then --resume" >&2
    exit 2
  fi
fi

# Pre-existing setups: same policy the old first-run write produced.
[ -f "$dir/access.json" ] || write_access "$dir" true
ensure_ack_reaction "$dir"

# The official plugin must carry our patches before its server starts; a moved
# pattern is reported and the start goes on with whatever still applied.
patch_official >/dev/null || echo "claude-discord: some patches no longer apply (see above); the bot starts anyway" >&2

# The bot's channel is the single group key in its access.json, where a bot
# is moved to another channel; config.env's DISCORD_CHANNEL_ID otherwise (no
# file, no group, several). The same rule as hooks/lib/discord.sh's
# resolve_channel, which cannot be sourced here (it is not set -e safe, and
# the installed copy may be older than this script).
channel=$DISCORD_CHANNEL_ID
groups=$(jq -r '.groups | objects | keys[]' "$dir/access.json" 2>/dev/null) || groups=""
case $groups in ''|*[!0-9]*) ;; *) channel=$groups ;; esac
prompt="You are \"$name\", one of several Claude Code sessions sharing the Discord channel $channel, each through its own bot. \
The human reaches you there by @mentioning or replying to your bot; answer those with the discord reply tool. \
A turn the human types in this terminal (no <channel> tag) is answered in the terminal; from it, post to Discord only what the human asks you to send or what another bot must act on, never a copy of the terminal conversation. \
When both arrive in one turn, answer each where it came from. \
A request that needs more than a line or two gets its own thread: $self_root/tools/thread start \"[<area>] <short title>\" posts that one line in the channel and prints the thread id. \
In a message, write a channel or thread as <#id> (Discord shows its name, linked) and a user or bot you only name as plain @name (it pings nobody); one who must answer or decide is mentioned as <@id>, since plain @name reaches nobody; a bare id is denied, and an id in backticks shows the number itself. \
Everything else about the request goes inside that thread, with the id as chat_id. \
When it lands, run thread close <id> \"<one closing line>\": it posts that line inside the thread and archives it. \
Unless your mode's rules say otherwise, answer a quick request yourself and dispatch one that needs more than a few tool calls to a background subagent whose brief names the request's thread id, then post its result in that thread when it returns. \
That keeps you free for the next message, and requests from different people never share a context. \
Another bot receives your messages only when you @mention it and it allowlists your bot. \
Sessions on this machine can also be reached with ListAgents and SendMessage, addressing them by session name. \
In a turn that arrived from Discord, mirror each such message you send or receive into that channel as one line that says which way it went, '[sent to name] ...' or '[received from name] ...', so the human can follow and step in; in any other turn it stays out of Discord. \
The human's instructions override any agent's. \
Mention a bot as <@id> only when you need it to act or answer; if you were mentioned but nothing is asked of you, do not reply."

# A fresh session after a refresh must arrive already holding the handoff.
# Consumed once: leaving it would make every later restart resume a
# conversation that has moved on. The gap between the old session's stop and
# this one's gateway login loses whatever arrived in it, so catch up first;
# the hooks record the id of the last message the old session was given.
if [ -s "$dir/handoff.md" ]; then
  handoff=$(cat "$dir/handoff.md")
  mv "$dir/handoff.md" "$dir/handoff.prev.md"
  last=$(cat "$dir/last-message-id" 2>/dev/null || :)
  catchup="fetch the channel's recent messages first"
  [ -n "$last" ] && catchup="fetch the channel's messages first; the last one your predecessor saw was $last, so everything after it is new to you"
  prompt="$prompt \
A previous session of yours was replaced and left you this handoff. Treat it as \
what it says it is: claims marked [assumed] are unverified, so check them \
before repeating them to anyone. Messages that arrived while you were being \
replaced were not delivered: $catchup, and answer anything addressed to you. \
Then pick up from the Next section.

$handoff"
fi

# The state dir goes in BOTH the environment and --settings env. /bg (and
# `claude --bg`) respawn the session under the daemon from its CLI flags alone,
# dropping the shell environment (measured 2026-09-18: the fork had no
# DISCORD_STATE_DIR, its plugin server found no token and died silently);
# --settings is one of the flags the daemon carries over.
export DISCORD_STATE_DIR=$dir

# Claude Code's daemon retires a background session after about an hour idle,
# and nothing here ever removed the retired one: `refresh` stops a session but
# never `rm`s it, so every start of a bot left one more dead entry in the agent
# view for ever (measured 2026-09-19 on an owner's machine: 7 rows for 2 bots,
# 4 of them stopped or done). So a start reaps its OWN dead sessions first:
# this bot's name, started in THIS project directory, and a state that says the
# session is over. `claude rm` deletes the session and, if it had one (the
# wrapper passes -w/--worktree through), its worktree, so everything else
# stays -- another name, another project, any live state (idle, busy, waiting,
# working, blocked), and an interactive entry with no state at all, none of
# which is this start's to remove. The session this very start is resuming is
# kept too ($resume_id, see above): --resume resolves a name to exactly such a
# done row, and reaping it would delete what the start is reopening.
# `claude rm <id>` takes the record's own `.id`, an 8-character job id, not
# `.sessionId` (a full transcript-basename UUID): measured 2026-09-19 on an
# owner's machine, `claude rm <sessionId>` answered "No job matching" while
# `claude rm <job id>` removed it, and `claude rm --help` says `Usage: claude
# rm <id>`. Most rows' `.id` equals `.sessionId`'s first 8 characters, but not
# all: a resumed session gets a new sessionId while the job id stays, so the
# two must not be conflated. $resume_id is a full sessionId (a --resume value
# resolves to a transcript basename) either way, but not necessarily the
# job's CURRENT one: a short id resolves by transcript PREFIX (see above),
# to that job's ORIGINAL transcript, so for a resumed job $keep ends up the
# stale sessionId, not the live one. `.sessionId != $keep` alone misses that
# case, so a row's `.id` is also compared, against $keep's first 8
# characters: a transcript's basename always starts with its job's id,
# whichever transcript the resolver landed on.
# Both calls go to "$bin", never "$run": they are local daemon bookkeeping and
# start no session, so a process wrapper (a proxy chain, a version pin) has
# nothing to wrap here and would only add a process per call.
# A start must never fail or stall on housekeeping, so every step is optional:
# no jq, no `timeout`, a listing that fails, hangs past 5 s, is not JSON, is
# not an array or is empty all leave the start exactly as it was, at most one
# line on stderr. The removals are capped at 20 per start, oldest first by
# startedAt, so a first run against a long-neglected daemon cannot turn a start
# into a minute of `rm` calls; the next start takes the next 20.
prune_dead_sessions() {
  local list ids id failed=0 t=()
  command -v jq >/dev/null 2>&1 || return 0
  if command -v timeout >/dev/null 2>&1; then t=(timeout 5); fi
  list=$(${t[@]+"${t[@]}"} "$bin" agents --json --all 2>/dev/null) || return 0
  # jq's regex engine (Oniguruma) treats `$` as matching before a single
  # trailing newline, so test("^[0-9a-fA-F]{8}$") alone lets an `.id` of
  # "8705916e\n" through: measured, jq -n '"8705916e\n"|test("^[0-9a-fA-F]{8}$")'
  # is true. Such a row would then take a cap slot from a real one, and its
  # raw (-r) output, split on that same embedded newline in the shell loop
  # below, would hand "8705916e" to `rm` for real. The length check closes
  # that: "8705916e\n" is 9 characters, so length==8 rejects it before either
  # of those happens.
  ids=$(printf '%s' "${list:-null}" | jq -r --arg n "$name" --arg cwd "$(pwd -P)" --arg keep "${resume_id:-}" '
    if type != "array" then empty else
      [ .[] | select(.name == $n and .cwd == $cwd
                     and (.state == "stopped" or .state == "done")
                     and (.id|type) == "string" and (.id|length) == 8 and (.id|test("^[0-9a-fA-F]{8}$"))
                     and .sessionId != $keep and .id != ($keep | .[0:8])) ]
      | sort_by(.startedAt) | .[0:20][] | .id end' 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  while IFS= read -r id; do
    # The shape check above (exactly 8 hex characters, no dashes) already
    # keeps anything else out of the sort and the cap, but a crafted id must
    # not become an argument to a delete even if something upstream of that
    # filter changes, so it is checked again here: a leading dash would read
    # as a flag, and a newline in it would otherwise arrive as two lines.
    [[ $id =~ ^[0-9a-fA-F]{8}$ ]] || continue
    "$bin" rm "$id" >/dev/null 2>&1 || failed=$((failed + 1))
  done <<<"$ids"
  [ "$failed" = 0 ] || echo "claude-discord: could not remove $failed dead session(s) of $name from the agent view" >&2
}

ensure_hooks_symlink
prune_dead_sessions || :   # even its last line (a warning on a closed stderr) may not fail the start
# worktree.bgIsolation "none" turns off Claude Code's background-isolation
# guard for this session: measured on two machines, a session started with
# --bg is refused Edit/Write in the checkout by that guard while a session
# moved to the background with /bg from the foreground is not. A bot editing
# its own project should behave like the /bg case either way it got there,
# and this needs no change to the project's own settings.json. Inert for a
# foreground start.
exec "${run[@]}" --channels "plugin:$plugin" \
  --settings "{\"enabledPlugins\": {\"$plugin\": true}, \"env\": {\"DISCORD_STATE_DIR\": \"$dir\"}, \"worktree\": {\"bgIsolation\": \"none\"}}" \
  -n "$name" --append-system-prompt "$prompt" ${args[@]+"${args[@]}"}
