#!/usr/bin/env bash
# Runs a Claude Code session behind its own Discord bot, so several sessions
# can sit in one Discord channel. The human talks to each by @mentioning its
# bot; the bots reach each other the same way once allowlisted (the start
# patches the plugin to let other bots through), and sessions on one machine
# can also use SendMessage, mirroring those exchanges into the channel.
#
#   claude-discord setup <name> [--reset|--mode]  ask for channel/user IDs, allowed users, the
#                                          bot token, mention policy and mode (dev-manager also
#                                          asks for its peers); --reset asks all again; --mode
#                                          asks only the mode (and, for dev-manager, the peers)
#                                          for a bot already set up
#   claude-discord [name] [claude args]  start the session named <name>; the
#                                          name may come before or after the
#                                          claude args, and may be left out when
#                                          the project has exactly one bot
#   claude-discord refresh <name> [--force] [claude args]
#                                        replace the running session with a fresh
#                                        one that starts from its handoff
#   claude-discord health [--json]
#                                        is every bot in this project still
#                                        answering? exit 1 on a finding
#   claude-discord health --uninstall-timer
#                                        remove the systemd --user timer an
#                                        older version installed; no OS
#                                        scheduler is installed any more
# All run from the project directory: state is ./.claude/discord-agents/<name>/.
#
# Origin: d.kim4's wrapper (2026-09-18), published at
# https://github.com/codeslake/claude-discord. Portable on purpose: nothing
# here assumes a particular shell setup.
#
#   CLAUDE_DISCORD_LAUNCHER   optional. An environment that wraps `claude` in a
#                             process wrapper (proxy chain, version pin) names
#                             it here and the session is started as
#                             `$CLAUDE_DISCORD_LAUNCHER <claude-bin> <args>`.
#                             Unset, Claude Code's own CLAUDE_CODE_PROCESS_WRAPPER
#                             is used, from the environment or, failing that,
#                             from `.env.CLAUDE_CODE_PROCESS_WRAPPER` in
#                             ~/.claude/settings.json; unset too, plain `claude`
#                             on PATH.
#   claude-discord patch      patches every cached copy of the official discord
#                             plugin (also run at each start): bots hear each
#                             other, @everyone wakes none, long replies split
#                             fence-safe (runtime/discord-chunk.ts), the gateway
#                             follows HTTPS_PROXY (runtime/discord-proxy.ts).
# Needs: bun, jq, and `claude plugin install discord@claude-plugins-official`.
set -euo pipefail

# State lives in the PROJECT, next to its other .claude/ files, so a bot belongs
# to the directory you start it from and `setup` is run there. The token is a
# plaintext secret inside a git tree, so setup drops a `*` .gitignore into the
# directory: nothing under it is ever staged, and the project's own .gitignore
# is left alone.
root=$PWD/.claude/discord-agents
helpers=$HOME/.claude-discord
plugin=discord@claude-plugins-official
# This script lives at <plugin root>/bin/claude-discord; the plugin's tools
# and rules are named from here, resolved through any symlink to the real copy.
self_root=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd -P)

# access.json is written at setup time, so every answer lives in the file the
# plugin reads and nothing else needs persisting. The run path below keeps a
# fallback for bot dirs set up before this existed.
write_access() {  # $1 = bot dir, $2 = requireMention (true|false)
  jq -n --arg ch "$DISCORD_CHANNEL_ID" --arg me "$DISCORD_USER_ID" \
        --arg others "${DISCORD_ALLOW_IDS:-}" --argjson mention "$2" \
    '{dmPolicy: "allowlist", allowFrom: [$me], ackReaction: "👀",
      groups: {($ch): {requireMention: $mention,
                       allowFrom: ([$me] + ($others | split(",") | map(gsub("\\s";"")) | map(select(. != ""))))}}}' \
    > "$1/access.json"
}

# Every JSON file claude-discord edits in place (settings.json, access.json,
# peers.json) goes through here: the file (a missing or 0-byte one reads as
# {}) is run through the jq filter in the arguments and written back only
# when the result differs, through a symlink (`cat tmp > file`, never mv)
# and with a trailing newline. A file that is not valid JSON, a filter that
# fails on it (a non-object, an event key holding a non-array) or a failed
# write is warned about on stderr, naming the file, and left alone: an edit
# must never fail the setup or the start it runs inside.
jq_edit() {  # $1 = file, the rest = jq arguments
  local f=$1 base='{}' merged
  shift
  if [ -e "$f" ]; then
    base=$(jq . "$f" 2>/dev/null) || { echo "claude-discord: $f is not valid JSON, leaving it alone" >&2; return 0; }
    [ -n "$base" ] || base='{}'
  fi
  merged=$(printf '%s' "$base" | jq "$@" 2>/dev/null) || merged=""
  [ -n "$merged" ] || { echo "claude-discord: could not update $f, leaving it alone" >&2; return 0; }
  [ "$merged" != "$base" ] || return 0
  if mkdir -p "$(dirname "$f")" 2>/dev/null && printf '%s\n' "$merged" > "$f.tmp.$$" 2>/dev/null && cat "$f.tmp.$$" > "$f" 2>/dev/null; then
    :
  else
    echo "claude-discord: could not write $f, leaving it alone" >&2
  fi
  rm -f "$f.tmp.$$"
}

# Registers this project's hooks, all of them in settings.local.json, which is
# gitignored and per machine, and none in settings.json, which a shared repo
# tracks: writing our entries there on every bot start left such a repo dirty,
# blocked its merge script and broke its own tests on a clean checkout
# (2026-10-09). settings.local.json is still project-wide, so every session of
# the checkout still runs them; they exit at once outside a Discord turn. Five
# entries are the same for every bot on every machine: the four Discord-turn
# hooks (identity/refresh, primed once per session; the reply flag; the
# checkmark reaction; at session start, re-priming after a compact/clear and
# clearing a turn left over from a startup/resume), which make a turn that
# arrived over Discord be answered through the discord reply tool only, never
# also typed into the CLI, and peers/thread-guard, which keeps Discord to
# Discord turns and the channel to short lines, on a reply and on an edit
# alike. Every other entry is registered only while its mode is among $1, the
# modes of the bots THIS machine runs (the three peers hooks for dev-manager,
# on-start for autoresearchclaw). Any entry of ours (a command under
# .claude/discord-agents/hooks/) that a file should not hold is removed from
# it: a mode hook no bot needs, a hook in settings.json (every earlier version
# put the five every-bot entries there), one that no longer exists
# (turn/on-compact became turn/on-session-start) or one under another event or
# matcher (autoresearchclaw/on-start was startup|resume), along with a matcher
# group or an event left empty by that. Each command guards on [ -x ], so a
# machine without the hooks installed simply runs nothing.
# Idempotent per entry, and a file is written only when it changes (Claude
# Code writes its permission grants into settings.local.json).
# Parallel arrays, not a packed "event|matcher|script" string, because a
# matcher itself can contain "|" (startup|resume|compact|clear).
register_hooks() {  # $1 = the project's bot modes, space-separated
  local modes=" ${1:-} "
  local events=(UserPromptSubmit PostToolUse Stop SessionStart PreToolUse PostToolUse PreToolUse PreToolUse SessionStart)
  local matchers=("" "mcp__plugin_discord_discord__reply" "" "startup|resume|compact|clear" "mcp__plugin_discord_discord__reply" "mcp__plugin_discord_discord__reply" "mcp__plugin_discord_discord__reply|mcp__plugin_discord_discord__edit_message" "Edit|Write|MultiEdit" "startup|resume|compact|clear")
  local scripts=(turn/on-prompt turn/on-reply turn/on-stop turn/on-session-start peers/mention-guard peers/checkin peers/thread-guard peers/edit-gate autoresearchclaw/on-start)
  local needs=("" "" "" "" dev-manager dev-manager "" dev-manager autoresearchclaw)   # the mode an entry needs; "" = every bot
  local want='[]' i cmd file
  for i in "${!events[@]}"; do
    [ -z "${needs[i]}" ] || case $modes in *" ${needs[i]} "*) ;; *) continue ;; esac
    cmd="h=\"\$CLAUDE_PROJECT_DIR/.claude/discord-agents/hooks/${scripts[i]}\"; [ ! -x \"\$h\" ] || \"\$h\""
    want=$(printf '%s' "$want" | jq -c --arg ev "${events[i]}" --arg m "${matchers[i]}" --arg cmd "$cmd" \
      '. + [{ev: $ev, m: $m, cmd: $cmd}]') || return 0
  done
  for file in settings.json settings.local.json; do
    jq_edit "$PWD/.claude/$file" --argjson all "$want" --arg file "$file" '
      (if $file == "settings.local.json" then $all else [] end) as $want
      | ((.hooks | type) == "object" and (.hooks | tostring | contains("/.claude/discord-agents/hooks/"))) as $ours
      | def stale($ev; $m): (.command? // "" | tostring) as $c
          | ($c | contains("/.claude/discord-agents/hooks/"))
            and ([$want[] | select(.ev == $ev and .m == $m) | .cmd] | index($c)) == null;
      (if (.hooks | type) != "object" then . else
        .hooks |= with_entries(.key as $ev
          | if (.value | type) == "array" and any(.value[]; (.matcher? // "") as $m | any(.hooks?[]?; stale($ev; $m))) then
              .value |= map((.matcher? // "") as $m
                | if any(.hooks?[]?; stale($ev; $m)) then (.hooks |= map(select(stale($ev; $m) | not))) | select(.hooks | length > 0) else . end)
              | select(.value | length > 0)
            else . end)
      end)
      | reduce $want[] as $w (.;
          if any(.hooks[$w.ev][]?.hooks?[]?; .command? == $w.cmd) then .
          else .hooks[$w.ev] = ((.hooks[$w.ev] // []) + [(if $w.m == "" then {} else {matcher: $w.m} end) + {hooks: [{type: "command", command: $w.cmd}]}])
          end)
      | if $ours and .hooks == {} then del(.hooks) else . end'   # emptied by us: leave no "hooks": {} diff behind
  done
}

# Adds access.json's ackReaction key (the plugin's own read-receipt
# reaction) only when the key is absent; an explicit "" means the owner
# disabled it and is left alone.
ensure_ack_reaction() {  # $1 = bot dir
  [ -f "$1/access.json" ] || return 0
  jq_edit "$1/access.json" 'if has("ackReaction") then . else . + {ackReaction: "👀"} end'
}

# A project's mode drops are the union over its bots' modes (<bot>/mode), so
# one dev-manager bot keeps the dev-manager rule and the peers hooks in place
# for the whole project. Whatever no bot's mode produces any more is removed:
# every .claude/rules/claude-discord-*.md but the ones kept (that prefix is
# claude-discord's own; no other file is touched), and every mode hook entry
# (see register_hooks). Run by setup and every start; idempotent; never
# aborts either.
sync_mode_drops() {
  local modes="" f keep="" rules=$PWD/.claude/rules src=$helpers/rules/dev-manager.md
  for f in "$root"/*/mode; do
    modes="$modes $(cat "$f" 2>/dev/null || :)"   # no bot yet: the glob stays literal, and set -e must not see cat fail
  done
  case " $modes " in *" dev-manager "*) keep=$rules/claude-discord-dev-manager.md;; esac
  # autoresearchclaw drops no rule file: every session under the project
  # loads one, the pipeline's own agent sessions included. Its only drop is
  # the on-start hook (see register_hooks), which hands its rule to the
  # bot's session as SessionStart context.
  for f in "$rules"/claude-discord-*.md; do
    [ "$f" = "$keep" ] || rm -f "$f" 2>/dev/null || echo "claude-discord: could not remove $f" >&2
  done
  if [ -n "$keep" ] && ! cmp -s "$src" "$keep"; then
    if [ ! -f "$src" ]; then
      echo "claude-discord: $src is missing; re-run install.sh" >&2
    elif ! { mkdir -p "$rules" && cat "$src" > "$keep"; } 2>/dev/null; then
      echo "claude-discord: could not write $keep" >&2
    fi
  fi
  register_hooks "$modes"
}

# Makes <project>/.claude/discord-agents/hooks a symlink to the installed
# hooks, so install.sh reaches a session that is already running. Only when
# the path is absent or already a symlink (broken or not); a real directory
# there is left alone with a warning.
ensure_hooks_symlink() {
  local link="$root/hooks"
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "claude-discord: $link exists and is not a symlink, leaving it alone" >&2
    return 0
  fi
  mkdir -p "$root" 2>/dev/null || return 0
  ln -sfn "$helpers/hooks" "$link" 2>/dev/null || echo "claude-discord: could not symlink $link" >&2
}

# select_one <label> <default> <option>...: prints the chosen option's first
# word (an option is "<name>  <hint>"). On a terminal, an @clack-style picker
# drawn on /dev/tty: ◆ while active, ● on the cursor row, ○ on the others;
# ↑/↓ or k/j move, Enter picks, the default starts under the cursor; it
# collapses to "◇ <label> — <choice>". Without a terminal on stdin, one line
# is read: an option name or its 1-based number; empty means the default,
# anything else too, with a warning. A subshell, so the stty change and the
# traps that undo it (Ctrl-C included) never leak into setup.
select_one() (
  label=$1 def=$2
  shift 2
  opts=("$@") cur=0
  for i in "${!opts[@]}"; do [ "${opts[i]%% *}" != "$def" ] || cur=$i; done
  if [ ! -t 0 ]; then
    IFS= read -r ans || :
    ans=${ans//[[:space:]]/} pick=-1
    for i in "${!opts[@]}"; do [ "$ans" != "${opts[i]%% *}" ] && [ "$ans" != "$((i + 1))" ] || pick=$i; done
    if [ "$pick" = -1 ]; then
      [ -z "$ans" ] || echo "claude-discord: no $label '$ans', using ${opts[cur]%% *}" >&2
      pick=$cur
    fi
    echo "${opts[pick]%% *}"
    exit 0
  fi
  exec 3<>/dev/tty
  saved=$(stty -g <&3)
  trap 'stty "$saved" <&3; printf "\e[?25h" >&3' EXIT
  trap 'exit 130' INT TERM
  stty -echo -icanon <&3
  cols=$(stty size <&3) cols=${cols#* }
  [ "$cols" -gt 20 ] 2>/dev/null || cols=80
  printf '\e[?25l' >&3
  n=0
  while :; do
    [ "$n" = 0 ] || printf '\e[%dF\e[J' "$n" >&3
    printf '\e[36m◆\e[0m  %s  \e[2m↑/↓ · enter\e[0m\n' "$label" >&3
    for i in "${!opts[@]}"; do
      if [ "$i" = "$cur" ]; then printf '\e[2m│\e[0m  \e[32m●\e[0m \e[36m%s\e[0m\n' "${opts[i]:0:cols-6}"
      else printf '\e[2m│\e[0m  ○ %s\n' "${opts[i]:0:cols-6}"; fi >&3
    done
    n=$((${#opts[@]} + 1))
    IFS= read -rn1 key <&3 || key=""
    [ "$key" != $'\e' ] || read -rn2 -t 1 key <&3 || key=x   # an arrow is ESC [ A/B, or ESC O A/B in application mode; a lone ESC does nothing
    case $key in
      k|'[A'|OA) cur=$(((cur + ${#opts[@]} - 1) % ${#opts[@]}));;
      j|'[B'|OB) cur=$(((cur + 1) % ${#opts[@]}));;
      '') break;;
    esac
  done
  printf '\e[%dF\e[J\e[32m◇\e[0m  %s — %s\n' "$n" "$label" "${opts[cur]%% *}" >&3
  echo "${opts[cur]%% *}"
)

# Installs the plugin at the chosen scope (setup has validated $scope, $method
# and the other scope's absence by now). method clone: this repo cloned into
# the skills dir, so a project can pin its own version. method link: a symlink
# to the machine's one source clone, ~/.claude-discord/source, so one update
# moves every bot; the hooks and tools resolve their real directory rather
# than trust ${CLAUDE_PLUGIN_ROOT}, and the plugin declares no .mcp.json, so
# the measured problems of a link do not bite. An existing install of either
# kind is kept as it is. Project scope loads only when ~/.claude.json trusts
# that exact path; setup asks before writing it.
has_path() { [ -e "$1" ] || [ -L "$1" ]; }   # a dangling link counts
install_plugin() {  # uses $scope $method $pdir $gdir
  local repo=${CLAUDE_DISCORD_REPO:-https://github.com/codeslake/claude-discord}
  local src=$HOME/.claude-discord/source target ex pat here t
  case $scope in project) target=$pdir;; *) target=$gdir;; esac
  if has_path "$target"; then
    echo "claude-discord: plugin already installed at $target, kept as it is"
  else
    [ -n "$method" ] || method=$(select_one Method link "link   the machine's one source clone, ~/.claude-discord/source (one update for every bot)" "clone  its own copy, so this install can pin a version")
    mkdir -p "$(dirname "$target")"
    if [ "$method" = link ]; then
      has_path "$src" || git clone -q "$repo" "$src" || { echo "claude-discord: could not clone $repo into $src" >&2; return 1; }
      ln -s "$src" "$target"
    else
      git clone -q "$repo" "$target" || { echo "claude-discord: could not clone $repo into $target" >&2; return 1; }
    fi
  fi
  # A git-tracked project (worktree, submodule or subdirectory too) keeps the
  # install out of git status; no trailing slash, so it matches a link as well.
  if [ "$scope" = project ] && git -C "$PWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    ex=$(git -C "$PWD" rev-parse --git-path info/exclude) here=$(git -C "$PWD" rev-parse --show-prefix)
    case $ex in /*) ;; *) ex=$PWD/$ex;; esac
    pat=/${here}.claude/skills/claude-discord
    grep -qxF "$pat" "$ex" 2>/dev/null || { mkdir -p "$(dirname "$ex")" && printf '%s\n' "$pat" >> "$ex"; }
  fi
  mkdir -p "$HOME/.local/bin" "$HOME/.claude-discord/records"
  cmp -s "$target/shim/claude-discord" "$HOME/.local/bin/claude-discord" ||
    install -m 755 "$target/shim/claude-discord" "$HOME/.local/bin/claude-discord"
  touch "$HOME/.claude-discord/records/installs"
  grep -qxF "$target" "$HOME/.claude-discord/records/installs" || printf '%s\n' "$target" >> "$HOME/.claude-discord/records/installs"
  # Keyed by the physical path, like refresh's check.
  if [ "$scope" = project ] && [ "$(jq -r --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted | if . == true then "yes" else "no" end' "$HOME/.claude.json" 2>/dev/null)" != yes ]; then
    echo "claude-discord: $PWD is not trusted in ~/.claude.json, so Claude Code will not load the plugin here." >&2
    read -rp "Mark this project trusted now? [y/N] " t || t=""
    case $t in y|Y) jq_edit "$HOME/.claude.json" --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted = true';; esac
  fi
}

if [ "${1:-}" = setup ]; then
  name=${2:?usage: claude-discord setup <name> [--scope project|global] [--method link|clone] [--reset|--mode]}
  # --scope and --method may sit anywhere after the name; the rest keeps its place so ${3:-} still sees --reset/--mode.
  scope="" method="" want="" rest=()
  for a in "${@:3}"; do
    if [ -n "$want" ]; then
      case $want in scope) scope=$a;; method) method=$a;; esac
      want=""
      continue
    fi
    case $a in
      --scope=*) scope=${a#--scope=};;
      --method=*) method=${a#--method=};;
      --scope) want=scope;;
      --method) want=method;;
      *) rest+=("$a");;
    esac
  done
  [ -z "$want" ] || { echo "claude-discord: --$want needs a value" >&2; exit 2; }
  set -- "$1" "$2" ${rest[@]+"${rest[@]}"}
  case $name in
    ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
    hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
  esac
  # Everything about the install that can be refused is decided here, before a
  # prompt or a write: a bad flag or a copy at the other scope must leave the
  # bot's files (and --reset's deletion) alone.
  pdir=$PWD/.claude/skills/claude-discord gdir=$HOME/.claude/skills/claude-discord
  if [ "${3:-}" = --mode ]; then
    [ -z "$scope$method" ] || { echo "claude-discord: --mode changes only the mode and installs nothing; --scope and --method do not apply" >&2; exit 2; }
  else
    case $scope in ''|project|global) ;; *) echo "claude-discord: --scope must be project or global, got '$scope'" >&2; exit 2;; esac
    case $method in ''|link|clone) ;; *) echo "claude-discord: --method must be link or clone, got '$method'" >&2; exit 2;; esac
    # Asked once per project: an install already there decides the scope.
    if [ -z "$scope" ]; then
      if has_path "$pdir"; then scope=project; elif has_path "$gdir"; then scope=global; fi
    fi
    if [ "$scope" = project ] && has_path "$gdir"; then
      echo "claude-discord: already installed globally at $gdir; remove it or use --scope global" >&2; exit 2
    elif [ "$scope" = global ] && has_path "$pdir"; then
      echo "claude-discord: already installed for this project at $pdir; remove it or use --scope project" >&2; exit 2
    fi
  fi
  umask 077
  if [ "${3:-}" = --mode ]; then
    # --mode changes only an already set-up bot's mode, so re-picking a mode
    # never re-asks the token or the mention question. It creates nothing:
    # a bot without both files gets neither a directory nor config.env.
    [ -f "$root/$name/.env" ] && [ -f "$root/$name/access.json" ] || {
      echo "claude-discord: bot '$name' is not set up; run 'claude-discord setup $name' first" >&2
      exit 2
    }
  else
    # --reset forgets this bot's token and access policy AND the shared IDs, so
    # every prompt is asked again; other bots keep their own files.
    [ "${3:-}" = --reset ] && rm -rf "$root/$name" "$root/config.env"
    mkdir -p "$root/$name"
    printf '*\n' > "$root/.gitignore"
    if [ ! -f "$root/config.env" ]; then
      read -rp "Discord channel ID: " channel
      read -rp "Your Discord user ID: " user
      read -rp "Other user or bot IDs allowed to trigger bots there (comma-separated, empty for none): " others
      others=${others//[[:space:]]/}   # the file is sourced: a stray space would run an ID as a command
      printf "DISCORD_CHANNEL_ID='%s'\nDISCORD_USER_ID='%s'\nDISCORD_ALLOW_IDS='%s'\n" "$channel" "$user" "$others" > "$root/config.env"
    fi
  fi
  [ -f "$root/config.env" ] && . "$root/config.env"   # sourced whenever present: later code (write_access) reads its variables
  if [ "${3:-}" != --mode ]; then
    keep=""
    [ -f "$root/$name/.env" ] && keep=" (empty keeps the current one)"
    read -rsp "Bot token for $name$keep: " token
    echo
    [ -z "$token" ] && [ -n "$keep" ] || printf 'DISCORD_BOT_TOKEN=%s\n' "$token" > "$root/$name/.env"
    # Every bot in one channel answering every message means N replies per human
    # message, so the default stays mention-only; opt in per bot.
    read -rp "Respond to every message in the channel without an @mention? [y/N] " nomention
    case $nomention in y|Y) mention=false;; *) mention=true;; esac
    # access.json is the bot's LIVE policy: the plugin re-reads it on every
    # message, and its groups may have been hand-edited since the last setup
    # (moved to another channel, allowFrom trimmed, ackReaction silenced). A
    # re-run must not clobber that; only a bot with none yet (new, or just
    # after --reset, which deletes the bot dir first) gets one written fresh.
    if [ -f "$root/$name/access.json" ]; then
      jq_edit "$root/$name/access.json" --argjson mention "$mention" \
        'if (.groups | type) == "object" then .groups |= map_values(.requireMention = $mention) else . end'
    else
      write_access "$root/$name" "$mention"
    fi
  fi
  mode=$(cat "$root/$name/mode" 2>/dev/null) || mode=none
  mode=$(select_one Mode "$mode" \
    "none  a plain bot" \
    "dev-manager  coordinates claude-discord changes with peer bots" \
    "autoresearchclaw  reports each AutoResearchClaw iteration to the channel")
  printf '%s\n' "$mode" > "$root/$name/mode"
  if [ "$mode" = dev-manager ]; then
    read -rp "Peer dev bots as name:bot_id:owner_id:machine, comma-separated (empty keeps the current list): " peers || :
    peers=${peers//[[:space:]]/}
    entry='^[^:]+:[0-9]+:[0-9]+:[^:]+$'
    bad=$(jq -rn --arg in "$peers" --arg re "$entry" '$in | split(",")[] | select(. != "" and (test($re) | not))')
    [ -z "$bad" ] || echo "claude-discord: skipping peers not shaped name:bot_id:owner_id:machine: ${bad//$'\n'/ }" >&2
    jq_edit "$root/peers.json" --arg in "$peers" --arg re "$entry" '
      reduce ($in | split(",")[] | select(test($re)) | split(":") | {name: .[0], bot_id: .[1], owner_id: .[2], machine: .[3]}) as $p
        (.; if any(.peers[]?; .bot_id == $p.bot_id) then .peers |= map(if .bot_id == $p.bot_id then $p else . end)
            else .peers = (.peers // []) + [$p] end)'
    # access.json's groups are kept as they are (see above), so peers go into
    # every existing group's allowFrom, wherever the bot's channel actually
    # is, not only the one keyed by config.env's channel; this bot itself is
    # skipped by name, and $a + ($ids - $a) keeps it additive, as before.
    ids=$(jq -c --arg self "$name" '[.peers[]? | select((.name // "" | tostring | ascii_downcase) != ($self | ascii_downcase)) | .bot_id | tostring]' "$root/peers.json" 2>/dev/null) || ids='[]'
    jq_edit "$root/$name/access.json" --argjson ids "${ids:-[]}" \
      'if (.groups | type) == "object"
       then .groups |= map_values(.allowFrom = ((.allowFrom // []) as $a | $a + ($ids - $a)))
       else . end'
    echo "Ask each peer's owner to add this bot's id to their allowFrom; both directions are needed."
  fi
  # --mode touches only the mode file, so it never installs or asks for a scope.
  if [ "${3:-}" != --mode ]; then
    [ -n "$scope" ] || scope=$(select_one Scope project "project  this project only (.claude/skills/claude-discord)" "global  every project (~/.claude/skills/claude-discord)")
    install_plugin || exit $?
  fi
  ensure_hooks_symlink
  sync_mode_drops
  if [ "${3:-}" = --mode ]; then
    echo "claude-discord: $root/$name/mode set to $mode"
  else
    echo "claude-discord: $root/$name/access.json written (requireMention=$mention, mode=$mode)"
  fi
  exit 0
fi

# The bot name is the first bare word, wherever it sits: `claude-discord x --bg`
# and `claude-discord --bg x` are the same command. A word that follows a flag
# taking a value is that value, so `--resume x` never reads as the name, and
# with no bare word at all the project's single bot is meant. The list is
# every flag `claude --help` (2.1.277) shows with a value, optional ones
# ([value]) included since claude takes the next word for them too, plus
# hidden ones in use (--channels, --max-turns, the *-file prompt flags).
takes_value() {
  case $1 in
    -r|--resume|--model|--effort|--settings|--agent|--agents|--permission-mode|--permission-prompts| \
    --mcp-config|--add-dir|--session-id|--fallback-model|--max-turns|--max-budget-usd| \
    --output-format|--input-format|--json-schema|--debug-file|-d|--debug|--betas|--autocompact| \
    --append-system-prompt|--append-system-prompt-file|--system-prompt|--system-prompt-file| \
    --system-prompt-snapshot|--allowedTools|--allowed-tools|--disallowedTools|--disallowed-tools| \
    --tools|--setting-sources|--plugin-dir|--plugin-url|--file|--environment|--cloud|--from-pr| \
    --teleport|--remote-control|--remote-control-session-name-prefix|--prompt-suggestions| \
    -w|--worktree|--channels|-n|--name) return 0;;
    *) return 1;;
  esac
}

# A bot can stop answering without anything failing loudly: measured on this
# machine, a worker that came back from a Claude Code self-upgrade ran no
# hooks at all for 21 hours, and a `refresh` whose `--bg` start hit the
# workspace-trust gate left the bot down for 22 -- neither reported anywhere.
# `health` is the outside check for exactly that, run by hand from outside
# the session, so it still speaks when the session is the thing that died.
#
#   claude-discord health [--json]
#   claude-discord health --uninstall-timer
#
# What it judges by, and why not the obvious thing: `claude agents`' `.state`
# is NOT a liveness signal. Measured on two machines, a fully live bot shows
# `state: done, status: idle` while its pid and its gateway connection are
# both up; `state` tracks whether a turn is running. Counting processes is no
# better on its own -- the upgrade failure above kept server, gateway and
# session alive and killed only the hooks, so every process check said
# "fine". So the PRIMARY signal is behavioural:
#
#   a message that addressed this bot, newer than the last one its hooks
#   recorded ($dir/last-message-id, written by turn/on-prompt), and older
#   than $stale_min minutes
#
# which catches a dead process, dead hooks and a wedged turn alike. The
# process count is then used only to NAME the cause (none = down, several =
# two sessions on one token). Three things would otherwise make that signal
# cry wolf, and each is filtered:
#   - the plugin drops a message from an author outside access.json's
#     allowFrom before any hook runs, so last-message-id can never catch up
#     to it; health applies the same allowFrom (empty = everyone, as there).
#   - a long turn legitimately takes minutes, so a turn in flight
#     (turns/<session id>, written by on-prompt and removed by on-stop)
#     holds the alert back -- but only while that file is younger than
#     $turn_max_min, since a turn whose hooks died leaves it behind for ever
#     and would otherwise silence the very failure this exists to catch.
#   - a human reaches a bot by replying to it, with no mention at all, so a
#     reply whose referenced_message is this bot's counts as addressing it.
# Known gap: the plugin also treats a mention of the bot's managed ROLE as
# addressing it, and the REST payload carries those in `mention_roles`, not
# in `mentions`. Such a message is not counted, so health under-reports
# there rather than crying wolf -- the safe direction for a thing that wakes
# a human.
# Never restarts anything and never stops anything: a misjudged restart is
# what puts two sessions on one token, and this is the tool most likely to
# misjudge. It reports, and a human decides.
if [ "${1:-}" = health ]; then
  shift
  stale_min=15        # an addressed message older than this with no hook record is an alert
  turn_max_min=60     # a turns/<sid> file older than this is a wedged turn, not a live one
  unknown_cap=6       # runs in a row (30 min at 5 min) that could not tell before saying so
  # However long a turn claims to be running, a message left unanswered this
  # long is worth saying out loud. `working` is a claim by the daemon, and a
  # session can sit in that state wedged on a tool call or a prompt that
  # never returns; without a ceiling the hold is unbounded and a bot can be
  # silent for days with nobody told. Deliberately generous -- well past any
  # honest turn -- so it only fires when something is really wrong.
  busy_cap_min=240    # 4 h unanswered ends the hold whatever the session says
  as_json=no timer=""
  for a in "$@"; do
    case $a in
      --json) as_json=yes;;
      --uninstall-timer) timer=uninstall;;
      *) echo "usage: claude-discord health [--json] | health --uninstall-timer" >&2; exit 2;;
    esac
  done
  # The working directory decides, and only when it holds no bots does the
  # environment stand in. `refresh` leans on DISCORD_STATE_DIR because a
  # session refreshes ITSELF, but `health` is about a project: measured,
  # running it from another project's directory inside a bot session
  # reported that session's bots instead -- a confident answer about the
  # wrong project. A session whose shell has wandered off its own project
  # still gets the fallback.
  if [ ! -d "$root" ] && [ -n "${DISCORD_STATE_DIR:-}" ]; then
    cd "$(dirname "$(dirname "$(dirname "$DISCORD_STATE_DIR")")")"
    root=$PWD/.claude/discord-agents
  fi

  # Removing a timer an older version installed. Installing one is gone: the
  # owner's rule (2026-10-09) is no OS scheduler -- a systemd unit outlives
  # every session, so a bot thought stopped comes back on the next boot.
  # One unit per project, named after its basename.
  if [ "$timer" = uninstall ]; then
    slug=$(basename "$PWD" | tr -cd 'A-Za-z0-9_-'); slug=${slug:-project}
    unit=claude-discord-health-$slug
    ud=$HOME/.config/systemd/user
    [ -f "$ud/$unit.timer" ] || [ -f "$ud/$unit.service" ] || { echo "claude-discord: no timer was installed for this project"; exit 0; }
    systemctl --user disable --now "$unit.timer" >/dev/null 2>&1 || :
    # Both paths are built from $HOME and a slug of $PWD's basename, and
    # the slug falls back to "project", so neither can be empty; unlink
    # rather than rm, since it can only ever remove one plain file.
    [ -f "$ud/$unit.timer" ] && unlink "$ud/$unit.timer"
    [ -f "$ud/$unit.service" ] && unlink "$ud/$unit.service"
    systemctl --user daemon-reload >/dev/null 2>&1 || :
    echo "claude-discord: removed $unit.timer"
    exit 0
  fi

  [ -d "$root" ] || { echo "claude-discord: no bot set up in $root" >&2; exit 1; }
  command -v jq >/dev/null 2>&1 || { echo "claude-discord: health needs jq" >&2; exit 1; }
  command -v curl >/dev/null 2>&1 || { echo "claude-discord: health needs curl" >&2; exit 1; }
  [ ! -f "$root/config.env" ] || . "$root/config.env"

  now_s=$(date +%s)
  # A Discord id is a snowflake: its top 42 bits are milliseconds since
  # 2015-01-01, so an id alone gives both an age and an ordering with no API
  # call. Ids are ~1.5e18 and bash arithmetic is 64-bit, so this cannot
  # overflow.
  # The id arrives as a decimal STRING (see addressed_ids). Bash arithmetic
  # is 64-bit and a snowflake is ~1.5e18, so this is exact -- unlike jq 1.6,
  # whose doubles are not. A leading zero would be read as octal, so it is
  # stripped; ids never have one, but the guard costs nothing.
  snowflake_s() { local i=${1#"${1%%[!0]*}"}; printf '%s' $(( ((${i:-0} >> 22) + 1420070400000) / 1000 )); }
  is_id() { case ${1:-} in ''|*[!0-9]*) return 1;; esac; return 0; }

  # Counts the plugin servers belonging to one bot. argv FIRST, environ
  # second, and that order is the whole point: every child of a bot session
  # (its shells, its subagents, its hooks) inherits DISCORD_STATE_DIR, so
  # matching on the environment alone counts them all and reports a healthy
  # bot as a duplicate. A server is `bun run --cwd <plugin>/discord/<ver>
  # ... start`, so the argv test is: argv[0] is bun, some argument sits
  # under a .../discord/ directory, and the last argument is `start`. Only
  # then is that pid's environ read, to see WHICH bot it serves. Prints
  # "unknown" where there is no /proc to read (macOS), which the caller
  # treats as "cannot tell", never as zero.
  # The candidate pids, found ONCE per run rather than once per bot.
  # Walking every /proc entry cost ~85 ms per call here (805 processes) and
  # ~300 ms on a busier machine. `pgrep -x bun` narrows it to the handful of
  # processes that could possibly be a plugin server (6 of 820 here) using
  # one C program instead of hundreds of shell reads. Without pgrep, or if it
  # errors, fall back to the full walk -- correctness must not depend on an
  # optional tool.
  # Per RUN, not per bot: the list is a property of the machine, not of a
  # bot, and calling it per bot cost 8 forks where 1 does (measured here:
  # 0.15 s for 8, 0.02 s for 1). It also makes the run self-consistent --
  # every bot is judged against the same instant -- where a per-bot list
  # could count a server for one bot that had already exited for the next.
  # A health run is a snapshot either way; this makes it one snapshot.
  server_cands=""
  if [ -d /proc ]; then
    if command -v pgrep >/dev/null 2>&1 && server_cands=$(pgrep -x bun 2>/dev/null); then
      server_cands=$(printf '/proc/%s/cmdline ' $server_cands)
    else
      server_cands=$(printf '%s ' /proc/[0-9]*/cmdline)
    fi
  fi

  count_servers() {  # $1 = bot state dir
    local n=0 c pid args a hit
    [ -d /proc ] || { printf 'unknown'; return 0; }
    for c in $server_cands; do
      # Braces around the read, not `2>/dev/null` on mapfile alone: a
      # process that exits between the glob and the read makes the SHELL
      # report the failed redirect, which mapfile's own redirection does not
      # silence, and this must print nothing but a number. No `basename`
      # either -- one fork per process on a machine with 800 of them cost
      # 281 ms a scan, against 83 ms for the expansion (measured).
      { mapfile -d '' -t args < "$c"; } 2>/dev/null || continue
      [ "${#args[@]}" -ge 2 ] || continue
      [ "${args[0]##*/}" = bun ] || continue
      [ "${args[${#args[@]}-1]}" = start ] || continue
      hit=no
      for a in "${args[@]}"; do case $a in */discord/*) hit=yes; break;; esac; done
      [ "$hit" = yes ] || continue
      pid=${c#/proc/}; pid=${pid%/cmdline}
      # -x: without it this is a SUBSTRING test, so a bot named "hbot"
      # counts "hbot2"'s server too (measured) -- the shorter-named bot then
      # reads as a duplicate and the longer-named one, when down, does not
      # read as down at all. -z makes each NUL-separated entry a line, and
      # -x anchors the whole entry.
      grep -qzxF "DISCORD_STATE_DIR=$1" "/proc/$pid/environ" 2>/dev/null && n=$((n + 1))
    done
    printf '%s' "$n"
  }

  # The age in minutes of the youngest turn in flight, or "" when none.
  # on-prompt creates turns/<session id> and appends a line for every
  # further message of the same turn, so a busy long turn keeps its mtime
  # fresh; on-stop removes it. The .primed and .replied neighbours are not
  # turn markers. The youngest, not the oldest: one wedged leftover must not
  # make a bot that is answering right now look wedged.
  turn_age_min() {  # $1 = bot state dir
    local f best="" age mt
    for f in "$1"/turns/*; do
      case $f in *.primed|*.replied|*'/*') continue;; esac
      [ -f "$f" ] || continue
      mt=$(date -r "$f" +%s 2>/dev/null) || continue
      age=$(( (now_s - mt) / 60 ))
      if [ -z "$best" ] || [ "$age" -lt "$best" ]; then best=$age; fi
    done
    printf '%s' "$best"
  }

  # Is a session of this bot, in this project, running a turn right now?
  # `.state` is useless as a LIVENESS signal (a live bot sits at `done`), but
  # this is the one thing it does measure, and the turn file's mtime cannot
  # tell a long working turn from a wedged one: on-prompt only touches that
  # file when a MESSAGE arrives, so a turn that runs for hours off a single
  # message goes stale-looking while it works. Measured 2026-09-25: this very
  # session was reported stale, with a --force refresh as the suggested fix,
  # while it was mid-turn. So the turn-file cap is only believed when the
  # daemon also says nothing is running. Unknown (no jq, no claude, a listing
  # that fails or is not a list) counts as WORKING, the quiet direction: a
  # missed alert is recoverable, an alert telling someone to force-refresh a
  # session that is busy is not.
  # Exit 0 = working, 1 = not working, 2 = could not tell. The caller treats
  # 2 like 0 (hold the alert) but counts how many runs in a row said so: a
  # daemon that keeps failing to answer is itself a sign something is wrong,
  # and holding for ever would hide it. See $unknown_cap below.
  session_working() {
    local list t=()
    command -v jq >/dev/null 2>&1 || return 2
    command -v claude >/dev/null 2>&1 || return 2
    command -v timeout >/dev/null 2>&1 && t=(timeout 5)
    list=$(${t[@]+"${t[@]}"} claude agents --json 2>/dev/null) || return 2
    printf '%s' "${list:-null}" | jq -e 'type == "array"' >/dev/null 2>&1 || return 2
    printf '%s' "$list" | jq -e --arg n "$1" --arg cwd "$(pwd -P)" '
      any(.[]; (.name? // "") == $n and (.cwd? // "") == $cwd
               and ((.state? // "") == "working" or (.status? // "") == "busy"))' \
      >/dev/null 2>&1
  }

  api() {  # $1 = path; sets $status and $resp. Token on stdin, never argv.
    local out
    out=$(printf 'Authorization: Bot %s\n' "$tok" | curl -s --max-time 10 -w '\n%{http_code}' -H @- \
      "https://discord.com/api/v10/$1" 2>/dev/null) || out=""
    status=${out##*$'\n'} resp=${out%$'\n'*}
    case $status in ''|*[!0-9]*) status=000;; esac
  }

  # The ids in a messages array that addressed this bot. An author
  # outside allowFrom is dropped exactly as the plugin drops it, so
  # last-message-id's inability to ever reach such a message cannot become
  # an alert; an EMPTY allowFrom allows everyone, as it does there. With
  # requireMention false every allowed author's message counts; with it
  # true, a mention of this bot or a reply to one of its own messages does.
  # `.mentions` excludes @everyone, which the start patches the plugin to
  # ignore too, so the two agree.
  # The author id is bound to $aid before the allowFrom test: inside
  # `$allow | index(...)` the input is the allow ARRAY, so reaching for
  # `.author` there indexes an array with a string and the whole filter dies
  # (measured: every message dropped, so a dead bot read as healthy).
  # An id is never turned into a jq NUMBER. jq 1.6 -- still /usr/bin/jq on
  # this machine -- holds every number as an IEEE double, and a 19-digit
  # snowflake does not fit in 53 bits of mantissa: measured,
  # "1553056881315025049"|tonumber|tostring gives 1553056881315025200, which
  # is LARGER than the original, so it sails past last-message-id and invents
  # a stale verdict for a bot that is perfectly idle; two ids one apart also
  # compare equal. Ids therefore stay strings, compared by (length, then
  # lexically) -- exact for fixed-width decimals, and Discord ids are 18-19
  # digits and will not reach 20 this century.
  #
  # OLDEST unanswered, not newest: the age being measured is how long the bot
  # has been failing to answer, so it must start at the FIRST message it did
  # not answer. With the newest, every fresh message resets the clock -- and
  # a wedged bot is exactly one people keep calling, so the bots this is for
  # would never be reported. The set is bounded below by last-message-id, so
  # something answered long ago cannot drag the age back.
  id_newer() {  # $1 > $2, as ids
    [ "${#1}" -gt "${#2}" ] && return 0
    [ "${#1}" -lt "${#2}" ] && return 1
    [[ $1 > $2 ]]
  }
  addressed_ids() {  # $1 = messages JSON; ids newer than $last_seen, oldest first
    printf '%s' "$1" | jq -r --arg me "$me" --argjson allow "$allow" \
      --argjson mention "$mention" --arg seen "$last_seen" '
      if type != "array" then empty else
        [ .[]
          | (.author.id? // "") as $aid
          | select($aid != $me)
          | select(($allow | length) == 0 or ($allow | index($aid)) != null)
          | select($mention == false
                   or ((.mentions // []) | any((.id? // "") == $me))
                   or ((.referenced_message.author.id? // "") == $me))
          | .id
          | select(type == "string" and test("^[0-9]{17,20}$"))
          | select((. | length) > ($seen | length)
                   or ((. | length) == ($seen | length) and . > $seen)) ]
        | sort | .[]
      end' 2>/dev/null || :
  }
  # The oldest of $oldest and every id read from $1, kept in $oldest.
  note_oldest() {  # $1 = messages JSON
    local id
    while IFS= read -r id; do
      case $id in ''|*[!0-9]*) continue;; esac
      # `cond && oldest=$id` alone would be FATAL here: under `set -e` a
      # loop body whose last command returns non-zero aborts the script, and
      # that is precisely the ordinary case -- the second id not being older
      # than the first. Measured: two unanswered messages made the whole
      # check die mid-run with no output and no error. The else branch keeps
      # the body's status zero. (Same trap as `session_working; x=$?`.)
      if [ -z "$oldest" ] || id_newer "$oldest" "$id"; then oldest=$id; fi
    done < <(addressed_ids "$1")
  }

  # Can this machine reach Discord at all? `GET /gateway` needs no token, so
  # its answer separates "the network is blocked" from "this bot's token was
  # refused" -- and without that separation the two are indistinguishable:
  # measured 2026-09-25, a run with no HTTPS_PROXY got 403 on every call and
  # blamed every bot's token, which would have sent every owner to check a
  # credential that was perfectly fine. So when the network is down, that is
  # the single finding and no token is blamed. The wording names the likely cause,
  # since a missing proxy is what produced it here.
  # Same `-w '\n%{http_code}'` shape as api() below rather than
  # `-o /dev/null -w '%{http_code}'`: the status must be taken from the LAST
  # line, since a body is written whatever -o says.
  net_status=$(curl -s --max-time 10 -w '\n%{http_code}' \
    https://discord.com/api/v10/gateway </dev/null 2>/dev/null) || net_status=""
  net_status=${net_status##*$'\n'}
  case $net_status in ''|*[!0-9]*) net_status=000;; esac
  case $net_status in 2*) net=ok;; *) net=down;; esac

  # A project fact, not a per-bot one, so it is read once rather than once
  # per bot. An explicit null test, not `// "unknown"`: jq's `//` treats
  # FALSE as empty, so the untrusted case -- the one worth reporting -- would
  # read as "unknown" and the hint would be lost.
  trusted=$(jq -r --arg p "$PWD" '.projects[$p].hasTrustDialogAccepted | if . == null then "unknown" else tostring end' "$HOME/.claude.json" 2>/dev/null) || trusted=unknown
  [ -n "$trusted" ] || trusted=unknown

  # Fields are collected separated by US (0x1f) and turned into JSON once,
  # after the loop -- one jq for the whole run instead of one per bot. A
  # variable rather than a temp file: the loop is no subshell, so it
  # survives, and a machine whose TMPDIR is unwritable still works
  # (measured: with mktemp failing, the file version printed two errors and
  # no result at all). US is chosen because no bot name, verdict, detail or
  # line of refresh.log can contain it; a bash variable could not hold NUL.
  rows=""
  for d in "$root"/*/; do
    d=${d%/}
    [ -f "$d/.env" ] || continue
    # Shell expansion, not `basename`: one fork per bot per run, five minutes
    # apart forever, for a string operation bash already does. $d has had its
    # trailing slash stripped just above, so ${d##*/} is the directory name.
    bot=${d##*/}
    tok=$(grep '^DISCORD_BOT_TOKEN=' "$d/.env" 2>/dev/null | head -1) || tok=""
    tok=${tok#DISCORD_BOT_TOKEN=}
    servers=$(count_servers "$d")
    turn=$(turn_age_min "$d")
    last_seen=$(cat "$d/last-message-id" 2>/dev/null) || last_seen=0
    is_id "$last_seen" || last_seen=0
    refresh_tail=$(tail -1 "$d/refresh.log" 2>/dev/null) || refresh_tail=""

    # The channel is the single numeric group key in access.json (where a bot
    # is moved), config.env's otherwise: the same rule as the start path and
    # hooks/lib/discord.sh. Two keys are as ambiguous as none.
    # requireMention and allowFrom come from that same group, so all three
    # are read in ONE jq: a fork per field per bot per run is pure waste, and
    # it showed up in the suite's wall time.
    # Note the explicit null tests rather than `//`: jq's `//` treats FALSE
    # as empty, so `requireMention // true` read an owner's deliberate
    # "answer everything" (false) as true and dropped every message there as
    # unaddressed -- a wedged bot in such a channel was undetectable. Third
    # place that operator bit here; false is a meaningful value in all of
    # them, so `//` is never right for one.
    cfg=$(jq -r --arg fb "${DISCORD_CHANNEL_ID:-}" '
      (.groups | objects | keys) as $k
      | (if ($k | length) == 1 and ($k[0] | test("^[0-9]+$")) then $k[0] else $fb end) as $ch
      | [ $ch,
          (.groups[$ch].requireMention | if . == null then true else . end | tostring),
          ((.groups[$ch].allowFrom // []) | map(tostring) | unique | @json) ]
      | @tsv' "$d/access.json" 2>/dev/null) || cfg=""
    IFS=$'\t' read -r ch mention allow <<<"$cfg"
    case ${ch:-} in ''|*[!0-9]*) ch=${DISCORD_CHANNEL_ID:-};; esac
    case ${mention:-} in true|false) ;; *) mention=true;; esac
    case ${allow:-} in '['*) ;; *) allow='[]';; esac

    verdict=ok detail="" oldest="" age=0 me="" status=000 resp=""
    if [ "$net" = down ]; then
      verdict=noreach detail="this machine cannot reach Discord (HTTP $net_status on the unauthenticated /gateway), so nothing can be said about any bot; behind a proxy, check HTTPS_PROXY"
    elif [ -z "$tok" ] || ! is_id "$ch"; then
      verdict=unknown detail="no token or channel in $d"
    else
      # A bot's own user id never changes, so it is asked for once and kept
      # in the state dir: that is one fewer HTTP call
      # AND one fewer jq per bot per run, for a fact that was already known.
      # A cached value is trusted only if it looks like an id.
      me=$(cat "$d/bot-id" 2>/dev/null) || me=""
      if ! is_id "$me"; then
        api users/@me
        me=$(printf '%s' "$resp" | jq -r '.id // empty' 2>/dev/null) || me=""
        ! is_id "$me" || printf '%s\n' "$me" > "$d/bot-id" 2>/dev/null || :
      fi
      if ! is_id "$me"; then
        # 401 and 403 mean the credential itself was refused. Anything else
        # -- a timeout or DNS failure (000), a rate limit (429), a Discord
        # outage (5xx) -- is not the token's fault, and saying it is sends
        # someone to rotate a credential that was fine. Those are reported
        # as what they are and no bot is blamed.
        case $status in
          401|403) verdict=unreachable detail="Discord refused this bot's token (HTTP $status)";;
          429)     verdict=throttled detail="Discord is rate-limiting this bot (HTTP 429); nothing can be said about it this run";;
          *)       verdict=apierror detail="Discord did not answer for this bot (HTTP $status); the token was not rejected, so this is Discord's side or the network";;
        esac
      else
        api "channels/$ch/messages?limit=50"
        case $status in
          2*)      note_oldest "$resp";;
          401|403) verdict=unreachable detail="cannot read the channel (HTTP $status): the bot's channel permissions or its token";;
          429)     verdict=throttled detail="Discord is rate-limiting this bot (HTTP 429); nothing can be said about it this run";;
          *)       verdict=apierror detail="cannot read the channel (HTTP $status); the token was not rejected, so this is Discord's side or the network";;
        esac
        # Threads carry their own messages, and one request for the guild's
        # active threads answers with every thread's last_message_id, so a
        # thread is only READ when something in it is newer than the last id
        # the hooks recorded. Normally that is nothing at all. The
        # last_message_id comparison is done in the shell, on strings, for
        # the jq-1.6 precision reason above.
        if [ "$verdict" = ok ]; then
          # The guild a channel belongs to cannot change -- a channel is
          # created inside one guild and is deleted, not moved -- so this
          # whole request exists to learn one immutable fact. It is kept in
          # the state dir like bot-id, which is one fewer HTTP call AND one
          # fewer jq per bot per run.
          # The CHANNEL is stored beside the guild because the bot's channel
          # CAN change (access.json is edited to move it), and a cache keyed
          # on nothing would then answer for the old channel. A cached line
          # is used only when its channel is still this one and the guild
          # still looks like an id; anything else re-fetches and rewrites it.
          gid="" cached=$(cat "$d/channel-guild" 2>/dev/null) || cached=""
          case $cached in "$ch "*) gid=${cached#* };; esac
          if ! is_id "$gid"; then
            api "channels/$ch"
            gid=$(printf '%s' "$resp" | jq -r '.guild_id // empty' 2>/dev/null) || gid=""
            ! is_id "$gid" || printf '%s %s\n' "$ch" "$gid" > "$d/channel-guild" 2>/dev/null || :
          fi
          if is_id "$gid"; then
            api "guilds/$gid/threads/active"
            for t in $(printf '%s' "$resp" | jq -r --arg c "$ch" '
                  (.threads // []) | .[] | select((.parent_id // "") == $c)
                  | [(.id // ""), (.last_message_id // "0")] | @tsv' 2>/dev/null |
                  while IFS=$'\t' read -r tid tlast; do
                    is_id "$tid" || continue
                    case $tlast in (''|*[!0-9]*) tlast=0;; esac   # (: bash 3.2 ends $( ) at a bare )
                    id_newer "$tlast" "$last_seen" && printf '%s\n' "$tid"
                  done); do
              api "channels/$t/messages?limit=50"
              case $status in 2*) note_oldest "$resp";; *) continue;; esac
            done
          fi
        fi
      fi
    fi

    # $oldest is already known to be newer than last-message-id (both the
    # channel and the thread filters require it), so there is nothing left
    # to compare here.
    if [ "$verdict" = ok ] && [ -n "$oldest" ]; then
      age=$(( (now_s - $(snowflake_s "$oldest")) / 60 ))
      if [ "$age" -ge "$stale_min" ]; then
        # `session_working; working=$?` would be fatal: the script runs under
        # `set -e`, and a non-zero exit from a command that is neither last
        # nor in a condition aborts it -- silently, since health prints as it
        # goes (measured: the whole check died with no output). `&&`/`||`
        # makes it a tested command, which set -e allows.
        working=1
        [ -z "$turn" ] || { session_working "$bot" && working=0 || working=$?; }
        # A run that could not tell is counted; a run that could resets the
        # count. Past the cap the hold is given up and the not-knowing is
        # itself the finding: `claude agents` failing repeatedly means the
        # daemon is unwell, which is exactly when a bot breaks.
        if [ "$working" = 2 ]; then
          unknowns=$(( $(cat "$d/health-unknown" 2>/dev/null || echo 0) + 1 ))
          case $unknowns in ''|*[!0-9]*) unknowns=1;; esac
          printf '%s\n' "$unknowns" > "$d/health-unknown" 2>/dev/null || :
        else
          unknowns=0
          [ ! -f "$d/health-unknown" ] || unlink "$d/health-unknown" 2>/dev/null || :
        fi
        if [ "$working" = 2 ] && [ "$unknowns" -ge "$unknown_cap" ]; then
          verdict=nostate detail="unanswered for ${age}m and 'claude agents' has not answered for $unknowns runs, so whether a turn is running cannot be told; the daemon itself may be unwell"
        elif [ -n "$turn" ] && { [ "$turn" -lt "$turn_max_min" ] || [ "$working" != 1 ]; } &&
             [ "$age" -lt "$busy_cap_min" ]; then
          verdict=busy detail="a turn has been in flight ${turn}m; holding the finding"
          case $working in
            0) detail="$detail (the session is running one now)";;
            2) detail="$detail (run $unknowns of $unknown_cap with no answer from 'claude agents')";;
          esac
        else
          verdict=stale
          case $servers in
            0)       detail="no plugin server: the bot is down";;
            1)       detail="the plugin server is up, so its hooks or its turn are stuck";;
            unknown) detail="cannot count plugin servers on this machine";;
            *)       detail="$servers plugin servers: two sessions share this bot's token";;
          esac
          detail="unanswered for ${age}m -- $detail"
          [ -z "$turn" ] || detail="$detail; a turn file has sat there ${turn}m"
          [ "$age" -lt "$busy_cap_min" ] || [ "$working" = 1 ] ||
            detail="$detail; the session still claims to be working, but ${busy_cap_min}m unanswered is too long to keep holding"
        fi
      fi
    fi
    # A duplicate is worth saying even when the bot is answering: both
    # sessions answer, so the channel gets every reply twice.
    if [ "$verdict" = ok ] && [ "$servers" != unknown ] && [ "$servers" -gt 1 ]; then
      verdict=duplicate detail="$servers plugin servers share this bot's token"
    fi
    # No server and nothing waiting to be answered: still down, and worth
    # naming before someone writes into a channel nobody is listening on.
    if [ "$verdict" = ok ] && [ "$servers" = 0 ]; then
      verdict=down detail="no plugin server for this bot"
      case $refresh_tail in *'not trusted'*) detail="$detail; its last refresh failed on workspace trust";; esac
      [ "$trusted" != false ] || detail="$detail; this project is not trusted, so a --bg start will refuse"
    fi

    rows=$rows$bot$'\x1f'$verdict$'\x1f'$detail$'\x1f'$servers$'\x1f'${turn:-}$'\x1f'
    rows=$rows${oldest:-}$'\x1f'$last_seen$'\x1f'${age:-0}$'\x1f'$refresh_tail$'\x1f'$trusted$'\x1f'


    line="claude-discord health: $bot $verdict${detail:+ -- $detail}"
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line" >> "$d/health.log" 2>/dev/null || :
    # journal too, because the log above lives in the state dir of a bot
    # whose whole problem may be that nobody is looking at it.
    ! command -v logger >/dev/null 2>&1 || logger -t claude-discord-health -- "$line" 2>/dev/null || :

    [ "$as_json" = yes ] || echo "$line"
  done
  # One jq for the whole run: it reads the NUL-separated fields, groups them
  # ten at a time into objects, prints them when asked, and reports through
  # its exit status whether anything needs a human -- so a caller can tell
  # without parsing anything. `busy` is not a
  # finding. No bots at all is an empty list, which is "nothing wrong".
  # The findings flag goes on its own LAST line, so what precedes it stays
  # exactly the JSON a caller would parse; the shell strips that line off
  # before printing. A marker merged into the document would corrupt the one
  # thing --json exists to produce.
  rows=$(printf '%s' "$rows" | jq -rRs --argjson show "$([ "$as_json" = yes ] && echo true || echo false)" '
    [ splits("\u001f") ] | .[:-1]
    | [ range(0; length; 10) as $i
        | { bot: .[$i], verdict: .[$i+1], detail: .[$i+2], servers: .[$i+3],
            turn_min: .[$i+4], oldest_unanswered: .[$i+5], last_seen: .[$i+6],
            unanswered_min: (.[$i+7] | tonumber? // 0), refresh_tail: .[$i+8],
            trusted: .[$i+9] } ]
    | (if $show then (tojson + "\n") else "" end)
      + (if all(.[]; .verdict == "ok" or .verdict == "busy") then "ok" else "finding" end)
    ' 2>/dev/null) || rows=finding
  verdicts=${rows##*$'\n'}
  if [ "$as_json" = yes ] && [ "$rows" != "$verdicts" ]; then
    printf '%s' "${rows%$'\n'*}" | jq .
  fi
  [ "$verdicts" = ok ] || exit 1
  exit 0
fi

# A long-running session answers worse as its context fills, and the automatic
# compaction near the limit summarises at the point the model is least able to
# judge what matters. `refresh` replaces the session on purpose while it can
# still choose well: the session writes handoff.md (the hook tells it how), then
# runs this. A session cannot replace itself, so the work is handed to a
# detached child that outlives the session's own shell:
#   1. refuse unless handoff.md is there (--force skips that, for a wedged session)
#   2. stop the running session(s) registered under this bot's name
#   3. start a fresh one in the background; the launch path below folds
#      handoff.md into its system prompt and moves it aside
# Stop before start, never the reverse: two sessions on one token both answer.
# The gap between them loses whatever arrives in it; the fresh session is told
# to catch up from the channel history.
if [ "${1:-}" = refresh ]; then
  shift
  # The name is kept out of the claude args so the launch below can be given
  # it explicitly, whether it came from the command line or from the
  # environment: with two bots in the project the launcher cannot guess.
  force=no; fresh=() name="" skip=0
  for a in "$@"; do
    # A flag's value never starts with "-": after one whose value is optional
    # (--debug, --worktree) the next word may be the next flag.
    if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) fresh+=("$a"); continue;; esac; fi
    case $a in
      --force) force=yes;;
      -n|--name|--name=*) echo "claude-discord: the session is named after the bot; drop $a" >&2; exit 2;;
      -*) fresh+=("$a"); takes_value "$a" && skip=1 || :;;
      *)  if [ -z "$name" ]; then name=$a; else fresh+=("$a"); fi;;
    esac
  done
  # This script is re-run twice below (the detached child, then the launch),
  # and the cd that follows would break a relative `./claude-discord`.
  case $0 in /*) self=$0;; *) self=$PWD/$0;; esac
  # The session runs this from its own Bash, whose cwd has usually wandered
  # off the project by now. Its environment still says where the state is
  # (DISCORD_STATE_DIR is set at launch), so go back to that project; a shell
  # outside any session gives the directory the usual way, by standing in it.
  if [ -n "${DISCORD_STATE_DIR:-}" ]; then
    [ -n "$name" ] || name=$(basename "$DISCORD_STATE_DIR")
    cd "$(dirname "$(dirname "$(dirname "$DISCORD_STATE_DIR")")")"
    root=$PWD/.claude/discord-agents
  fi
  [ -n "$name" ] || { echo "usage: claude-discord refresh <name> [--force] [claude args]" >&2; exit 2; }
  case $name in ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;; esac
  dir=$root/$name
  [ -f "$dir/.env" ] || { echo "claude-discord: no bot '$name' under $root" >&2; exit 1; }
  if [ "$force" = no ] && [ ! -s "$dir/handoff.md" ]; then
    echo "claude-discord: $dir/handoff.md is missing or empty; write it first, or pass --force to replace the session without one" >&2
    exit 1
  fi
  # `claude --bg` refuses to start in a workspace whose trust has never been
  # accepted, and the foreground path does not: measured 2026-09-25, a --bg
  # start in an unregistered directory exits 1 with "Workspace not trusted".
  # A bot started in a terminal and moved to the background with /bg
  # therefore never meets that gate, and can run for weeks with the trust
  # unaccepted -- until a refresh stops it and cannot start its replacement.
  # That is how a bot here was down for 22 hours. So the trust flag is read
  # BEFORE anything is stopped. Fail-OPEN on purpose: anything but an
  # explicit `false` (no file, no jq, no such project key, a future Claude
  # Code that keeps trust elsewhere) proceeds exactly as before, because a
  # check that misreads would otherwise block a refresh that would have
  # worked. --force says "do it anyway", here as everywhere else.
  # `// "unset"` would be wrong here: jq's `//` treats FALSE as empty, so
  # `false // "unset"` is "unset" and the one value this checks for could
  # never be seen (measured). An explicit null test is the only correct form.
  if [ "$force" = no ] && command -v jq >/dev/null 2>&1 &&
     [ "$(jq -r --arg p "$(pwd -P)" '.projects[$p].hasTrustDialogAccepted | if . == null then "unset" else tostring end' "$HOME/.claude.json" 2>/dev/null)" = false ]; then
    echo "claude-discord: $PWD is not a trusted workspace, so the fresh --bg session would refuse to start and $name would be left down." >&2
    echo "claude-discord: run 'claude' here once and accept the trust prompt, then retry; --force refreshes anyway." >&2
    exit 1
  fi
  if [ "${CLAUDE_DISCORD_REFRESH_CHILD:-}" != 1 ]; then
    # Re-run this same command detached: `claude stop` below kills the session
    # that is very likely running us, and its whole process group with it.
    # perl's setsid rather than setsid(1): macOS ships perl but no setsid.
    export CLAUDE_DISCORD_REFRESH_CHILD=1
    # One generation of the log kept aside, as handoff.prev.md is. The child's
    # `>` truncates refresh.log, and an outage is usually met with a second
    # refresh minutes after the first: that run would erase the only record of
    # what the first one did, which is the question this log exists to answer
    # afterwards (measured on DY-DevBot, 2026-10-07: a 21:14 --force left
    # nothing of the 21:12 attempt).
    [ ! -f "$dir/refresh.log" ] || mv -f "$dir/refresh.log" "$dir/refresh.prev.log" 2>/dev/null || :
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- nohup "$self" refresh "$@" > "$dir/refresh.log" 2>&1 < /dev/null &
    echo "claude-discord: refreshing $name in the background; progress in $dir/refresh.log"
    exit 0
  fi
  # Sessions are registered under the name the wrapper gave them (-n) and the
  # directory they were started in; another project's bot of the same name is
  # not ours. A renamed one (/rename) is still found by its job record: every
  # background launch passes --settings naming this bot's DISCORD_STATE_DIR,
  # and the daemon keeps that in jobs/<id>/state.json's respawnFlags. A child
  # session started from the bot's shell only inherits the variable, so it
  # is never matched this way. Every live match is stopped, not one: a copy
  # left running is the two-sessions-on-one-token this exists to prevent. A background session has an id for `claude stop` (its pid may be
  # null while it is blocked, so the id decides); a foreground one has only a
  # pid, and SIGTERM is what closing its terminal would send. A listing that
  # fails or is not an array says nothing about what is running, which is not
  # the same as "nothing is": --force may not paper over it.
  jobs=$(grep -lF -- "DISCORD_STATE_DIR\\\": \\\"$dir\\\"" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/jobs/*/state.json 2>/dev/null) || jobs=""
  jobs=$(printf '%s\n' "$jobs" | sed -n 's#.*/\([^/]*\)/state\.json$#\1#p')
  if ! agents=$(claude agents --json 2>/dev/null) || ! live=$(printf '%s' "${agents:-null}" | jq -r --arg n "$name" --arg jobs "$jobs" --arg cwd "$(pwd -P)" '
      ($jobs | split("\n")) as $j |
      if type != "array" then error("not a list") else
        .[] | select((.name == $n or (.id as $i | any($j[]; . == $i))) and .cwd == $cwd and (.id != null or .pid != null))
        | "\(.id // "-") \(.pid // "-")" end' 2>/dev/null); then
    echo "claude-discord: 'claude agents --json' failed, so what is running is unknown; refusing to start a second session" >&2
    exit 1
  fi
  if [ -z "$live" ]; then
    # Nothing to stop means either the bot is down or it is running somewhere
    # this cannot see (started under another name, or from another directory).
    # Starting a second session in the latter case puts two on one token, so
    # refuse unless told otherwise.
    if [ "$force" = no ]; then
      echo "claude-discord: no running session of $name (by name or by its job record) started in $PWD; it may be down, or running under another name. 'claude agents' lists them; pass --force to start a fresh one anyway" >&2
      exit 1
    fi
    echo "claude-discord: no running session named $name found; starting a fresh one (--force)"
  fi
  pids=()
  while read -r id pid; do
    [ -n "$id" ] || continue
    echo "claude-discord: stopping $name ($id, pid $pid)"
    if [ "$id" != - ]; then
      claude stop "$id" || echo "claude-discord: stop $id failed (already gone?)" >&2
    else
      kill -TERM "$pid" 2>/dev/null || :
    fi
    [ "$pid" = - ] || pids+=("$pid")
  done <<<"$live"
  # A stop that did not take leaves two sessions on one token, so wait for
  # every old pid to go before starting anything; a session that will not die
  # is reported, not raced.
  for _ in $(seq 20); do
    alive=()
    for pid in ${pids[@]+"${pids[@]}"}; do kill -0 "$pid" 2>/dev/null && alive+=("$pid") || :; done
    [ ${#alive[@]} -gt 0 ] || break
    sleep 0.5
  done
  if [ ${#alive[@]} -gt 0 ]; then
    echo "claude-discord: session $name still running after stop (pid ${alive[*]}); not starting another. Stop it by hand, then run 'claude-discord refresh $name --force'" >&2
    exit 1
  fi
  # The stopped session's channel server needs a moment to release the token;
  # a fresh gateway login while the old one is still up gets both dropped.
  [ -n "$live" ] && sleep 3
  echo "claude-discord: starting $name"
  unset CLAUDE_DISCORD_REFRESH_CHILD   # the fresh session's own refresh must fork again
  # A first turn, or the fresh session sits idle until the next message and
  # whoever asked for the refresh sees nothing happen. A prompt given on the
  # command line (a bare word after the name) is that first turn instead.
  kickoff=("Catch up on the channel and continue from your handoff.")
  skip=0
  for a in ${fresh[@]+"${fresh[@]}"}; do
    if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) continue;; esac; fi
    case $a in -*) takes_value "$a" && skip=1 || :;; *) kickoff=();; esac
  done
  # NOT exec: the launch path below consumes handoff.md (it folds it into the
  # system prompt and renames it handoff.prev.md) BEFORE it starts claude, so
  # a start that fails leaves the handoff gone from the path a retry looks at
  # -- and a retry without --force then refuses because handoff.md is
  # missing. That happened here: a --bg start refused on workspace trust and
  # took the handoff with it. Running it as a child instead means there is
  # still a shell to put the file back. `claude --bg` returns as soon as the
  # session is backgrounded (measured: 0 s), so waiting for it costs nothing
  # and a non-zero status is a real launch failure.
  # Whether THIS refresh had a handoff to consume, recorded before the start.
  # Without it, a --force refresh of a bot with no handoff.md would "restore"
  # whatever handoff.prev.md an EARLIER refresh left behind, handing the next
  # session a stale handoff -- worse than none.
  had_handoff=no; [ ! -s "$dir/handoff.md" ] || had_handoff=yes
  "$self" --bg "$name" ${fresh[@]+"${fresh[@]}"} ${kickoff[@]+"${kickoff[@]}"} && exit 0
  rc=$?
  if [ "$had_handoff" = yes ] && [ ! -s "$dir/handoff.md" ] && [ -s "$dir/handoff.prev.md" ]; then
    mv "$dir/handoff.prev.md" "$dir/handoff.md" &&
      echo "claude-discord: start failed, so $name's handoff was put back; fix the error above and run 'claude-discord refresh $name'" >&2
  fi
  exit "$rc"
fi

# Patches the official discord plugin's install(s) so bots can work together.
# Every version dir in the cache, not just the active one: an auto-update adds
# an unpatched dir while bots run on the old one, and the next start, respawn
# or config-changing /reload-plugins uses the new one (measured, 2.1.296).
# Five patches, each idempotent because its pattern is gone once applied:
#   bot-authors     let other bots reach access.json's allowFrom gate
#   ignore-everyone @everyone/@here wake no bot
#   chunk           fence-safe chunking, imported from the stable runtime copy
#   proxy           bunfig preload pinning fetch and WebSocket to HTTPS_PROXY
#   failure-cache   a per-bot env in .mcp.json, so Claude Code's 15-minute MCP
#                   failure cache (keyed on the config hashed after ${VAR}
#                   expansion) no longer blocks every bot for one bot's failure
# The runtime files are copied to ~/.claude-discord/runtime/ because the plugin
# cache is machine-wide while clones are per project. Exit 1 names the file and
# patch whose pattern moved; the others are still applied.
patch_official() {
  local rt=$HOME/.claude-discord/runtime d f rc=0 changed=""
  mark() { case " $changed " in *" $1 "*) ;; *) changed="$changed $1";; esac; }   # list a file once
  mkdir -p "$rt" || return 1
  for f in discord-chunk.ts discord-proxy.ts; do
    cmp -s "$self_root/runtime/$f" "$rt/$f" || cp "$self_root/runtime/$f" "$rt/$f"
  done
  for d in "$HOME"/.claude/plugins/cache/claude-plugins-official/discord/*/; do
    d=${d%/}; f=$d/server.ts   # no trailing slash, so messages name the file cleanly
    [ -f "$f" ] || continue
    if grep -q 'if (msg.author.bot) return' "$f"; then
      perl -pi -e 's/^(\s*)if \(msg\.author\.bot\) return$/$1if (msg.author.id === client.user?.id) return/' "$f"; mark "$f"
    elif ! grep -qF 'msg.author.id === client.user?.id' "$f"; then
      echo "claude-discord: patch: $f: bot-authors no longer matches" >&2; rc=1
    fi
    if grep -q 'msg.mentions.has(client.user))' "$f"; then
      perl -pi -e 's/msg\.mentions\.has\(client\.user\)\)/msg.mentions.has(client.user, { ignoreEveryone: true }))/' "$f"; mark "$f"
    elif ! grep -qF 'ignoreEveryone: true' "$f"; then
      echo "claude-discord: patch: $f: ignore-everyone no longer matches" >&2; rc=1
    fi
    if grep -qE '^[[:space:]]*const chunks = chunk\(text, limit, mode\);?[[:space:]]*$' "$f"; then
      CHUNK_TS=$rt/discord-chunk.ts perl -pi -e 's/^(\s*)const chunks = chunk\(text, limit, mode\)(;?\s*)$/$1const chunks = (await import("$ENV{CHUNK_TS}")).chunk(text, limit, mode)$2/' "$f"; mark "$f"
    elif ! grep -qF '.chunk(text, limit, mode)' "$f"; then
      echo "claude-discord: patch: $f: chunk no longer matches" >&2; rc=1
    fi
    [ "$(cat "$d/bunfig.toml" 2>/dev/null)" = "preload = [\"$rt/discord-proxy.ts\"]" ] ||
      { printf 'preload = ["%s"]\n' "$rt/discord-proxy.ts" > "$d/bunfig.toml"; mark "$d/bunfig.toml"; }
    if [ -f "$d/.mcp.json" ] && ! jq -e '.mcpServers.discord.env.DISCORD_STATE_DIR' "$d/.mcp.json" >/dev/null 2>&1; then
      # Only a file that already defines the discord server is edited (jq would
      # otherwise create a command-less one); jq_edit leaves bad JSON alone and
      # returns 0, so the result is verified, not assumed.
      jq -e '.mcpServers.discord.command' "$d/.mcp.json" >/dev/null 2>&1 &&
        jq_edit "$d/.mcp.json" '.mcpServers.discord.env = ((.mcpServers.discord.env // {}) + {DISCORD_STATE_DIR: "${DISCORD_STATE_DIR}"})'
      if jq -e '.mcpServers.discord.env.DISCORD_STATE_DIR' "$d/.mcp.json" >/dev/null 2>&1; then
        mark "$d/.mcp.json"
      else
        echo "claude-discord: patch: $d/.mcp.json: failure-cache no longer matches" >&2; rc=1
      fi
    fi
  done
  [ -z "$changed" ] || echo "claude-discord: patched$changed"
  return "$rc"
}
if [ "${1:-}" = patch ]; then patch_official; exit $?; fi

args=() name="" skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) args+=("$a"); continue;; esac; fi   # a value never starts with "-" (see refresh)
  case $a in
    # The wrapper names the session after the bot (-n below); a later --name
    # wins and the bot then goes by another name (DY-DevBot's alphabot ran as
    # researchbot, 2026-10-09).
    -n|--name|--name=*) echo "claude-discord: the session is named after the bot; drop $a" >&2; exit 2;;
    -*) args+=("$a"); takes_value "$a" && skip=1 || :;;
    *)  if [ -z "$name" ]; then name=$a; else args+=("$a"); fi;;
  esac
done
if [ -z "$name" ]; then
  bots=()
  for d in "$root"/*/; do [ -f "$d/.env" ] && bots+=("$(basename "$d")"); done
  case ${#bots[@]} in
    1) name=${bots[0]};;
    0) echo "claude-discord: no bot set up in $root; run 'claude-discord setup <name>' in this directory first" >&2; exit 1;;
    *) echo "claude-discord: this directory has several bots (${bots[*]}); name the one to start" >&2; exit 2;;
  esac
fi
case $name in
  ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
  hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
esac
dir=$root/$name
if [ ! -f "$dir/.env" ] || [ ! -f "$root/config.env" ]; then
  echo "claude-discord: no bot '$name' under $root; run 'claude-discord setup $name' in this directory first" >&2
  exit 1
fi
. "$root/config.env"

# Pre-existing setups: same policy the old first-run write produced.
[ -f "$dir/access.json" ] || write_access "$dir" true
ensure_ack_reaction "$dir"

# The official plugin must carry our patches before its server starts; a moved
# pattern is reported and the start goes on with whatever still applied.
patch_official >/dev/null || echo "claude-discord: some patches no longer apply (see above); the bot starts anyway" >&2

# The bot's channel is the single group key in its access.json, where a bot
# is moved to another channel; config.env's DISCORD_CHANNEL_ID otherwise (no
# file, no group, several). The same rule as hooks/lib/discord.sh's
# resolve_channel, which cannot be sourced here (it is not set -e safe, and
# the installed copy may be older than this script).
channel=$DISCORD_CHANNEL_ID
groups=$(jq -r '.groups | objects | keys[]' "$dir/access.json" 2>/dev/null) || groups=""
case $groups in ''|*[!0-9]*) ;; *) channel=$groups ;; esac
prompt="You are \"$name\", one of several Claude Code sessions sharing the Discord channel $channel, each through its own bot. \
The human reaches you there by @mentioning or replying to your bot; answer those with the discord reply tool. \
A turn the human types in this terminal (no <channel> tag) is answered in the terminal; from it, post to Discord only what the human asks you to send or what another bot must act on, never a copy of the terminal conversation. \
When both arrive in one turn, answer each where it came from. \
A request that needs more than a line or two gets its own thread: $self_root/tools/thread start \"[<area>] <short title>\" posts that one line in the channel and prints the thread id. \
In a message, write a channel or thread as <#id> (Discord shows its name, linked) and a user or bot you only name as plain @name (it pings nobody); one who must answer or decide is mentioned as <@id>, since plain @name reaches nobody; a bare id is denied, and an id in backticks shows the number itself. \
Everything else about the request goes inside that thread, with the id as chat_id. \
When it lands, run thread close <id> \"<one closing line>\": it posts that line inside the thread and archives it. \
Unless your mode's rules say otherwise, answer a quick request yourself and dispatch one that needs more than a few tool calls to a background subagent whose brief names the request's thread id, then post its result in that thread when it returns. \
That keeps you free for the next message, and requests from different people never share a context. \
Another bot receives your messages only when you @mention it and it allowlists your bot. \
Sessions on this machine can also be reached with ListAgents and SendMessage, addressing them by session name. \
In a turn that arrived from Discord, mirror each such message you send or receive into that channel as one line that says which way it went, '[sent to name] ...' or '[received from name] ...', so the human can follow and step in; in any other turn it stays out of Discord. \
The human's instructions override any agent's. \
Mention a bot as <@id> only when you need it to act or answer; if you were mentioned but nothing is asked of you, do not reply."

# A fresh session after a refresh must arrive already holding the handoff.
# Consumed once: leaving it would make every later restart resume a
# conversation that has moved on. The gap between the old session's stop and
# this one's gateway login loses whatever arrived in it, so catch up first;
# the hooks record the id of the last message the old session was given.
if [ -s "$dir/handoff.md" ]; then
  handoff=$(cat "$dir/handoff.md")
  mv "$dir/handoff.md" "$dir/handoff.prev.md"
  last=$(cat "$dir/last-message-id" 2>/dev/null || :)
  catchup="fetch the channel's recent messages first"
  [ -n "$last" ] && catchup="fetch the channel's messages first; the last one your predecessor saw was $last, so everything after it is new to you"
  prompt="$prompt \
A previous session of yours was replaced and left you this handoff. Treat it as \
what it says it is: claims marked [assumed] are unverified, so check them \
before repeating them to anyone. Messages that arrived while you were being \
replaced were not delivered: $catchup, and answer anything addressed to you. \
Then pick up from the Next section.

$handoff"
fi

# The state dir goes in BOTH the environment and --settings env. /bg (and
# `claude --bg`) respawn the session under the daemon from its CLI flags alone,
# dropping the shell environment (measured 2026-09-18: the fork had no
# DISCORD_STATE_DIR, its plugin server found no token and died silently);
# --settings is one of the flags the daemon carries over.
export DISCORD_STATE_DIR=$dir
# `claude --resume` takes a full session id; a NAME only works through the
# interactive picker, which cannot appear under --bg and is a detour otherwise.
# So resolve a name, or a short id as `claude agents` prints it, against this
# project's transcripts. Anything already a full id, or not found, is passed
# through untouched and claude decides.
res_i=-1 res_pre=""
for i in "${!args[@]}"; do
  case ${args[i]} in
    --resume|-r)  res_i=$((i+1)); res_pre="";;
    --resume=*)   res_i=$i;       res_pre="--resume=";;
    -r=*)         res_i=$i;       res_pre="-r=";;
  esac
done
want=""
[ "$res_i" -ge 0 ] && want=${args[res_i]:-} && want=${want#"$res_pre"}
if [ -n "$want" ] && ! printf '%s' "$want" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
  # Claude Code's own transcript-dir naming: EVERY non-alphanumeric character
  # of the path becomes '-'. A narrower `tr './'` missed '_' and silently left
  # the name unresolved, and `--bg --resume <name>` then hangs on a picker.
  proj=$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
  found=""
  if printf '%s' "$want" | grep -qE '^[0-9a-f]{8}$'; then
    found=$(cd "$proj" 2>/dev/null && ls -t "$want"*.jsonl 2>/dev/null | head -1) || :
  else
    # The name is the session's own title (claude-discord -n, or /rename), which
    # is rewritten on every change, so only the LAST record of a file counts.
    found=$(cd "$proj" 2>/dev/null && for f in $(ls -t ./*.jsonl 2>/dev/null); do
      t=$(tail -c 262144 "$f" | grep -o '"customTitle":"[^"]*"' | tail -1)
      [ "$t" = "\"customTitle\":\"$want\"" ] && { echo "${f#./}"; break; }
    done) || :   # no match is not an error: `set -e` would abort on the loop's last test
  fi
  if [ -n "$found" ]; then
    args[res_i]="$res_pre${found%.jsonl}"
    echo "claude-discord: --resume $want -> ${found%.jsonl}" >&2
  fi
fi
# Whatever --resume ends up pointing at, resolved just above or passed through
# as a full id, is the session this start is about to reopen: the reaping below
# must never delete it. A transcript's basename IS the session id, and a name
# resolves to the newest transcript of this bot in this project, which is
# exactly the kind of row the daemon calls done.
resume_id=""
[ "$res_i" -ge 0 ] && resume_id=${args[res_i]:-} && resume_id=${resume_id#"$res_pre"}

# `claude` here is whatever bash finds on PATH, never a shell function: a setup
# that wraps claude in a process wrapper must name it, or that wrapping is
# skipped (measured 2026-09-18 with a launcher that wires a proxy chain: the
# bare binary bypassed it). CLAUDE_CODE_PROCESS_WRAPPER is Claude Code's own
# name for that wrapper and is exported into every session, so honouring it
# means an environment that already has one needs no extra setting. Not every
# session gets it in the environment though (settings.json's `env` block is
# merged into the session, not necessarily into the shell that starts it), so
# a session-scoped wrapper falls back to reading it from the same file Claude
# Code itself reads it from: ~/.claude/settings.json.
bin=$(command -v claude) || { echo "claude-discord: claude is not on PATH" >&2; exit 127; }
launcher=${CLAUDE_DISCORD_LAUNCHER:-${CLAUDE_CODE_PROCESS_WRAPPER:-}}
[ -n "$launcher" ] || launcher=$(jq -r '.env.CLAUDE_CODE_PROCESS_WRAPPER // empty' "$HOME/.claude/settings.json" 2>/dev/null) || :
run=("$bin")
[ -n "$launcher" ] && run=("$launcher" "$bin")

# Claude Code's daemon retires a background session after about an hour idle,
# and nothing here ever removed the retired one: `refresh` stops a session but
# never `rm`s it, so every start of a bot left one more dead entry in the agent
# view for ever (measured 2026-09-19 on an owner's machine: 7 rows for 2 bots,
# 4 of them stopped or done). So a start reaps its OWN dead sessions first:
# this bot's name, started in THIS project directory, and a state that says the
# session is over. `claude rm` deletes the session and, if it had one (the
# wrapper passes -w/--worktree through), its worktree, so everything else
# stays -- another name, another project, any live state (idle, busy, waiting,
# working, blocked), and an interactive entry with no state at all, none of
# which is this start's to remove. The session this very start is resuming is
# kept too ($resume_id, see above): --resume resolves a name to exactly such a
# done row, and reaping it would delete what the start is reopening.
# `claude rm <id>` takes the record's own `.id`, an 8-character job id, not
# `.sessionId` (a full transcript-basename UUID): measured 2026-09-19 on an
# owner's machine, `claude rm <sessionId>` answered "No job matching" while
# `claude rm <job id>` removed it, and `claude rm --help` says `Usage: claude
# rm <id>`. Most rows' `.id` equals `.sessionId`'s first 8 characters, but not
# all: a resumed session gets a new sessionId while the job id stays, so the
# two must not be conflated. $resume_id is a full sessionId (a --resume value
# resolves to a transcript basename) either way, but not necessarily the
# job's CURRENT one: a short id resolves by transcript PREFIX (see above),
# to that job's ORIGINAL transcript, so for a resumed job $keep ends up the
# stale sessionId, not the live one. `.sessionId != $keep` alone misses that
# case, so a row's `.id` is also compared, against $keep's first 8
# characters: a transcript's basename always starts with its job's id,
# whichever transcript the resolver landed on.
# Both calls go to "$bin", never "$run": they are local daemon bookkeeping and
# start no session, so a process wrapper (a proxy chain, a version pin) has
# nothing to wrap here and would only add a process per call.
# A start must never fail or stall on housekeeping, so every step is optional:
# no jq, no `timeout`, a listing that fails, hangs past 5 s, is not JSON, is
# not an array or is empty all leave the start exactly as it was, at most one
# line on stderr. The removals are capped at 20 per start, oldest first by
# startedAt, so a first run against a long-neglected daemon cannot turn a start
# into a minute of `rm` calls; the next start takes the next 20.
prune_dead_sessions() {
  local list ids id failed=0 t=()
  command -v jq >/dev/null 2>&1 || return 0
  if command -v timeout >/dev/null 2>&1; then t=(timeout 5); fi
  list=$(${t[@]+"${t[@]}"} "$bin" agents --json --all 2>/dev/null) || return 0
  # jq's regex engine (Oniguruma) treats `$` as matching before a single
  # trailing newline, so test("^[0-9a-fA-F]{8}$") alone lets an `.id` of
  # "8705916e\n" through: measured, jq -n '"8705916e\n"|test("^[0-9a-fA-F]{8}$")'
  # is true. Such a row would then take a cap slot from a real one, and its
  # raw (-r) output, split on that same embedded newline in the shell loop
  # below, would hand "8705916e" to `rm` for real. The length check closes
  # that: "8705916e\n" is 9 characters, so length==8 rejects it before either
  # of those happens.
  ids=$(printf '%s' "${list:-null}" | jq -r --arg n "$name" --arg cwd "$(pwd -P)" --arg keep "${resume_id:-}" '
    if type != "array" then empty else
      [ .[] | select(.name == $n and .cwd == $cwd
                     and (.state == "stopped" or .state == "done")
                     and (.id|type) == "string" and (.id|length) == 8 and (.id|test("^[0-9a-fA-F]{8}$"))
                     and .sessionId != $keep and .id != ($keep | .[0:8])) ]
      | sort_by(.startedAt) | .[0:20][] | .id end' 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  while IFS= read -r id; do
    # The shape check above (exactly 8 hex characters, no dashes) already
    # keeps anything else out of the sort and the cap, but a crafted id must
    # not become an argument to a delete even if something upstream of that
    # filter changes, so it is checked again here: a leading dash would read
    # as a flag, and a newline in it would otherwise arrive as two lines.
    [[ $id =~ ^[0-9a-fA-F]{8}$ ]] || continue
    "$bin" rm "$id" >/dev/null 2>&1 || failed=$((failed + 1))
  done <<<"$ids"
  [ "$failed" = 0 ] || echo "claude-discord: could not remove $failed dead session(s) of $name from the agent view" >&2
}

ensure_hooks_symlink
sync_mode_drops
prune_dead_sessions || :   # even its last line (a warning on a closed stderr) may not fail the start
# worktree.bgIsolation "none" turns off Claude Code's background-isolation
# guard for this session: measured on two machines, a session started with
# --bg is refused Edit/Write in the checkout by that guard while a session
# moved to the background with /bg from the foreground is not. A bot editing
# its own project should behave like the /bg case either way it got there,
# and this needs no change to the project's own settings.json. Inert for a
# foreground start.
exec "${run[@]}" --channels "plugin:$plugin" \
  --settings "{\"enabledPlugins\": {\"$plugin\": true}, \"env\": {\"DISCORD_STATE_DIR\": \"$dir\"}, \"worktree\": {\"bgIsolation\": \"none\"}}" \
  -n "$name" --append-system-prompt "$prompt" ${args[@]+"${args[@]}"}
