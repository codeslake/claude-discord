#!/usr/bin/env bash
# Runs a Claude Code session behind its own Discord bot, so several sessions
# can sit in one Discord channel. The human talks to each by @mentioning its
# bot; the bots reach each other the same way once allowlisted (the start
# patches the plugin to let other bots through), and sessions on one machine
# can also use SendMessage, mirroring those exchanges into the channel.
#
#   claude-discord setup <name> [--reset|--mode]  ask for channel/user IDs, allowed users, the
#                                          bot token, mention policy and mode (dev-manager also
#                                          asks for its peers); --reset asks all again; --mode
#                                          asks only the mode (and, for dev-manager, the peers)
#                                          for a bot already set up
#   claude-discord [name] [claude args]  start the session named <name>; the
#                                          name may come before or after the
#                                          claude args, and may be left out when
#                                          the project has exactly one bot
#   claude-discord refresh <name> [--force] [claude args]
#                                        replace the running session with a fresh
#                                        one that starts from its handoff
# All run from the project directory: state is ./.claude/discord-agents/<name>/.
#
# Origin: d.kim4's wrapper (2026-09-18), published at
# https://github.com/codeslake/claude-discord. Portable on purpose: nothing
# here assumes a particular shell setup.
#
#   CLAUDE_DISCORD_LAUNCHER   optional. An environment that wraps `claude` in a
#                             process wrapper (proxy chain, version pin) names
#                             it here and the session is started as
#                             `$CLAUDE_DISCORD_LAUNCHER <claude-bin> <args>`.
#                             Unset, Claude Code's own CLAUDE_CODE_PROCESS_WRAPPER
#                             is used, from the environment or, failing that,
#                             from `.env.CLAUDE_CODE_PROCESS_WRAPPER` in
#                             ~/.claude/settings.json; unset too, plain `claude`
#                             on PATH.
#   ~/.claude-discord/discord-proxy.ts
#                             optional. bun's WebSocket ignores HTTPS_PROXY,
#                             so behind a corporate proxy the Discord gateway
#                             dies on TLS interception; this preload pins it to
#                             HTTPS_PROXY. Only wired in when the file exists.
# Needs: bun, jq, and `claude plugin install discord@claude-plugins-official`.
set -euo pipefail

# State lives in the PROJECT, next to its other .claude/ files, so a bot belongs
# to the directory you start it from and `setup` is run there. The token is a
# plaintext secret inside a git tree, so setup drops a `*` .gitignore into the
# directory: nothing under it is ever staged, and the project's own .gitignore
# is left alone.
root=$PWD/.claude/discord-agents
helpers=$HOME/.claude-discord
plugin=discord@claude-plugins-official

# access.json is written at setup time, so every answer lives in the file the
# plugin reads and nothing else needs persisting. The run path below keeps a
# fallback for bot dirs set up before this existed.
write_access() {  # $1 = bot dir, $2 = requireMention (true|false)
  jq -n --arg ch "$DISCORD_CHANNEL_ID" --arg me "$DISCORD_USER_ID" \
        --arg others "${DISCORD_ALLOW_IDS:-}" --argjson mention "$2" \
    '{dmPolicy: "allowlist", allowFrom: [$me], ackReaction: "👀",
      groups: {($ch): {requireMention: $mention,
                       allowFrom: ([$me] + ($others | split(",") | map(gsub("\\s";"")) | map(select(. != ""))))}}}' \
    > "$1/access.json"
}

# Every JSON file claude-discord edits in place (settings.json, access.json,
# peers.json) goes through here: the file (a missing or 0-byte one reads as
# {}) is run through the jq filter in the arguments and written back only
# when the result differs, through a symlink (`cat tmp > file`, never mv)
# and with a trailing newline. A file that is not valid JSON, a filter that
# fails on it (a non-object, an event key holding a non-array) or a failed
# write is warned about on stderr, naming the file, and left alone: an edit
# must never fail the setup or the start it runs inside.
jq_edit() {  # $1 = file, the rest = jq arguments
  local f=$1 base='{}' merged
  shift
  if [ -e "$f" ]; then
    base=$(jq . "$f" 2>/dev/null) || { echo "claude-discord: $f is not valid JSON, leaving it alone" >&2; return 0; }
    [ -n "$base" ] || base='{}'
  fi
  merged=$(printf '%s' "$base" | jq "$@" 2>/dev/null) || merged=""
  [ -n "$merged" ] || { echo "claude-discord: could not update $f, leaving it alone" >&2; return 0; }
  [ "$merged" != "$base" ] || return 0
  if mkdir -p "$(dirname "$f")" 2>/dev/null && printf '%s\n' "$merged" > "$f.tmp.$$" 2>/dev/null && cat "$f.tmp.$$" > "$f" 2>/dev/null; then
    :
  else
    echo "claude-discord: could not write $f, leaving it alone" >&2
  fi
  rm -f "$f.tmp.$$"
}

# Registers this project's hooks. The four Discord-turn hooks (identity/
# refresh, primed once per session; the reply flag; the checkmark reaction;
# at session start, re-priming after a compact/clear and clearing a turn left
# over from a startup/resume), which make a turn that arrived over
# Discord be answered through the discord reply tool only, never also typed
# into the CLI, are the same for every bot on every machine: they go into
# settings.json, which can be committed and shared. Every other entry is
# registered only while its mode is among $1, the modes of the bots THIS
# machine runs (the three peers hooks for dev-manager, on-start for
# autoresearchclaw), so it goes into settings.local.json, which is per
# machine; in a committed settings.json it would flip on every start of a
# machine with other bots. Any entry of ours (a command under
# .claude/discord-agents/hooks/) that a file should not hold is removed from
# it: a mode hook no bot needs, a hook in the other file (settings.json held
# the peers hooks in an earlier version), one that no longer exists
# (turn/on-compact became turn/on-session-start) or one under another event
# or matcher (autoresearchclaw/on-start was startup|resume), along with a
# matcher group or an event left empty by that. Each command guards on
# [ -x ], so a machine without the hooks installed simply runs nothing.
# Idempotent per entry, and a file is written only when it changes (Claude
# Code writes its permission grants into settings.local.json).
# Parallel arrays, not a packed "event|matcher|script" string, because a
# matcher itself can contain "|" (startup|resume|compact|clear).
register_hooks() {  # $1 = the project's bot modes, space-separated
  local modes=" ${1:-} "
  local events=(UserPromptSubmit PostToolUse Stop SessionStart PreToolUse PostToolUse PreToolUse SessionStart)
  local matchers=("" "mcp__plugin_discord_discord__reply" "" "startup|resume|compact|clear" "mcp__plugin_discord_discord__reply" "mcp__plugin_discord_discord__reply" "Edit|Write|MultiEdit" "startup|resume|compact|clear")
  local scripts=(turn/on-prompt turn/on-reply turn/on-stop turn/on-session-start peers/mention-guard peers/checkin peers/edit-gate autoresearchclaw/on-start)
  local needs=("" "" "" "" dev-manager dev-manager dev-manager autoresearchclaw)   # the mode an entry needs; "" = every bot
  local want='[]' i cmd file
  for i in "${!events[@]}"; do
    if [ -z "${needs[i]}" ]; then
      file=settings.json
    else
      case $modes in *" ${needs[i]} "*) file=settings.local.json ;; *) continue ;; esac
    fi
    cmd="h=\"\$CLAUDE_PROJECT_DIR/.claude/discord-agents/hooks/${scripts[i]}\"; [ ! -x \"\$h\" ] || \"\$h\""
    want=$(printf '%s' "$want" | jq -c --arg ev "${events[i]}" --arg m "${matchers[i]}" --arg cmd "$cmd" --arg file "$file" \
      '. + [{ev: $ev, m: $m, cmd: $cmd, file: $file}]') || return 0
  done
  for file in settings.json settings.local.json; do
    jq_edit "$PWD/.claude/$file" --argjson all "$want" --arg file "$file" '
      ($all | map(select(.file == $file))) as $want
      | def stale($ev; $m): (.command? // "" | tostring) as $c
          | ($c | contains("/.claude/discord-agents/hooks/"))
            and ([$want[] | select(.ev == $ev and .m == $m) | .cmd] | index($c)) == null;
      (if (.hooks | type) != "object" then . else
        .hooks |= with_entries(.key as $ev
          | if (.value | type) == "array" and any(.value[]; (.matcher? // "") as $m | any(.hooks?[]?; stale($ev; $m))) then
              .value |= map((.matcher? // "") as $m
                | if any(.hooks?[]?; stale($ev; $m)) then (.hooks |= map(select(stale($ev; $m) | not))) | select(.hooks | length > 0) else . end)
              | select(.value | length > 0)
            else . end)
      end)
      | reduce $want[] as $w (.;
          if any(.hooks[$w.ev][]?.hooks?[]?; .command? == $w.cmd) then .
          else .hooks[$w.ev] = ((.hooks[$w.ev] // []) + [(if $w.m == "" then {} else {matcher: $w.m} end) + {hooks: [{type: "command", command: $w.cmd}]}])
          end)'
  done
}

# Adds access.json's ackReaction key (the plugin's own read-receipt
# reaction) only when the key is absent; an explicit "" means the owner
# disabled it and is left alone.
ensure_ack_reaction() {  # $1 = bot dir
  [ -f "$1/access.json" ] || return 0
  jq_edit "$1/access.json" 'if has("ackReaction") then . else . + {ackReaction: "👀"} end'
}

# A project's mode drops are the union over its bots' modes (<bot>/mode), so
# one dev-manager bot keeps the dev-manager rule and the peers hooks in place
# for the whole project. Whatever no bot's mode produces any more is removed:
# every .claude/rules/claude-discord-*.md but the ones kept (that prefix is
# claude-discord's own; no other file is touched), and every mode hook entry
# (see register_hooks). Run by setup and every start; idempotent; never
# aborts either.
sync_mode_drops() {
  local modes="" f keep="" rules=$PWD/.claude/rules src=$helpers/rules/dev-manager.md
  for f in "$root"/*/mode; do
    modes="$modes $(cat "$f" 2>/dev/null || :)"   # no bot yet: the glob stays literal, and set -e must not see cat fail
  done
  case " $modes " in *" dev-manager "*) keep=$rules/claude-discord-dev-manager.md;; esac
  # autoresearchclaw drops no rule file: every session under the project
  # loads one, the pipeline's own agent sessions included. Its only drop is
  # the on-start hook (see register_hooks), which hands its rule to the
  # bot's session as SessionStart context.
  for f in "$rules"/claude-discord-*.md; do
    [ "$f" = "$keep" ] || rm -f "$f" 2>/dev/null || echo "claude-discord: could not remove $f" >&2
  done
  if [ -n "$keep" ] && ! cmp -s "$src" "$keep"; then
    if [ ! -f "$src" ]; then
      echo "claude-discord: $src is missing; re-run install.sh" >&2
    elif ! { mkdir -p "$rules" && cat "$src" > "$keep"; } 2>/dev/null; then
      echo "claude-discord: could not write $keep" >&2
    fi
  fi
  register_hooks "$modes"
}

# Makes <project>/.claude/discord-agents/hooks a symlink to the installed
# hooks, so install.sh reaches a session that is already running. Only when
# the path is absent or already a symlink (broken or not); a real directory
# there is left alone with a warning.
ensure_hooks_symlink() {
  local link="$root/hooks"
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "claude-discord: $link exists and is not a symlink, leaving it alone" >&2
    return 0
  fi
  mkdir -p "$root" 2>/dev/null || return 0
  ln -sfn "$helpers/hooks" "$link" 2>/dev/null || echo "claude-discord: could not symlink $link" >&2
}

# select_one <label> <default> <option>...: prints the chosen option's first
# word (an option is "<name>  <hint>"). On a terminal, an @clack-style picker
# drawn on /dev/tty: ◆ while active, ● on the cursor row, ○ on the others;
# ↑/↓ or k/j move, Enter picks, the default starts under the cursor; it
# collapses to "◇ <label> — <choice>". Without a terminal on stdin, one line
# is read: an option name or its 1-based number; empty means the default,
# anything else too, with a warning. A subshell, so the stty change and the
# traps that undo it (Ctrl-C included) never leak into setup.
select_one() (
  label=$1 def=$2
  shift 2
  opts=("$@") cur=0
  for i in "${!opts[@]}"; do [ "${opts[i]%% *}" != "$def" ] || cur=$i; done
  if [ ! -t 0 ]; then
    IFS= read -r ans || :
    ans=${ans//[[:space:]]/} pick=-1
    for i in "${!opts[@]}"; do [ "$ans" != "${opts[i]%% *}" ] && [ "$ans" != "$((i + 1))" ] || pick=$i; done
    if [ "$pick" = -1 ]; then
      [ -z "$ans" ] || echo "claude-discord: no $label '$ans', using ${opts[cur]%% *}" >&2
      pick=$cur
    fi
    echo "${opts[pick]%% *}"
    exit 0
  fi
  exec 3<>/dev/tty
  saved=$(stty -g <&3)
  trap 'stty "$saved" <&3; printf "\e[?25h" >&3' EXIT
  trap 'exit 130' INT TERM
  stty -echo -icanon <&3
  cols=$(stty size <&3) cols=${cols#* }
  [ "$cols" -gt 20 ] 2>/dev/null || cols=80
  printf '\e[?25l' >&3
  n=0
  while :; do
    [ "$n" = 0 ] || printf '\e[%dF\e[J' "$n" >&3
    printf '\e[36m◆\e[0m  %s  \e[2m↑/↓ · enter\e[0m\n' "$label" >&3
    for i in "${!opts[@]}"; do
      if [ "$i" = "$cur" ]; then printf '\e[2m│\e[0m  \e[32m●\e[0m \e[36m%s\e[0m\n' "${opts[i]:0:cols-6}"
      else printf '\e[2m│\e[0m  ○ %s\n' "${opts[i]:0:cols-6}"; fi >&3
    done
    n=$((${#opts[@]} + 1))
    IFS= read -rn1 key <&3 || key=""
    [ "$key" != $'\e' ] || read -rn2 -t 1 key <&3 || key=x   # an arrow is ESC [ A/B, or ESC O A/B in application mode; a lone ESC does nothing
    case $key in
      k|'[A'|OA) cur=$(((cur + ${#opts[@]} - 1) % ${#opts[@]}));;
      j|'[B'|OB) cur=$(((cur + 1) % ${#opts[@]}));;
      '') break;;
    esac
  done
  printf '\e[%dF\e[J\e[32m◇\e[0m  %s — %s\n' "$n" "$label" "${opts[cur]%% *}" >&3
  echo "${opts[cur]%% *}"
)

if [ "${1:-}" = setup ]; then
  name=${2:?usage: claude-discord setup <name> [--reset|--mode]}
  case $name in
    ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
    hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
  esac
  umask 077
  if [ "${3:-}" = --mode ]; then
    # --mode changes only an already set-up bot's mode, so re-picking a mode
    # never re-asks the token or the mention question. It creates nothing:
    # a bot without both files gets neither a directory nor config.env.
    [ -f "$root/$name/.env" ] && [ -f "$root/$name/access.json" ] || {
      echo "claude-discord: bot '$name' is not set up; run 'claude-discord setup $name' first" >&2
      exit 2
    }
  else
    # --reset forgets this bot's token and access policy AND the shared IDs, so
    # every prompt is asked again; other bots keep their own files.
    [ "${3:-}" = --reset ] && rm -rf "$root/$name" "$root/config.env"
    mkdir -p "$root/$name"
    printf '*\n' > "$root/.gitignore"
    if [ ! -f "$root/config.env" ]; then
      read -rp "Discord channel ID: " channel
      read -rp "Your Discord user ID: " user
      read -rp "Other user or bot IDs allowed to trigger bots there (comma-separated, empty for none): " others
      others=${others//[[:space:]]/}   # the file is sourced: a stray space would run an ID as a command
      printf "DISCORD_CHANNEL_ID='%s'\nDISCORD_USER_ID='%s'\nDISCORD_ALLOW_IDS='%s'\n" "$channel" "$user" "$others" > "$root/config.env"
    fi
  fi
  [ -f "$root/config.env" ] && . "$root/config.env"   # sourced whenever present: later code (write_access) reads its variables
  if [ "${3:-}" != --mode ]; then
    keep=""
    [ -f "$root/$name/.env" ] && keep=" (empty keeps the current one)"
    read -rsp "Bot token for $name$keep: " token
    echo
    [ -z "$token" ] && [ -n "$keep" ] || printf 'DISCORD_BOT_TOKEN=%s\n' "$token" > "$root/$name/.env"
    # Every bot in one channel answering every message means N replies per human
    # message, so the default stays mention-only; opt in per bot.
    read -rp "Respond to every message in the channel without an @mention? [y/N] " nomention
    case $nomention in y|Y) mention=false;; *) mention=true;; esac
    # access.json is the bot's LIVE policy: the plugin re-reads it on every
    # message, and its groups may have been hand-edited since the last setup
    # (moved to another channel, allowFrom trimmed, ackReaction silenced). A
    # re-run must not clobber that; only a bot with none yet (new, or just
    # after --reset, which deletes the bot dir first) gets one written fresh.
    if [ -f "$root/$name/access.json" ]; then
      jq_edit "$root/$name/access.json" --argjson mention "$mention" \
        'if (.groups | type) == "object" then .groups |= map_values(.requireMention = $mention) else . end'
    else
      write_access "$root/$name" "$mention"
    fi
  fi
  mode=$(cat "$root/$name/mode" 2>/dev/null) || mode=none
  mode=$(select_one Mode "$mode" \
    "none  a plain bot" \
    "dev-manager  coordinates claude-discord changes with peer bots" \
    "autoresearchclaw  reports each AutoResearchClaw iteration to the channel")
  printf '%s\n' "$mode" > "$root/$name/mode"
  if [ "$mode" = dev-manager ]; then
    read -rp "Peer dev bots as name:bot_id:owner_id:machine, comma-separated (empty keeps the current list): " peers || :
    peers=${peers//[[:space:]]/}
    entry='^[^:]+:[0-9]+:[0-9]+:[^:]+$'
    bad=$(jq -rn --arg in "$peers" --arg re "$entry" '$in | split(",")[] | select(. != "" and (test($re) | not))')
    [ -z "$bad" ] || echo "claude-discord: skipping peers not shaped name:bot_id:owner_id:machine: ${bad//$'\n'/ }" >&2
    jq_edit "$root/peers.json" --arg in "$peers" --arg re "$entry" '
      reduce ($in | split(",")[] | select(test($re)) | split(":") | {name: .[0], bot_id: .[1], owner_id: .[2], machine: .[3]}) as $p
        (.; if any(.peers[]?; .bot_id == $p.bot_id) then .peers |= map(if .bot_id == $p.bot_id then $p else . end)
            else .peers = (.peers // []) + [$p] end)'
    # access.json's groups are kept as they are (see above), so peers go into
    # every existing group's allowFrom, wherever the bot's channel actually
    # is, not only the one keyed by config.env's channel; this bot itself is
    # skipped by name, and $a + ($ids - $a) keeps it additive, as before.
    ids=$(jq -c --arg self "$name" '[.peers[]? | select((.name // "" | tostring | ascii_downcase) != ($self | ascii_downcase)) | .bot_id | tostring]' "$root/peers.json" 2>/dev/null) || ids='[]'
    jq_edit "$root/$name/access.json" --argjson ids "${ids:-[]}" \
      'if (.groups | type) == "object"
       then .groups |= map_values(.allowFrom = ((.allowFrom // []) as $a | $a + ($ids - $a)))
       else . end'
    echo "Ask each peer's owner to add this bot's id to their allowFrom; both directions are needed."
  fi
  ensure_hooks_symlink
  sync_mode_drops
  if [ "${3:-}" = --mode ]; then
    echo "claude-discord: $root/$name/mode set to $mode"
  else
    echo "claude-discord: $root/$name/access.json written (requireMention=$mention, mode=$mode)"
  fi
  exit 0
fi

# The bot name is the first bare word, wherever it sits: `claude-discord x --bg`
# and `claude-discord --bg x` are the same command. A word that follows a flag
# taking a value is that value, so `--resume x` never reads as the name, and
# with no bare word at all the project's single bot is meant. The list is
# every flag `claude --help` (2.1.277) shows with a value, optional ones
# ([value]) included since claude takes the next word for them too, plus
# hidden ones in use (--channels, --max-turns, the *-file prompt flags).
takes_value() {
  case $1 in
    -r|--resume|--model|--effort|--settings|--agent|--agents|--permission-mode|--permission-prompts| \
    --mcp-config|--add-dir|--session-id|--fallback-model|--max-turns|--max-budget-usd| \
    --output-format|--input-format|--json-schema|--debug-file|-d|--debug|--betas|--autocompact| \
    --append-system-prompt|--append-system-prompt-file|--system-prompt|--system-prompt-file| \
    --system-prompt-snapshot|--allowedTools|--allowed-tools|--disallowedTools|--disallowed-tools| \
    --tools|--setting-sources|--plugin-dir|--plugin-url|--file|--environment|--cloud|--from-pr| \
    --teleport|--remote-control|--remote-control-session-name-prefix|--prompt-suggestions| \
    -w|--worktree|--channels|-n|--name) return 0;;
    *) return 1;;
  esac
}

# A long-running session answers worse as its context fills, and the automatic
# compaction near the limit summarises at the point the model is least able to
# judge what matters. `refresh` replaces the session on purpose while it can
# still choose well: the session writes handoff.md (the hook tells it how), then
# runs this. A session cannot replace itself, so the work is handed to a
# detached child that outlives the session's own shell:
#   1. refuse unless handoff.md is there (--force skips that, for a wedged session)
#   2. stop the running session(s) registered under this bot's name
#   3. start a fresh one in the background; the launch path below folds
#      handoff.md into its system prompt and moves it aside
# Stop before start, never the reverse: two sessions on one token both answer.
# The gap between them loses whatever arrives in it; the fresh session is told
# to catch up from the channel history.
if [ "${1:-}" = refresh ]; then
  shift
  # The name is kept out of the claude args so the launch below can be given
  # it explicitly, whether it came from the command line or from the
  # environment: with two bots in the project the launcher cannot guess.
  force=no; fresh=() name="" skip=0
  for a in "$@"; do
    # A flag's value never starts with "-": after one whose value is optional
    # (--debug, --worktree) the next word may be the next flag.
    if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) fresh+=("$a"); continue;; esac; fi
    case $a in
      --force) force=yes;;
      -*) fresh+=("$a"); takes_value "$a" && skip=1 || :;;
      *)  if [ -z "$name" ]; then name=$a; else fresh+=("$a"); fi;;
    esac
  done
  # This script is re-run twice below (the detached child, then the launch),
  # and the cd that follows would break a relative `./claude-discord`.
  case $0 in /*) self=$0;; *) self=$PWD/$0;; esac
  # The session runs this from its own Bash, whose cwd has usually wandered
  # off the project by now. Its environment still says where the state is
  # (DISCORD_STATE_DIR is set at launch), so go back to that project; a shell
  # outside any session gives the directory the usual way, by standing in it.
  if [ -n "${DISCORD_STATE_DIR:-}" ]; then
    [ -n "$name" ] || name=$(basename "$DISCORD_STATE_DIR")
    cd "$(dirname "$(dirname "$(dirname "$DISCORD_STATE_DIR")")")"
    root=$PWD/.claude/discord-agents
  fi
  [ -n "$name" ] || { echo "usage: claude-discord refresh <name> [--force] [claude args]" >&2; exit 2; }
  case $name in ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;; esac
  dir=$root/$name
  [ -f "$dir/.env" ] || { echo "claude-discord: no bot '$name' under $root" >&2; exit 1; }
  if [ "$force" = no ] && [ ! -s "$dir/handoff.md" ]; then
    echo "claude-discord: $dir/handoff.md is missing or empty; write it first, or pass --force to replace the session without one" >&2
    exit 1
  fi
  if [ "${CLAUDE_DISCORD_REFRESH_CHILD:-}" != 1 ]; then
    # Re-run this same command detached: `claude stop` below kills the session
    # that is very likely running us, and its whole process group with it.
    # perl's setsid rather than setsid(1): macOS ships perl but no setsid.
    export CLAUDE_DISCORD_REFRESH_CHILD=1
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- nohup "$self" refresh "$@" > "$dir/refresh.log" 2>&1 < /dev/null &
    echo "claude-discord: refreshing $name in the background; progress in $dir/refresh.log"
    exit 0
  fi
  # Sessions are registered under the name the wrapper gave them (-n) and the
  # directory they were started in; another project's bot of the same name is
  # not ours. A background session has an id for `claude stop` (its pid may be
  # null while it is blocked, so the id decides); a foreground one has only a
  # pid, and SIGTERM is what closing its terminal would send. A listing that
  # fails or is not an array says nothing about what is running, which is not
  # the same as "nothing is": --force may not paper over it.
  if ! agents=$(claude agents --json 2>/dev/null) || ! live=$(printf '%s' "${agents:-null}" | jq -r --arg n "$name" --arg cwd "$(pwd -P)" '
      if type != "array" then error("not a list") else
        .[] | select(.name == $n and .cwd == $cwd and (.id != null or .pid != null))
        | "\(.id // "-") \(.pid // "-")" end' 2>/dev/null); then
    echo "claude-discord: 'claude agents --json' failed, so what is running is unknown; refusing to start a second session" >&2
    exit 1
  fi
  if [ -z "$live" ]; then
    # Nothing to stop means either the bot is down or it is running somewhere
    # this cannot see (started under another name, or from another directory).
    # Starting a second session in the latter case puts two on one token, so
    # refuse unless told otherwise.
    if [ "$force" = no ]; then
      echo "claude-discord: no running session named $name started in $PWD; it may be down, or running under another name. 'claude agents' lists them; pass --force to start a fresh one anyway" >&2
      exit 1
    fi
    echo "claude-discord: no running session named $name found; starting a fresh one (--force)"
  fi
  pids=()
  while read -r id pid; do
    [ -n "$id" ] || continue
    echo "claude-discord: stopping $name ($id, pid $pid)"
    if [ "$id" != - ]; then
      claude stop "$id" || echo "claude-discord: stop $id failed (already gone?)" >&2
    else
      kill -TERM "$pid" 2>/dev/null || :
    fi
    [ "$pid" = - ] || pids+=("$pid")
  done <<<"$live"
  # A stop that did not take leaves two sessions on one token, so wait for
  # every old pid to go before starting anything; a session that will not die
  # is reported, not raced.
  for _ in $(seq 20); do
    alive=()
    for pid in ${pids[@]+"${pids[@]}"}; do kill -0 "$pid" 2>/dev/null && alive+=("$pid") || :; done
    [ ${#alive[@]} -gt 0 ] || break
    sleep 0.5
  done
  if [ ${#alive[@]} -gt 0 ]; then
    echo "claude-discord: session $name still running after stop (pid ${alive[*]}); not starting another. Stop it by hand, then run 'claude-discord refresh $name --force'" >&2
    exit 1
  fi
  # The stopped session's channel server needs a moment to release the token;
  # a fresh gateway login while the old one is still up gets both dropped.
  [ -n "$live" ] && sleep 3
  echo "claude-discord: starting $name"
  unset CLAUDE_DISCORD_REFRESH_CHILD   # the fresh session's own refresh must fork again
  # A first turn, or the fresh session sits idle until the next message and
  # whoever asked for the refresh sees nothing happen. A prompt given on the
  # command line (a bare word after the name) is that first turn instead.
  kickoff=("Catch up on the channel and continue from your handoff.")
  skip=0
  for a in ${fresh[@]+"${fresh[@]}"}; do
    if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) continue;; esac; fi
    case $a in -*) takes_value "$a" && skip=1 || :;; *) kickoff=();; esac
  done
  exec "$self" --bg "$name" ${fresh[@]+"${fresh[@]}"} ${kickoff[@]+"${kickoff[@]}"}
fi

args=() name="" skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; case $a in -*) ;; *) args+=("$a"); continue;; esac; fi   # a value never starts with "-" (see refresh)
  case $a in
    -*) args+=("$a"); takes_value "$a" && skip=1 || :;;
    *)  if [ -z "$name" ]; then name=$a; else args+=("$a"); fi;;
  esac
done
if [ -z "$name" ]; then
  bots=()
  for d in "$root"/*/; do [ -f "$d/.env" ] && bots+=("$(basename "$d")"); done
  case ${#bots[@]} in
    1) name=${bots[0]};;
    0) echo "claude-discord: no bot set up in $root; run 'claude-discord setup <name>' in this directory first" >&2; exit 1;;
    *) echo "claude-discord: this directory has several bots (${bots[*]}); name the one to start" >&2; exit 2;;
  esac
fi
case $name in
  ''|.|..|*/*) echo "claude-discord: bot name must be a plain directory name, got '$name'" >&2; exit 2;;
  hooks|checkin) echo "claude-discord: bot name '$name' is reserved for the $name directory" >&2; exit 2;;
esac
dir=$root/$name
if [ ! -f "$dir/.env" ] || [ ! -f "$root/config.env" ]; then
  echo "claude-discord: no bot '$name' under $root; run 'claude-discord setup $name' in this directory first" >&2
  exit 1
fi
. "$root/config.env"

# Pre-existing setups: same policy the old first-run write produced.
[ -f "$dir/access.json" ] || write_access "$dir" true
ensure_ack_reaction "$dir"

# A plugin update replaces its directory, so put the proxy preload back every
# time; a machine without the preload gets no bunfig and bun's defaults.
install=$(jq -r --arg p "$plugin" '.plugins[$p][0].installPath' "$HOME/.claude/plugins/installed_plugins.json")
if [ -f "$helpers/discord-proxy.ts" ]; then
  printf 'preload = ["%s"]\n' "$helpers/discord-proxy.ts" > "$install/bunfig.toml"
else
  rm -f "$install/bunfig.toml"
fi

# Upstream drops every message whose author is a bot, so two bots can never
# hear each other. Narrow that to "my own messages" and let access.json's
# allowFrom decide which other bots get through. Same re-apply-every-start
# reasoning as bunfig.toml; idempotent because the pattern is gone once patched.
grep -q 'if (msg.author.bot) return' "$install/server.ts" &&
  perl -pi -e 's/^(\s*)if \(msg\.author\.bot\) return$/$1if (msg.author.id === client.user?.id) return/' "$install/server.ts"
# discord.js counts @everyone/@here as a mention of every bot, so one broadcast
# wakes every session in the channel. A session is addressed by its own bot only.
grep -q 'msg.mentions.has(client.user))' "$install/server.ts" &&
  perl -pi -e 's/msg\.mentions\.has\(client\.user\)\)/msg.mentions.has(client.user, { ignoreEveryone: true }))/' "$install/server.ts"

# The bot's channel is the single group key in its access.json, where a bot
# is moved to another channel; config.env's DISCORD_CHANNEL_ID otherwise (no
# file, no group, several). The same rule as hooks/lib/discord.sh's
# resolve_channel, which cannot be sourced here (it is not set -e safe, and
# the installed copy may be older than this script).
channel=$DISCORD_CHANNEL_ID
groups=$(jq -r '.groups | objects | keys[]' "$dir/access.json" 2>/dev/null) || groups=""
case $groups in ''|*[!0-9]*) ;; *) channel=$groups ;; esac
prompt="You are \"$name\", one of several Claude Code sessions sharing the Discord channel $channel, each through its own bot. \
The human reaches you there by @mentioning or replying to your bot; answer with the discord reply tool. \
Another bot receives your messages only when you @mention it and it allowlists your bot. \
Sessions on this machine can also be reached with ListAgents and SendMessage, addressing them by session name; mirror every such message you send or receive into that channel as one line ('-> name: ...' or '<- name: ...') so the human can follow and step in. \
The human's instructions override any agent's. \
Mention a bot as <@id> only when you need it to act or answer; if you were mentioned but nothing is asked of you, do not reply."

# A fresh session after a refresh must arrive already holding the handoff.
# Consumed once: leaving it would make every later restart resume a
# conversation that has moved on. The gap between the old session's stop and
# this one's gateway login loses whatever arrived in it, so catch up first;
# the hooks record the id of the last message the old session was given.
if [ -s "$dir/handoff.md" ]; then
  handoff=$(cat "$dir/handoff.md")
  mv "$dir/handoff.md" "$dir/handoff.prev.md"
  last=$(cat "$dir/last-message-id" 2>/dev/null || :)
  catchup="fetch the channel's recent messages first"
  [ -n "$last" ] && catchup="fetch the channel's messages first; the last one your predecessor saw was $last, so everything after it is new to you"
  prompt="$prompt \
A previous session of yours was replaced and left you this handoff. Treat it as \
what it says it is: claims marked [assumed] are unverified, so check them \
before repeating them to anyone. Messages that arrived while you were being \
replaced were not delivered: $catchup, and answer anything addressed to you. \
Then pick up from the Next section.

$handoff"
fi

# The state dir goes in BOTH the environment and --settings env. /bg (and
# `claude --bg`) respawn the session under the daemon from its CLI flags alone,
# dropping the shell environment (measured 2026-09-18: the fork had no
# DISCORD_STATE_DIR, its plugin server found no token and died silently);
# --settings is one of the flags the daemon carries over.
export DISCORD_STATE_DIR=$dir
# `claude --resume` takes a full session id; a NAME only works through the
# interactive picker, which cannot appear under --bg and is a detour otherwise.
# So resolve a name, or a short id as `claude agents` prints it, against this
# project's transcripts. Anything already a full id, or not found, is passed
# through untouched and claude decides.
res_i=-1 res_pre=""
for i in "${!args[@]}"; do
  case ${args[i]} in
    --resume|-r)  res_i=$((i+1)); res_pre="";;
    --resume=*)   res_i=$i;       res_pre="--resume=";;
    -r=*)         res_i=$i;       res_pre="-r=";;
  esac
done
want=""
[ "$res_i" -ge 0 ] && want=${args[res_i]:-} && want=${want#"$res_pre"}
if [ -n "$want" ] && ! printf '%s' "$want" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
  proj=$HOME/.claude/projects/$(printf '%s' "$PWD" | tr './' '--')
  found=""
  if printf '%s' "$want" | grep -qE '^[0-9a-f]{8}$'; then
    found=$(cd "$proj" 2>/dev/null && ls -t "$want"*.jsonl 2>/dev/null | head -1) || :
  else
    # The name is the session's own title (claude-discord -n, or /rename), which
    # is rewritten on every change, so only the LAST record of a file counts.
    found=$(cd "$proj" 2>/dev/null && for f in $(ls -t ./*.jsonl 2>/dev/null); do
      t=$(tail -c 262144 "$f" | grep -o '"customTitle":"[^"]*"' | tail -1)
      [ "$t" = "\"customTitle\":\"$want\"" ] && { echo "${f#./}"; break; }
    done) || :   # no match is not an error: `set -e` would abort on the loop's last test
  fi
  if [ -n "$found" ]; then
    args[res_i]="$res_pre${found%.jsonl}"
    echo "claude-discord: --resume $want -> ${found%.jsonl}" >&2
  fi
fi
# Whatever --resume ends up pointing at, resolved just above or passed through
# as a full id, is the session this start is about to reopen: the reaping below
# must never delete it. A transcript's basename IS the session id, and a name
# resolves to the newest transcript of this bot in this project, which is
# exactly the kind of row the daemon calls done.
resume_id=""
[ "$res_i" -ge 0 ] && resume_id=${args[res_i]:-} && resume_id=${resume_id#"$res_pre"}

# `claude` here is whatever bash finds on PATH, never a shell function: a setup
# that wraps claude in a process wrapper must name it, or that wrapping is
# skipped (measured 2026-09-18 with a launcher that wires a proxy chain: the
# bare binary bypassed it). CLAUDE_CODE_PROCESS_WRAPPER is Claude Code's own
# name for that wrapper and is exported into every session, so honouring it
# means an environment that already has one needs no extra setting. Not every
# session gets it in the environment though (settings.json's `env` block is
# merged into the session, not necessarily into the shell that starts it), so
# a session-scoped wrapper falls back to reading it from the same file Claude
# Code itself reads it from: ~/.claude/settings.json.
bin=$(command -v claude) || { echo "claude-discord: claude is not on PATH" >&2; exit 127; }
launcher=${CLAUDE_DISCORD_LAUNCHER:-${CLAUDE_CODE_PROCESS_WRAPPER:-}}
[ -n "$launcher" ] || launcher=$(jq -r '.env.CLAUDE_CODE_PROCESS_WRAPPER // empty' "$HOME/.claude/settings.json" 2>/dev/null) || :
run=("$bin")
[ -n "$launcher" ] && run=("$launcher" "$bin")

# Claude Code's daemon retires a background session after about an hour idle,
# and nothing here ever removed the retired one: `refresh` stops a session but
# never `rm`s it, so every start of a bot left one more dead entry in the agent
# view for ever (measured 2026-09-19 on an owner's machine: 7 rows for 2 bots,
# 4 of them stopped or done). So a start reaps its OWN dead sessions first:
# this bot's name, started in THIS project directory, and a state that says the
# session is over. `claude rm` deletes the session and, if it had one (the
# wrapper passes -w/--worktree through), its worktree, so everything else
# stays -- another name, another project, any live state (idle, busy, waiting,
# working, blocked), and an interactive entry with no state at all, none of
# which is this start's to remove. The session this very start is resuming is
# kept too ($resume_id, see above): --resume resolves a name to exactly such a
# done row, and reaping it would delete what the start is reopening.
# `claude rm <id>` takes the record's own `.id`, an 8-character job id, not
# `.sessionId` (a full transcript-basename UUID): measured 2026-09-19 on an
# owner's machine, `claude rm <sessionId>` answered "No job matching" while
# `claude rm <job id>` removed it, and `claude rm --help` says `Usage: claude
# rm <id>`. Most rows' `.id` equals `.sessionId`'s first 8 characters, but not
# all: a resumed session gets a new sessionId while the job id stays, so the
# two must not be conflated. $resume_id is still a full sessionId (a --resume
# value resolves to a transcript basename), so the exclusion still compares
# .sessionId != $keep; a row's .id is also compared to $keep in case a short
# id, rather than a name, was passed to --resume.
# Both calls go to "$bin", never "$run": they are local daemon bookkeeping and
# start no session, so a process wrapper (a proxy chain, a version pin) has
# nothing to wrap here and would only add a process per call.
# A start must never fail or stall on housekeeping, so every step is optional:
# no jq, no `timeout`, a listing that fails, hangs past 5 s, is not JSON, is
# not an array or is empty all leave the start exactly as it was, at most one
# line on stderr. The removals are capped at 20 per start, oldest first by
# startedAt, so a first run against a long-neglected daemon cannot turn a start
# into a minute of `rm` calls; the next start takes the next 20.
prune_dead_sessions() {
  local list ids id failed=0 t=()
  command -v jq >/dev/null 2>&1 || return 0
  if command -v timeout >/dev/null 2>&1; then t=(timeout 5); fi
  list=$(${t[@]+"${t[@]}"} "$bin" agents --json --all 2>/dev/null) || return 0
  ids=$(printf '%s' "${list:-null}" | jq -r --arg n "$name" --arg cwd "$(pwd -P)" --arg keep "${resume_id:-}" '
    if type != "array" then empty else
      [ .[] | select(.name == $n and .cwd == $cwd
                     and (.state == "stopped" or .state == "done")
                     and (.id // "") != "" and .sessionId != $keep and .id != $keep) ]
      | sort_by(.startedAt) | .[0:20][] | .id end' 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  while IFS= read -r id; do
    # A job id is exactly 8 hex characters, no dashes: unlike a sessionId
    # (a UUID, hex and dashes), a job id could never be mistaken for one by
    # this shape, and a crafted id must not become an argument to a delete --
    # a leading dash would read as a flag, and a newline in it arrives here
    # as two lines, both of which this shape also rejects.
    [[ $id =~ ^[0-9a-fA-F]{8}$ ]] || continue
    "$bin" rm "$id" >/dev/null 2>&1 || failed=$((failed + 1))
  done <<<"$ids"
  [ "$failed" = 0 ] || echo "claude-discord: could not remove $failed dead session(s) of $name from the agent view" >&2
}

ensure_hooks_symlink
sync_mode_drops
prune_dead_sessions || :   # even its last line (a warning on a closed stderr) may not fail the start
# worktree.bgIsolation "none" turns off Claude Code's background-isolation
# guard for this session: measured on two machines, a session started with
# --bg is refused Edit/Write in the checkout by that guard while a session
# moved to the background with /bg from the foreground is not. A bot editing
# its own project should behave like the /bg case either way it got there,
# and this needs no change to the project's own settings.json. Inert for a
# foreground start.
exec "${run[@]}" --channels "plugin:$plugin" \
  --settings "{\"enabledPlugins\": {\"$plugin\": true}, \"env\": {\"DISCORD_STATE_DIR\": \"$dir\"}, \"worktree\": {\"bgIsolation\": \"none\"}}" \
  -n "$name" --append-system-prompt "$prompt" ${args[@]+"${args[@]}"}
