#!/usr/bin/env bash
# PreToolUse hook (matcher: mcp__plugin_discord_discord__reply), dev-manager
# bots only: a bot only receives messages that mention it (<@bot_id> or
# <@!bot_id>), so deny a reply that names a peer (as a whole word,
# case-insensitive) without its mention, or that answers a peer without
# mentioning it: the author of the message in reply_to when that is set,
# else of the turn's last recorded message (on-prompt records
# "chat_id message_id user_id"). Prints nothing unless it denies; a no-op
# without peers.json. Must never fail a turn.
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0

[ "$bot_mode" = dev-manager ] && [ -f "$DISCORD_STATE_DIR/../peers.json" ] || exit 0
input=$(cat 2>/dev/null) || exit 0
# session_id and reply_to without jq would need a JSON parser; one jq reads them.
out=$(printf '%s' "$input" | jq -r '"\(.session_id // "") \(.tool_input.reply_to // "")"' 2>/dev/null) || exit 0
session_id=${out%% *} reply_to=${out#* }
from=""
case $session_id in
  ''|*[!A-Za-z0-9_-]*) ;;
  *) turns="$DISCORD_STATE_DIR/turns/$session_id"
     if [ -f "$turns" ]; then
       while read -r _ m u _ || [ -n "$m" ]; do
         if [ -n "$reply_to" ]; then [ "$m" != "$reply_to" ] || from=$u; else from=$u; fi
       done < "$turns"
     fi ;;
esac
reason=$(printf '%s' "$input" | jq -r --arg self "$bot_name" --arg from "$from" --slurpfile pf "$DISCORD_STATE_DIR/../peers.json" '
  (.tool_input.text // "" | tostring) as $text
  | [$pf[0].peers[]? | {name: (.name // "" | tostring), bot_id: (.bot_id // "" | tostring)}
     | select(.name != "" and (.bot_id | test("^[0-9]+$")) and (.name | ascii_downcase) != ($self | ascii_downcase))]
  | def mentioned: . as $p | $text | contains("<@\($p.bot_id)>") or contains("<@!\($p.bot_id)>");
  def named: . as $p | ($text | ascii_downcase | split($p.name | ascii_downcase)) as $s
    | any(range(1; $s | length); ($s[. - 1] | test("[a-z0-9_-]$") | not) and ($s[.] | test("^[a-z0-9_-]") | not));
  first(([.[] | select(.bot_id == $from and (mentioned | not))][0] // empty
    | "You are answering \(.name); mention it as <@\(.bot_id)> or it never sees this."),
  ([.[] | select(named and (mentioned | not))][0] // empty
    | "Mention \(.name) as <@\(.bot_id)>; a bot only receives messages that mention it."))' 2>/dev/null)
[ -n "$reason" ] || exit 0
jq -nc --arg r "$reason" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}' 2>/dev/null
exit 0
