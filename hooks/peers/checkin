#!/usr/bin/env bash
# PostToolUse hook (matcher: mcp__plugin_discord_discord__reply), dev-manager
# bots only: a reply that mentions a peer (<@bot_id> or <@!bot_id>) is a
# check-in, so touch $CLAUDE_PROJECT_DIR/.claude/discord-agents/checkin/
# <session_id>, which edit-gate reads. Prints nothing; a no-op without
# peers.json. Must never fail a turn.
[ -n "${DISCORD_STATE_DIR:-}" ] || exit 0   # not a bot session: no fork, nothing sourced
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0
plugin_gate || exit 0

[ "$bot_mode" = dev-manager ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -f "$DISCORD_STATE_DIR/../peers.json" ] || exit 0
session_id=$(jq -r --arg self "$bot_name" --slurpfile pf "$DISCORD_STATE_DIR/../peers.json" '
  (.tool_input.text // "" | tostring) as $text
  | select(any($pf[0].peers[]? | {name: (.name // "" | tostring), bot_id: (.bot_id // "" | tostring)}
      | select(.name != "" and (.bot_id | test("^[0-9]+$")) and (.name | ascii_downcase) != ($self | ascii_downcase));
      . as $p | $text | contains("<@\($p.bot_id)>") or contains("<@!\($p.bot_id)>")))
  | .session_id // empty' 2>/dev/null) || exit 0
case $session_id in ''|*[!A-Za-z0-9_-]*) exit 0 ;; esac
d="$DISCORD_STATE_DIR/../checkin"   # the bot project's, also from a worktree session
mkdir -p "$d" 2>/dev/null && touch "$d/$session_id" 2>/dev/null
exit 0
