#!/usr/bin/env bash
# PreToolUse hook (matcher: mcp__plugin_discord_discord__reply): table format
# and channel length, every bot (it reads no peer). Prints nothing unless it
# rewrites a table or denies:
#
# 1. Tables, every bot and every chat. Discord renders no GFM table: its rows
#    arrive as raw pipes. A table (a separator row |-|-|: two columns or more,
#    a hyphen or more each, as GFM allows; the header row just above it; the
#    contiguous pipe rows below) outside a ``` code block is rewritten into
#    a ``` block with its columns aligned by display width (East Asian Wide and
#    Fullwidth count 2, combining marks 0), and `**`, `__` and backticks,
#    which a code block shows raw, stripped from the cells. A table with a
#    line wider than MAX_WIDTH becomes one "header: value · ..." line per
#    row instead. The reply goes out through updatedInput: the whole input,
#    only `text` changed. One inside a code block is left alone. A reply
#    with a table and an odd number of ``` marks is denied instead: a lone
#    ``` may be prose or a fence that opens real code, and rewriting around
#    it would drop the mark or turn code into a table. Without a working
#    python3 the reply is denied too, as before the rewrite existed.
# 2. Length, in the channel, every bot but autoresearchclaw, on the text as
#    rewritten: one request lives in one thread, so the CHANNEL carries two
#    short lines per request (one when it starts, one when it lands) and the
#    long text goes inside the thread. A thread has a chat_id of its own, so
#    a reply whose chat_id is the bot's channel is a channel message: deny it
#    once it is over 500 characters. Characters, not bytes -- the channel's
#    lines are often Korean, and jq's `length` counts codepoints whatever the
#    locale says. A no-op without a channel, and for an autoresearchclaw bot,
#    whose rule posts one report per iteration in the channel: the thread
#    rule covers requests, not those reports.
#
# Must never fail a turn.
set -u
. "$(dirname "$0")/../lib/discord.sh" 2>/dev/null || exit 0

deny() {
  jq -nc --arg r "$1" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}' 2>/dev/null
  exit 0
}

input=$(cat 2>/dev/null) || exit 0
# Even pieces of a split on ``` are outside every code block. The last piece
# after an unclosed fence is looked at too, so a table there is denied below.
table=$(printf '%s' "$input" | jq -r '
  [(.tool_input.text // "" | tostring) | splits("```")] as $p | $p | to_entries
  | map(select(.key % 2 == 0 or (.key == ($p | length) - 1 and ($p | length) % 2 == 0)).value)
  | join("\n") | split("\n")
  | if any(test("^\\s*\\|?\\s*:?-+:?\\s*(\\|\\s*:?-+:?\\s*)+\\|?\\s*$")) then "table" else empty end' 2>/dev/null) || exit 0

# The same pieces and the same separator row, in python3: prints the hook
# input with each table rewritten, or nothing when no separator has a header
# row above it (then the reply is not a table after all and goes out as is).
# It exits 1, and the reply is denied, when the ``` marks do not pair up.
converted=""
if [ "$table" = table ]; then
  converted=$(printf '%s' "$input" | python3 -c '
import json, re, sys, unicodedata

MAX_WIDTH = 72  # a guess at the columns a phone shows in a code block before wrapping it, not a measured value
SEP = re.compile(r"^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)+\|?\s*$")

def width(s):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)

def cells(line):
    line = line.strip()
    line = line[1:] if line.startswith("|") else line
    line = line[:-1] if line.endswith("|") else line
    return [re.sub(r"\*\*|__|`", "", c).replace("\\|", "|").strip() for c in re.split(r"(?<!\\)\|", line)]

def pad(c, w, a):
    n = w - width(c)
    return {"r": " " * n + c, "c": " " * (n // 2) + c + " " * (n - n // 2)}.get(a, c + " " * n)

def render(header, align, rows):
    n = max(map(len, [header] + rows))
    header, *rows = [r + [""] * (n - len(r)) for r in [header] + rows]
    ws = [max(width(r[i]) for r in [header] + rows) for i in range(n)]
    line = lambda r: " | ".join(pad(c, w, a) for c, w, a in zip(r, ws, align + ["l"] * n)).rstrip()
    out = [line(header), "-+-".join("-" * w for w in ws)] + [line(r) for r in rows]
    if max(map(width, out)) <= MAX_WIDTH:
        # A mention inside a code block pings nobody: mentions in the table go on a line of their own above it.
        tags = list(dict.fromkeys(re.findall(r"<@[!&]?\d+>", " ".join(sum([header] + rows, [])))))
        return ([" ".join(tags)] if tags else []) + ["```"] + out + ["```"]
    return [" · ".join(h + ": " + v for h, v in zip(header, r)) for r in rows] or [" · ".join(header)]

def convert(piece):
    lines, out, i = piece.split("\n"), [], 0
    while i < len(lines):
        if i and SEP.match(lines[i]) and lines[i - 1].strip():
            j = i + 1
            while j < len(lines) and "|" in lines[j]:
                j += 1
            align = ["c" if s[:1] == ":" == s[-1:] else "r" if s[-1:] == ":" else "l" for s in cells(lines[i])]
            out[-1:] = render(cells(lines[i - 1]), align, [cells(l) for l in lines[i + 1:j]])
            i = j
        else:
            out.append(lines[i])
            i += 1
    return "\n".join(out)

d = json.loads(sys.stdin.buffer.read())  # bytes: UTF-8 whatever the locale
ti = d["tool_input"]
p = str(ti.get("text") or "").split("```")
if len(p) % 2 == 0:
    sys.exit(1)
new = [convert(s) if k % 2 == 0 else s for k, s in enumerate(p)]
if new != p:
    text = "```".join(new)
    print(json.dumps(dict(d, tool_input=dict(ti, text=text))))  # ASCII escapes: no locale can fail it
' 2>/dev/null) || deny 'Discord does not render markdown tables: rewrite it as a list, or put the table inside a ``` code block, and close every ``` fence.'
  [ -z "$converted" ] || input=$converted
fi

if [ "$bot_mode" != autoresearchclaw ] && [ -n "$bot_channel" ]; then
  over=$(printf '%s' "$input" | jq -r --arg ch "$bot_channel" '
    select((.tool_input.chat_id // "" | tostring) == $ch
      and ((.tool_input.text // "" | tostring) | length) > 500) | "over"' 2>/dev/null) || exit 0
  [ "$over" != over ] || deny 'Over 500 characters in the channel: start a thread (~/.claude-discord/hooks/tools/thread start "[<area>] <short title>") and post this inside it, leaving one line here.'
fi

[ -n "$converted" ] || exit 0
printf '%s' "$input" | jq -c '{hookSpecificOutput: {hookEventName: "PreToolUse", updatedInput: .tool_input}}' 2>/dev/null
exit 0
