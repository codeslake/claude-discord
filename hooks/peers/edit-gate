#!/usr/bin/env bash
# PreToolUse hook (matcher: Edit|Write|MultiEdit), dev-manager bots only: an
# edit whose realpath (its directory's, for a file not created yet) contains
# /claude-discord/, and that git does not ignore, is denied unless this
# session checked in with a peer on Discord (checkin/<session_id>, touched by
# the checkin hook) within the last 60 minutes; an allowed edit re-touches
# it, so the window slides. Prints nothing unless it denies; a no-op without
# peers.json. Must never fail a turn.
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0

[ "$bot_mode" = dev-manager ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ] || exit 0
out=$(jq -r '(.session_id // ""), (.tool_input.file_path // "")' 2>/dev/null) || exit 0
session_id=${out%%$'\n'*}; f=${out#*$'\n'}
[ "$out" != "$session_id" ] && [ -n "$f" ] || exit 0
case $session_id in ''|*[!A-Za-z0-9_-]*) exit 0 ;; esac
r=$(realpath "$f" 2>/dev/null) || { d=$(cd "$(dirname "$f")" 2>/dev/null && pwd -P) && r=$d/${f##*/}; } || r=$f
case $r/ in */claude-discord/*) ;; *) exit 0 ;; esac
# A path git ignores is not claude-discord's code but state kept inside the
# checkout (a bot's .claude/discord-agents/, where the refresh handoff is
# written; .superpowers/). git runs from the nearest directory that exists.
d=$(dirname "$r")
while [ ! -d "$d" ]; do d=$(dirname "$d"); done
git -C "$d" check-ignore -q "$r" 2>/dev/null && exit 0
p=$(peers) && [ -n "$p" ] || exit 0
ci="$CLAUDE_PROJECT_DIR/.claude/discord-agents/checkin/$session_id"
if [ -n "$(find "$ci" -mmin -60 2>/dev/null)" ]; then
  touch "$ci" 2>/dev/null
  exit 0
fi
ids=$(printf '%s' "$p" | jq -r '[.[] | "<@\(.bot_id)>"] | join(" ")' 2>/dev/null)
jq -nc --arg r "Before changing claude-discord, announce on Discord what you will change (mention $ids); you do not need to wait for an answer." \
  '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}' 2>/dev/null
exit 0
