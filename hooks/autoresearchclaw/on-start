#!/usr/bin/env bash
# SessionStart hook (matcher: startup|resume), registered while some bot in
# the project is in autoresearchclaw mode. For such a bot, starts
# autoresearchclaw/watch detached for this session and writes
# $DISCORD_STATE_DIR/arc-watch.pid as "<watcher pid> <worker pid>"; a live
# watcher of this same session is left alone. A resumed session is a new
# worker, so it gets its own watcher, and the old one exits at its next wake
# because the pidfile no longer names it. Prints nothing; never fails.
set -u
. "$(dirname "$0")/../lib/discord.sh" 2>/dev/null || exit 0
[ "$bot_mode" = autoresearchclaw ] || exit 0

# The worker is the session's claude process. A hook runs as
# `sh -c <command>` under it (measured: hook -> sh -> claude), and that sh
# exits with the hook, so walk up past shells.
worker=$PPID
while c=$(ps -o comm= -p "$worker" 2>/dev/null); do
  c=${c##*/}
  case ${c#-} in
    sh|bash|dash|zsh) worker=$(ps -o ppid= -p "$worker" 2>/dev/null | tr -d ' ') ;;
    *) break ;;
  esac
done
[ "${worker:-0}" -gt 1 ] 2>/dev/null && kill -0 "$worker" 2>/dev/null || exit 0

pidfile=$DISCORD_STATE_DIR/arc-watch.pid
pid="" for_worker=""
{ read -r pid for_worker < "$pidfile"; } 2>/dev/null || :
[ "$for_worker" = "$worker" ] && kill -0 "$pid" 2>/dev/null && exit 0
# perl's setsid rather than setsid(1): macOS ships perl but no setsid. Every
# stream is redirected, or the watcher would hold the hook's output open.
perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- "$(dirname "$0")/watch" "$worker" </dev/null >/dev/null 2>&1 &
printf '%s %s\n' "$!" "$worker" 2>/dev/null > "$pidfile"
exit 0
