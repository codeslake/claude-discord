#!/usr/bin/env bash
# SessionStart hook (matcher: startup|resume|compact|clear), registered while
# some bot in the project is in autoresearchclaw mode. For such a bot's
# session, prints the SessionStart JSON whose additionalContext is the whole
# plugin's rules/autoresearchclaw.md: the per-iteration
# report, the discussion rule, what never leaves the machine. At every
# source, since a compaction or /clear drops that context from the
# transcript. It arrives as context, not as a project .claude/rules file,
# because every session under the project loads the project's rules,
# AutoResearchClaw's own backend `claude` calls included, and those must not
# take on the bot's duties.
# ponytail: keyed on DISCORD_STATE_DIR alone, so a `claude` started from the
# bot session's own Bash inherits it and gets this context too; tell the
# bot's own session apart (its worker pid, say) if such a child ever acts on it.
# Prints nothing without DISCORD_STATE_DIR, for a bot in another mode or
# without the rule file. Starts no process; never fails.
[ -n "${DISCORD_STATE_DIR:-}" ] || exit 0   # not a bot session: no fork, nothing sourced
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0
plugin_gate || exit 0
[ "$bot_mode" = autoresearchclaw ] || exit 0
rule=$plugin_root/rules/autoresearchclaw.md
[ -f "$rule" ] || exit 0
# The rule's Bash loop needs a real path (a context line is not an env var).
sed "s#@ARC_EVENTS@#$plugin_root/tools/arc-events#g" "$rule" | jq -Rsc '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: .}}' 2>/dev/null   # not --rawfile: jq 1.5 lacks it
exit 0
