#!/usr/bin/env bash
# Run by an autoresearchclaw bot's session, from its standing watch (see
# rules/autoresearchclaw.md); never registered as a hook. Prints one line per
# NEW event under the project's AutoResearchClaw runs (artifacts/rc-*/ only),
# nothing when nothing is new:
#   iteration-end artifacts/rc-<run>/stage-15/decision.md    an iteration ended
#   run-end artifacts/rc-<run>/pipeline_summary.json         a run ended
# The project is $DISCORD_STATE_DIR/../../.. (the state dir is
# <project>/.claude/discord-agents/<bot>). Dedup key: the file's path
# relative to the project plus the cksum of its content, one
# "<path> <cksum>" line per seen pair in $DISCORD_STATE_DIR/arc-seen. So a
# relaunch that rewrites decision.md with other content is a new event, and
# an identical rewrite (or a touch) is not. The first call ever (no arc-seen
# yet) records everything present and prints nothing: a bot's first watch on
# a project with history reports none of it. A pair is recorded before it is
# printed, so an event is printed at most once; one that cannot be recorded
# is not printed at all. An empty file, or one written less than 2 s ago, is
# left for a later call: AutoResearchClaw writes both files with one
# non-atomic write, and a half-written file would be reported twice. The
# watch calls this every minute, so a call costs one perl (the ages; macOS
# has no GNU stat), one cksum and one grep whatever the number of files.
# Exits 0, except 2 (with a line on stderr) without DISCORD_STATE_DIR: it
# only means something inside a bot session.
set -u
[ -n "${DISCORD_STATE_DIR:-}" ] || { echo "events: DISCORD_STATE_DIR is unset; run this inside a claude-discord bot session" >&2; exit 2; }
seen=$DISCORD_STATE_DIR/arc-seen
cd "$DISCORD_STATE_DIR/../../.." 2>/dev/null || exit 0
[ -e "$seen" ] && first=0 || first=1
files=()
for f in artifacts/rc-*/stage-15/decision.md artifacts/rc-*/pipeline_summary.json; do [ -s "$f" ] && files+=("$f"); done
keys="" lines=""
if [ ${#files[@]} -gt 0 ]; then
  ready=()
  while IFS= read -r f; do ready+=("$f"); done < <(perl -e 'for (@ARGV) { print "$_\n" if time - (stat)[9] >= 2 }' "${files[@]}" 2>/dev/null)
  if [ ${#ready[@]} -gt 0 ]; then
    all=""
    while read -r c s f; do all="$all$f $c $s"$'\n'; done < <(cksum -- "${ready[@]}" 2>/dev/null)
    if [ "$first" = 1 ]; then keys=$all
    else keys=$(printf '%s' "$all" | grep -vxFf "$seen" 2>/dev/null); [ -z "$keys" ] || keys="$keys"$'\n'
    fi
    # A key is "<path> <crc> <size>"; the path may hold spaces.
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      f=${k% * *}
      case $f in */pipeline_summary.json) lines="${lines}run-end $f"$'\n' ;; *) lines="${lines}iteration-end $f"$'\n' ;; esac
    done <<<"$keys"
  fi
fi
# Written even when empty: a project with no runs yet must not stay "first".
{ printf '%s' "$keys" >> "$seen"; } 2>/dev/null || exit 0
[ "$first" = 1 ] || printf '%s' "$lines"
exit 0
