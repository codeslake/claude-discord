#!/usr/bin/env bash
# SessionEnd hook (1.19.4): /exit or Ctrl-C in a foreground bot (reason "prompt_input_exit") and a logout are a person's
# doing: the bot is held, so health reads it `held` (not down) and neither the monitor's automatic recover nor boot brings
# it back. In a client attached to a background bot they only detach it (no SessionEnd), and a daemon restart for an
# upgrade respawns its workers with no SessionEnd.
# `claude stop`, `claude rm` and a delete in the agent view end with reason "other", like a SIGTERM from a docker stop, a
# reboot or the daemon's idle retire, and this hook cannot tell them apart: it ran 2 s ahead of the daemon's "bg settled
# <job> (killed)" line in 2.1.304 and about 0.6 s ahead of it in 2.1.314, and `claude rm` deletes the job dir first, so the job's
# identity is gone (1.19.7). So "other" holds nothing here: health and boot read daemon.log when they decide
# (person_stopped, bin/lib/state.sh).
# A hold writes <state dir>/held; the bot's next session start removes it (on-session-start), and the monitor posts one
# [held] line, so a wrong call is seen. Only the bot's own session counts: the job of
# CLAUDE_JOB_DIR whose state.json names this session (a `claude -p` started from the bot's shell inherits both
# variables, not its session id). Must never block or fail: any failure is silent success.
[ -n "${DISCORD_STATE_DIR:-}" ] && [ -d "$DISCORD_STATE_DIR" ] || exit 0
read -r session_id reason <<EOF2
$(jq -r '"\(.session_id // "") \(.reason // "")"' 2>/dev/null)
EOF2
case $reason in prompt_input_exit|logout) ;; *) exit 0;; esac   # clear: the session goes on as another
id=${CLAUDE_JOB_DIR:-}; id=${id##*/}
[[ $id =~ ^[0-9a-f]{8}$ ]] && [ -n "$session_id" ] || exit 0
jq -e --arg s "$session_id" '.sessionId == $s or .resumeSessionId == $s' "$CLAUDE_JOB_DIR/state.json" >/dev/null 2>&1 || exit 0
printf 'session-end %s %s\n' "$reason" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$DISCORD_STATE_DIR/held" 2>/dev/null || :
exit 0
