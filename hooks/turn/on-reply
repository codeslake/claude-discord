#!/usr/bin/env bash
# PostToolUse hook (matcher: mcp__plugin_discord_discord__reply): marks that
# this turn actually sent a Discord reply, so on-stop knows to react ✅ on
# it, and that no Discord message is left unanswered (.pending). Must never
# block or fail a turn.
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0

[ -n "$bot_name" ] || exit 0
session_id=$(jq -r '.session_id // empty' 2>/dev/null) || exit 0
[ -n "$session_id" ] && [ -n "$bot_name" ] || exit 0
{ [ -d "$DISCORD_STATE_DIR/turns" ] || mkdir -p "$DISCORD_STATE_DIR/turns" 2>/dev/null; } && : >> "$DISCORD_STATE_DIR/turns/$session_id.replied" 2>/dev/null
[ ! -e "$DISCORD_STATE_DIR/turns/$session_id.pending" ] || rm -f "$DISCORD_STATE_DIR/turns/$session_id.pending" 2>/dev/null
exit 0
