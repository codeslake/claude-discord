#!/usr/bin/env bash
# Stop hook: if this turn recorded any Discord messages, reacts on each of
# them, then clears the per-turn files: ✅ when the turn sent a reply (on-reply
# or the thread tool set .replied), else ☑️ (read, no reply). A session
# has read a message once it receives it, so a turn is never sent back for
# want of a reply (owner, 2026-10-12). Prints nothing on stdout or stderr in
# any path and always exits 0: it never blocks or fails a turn.
[ -n "${DISCORD_STATE_DIR:-}" ] || exit 0   # not a bot session: no fork, nothing sourced
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0
plugin_gate || exit 0

[ -n "$bot_name" ] || exit 0
any=""; for f in "$DISCORD_STATE_DIR"/turns/*; do case $f in *.primed) ;; *) [ ! -e "$f" ] || any=1;; esac; done
[ -n "$any" ] || exit 0
input=$(cat 2>/dev/null) || exit 0
session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null) || exit 0
if [ -n "$session_id" ] && [ -n "$bot_name" ]; then
  turns="$DISCORD_STATE_DIR/turns/$session_id"
  replied="$turns.replied"
  if [ -f "$turns" ]; then
    mark='%E2%98%91%EF%B8%8F'; [ -f "$replied" ] && mark='%E2%9C%85'
    while IFS=' ' read -r chat_id message_id _; do
      [ -n "$chat_id" ] && [ -n "$message_id" ] || continue
      react "$chat_id" "$message_id" "$mark"
    done < "$turns"
  fi 2>/dev/null   # an unreadable turns file must not reach stderr either: this hook prints nothing
  rm -f "$turns" "$replied" 2>/dev/null
fi
exit 0
