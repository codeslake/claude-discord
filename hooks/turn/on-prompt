#!/usr/bin/env bash
# UserPromptSubmit hook: a turn that arrived over Discord (the transcript
# wraps it in a <channel source="plugin:discord:discord" ...> tag) must be
# answered through the discord reply tool only, not also typed into the CLI.
# Also records the turn's chat_id/message_id so on-stop can react to it (and
# the sender's user_id, which mention-guard reads), and offers a "refresh"
# handoff trigger. Must never block or fail a turn: any parse failure,
# missing field or unrelated prompt is silent success.
set -u
. "${0%/*}/../lib/discord.sh" 2>/dev/null || exit 0

[ -n "$bot_name" ] || exit 0
input=$(cat 2>/dev/null) || exit 0
# No tag anywhere in the raw JSON: a terminal prompt. Nothing to do unless a
# turns file (a bare session id, no dot) is present.
if [[ $input != *'<channel source=\"plugin:discord:discord\" chat_id=\"'* ]]; then
  any=""; for f in "$DISCORD_STATE_DIR"/turns/*; do case ${f##*/} in *.*) ;; *) [ ! -e "$f" ] || any=1;; esac; done
  [ -n "$any" ] || exit 0
  prompt=""
else
  out=$(printf '%s' "$input" | jq -r '(.session_id // ""), (.prompt // empty)' 2>/dev/null) || exit 0
  session_id=${out%%$'\n'*}; prompt=${out#*$'\n'}
  [ "$out" != "$session_id" ] || prompt=""
fi
# A Discord turn is a prompt that OPENS with the plugin's tag,
# `<channel source="plugin:discord:discord" chat_id=".." message_id=".."
# user=".." user_id=".." ts="..">` (whitespace aside), and only that leading
# tag is trusted: its ids and the sender's user_id are recorded, never
# anything from the message body. The plugin does not escape `<` in content
# (`<@id>` arrives raw), so a later "tag", a literal </channel> or text shaped
# like an attribute (a path-traversal payload disguised as a message_id) can
# all be forged; measured, every delivery, a mid-turn arrival included (each
# is its own prompt), carried exactly one tag. Digits only; react() also
# refuses a non-numeric id. The tag is the prompt's first line (measured: a
# newline follows its '>'), not "up to the first >": the display name in
# user="" comes before user_id and may hold `">`, but no newline, so the
# tag's own user_id is the line's last one.
tag='^<channel source="plugin:discord:discord" chat_id="([0-9]+)" message_id="([0-9]+)"'
trimmed=${prompt#"${prompt%%[![:space:]]*}"}   # leading whitespace, a newline included, then the first line
head=${trimmed%%$'\n'*}
if ! [[ $head =~ $tag ]]; then
  # A prompt typed in the terminal. A turns file here is either this turn's
  # (the prompt came mid-turn, after a Discord message) or one an interrupt
  # left behind: Esc ends a turn without its Stop, so on-stop never removed
  # it, and this turn would take the old Discord message for its own
  # (thread-guard would let it post; on-stop would send it back to answer).
  # The transcript tells them apart: an interrupt later than the last Discord
  # message (a snowflake carries its time) ended that turn. Not one under 3 s
  # old (read to the second, so 2 to 3 s): a prompt submitted while a turn
  # runs writes the same marker just before it (measured 55 and 200 ms), and
  # that Discord message still wants its answer. Any failure keeps the file.
  [ -n "$bot_name" ] || exit 0
  { read -r sid; read -r transcript; } < <(printf '%s' "$input" | jq -r '.session_id // "", .transcript_path // ""' 2>/dev/null) || exit 0
  case $sid in ''|*/*) exit 0 ;; esac
  turns=$DISCORD_STATE_DIR/turns/$sid
  [ -s "$turns" ] && [ -f "$transcript" ] || exit 0
  last=$(tail -n 1 "$turns" | cut -d' ' -f2)
  tail -n 200 "$transcript" | jq -en --arg m "$last" '
    [inputs | select(.type == "user" and (.message.content | if type == "array" then .[0].text? else . end
       | tostring | startswith("[Request interrupted by user"))) | .timestamp] | last // empty
    | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 * 1000
    | . > (($m | tonumber) / 4194304 | floor) + 1420070400000 and . < now * 1000 - 3000' >/dev/null 2>&1 \
    && rm -f "$turns" "$turns.replied" "$turns.pending" 2>/dev/null
  exit 0
fi
chat_id=${BASH_REMATCH[1]} message_id=${BASH_REMATCH[2]}
[ -n "$bot_name" ] || exit 0
user_id=""; [[ $head =~ .*\ user_id=\"([0-9]+)\" ]] && user_id=${BASH_REMATCH[1]}

if [ -n "$session_id" ] && { [ -d "$DISCORD_STATE_DIR/turns" ] || mkdir -p "$DISCORD_STATE_DIR/turns" 2>/dev/null; }; then
  # A turn that is only just starting hasn't replied yet, so a flag here is
  # stale. on-stop removes both files at the end of a turn: no turns file
  # means a new turn. With one, this prompt is a Discord message that arrived
  # mid-turn, perhaps after the reply, and the flag must stay; the message is
  # appended, so the turn's ✅ reaches every message it answered. Either way
  # this message is unanswered until the next reply (.pending, which on-reply
  # removes and on-stop checks).
  [ -e "$DISCORD_STATE_DIR/turns/$session_id" ] || [ ! -e "$DISCORD_STATE_DIR/turns/$session_id.replied" ] || rm -f "$DISCORD_STATE_DIR/turns/$session_id.replied" 2>/dev/null
  : > "$DISCORD_STATE_DIR/turns/$session_id.pending" 2>/dev/null || :
  printf '%s %s%s\n' "$chat_id" "$message_id" "${user_id:+ $user_id}" >> "$DISCORD_STATE_DIR/turns/$session_id" 2>/dev/null || :
  printf '%s\n' "$message_id" > "$DISCORD_STATE_DIR/last-message-id" 2>/dev/null || :
fi

# The identity/rules preamble is injected once per session, not on every
# turn (it is long, and repeating it every turn wastes context). It is built
# every Discord turn and keyed by the bot's mode plus the text itself;
# turns/<session_id>.primed holds the key it was last injected under, and it
# is injected again whenever that file is missing or holds another key: a
# changed mode (its rules changed), and any change to the text itself (a new
# install, a moved channel, a changed peer list), so a running session gets
# it once at its next Discord turn. on-session-start deletes that file after
# a compaction or /clear, so the next Discord turn re-primes.
context=""
primed="$DISCORD_STATE_DIR/turns/$session_id.primed"
[ -z "$session_id" ] || resolve_channel
if [ -n "$session_id" ]; then
  identity="Discord turn. You are $bot_name, the Claude Code session behind the Discord bot $bot_name in channel $bot_channel. Answer a Discord message with the discord reply tool; a question typed in the terminal in the same turn is answered in the terminal. Mention a bot as <@id> only when you need it to act or answer; if you were mentioned but nothing is asked of you, do not reply. 👀 and ✅ reactions are added automatically. One request, one thread: ~/.claude-discord/hooks/tools/thread start \"[<area>] <short title>\" posts its channel line and prints the thread id, thread close <id> \"<closing line>\" posts the line it lands with and ends it; the channel holds those two lines. Unless your mode's rules say otherwise, answer a quick request yourself and hand a longer one to a background subagent whose brief names its thread id."
  # A dev-manager with peers also learns who they are and how to work with them.
  if [ "$bot_mode" = dev-manager ] && p=$(jq -r --arg self "$bot_name" '[.peers[]? | {name: (.name // "" | tostring), bot_id: (.bot_id // "" | tostring)}
    | select(.name != "" and (.bot_id | test("^[0-9]+$")) and (.name | ascii_downcase) != ($self | ascii_downcase))]
    | select(length > 0) | map("\(.name) <@\(.bot_id)>") | join(", ")' "$DISCORD_STATE_DIR/../peers.json" 2>/dev/null) && [ -n "$p" ]; then
    identity="$identity
Peers (mention to reach them): $p
Dev manager: work alone end to end; ping a peer only for a review, a test on its machine, an R&R split or a heads-up before changing shared files; Discord carries only what a peer must act on or the human asks you to send; echo nothing either way."
  fi
  key="$bot_mode $identity"
  old=""; IFS= read -rd '' old 2>/dev/null < "$primed" || :
  if [ "${old%$'\n'}" != "$key" ]; then
    context=$identity
    printf '%s\n' "$key" > "$primed" 2>/dev/null
  fi
fi

# "refresh", case-insensitive, once the opening tag and the closing
# </channel> tag are stripped, any @mentions (<@id> or <@!id>) are removed,
# and whitespace (the tag/body are on separate lines) is collapsed and
# trimmed. Fires on every "refresh" message regardless of the primed state,
# since it is a specific command, not boilerplate.
t=${prompt#*>}
t=${t%</channel>*}
# Only a prompt that says "refresh" at all pays for the normalising pipeline
# (a case glob, not ${t,,}: that needs bash 4).
text=""
case $t in *[Rr][Ee][Ff][Rr][Ee][Ss][Hh]*) text=$(printf '%s' "$t" | sed -E 's/<@!?[0-9]+>//g' | tr -s '[:space:]' ' ' | sed -E 's/^ +//; s/ +$//' | tr '[:upper:]' '[:lower:]') ;; esac
if [ "$text" = refresh ]; then
  refresh_text="A refresh was requested: you will be replaced by a fresh session with an empty context, and the only thing that reaches it is the file you write now. Write $DISCORD_STATE_DIR/handoff.md, overwriting it, with exactly these sections:
# handoff — $bot_name · <ISO timestamp>
## Unanswered — who asked (Discord handle), what, when, message link if known. One line each. Someone is waiting.
## In flight — work you started and where it actually stands. Mark each claim [verified] or [assumed]; the next session treats this file as fact.
## Decisions — decision: why. The reasoning, not just the outcome.
## Next — what the fresh session should do first.
Leave a section out if genuinely empty; do not pad. Channel conventions are already injected, do not restate them. Redact tokens and anything personal. Then run \`claude-discord refresh $bot_name\` and say nothing else."
  if [ -n "$context" ]; then
    context="$context

$refresh_text"
  else
    context=$refresh_text
  fi
fi

[ -n "$context" ] && jq -nc --arg ctx "$context" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$ctx}}' 2>/dev/null
exit 0
