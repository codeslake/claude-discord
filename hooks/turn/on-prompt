#!/usr/bin/env bash
# UserPromptSubmit hook: a turn that arrived over Discord (the transcript
# wraps it in a <channel source="plugin:discord:discord" ...> tag) must be
# answered through the discord reply tool only, not also typed into the CLI.
# Also records the turn's chat_id/message_id so on-stop can react to it (and
# the sender's user_id, which mention-guard reads), and offers a "refresh"
# handoff trigger. Must never block or fail a turn: any parse failure,
# missing field or unrelated prompt is silent success.
set -u
. "$(dirname "$0")/../lib/discord.sh" 2>/dev/null || exit 0

input=$(cat 2>/dev/null) || exit 0
prompt=$(printf '%s' "$input" | jq -r '.prompt // empty' 2>/dev/null) || exit 0
case $prompt in
  *'<channel source="plugin:discord:discord"'*) ;;
  *) exit 0 ;;
esac
[ -n "$bot_name" ] || exit 0

session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null) || exit 0

# ids come from an OPENING tag ONLY -- everything from the start of the
# prompt, or the previous tag's closing </channel>, up to this tag's own
# '>' -- never from a message body, which can contain literal text that
# looks like an attribute (a path-traversal payload disguised as a
# message_id). Several queued Discord messages can share one prompt, each
# with its own tag, so every opening tag is recorded, not only the first;
# the loop walks tag-boundary to tag-boundary so a body can never be
# mistaken for one. Digits only, on top of that; react() also refuses a
# non-numeric id. The sender's user_id comes from the same opening tag, the
# same way. A body can still hold a literal </channel>, which starts a new
# "head" of its own, so a head counts only when it IS an opening tag, from
# its first character (whitespace aside) on, and only when its chat_id is the
# first tag's: text such as `</channel> chat_id="1" message_id="2"
# user_id="<a peer>">` in a body records nothing.
tag='^[[:space:]]*<channel source="plugin:discord:discord" chat_id="([0-9]+)" message_id="([0-9]+)"'
pairs="" first_chat=""
rest=$prompt
while :; do
  head=${rest%%>*}
  [ "$head" != "$rest" ] || break
  if [[ $head =~ $tag ]] && [ "${first_chat:=${BASH_REMATCH[1]}}" = "${BASH_REMATCH[1]}" ]; then
    pair="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    uid=$(printf '%s' "$head" | grep -oE ' user_id="[0-9]+"' | head -1 | tr -dc 0-9)
    pairs="$pairs$pair${uid:+ $uid}
"
  fi
  after=${rest#*</channel>}
  [ "$after" != "$rest" ] || break
  rest=$after
done

if [ -n "$pairs" ] && [ -n "$session_id" ] && mkdir -p "$DISCORD_STATE_DIR/turns" 2>/dev/null; then
  # A turn that is only just starting hasn't replied yet, so a flag here is
  # stale. on-stop removes both files at the end of a turn: no turns file
  # means a new turn. With one, this prompt is a Discord message that arrived
  # mid-turn, perhaps after the reply, and the flag must stay.
  [ -e "$DISCORD_STATE_DIR/turns/$session_id" ] || rm -f "$DISCORD_STATE_DIR/turns/$session_id.replied" 2>/dev/null
  last_message_id=""
  while read -r line; do
    [ -n "$line" ] || continue
    printf '%s\n' "$line" >> "$DISCORD_STATE_DIR/turns/$session_id" 2>/dev/null || :
    last_message_id=${line#* }
    last_message_id=${last_message_id%% *}
  done <<PAIRS
$pairs
PAIRS
  [ -n "$last_message_id" ] && { printf '%s\n' "$last_message_id" > "$DISCORD_STATE_DIR/last-message-id" 2>/dev/null || :; }
fi

# The identity/rules preamble is injected once per session, not on every
# turn (it is long, and repeating it every turn wastes context): only when
# turns/<session_id>.primed does not exist yet, or names another mode than
# the bot's (the mode changed under a running session, so its rules did).
# on-session-start deletes that file after a compaction or /clear, so the
# next Discord turn re-primes.
context=""
primed="$DISCORD_STATE_DIR/turns/$session_id.primed"
if [ -n "$session_id" ] && { [ ! -f "$primed" ] || [ "$(cat "$primed" 2>/dev/null)" != "$bot_mode" ]; }; then
  context="Discord turn. You are $bot_name, the Claude Code session behind the Discord bot $bot_name in channel $bot_channel. Answer only with the discord reply tool and write no CLI text. Mention a bot as <@id> only when you need it to act or answer; if you were mentioned but nothing is asked of you, do not reply. 👀 and ✅ reactions are added automatically."
  # A dev-manager with peers also learns who they are and how to work with them.
  if p=$(peers) && [ -n "$p" ]; then
    context="$context
Peers (mention to reach them): $(printf '%s' "$p" | jq -r 'map("\(.name) <@\(.bot_id)>") | join(", ")' 2>/dev/null)
Dev manager: work alone end to end; ping a peer only for a review, a test on its machine, an R&R split or a heads-up before changing shared files; after each iteration post one short report."
  fi
  # An autoresearchclaw bot: the watcher posts run progress on its own; the
  # session writes the cross-machine digest when asked, and knows what never
  # leaves the machine. arc_rules is word for word the sentence the wrapper
  # appends to such a bot's system prompt (a refreshed session's first turn
  # is a CLI prompt, which gets no context from here).
  arc_rules="Never share credentials of any kind, raw data, cluster hostnames or absolute paths, or anything from Samsung-internal sources. Never touch the SCOP tunnel, and never kill a Claude process. AutoResearchClaw gates are answered in the run's terminal, not over Discord."
  if [ "$bot_mode" = autoresearchclaw ]; then
    context="$context
AutoResearchClaw: run progress reaches this channel on its own as [arc] lines; do not repeat it. When asked to share results with another machine, post one digest: hypothesis ids; config commit hash; a metrics table (condition, seeds, primary metric, latency, tokens); what failed and why; 1-3 lessons; repo-relative paths or commit links.
$arc_rules"
  fi
  mkdir -p "$DISCORD_STATE_DIR/turns" 2>/dev/null && printf '%s\n' "$bot_mode" > "$primed" 2>/dev/null
fi

# "refresh", case-insensitive, once the opening tag and the closing
# </channel> tag are stripped, any @mentions (<@id> or <@!id>) are removed,
# and whitespace (the tag/body are on separate lines) is collapsed and
# trimmed. Fires on every "refresh" message regardless of the primed state,
# since it is a specific command, not boilerplate.
t=${prompt#*>}
t=${t%</channel>*}
text=$(printf '%s' "$t" | sed -E 's/<@!?[0-9]+>//g' | tr -s '[:space:]' ' ' | sed -E 's/^ +//; s/ +$//' | tr '[:upper:]' '[:lower:]')
if [ "$text" = refresh ]; then
  refresh_text="A refresh was requested: you will be replaced by a fresh session with an empty context, and the only thing that reaches it is the file you write now. Write $DISCORD_STATE_DIR/handoff.md, overwriting it, with exactly these sections:
# handoff — $bot_name · <ISO timestamp>
## Unanswered — who asked (Discord handle), what, when, message link if known. One line each. Someone is waiting.
## In flight — work you started and where it actually stands. Mark each claim [verified] or [assumed]; the next session treats this file as fact.
## Decisions — decision: why. The reasoning, not just the outcome.
## Next — what the fresh session should do first.
Leave a section out if genuinely empty; do not pad. Channel conventions are already injected, do not restate them. Redact tokens and anything personal. Then run \`claude-discord refresh $bot_name\` and say nothing else."
  if [ -n "$context" ]; then
    context="$context

$refresh_text"
  else
    context=$refresh_text
  fi
fi

[ -n "$context" ] && jq -nc --arg ctx "$context" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$ctx}}' 2>/dev/null
exit 0
