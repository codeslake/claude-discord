#!/usr/bin/env bash
# One item, one thread. Discord opens a thread only FROM a message that is
# already in the channel, so whatever is posted first stays in the channel
# for good: starting a thread from a long answer leaves the long answer
# behind. `thread start` therefore posts the short title ITSELF and opens the
# thread on it, and everything else about the item is written inside, under
# the id this prints (a message-started thread's id is that message's id).
# `thread close` posts the item's closing line in the channel and archives
# the thread so it leaves the sidebar.
#
#   thread start "[<area>] <short title>"          prints the thread id
#   thread close <thread_id> ["<closing line>"]    silent on success
#
# Discord hears only Discord-origin work (see peers/thread-guard). A session
# (CLAUDE_CODE_SESSION_ID) starts a thread only in a turn with a Discord
# message in it, every bot but autoresearchclaw, and a dev-manager from any
# turn, for an item a peer must act on (its rule). Such a thread is listed as
# "<id> terminal": close takes its closing line, but thread-guard, which
# matches whole lines, does not open it to posts, so every post there from a
# terminal turn must open with a peer's mention. A thread started in a
# Discord turn is listed
# in open-threads until it is closed, and takes posts from any turn meanwhile,
# so the background subagent that works the request, and the turn its result
# wakes, report there; that turn lands it with a closing line through close.
# A thread started, or a closing line posted, in a Discord turn answers that
# turn's message as a reply would. Entries older than a week go at each start:
# a thread left to archive itself is never closed.
#
# Run by the session, not registered as a hook. Exit 2: no bot to speak as,
# or a bad argument. Exit 1: Discord refused, named by HTTP status and error
# code only -- never the token, never the response body.
set -u
. "$(dirname "$0")/../lib/discord.sh" 2>/dev/null || :

status=000 resp=""

is_id() { case ${1:-} in ''|*[!0-9]*) return 1;; esac; return 0; }

# api <method> <path> [json]: sets $status and $resp. The Authorization
# header goes on curl's stdin (-H @-), never argv, so the token cannot be
# read out of ps; the JSON body carries no secret and goes in argv.
api() {
  # -w '\n%{http_code}': curl expands the \n itself, which keeps the status
  # on a line of its own without putting a newline in argv.
  local out args=(-s --max-time 10 -w '\n%{http_code}' -X "$1" -H @- "https://discord.com/api/v10/$2")
  [ $# -lt 3 ] || args+=(-H 'Content-Type: application/json' --data-raw "$3")
  out=$(printf 'Authorization: Bot %s\n' "$bot_token" | curl "${args[@]}" 2>/dev/null) || out=""
  status=${out##*$'\n'} resp=${out%$'\n'*}
  case $status in ''|*[!0-9]*) status=000;; esac
}

err_code() { printf '%s' "$resp" | jq -r '.code // empty' 2>/dev/null; }

fail() {  # $1 = what was being done
  local c; c=$(err_code)
  printf 'thread: %s failed: HTTP %s, discord code %s\n' "$1" "$status" "${c:-none}" >&2
  exit 1
}

if [ -z "${bot_token:-}" ] || ! is_id "${bot_channel:-}"; then
  echo "thread: no bot channel or token; DISCORD_STATE_DIR must name the bot's state directory" >&2
  exit 2
fi

open=$DISCORD_STATE_DIR/open-threads
turn=$DISCORD_STATE_DIR/turns/${CLAUDE_CODE_SESSION_ID:-none}
discord_turn() {
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || [ "$bot_mode" = autoresearchclaw ] || [ -e "$turn" ]
}
# thread-guard never sees a title or a closing line, so its channel limit is
# kept here.
one_line() {  # $1 = text, $2 = what it is
  case $1 in *$'\n'*) false ;; esac && [ "$(printf '%s' "$1" | jq -Rrs length)" -le 500 ] \
    || { echo "thread: $2 is one line in the channel: no newline, 500 characters at most" >&2; exit 2; }
}
answered() {  # what on-reply does for a reply
  [ -e "$turn" ] || return 0
  : >> "$turn.replied"; rm -f "$turn.pending"
}
# keep <awk condition on $1> [id]: keeps the open-threads lines it holds for,
# through a temp file.
keep() {
  [ -f "$open" ] || return 0
  awk -v now="$(date +%s)" -v id="${2:-}" "$1" "$open" > "$open.$$" && mv -f "$open.$$" "$open"
}

case ${1:-} in
  start)
    title=${2:-}
    [ -n "$title" ] || { echo "thread: usage: thread start \"[<area>] <short title>\"" >&2; exit 2; }
    one_line "$title" "a title"
    from_discord=""
    if discord_turn; then from_discord=1
    elif [ "$bot_mode" != dev-manager ]; then echo "thread: this turn has no Discord message in it, so no thread: answer in the terminal" >&2; exit 2
    fi
    # A snowflake's top bits are its time in ms since 2015; awk's doubles lose
    # only low bits.
    keep '(int($1 / 4194304) + 1420070400000) / 1000 > now - 604800'
    api POST "channels/$bot_channel/messages" "$(jq -nc --arg c "$title" '{content: $c}')"
    case $status in 2*) ;; *) fail "posting the channel line";; esac
    mid=$(printf '%s' "$resp" | jq -r '.id // empty' 2>/dev/null)
    is_id "$mid" || fail "posting the channel line"
    # jq slices a string by CHARACTERS whatever the shell's locale says, so a
    # Korean title is cut at Discord's 100-character limit and never
    # mid-byte. Only the thread name is cut: the channel message above keeps
    # the whole title.
    api POST "channels/$bot_channel/messages/$mid/threads" \
      "$(jq -nc --arg n "$title" '{name: $n[0:100], auto_archive_duration: 1440}')"
    case $status in
      2*) tid=$(printf '%s' "$resp" | jq -r '.id // empty' 2>/dev/null)
          is_id "$tid" || fail "opening the thread"
          if [ -n "$from_discord" ]; then printf '%s\n' "$tid" >> "$open"; answered; else printf '%s terminal\n' "$tid" >> "$open"; fi
          printf '%s\n' "$tid" ;;
      # 160004: a thread is already open on that message. Its id IS the
      # message id, so the caller gets what it came for instead of an error.
      *) [ "$(err_code)" = 160004 ] || fail "opening the thread"
         if [ -n "$from_discord" ]; then printf '%s\n' "$mid" >> "$open"; answered; else printf '%s terminal\n' "$mid" >> "$open"; fi
         printf '%s\n' "$mid" ;;
    esac ;;
  close)
    is_id "${2:-}" || { echo "thread: usage: thread close <thread_id> (digits only) [\"<closing line>\"]" >&2; exit 2; }
    if [ -n "${3:-}" ]; then
      discord_turn || grep -qE "^$2( terminal)?\$" "$open" 2>/dev/null \
        || { echo "thread: this turn has no Discord message in it and $2 is not a thread this bot opened, so no closing line: answer in the terminal" >&2; exit 2; }
      one_line "$3" "a closing line"
      api POST "channels/$bot_channel/messages" "$(jq -nc --arg c "$3" '{content: $c}')"
      case $status in 2*) ;; *) fail "posting the closing line";; esac
      answered
    fi
    api PATCH "channels/$2" "$(jq -nc '{archived: true}')"
    case $status in 2*) ;; *) fail "archiving the thread";; esac
    keep '($1 "") != (id "")' "$2" ;;   # as strings: two snowflakes can be one double
  *)
    echo "thread: usage: thread start \"[<area>] <short title>\" | thread close <thread_id> [\"<closing line>\"]" >&2
    exit 2 ;;
esac
